[Unit]
Description=EC-CUBE migration orchestrator worker
After=default.target

[Service]
Type=simple
WorkingDirectory=/Users/akihito/git/ec-cube-alps
Environment=PROJECT_ROOT=/Users/akihito/git/ec-cube-alps
Environment=PHP_BIN=php
Environment=SLEEP_SECONDS=5
ExecStart=/usr/bin/env bash /Users/akihito/git/ec-cube-alps/orchestrator/run-worker-loop.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
