#!/usr/bin/env bash
# A MySQL of this worktree's own, run by malt, for the SQL-backed tests.
#
#   bin/test-mysql start [port]   start it (a free port when none is given) and prepare the database
#   bin/test-mysql url            print the DATABASE_URL that points at it
#   bin/test-mysql stop           stop it
#
# Its config, data and socket live under var/mysql, so worktrees never share a server.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIR="$ROOT/var/mysql"
CONFIG="$DIR/malt.json"
DATABASE=${TEST_MYSQL_DATABASE:-eccubedb_test}

port_of_config() {
    php -r '$c = json_decode((string) file_get_contents($argv[1]), true); echo $c["ports"]["mysql"][0] ?? "";' "$CONFIG"
}

url() {
    if [ ! -f "$CONFIG" ]; then
        echo "no MySQL of this worktree; run bin/test-mysql start" >&2
        return 1
    fi

    printf 'mysql://root@127.0.0.1:%s/%s?charset=utf8mb4&serverVersion=8.0.0\n' "$(port_of_config)" "$DATABASE"
}

# True only when the server on that port keeps its data under this worktree: nothing else is ever written to
ours() {
    [ "$(mysql --protocol=tcp -h127.0.0.1 -P"$1" -uroot -N -e 'SELECT @@datadir' 2>/dev/null)" = "$DIR/malt/var/mysql_0/" ]
}

listening() {
    lsof -nP -iTCP:"$1" -sTCP:LISTEN > /dev/null 2>&1
}

start() {
    local port=${1:-}
    local saved=''
    [ -f "$CONFIG" ] && saved=$(port_of_config)

    if [ -n "$saved" ] && ours "$saved"; then
        if [ -n "$port" ] && [ "$port" != "$saved" ]; then
            echo "this worktree's MySQL runs on port $saved; run bin/test-mysql stop first" >&2
            exit 1
        fi
        port=$saved
    else
        if [ -z "$port" ] && [ -n "$saved" ] && ! listening "$saved"; then
            port=$saved
        fi
        if [ -z "$port" ]; then
            # The OS picks a free port; malt refuses to start if another process takes it first
            port=$(php -r '$s = stream_socket_server("tcp://127.0.0.1:0"); echo explode(":", (string) stream_socket_get_name($s, false))[1];')
        fi
        if listening "$port"; then
            echo "port $port is held by another process" >&2
            exit 1
        fi

        mkdir -p "$DIR/malt/conf" "$DIR/malt/tmp" "$DIR/malt/logs" "$DIR/malt/var"
        # Kept apart until the server answers, so a failed start leaves the saved config as it was
        local next="$DIR/malt.next.json"
        printf '{"project_name": "be-bemart-test-mysql", "dependencies": ["mysql@8.0"], "ports": {"mysql": [%s]}}\n' "$port" > "$next"
        # malt fills in MALT_DIR when it starts the server, not the port, so the port is written here
        sed "s/3306/$port/g" "$ROOT/malt/conf/my_3306.cnf" > "$DIR/malt/conf/my_$port.cnf"
        if ! malt start --config="$next" >&2; then
            rm -f "$next"
            echo "malt could not start MySQL on port $port; see $DIR/malt/logs" >&2
            exit 1
        fi

        for _ in $(seq 1 60); do
            ours "$port" && break
            sleep 1
        done
        if ! ours "$port"; then
            malt stop --config="$next" >&2 || true
            rm -f "$next"
            echo "MySQL on port $port did not answer from $DIR; see $DIR/malt/logs" >&2
            exit 1
        fi

        mv "$next" "$CONFIG"
    fi

    "$ROOT/sql/setup-db.sh" "$(url)" > /dev/null
    echo "export DATABASE_URL='$(url)'"
}

stop() {
    [ ! -f "$CONFIG" ] || malt stop --config="$CONFIG"
}

case "${1:-}" in
    start) start "${2:-}" ;;
    stop) stop ;;
    url) url ;;
    *) echo "usage: bin/test-mysql start [port] | url | stop" >&2; exit 2 ;;
esac
