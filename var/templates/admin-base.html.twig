<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title is defined and title is not empty %}{{ title }} {% endif %}{% if sub_title is defined and sub_title is not empty %}{{ sub_title }} {% endif %}- {{ shop_name|default('BeMart') }}</title>
    <link rel="icon" href="/assets/img/favicon.ico">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.5.2/css/all.css" integrity="sha384-PPIZEGYM1v8zp5Py7UjFb79S58UeqCL9pYVnVPURKEqvioPROaVAJKKLzvH2rDnI" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/idea-store/css/idea-admin.css">
    {% block stylesheet %}{% endblock %}
</head>
<body id="page_{{ route|default('admin-index') }}">
<div class="idea-admin-shell">

    <header class="idea-admin-topbar">
        <a class="idea-admin-topbar__logo" href="/admin/index">BeMart</a>
        <a class="idea-admin-topbar__store-link" href="/" target="_blank">
            {{ shop_name|default('BeMart') }}
            <i class="fa fa-angle-right" aria-hidden="true"></i>
        </a>
        <span class="idea-admin-topbar__spacer"></span>
        <span class="idea-admin-topbar__user">
            <i class="fa fa-user-circle" aria-hidden="true"></i>
            {{ admin_name|default('管理者') }}
        </span>
    </header>

    <aside class="idea-admin-sidebar">
        <nav aria-label="管理メニュー">
            <ul class="idea-admin-sidenav">

                <li class="idea-admin-sidenav__item">
                    <a class="idea-admin-sidenav__link" href="/admin/index">
                        <i class="fa fa-home fa-fw" aria-hidden="true"></i>
                        ホーム
                    </a>
                </li>

                <li class="idea-admin-sidenav__item">
                    <button class="idea-admin-sidenav__link" type="button"
                            aria-expanded="false" aria-controls="nav-product">
                        <i class="fa fa-cube fa-fw" aria-hidden="true"></i>
                        商品管理
                        <i class="fa fa-angle-down fa-fw idea-admin-sidenav__caret" aria-hidden="true"></i>
                    </button>
                    <ul class="idea-admin-sidenav__sub" id="nav-product" hidden>
                        <li><a href="/admin/product-list">商品一覧</a></li>
                        <li><a href="/admin/product-new">商品登録</a></li>
                        <li><a href="/admin/class-name/class-name-list">規格管理</a></li>
                        <li><a href="/admin/class-category/class-category-list">規格分類管理</a></li>
                        <li><a href="/admin/category/category-list">カテゴリ管理</a></li>
                        <li><a href="/admin/tag/tag-list">タグ管理</a></li>
                    </ul>
                </li>

                <li class="idea-admin-sidenav__item">
                    <button class="idea-admin-sidenav__link" type="button"
                            aria-expanded="false" aria-controls="nav-order">
                        <i class="fa fa-shopping-cart fa-fw" aria-hidden="true"></i>
                        受注管理
                        <i class="fa fa-angle-down fa-fw idea-admin-sidenav__caret" aria-hidden="true"></i>
                    </button>
                    <ul class="idea-admin-sidenav__sub" id="nav-order" hidden>
                        <li><a href="/admin/order-list">受注一覧</a></li>
                        <li><a href="/admin/order-status">対応状況管理</a></li>
                        <li><a href="/admin/order/export-order">受注CSV出力</a></li>
                        <li><a href="/admin/order/export-shipping">出荷CSV出力</a></li>
                    </ul>
                </li>

                <li class="idea-admin-sidenav__item">
                    <button class="idea-admin-sidenav__link" type="button"
                            aria-expanded="false" aria-controls="nav-customer">
                        <i class="fa fa-users fa-fw" aria-hidden="true"></i>
                        会員管理
                        <i class="fa fa-angle-down fa-fw idea-admin-sidenav__caret" aria-hidden="true"></i>
                    </button>
                    <ul class="idea-admin-sidenav__sub" id="nav-customer" hidden>
                        <li><a href="/admin/customer-list">会員一覧</a></li>
                        <li><a href="/admin/customer-csv">会員CSV出力</a></li>
                    </ul>
                </li>

                <li class="idea-admin-sidenav__item">
                    <button class="idea-admin-sidenav__link" type="button"
                            aria-expanded="false" aria-controls="nav-content">
                        <i class="fa fa-file-alt fa-fw" aria-hidden="true"></i>
                        コンテンツ管理
                        <i class="fa fa-angle-down fa-fw idea-admin-sidenav__caret" aria-hidden="true"></i>
                    </button>
                    <ul class="idea-admin-sidenav__sub" id="nav-content" hidden>
                        <li><a href="/admin/news/news-list">新着情報管理</a></li>
                        <li><a href="/admin/page/page-list">ページ管理</a></li>
                        <li><a href="/admin/layout/layout-list">レイアウト管理</a></li>
                        <li><a href="/admin/block/block-list">ブロック管理</a></li>
                        <li><a href="/admin/content/css">CSS管理</a></li>
                        <li><a href="/admin/content/js">JavaScript管理</a></li>
                        <li><a href="/admin/content/cache">キャッシュ管理</a></li>
                    </ul>
                </li>

                <li class="idea-admin-sidenav__item">
                    <button class="idea-admin-sidenav__link" type="button"
                            aria-expanded="false" aria-controls="nav-setting">
                        <i class="fa fa-cog fa-fw" aria-hidden="true"></i>
                        設定
                        <i class="fa fa-angle-down fa-fw idea-admin-sidenav__caret" aria-hidden="true"></i>
                    </button>
                    <ul class="idea-admin-sidenav__sub" id="nav-setting" hidden>
                        <li><a href="/admin/base-info">基本設定</a></li>
                        <li><a href="/admin/delivery/delivery-list">配送方法設定</a></li>
                        <li><a href="/admin/payment/payment-list">支払方法設定</a></li>
                        <li><a href="/admin/tax-rule/tax-rule-list">税率設定</a></li>
                        <li><a href="/admin/csv-config">CSV出力項目設定</a></li>
                        <li><a href="/admin/member-list">メンバー管理</a></li>
                        <li><a href="/admin/authority-role">権限管理</a></li>
                        <li><a href="/admin/security">セキュリティ管理</a></li>
                    </ul>
                </li>

                <li class="idea-admin-sidenav__item">
                    <button class="idea-admin-sidenav__link" type="button"
                            aria-expanded="false" aria-controls="nav-store">
                        <i class="fa fa-plug fa-fw" aria-hidden="true"></i>
                        オーナーズストア
                        <i class="fa fa-angle-down fa-fw idea-admin-sidenav__caret" aria-hidden="true"></i>
                    </button>
                    <ul class="idea-admin-sidenav__sub" id="nav-store" hidden>
                        <li><a href="/admin/plugin-list">プラグイン一覧</a></li>
                        <li><a href="/admin/template/template-list">テンプレート一覧</a></li>
                        <li><a href="/admin/template/template-add">テンプレートアップロード</a></li>
                    </ul>
                </li>

                <li class="idea-admin-sidenav__item">
                    <button class="idea-admin-sidenav__link" type="button"
                            aria-expanded="false" aria-controls="nav-info">
                        <i class="fa fa-info-circle fa-fw" aria-hidden="true"></i>
                        情報
                        <i class="fa fa-angle-down fa-fw idea-admin-sidenav__caret" aria-hidden="true"></i>
                    </button>
                    <ul class="idea-admin-sidenav__sub" id="nav-info" hidden>
                        <li><a href="https://github.com/be-framework/BeMart" target="_blank">BeMart</a></li>
                        <li><a href="https://be-framework.github.io/BeMart/" target="_blank">公開ドキュメント</a></li>
                        <li><a href="https://bearsunday.github.io/" target="_blank">BEAR.Sunday</a></li>
                        <li><a href="https://github.com/be-framework/BeMart/issues" target="_blank">Issue tracker</a></li>
                    </ul>
                </li>

            </ul>
        </nav>
    </aside>

    <main class="idea-admin-content">
        <div class="idea-admin-page-header">
            <h2 class="idea-admin-page-title">{{ title|default('') }}</h2>
            {% if sub_title is defined and sub_title is not empty %}
            <span class="idea-admin-page-subtitle">{{ sub_title }}</span>
            {% endif %}
        </div>

        {% block main %}{% endblock %}

    </main>

</div>
<script>
(function () {
    document.querySelectorAll('.idea-admin-sidenav__link[aria-expanded]').forEach(function (btn) {
        var targetId = btn.getAttribute('aria-controls');
        var sub = document.getElementById(targetId);
        if (!sub) return;
        btn.addEventListener('click', function () {
            var open = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!open));
            if (open) { sub.hidden = true; } else { sub.hidden = false; }
        });
    });
}());
</script>
{% block javascript %}{% endblock %}
</body>
</html>
