{#
  Block/topic.html.twig — 特集ブロック（インクルード部品、extends なし）

  データ契約:
    変数 `topics` — array|null。各要素:
      title       string  — 特集タイトル
      kicker      string  — 上部ラベル（英語表記）
      image       string  — 画像パス
      href        string  — 遷移先 URL
      rel         string  — ALPS 遷移 rel（通常 "goProductList"）
      imageAlt    string  — img alt テキスト

    変数が未供給の場合はカテゴリベースのデフォルトリストを使用する。

  遷移:
    goProductList → /products?category_id={id}  (src/Resource/Page/Products.php #[Link])
  フォームなし。CSRF 不要。
  設計言語: IdeaStore（idea-* クラス / idea-store.css）。
#}

{% set defaultTopics = [
  {
    kicker:   'Storage',
    title:    '収納を整える',
    image:    '/assets/idea-store/images/category/real/entry-storage.png',
    imageAlt: '収納カテゴリの特集',
    href:     '/products?name=' ~ '収納'|url_encode,
    rel:      'goProductList'
  },
  {
    kicker:   'Kitchen',
    title:    '台所の道具を選ぶ',
    image:    '/assets/idea-store/images/category/real/entry-kitchen.png',
    imageAlt: '台所カテゴリの特集',
    href:     '/products?name=' ~ '台所'|url_encode,
    rel:      'goProductList'
  },
  {
    kicker:   'Furniture',
    title:    '家具を住まいに',
    image:    '/assets/idea-store/images/category/real/entry-furniture.png',
    imageAlt: '家具カテゴリの特集',
    href:     '/products?name=' ~ '家具'|url_encode,
    rel:      'goProductList'
  }
] %}

{% set topicItems = topics|default(defaultTopics) %}

<section class="idea-container idea-section idea-section--tight"
         aria-labelledby="idea-topic-heading">

  <div class="idea-section-head">
    <div>
      <p class="idea-eyebrow">Curated themes</p>
      <h2 id="idea-topic-heading" class="idea-section-title">特集</h2>
    </div>
    <a class="idea-muted idea-view-all"
       href="/products"
       rel="goProductList">商品を見る</a>
  </div>

  <div class="idea-editorial-cards">
    {% for item in topicItems %}
      {% set itemHref  = item.href|default('/products') %}
      {% set itemRel   = item.rel|default('goProductList') %}
      {% set itemAlt   = item.imageAlt|default(item.title|default('')) %}
      {% set itemImage = item.image|default('/assets/idea-store/images/category/real/entry-gelato.png') %}
      <a href="{{ itemHref }}"
         rel="{{ itemRel }}">
        <img src="{{ itemImage }}"
             alt="{{ itemAlt }}"
             loading="lazy">
        <span>
          {% if item.kicker is defined and item.kicker %}
            <span class="idea-card-kicker">{{ item.kicker }}</span>
          {% endif %}
          {{ item.title|default('') }}
        </span>
      </a>
    {% endfor %}
  </div>

</section>
