<header class="idea-header" role="banner">
  <a href="/" aria-label="{{ shop_name|default('BeMart') }} ホーム" class="idea-logo-link">
    <span class="idea-wordmark">{{ shop_name|default('BeMart') }}</span>
  </a>

  <nav class="idea-nav" aria-label="カテゴリナビゲーション">
    <a href="/products?category_id=2">新入荷</a>
    <a href="/products?category_id=1">ジェラート</a>
    <a href="/products?category_id=3">彩のデザート</a>
    <a href="/products?category_id=4">CUBE</a>
    <a href="/products?category_id=5">アイスサンド</a>
    <a href="/products?category_id=6">フルーツ</a>
  </nav>

  <div class="idea-header-actions">
    <form class="idea-search" action="/products" method="get" role="search">
      <input type="search" name="name" maxlength="50" placeholder="探す" aria-label="商品を検索">
    </form>

    <div class="idea-header-user">
      <a href="/entry" class="idea-header-user__link" aria-label="会員登録">登録</a>
      <a href="/login" class="idea-header-user__link" aria-label="ログイン">ログイン</a>
      <a href="/mypage" class="idea-header-user__link" aria-label="マイページ">マイページ</a>
    </div>

    <a class="idea-cart-link" href="/cart" aria-label="カートを見る">カート</a>
  </div>
</header>
