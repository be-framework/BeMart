{#
  BeMart storefront Block widget — site logo / wordmark.

  Standalone brand-mark partial. No extends. Included from the layout frame
  alongside other header blocks (header, category_nav_pc).

  Data contract: purely static. Reads only `shop_name` from the frame
  context (set by the page resource; defaults to 'BeMart').
  No domain resource, no form, no link traversal required.

  IdeaStore classes used:
    idea-logo-link  — wraps the home anchor (inline-flex, flex: 0 0 auto)
    idea-wordmark   — text-based brand name (no SVG asset dependency)
#}
<div class="idea-logo">
  <a href="/" class="idea-logo-link" aria-label="{{ shop_name|default('BeMart') }} ホーム">
    <span class="idea-wordmark">{{ shop_name|default('BeMart') }}</span>
  </a>
</div>
