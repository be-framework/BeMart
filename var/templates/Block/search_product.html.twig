{#
  BeMart storefront Block widget — product search.

  PORT/SIMPLIFIED of EC-CUBE 4.3 default-theme `Block/search_product.twig`.

  In EC-CUBE's default layout, the top page reaches Product/list through
  the header search block: submitting the search form with no keyword
  performs an all-products search and navigates to `/products`.

  EC-CUBE renders the category <select> from `form.category_id` (the
  Category repository). BeMart supplies the same choices through the
  `storefront_categories()` Twig helper (see BeMartTwigExtension::categories),
  which carries the six fixture categories Page/Products filters on, so a
  user can filter by category from the header — the empty 「全ての商品」
  option keeps the all-products affordance.
#}
<div class="ec-headerSearch">
    <form method="get" action="/products">
        <div class="ec-headerSearch__category">
            <div class="ec-select ec-select_search">
                <select name="category_id" id="category_id">
                    <option value="">全ての商品</option>
                    {% for category in storefront_categories() %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="ec-headerSearch__keyword">
            <div class="ec-input">
                <input type="search" name="name" maxlength="50" placeholder="キーワードを入力">
                <button class="ec-headerSearch__keywordBtn" type="submit" aria-label="商品を検索">
                    <div class="ec-icon">
                        <img src="{{ asset('assets/icon/search-dark.svg') }}" alt="">
                    </div>
                </button>
            </div>
        </div>
    </form>
</div>
