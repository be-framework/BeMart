{#
  Block/new_item.html.twig — 新着商品ブロック (included component, no extends).

  Data contract: src/Resource/Page/Products.php / var/json_schema/get-products.json
  Variable expected in scope:
    products[]  — { productCode, productName, name, price02, stock,
                    mainListImage, categoryNames[], descriptionList }
  Hypermedia (from #[Link] in Index.php):
    goProductList → /products
    goProduct     → /products/detail/{productCode}
  Design language: IdeaStore (idea-* classes from idea-store.css).
#}

{% set newItems = products|default([]) %}

<section class="idea-container idea-section idea-section--tight"
         aria-labelledby="idea-new-item-heading">
  <div class="idea-section-head">
    <div>
      <p class="idea-eyebrow">New arrivals</p>
      <h2 id="idea-new-item-heading" class="idea-section-title">新しく届いたもの</h2>
    </div>
    <a class="idea-muted idea-view-all"
       href="/products"
       rel="goProductList">すべて見る</a>
  </div>

  {% if newItems is not empty %}
    <div class="idea-product-grid idea-product-grid--home">
      {% for product in newItems|slice(0, 8) %}
        {% set code        = product.productCode|default(product.id|default('')) %}
        {% set itemName    = product.productName|default(product.name|default('')) %}
        {% set image       = product.mainListImage|default('/assets/idea-store/images/product/real/product-001.png') %}
        {% if image starts with 'idea-store/' %}
          {% set image = '/save_image/' ~ image %}
        {% elseif image starts with 'save_image/' or image starts with 'assets/' %}
          {% set image = '/' ~ image %}
        {% endif %}
        {% set category    = product.categoryNames|default([])|first|default('') %}
        {% set description = product.descriptionList|default('') %}
        {% set price       = product.price02|default(0) %}
        {% set stock       = product.stock|default(null) %}
        <a class="idea-card idea-product-card"
           href="/products/detail/{{ code }}"
           rel="goProduct">
          <span class="idea-product-card-media">
            <span class="idea-product-badge">NEW</span>
            <img src="{{ image }}"
                 alt="{{ itemName }}"
                 {% if loop.index > 4 %}loading="lazy"{% endif %}>
          </span>
          <span class="idea-card-body">
            {% if category %}
              <span class="idea-card-kicker">{{ category }}</span>
            {% endif %}
            <strong class="idea-card-title">{{ itemName }}</strong>
            {% if description %}
              <span class="idea-muted">{{ description }}</span>
            {% endif %}
            <span class="idea-card-bottom">
              <span class="idea-price">¥{{ price|number_format }}</span>
              <span aria-hidden="true">→</span>
            </span>
            <span class="idea-shipping">
              {%- if stock is not null and stock > 0 -%}
                在庫あり
              {%- else -%}
                入荷待ち
              {%- endif -%}
            </span>
            <span class="idea-card-cta-row" aria-hidden="true">
              <span class="idea-card-cta idea-card-cta--primary">詳細を見る</span>
            </span>
          </span>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</section>
