{#
  BeMart storefront Block widget — footer.

  Clean-room build in IdeaStore design language.

  Data contract:
  - `shop_name` (string, optional) — injected by the frame; defaults to
    'BeMart'. No other domain data is required; this widget is static.

  Link contract (src/Resource/Page/Index.php #[Link] declarations):
  - goHelpAbout        → /help/about
  - goHelpPrivacy      → /help/privacy
  - goHelpTradeLaw     → /help/trade-law
  - goHelpAgreement    → /help/agreement
  - goHelpGuide        → /help/guide
  - goContactForm      → /contact

  CSS vocabulary: idea-footer / idea-footer-grid / idea-footer-copy /
  idea-footer-nav / idea-eyebrow / idea-admin-access  (idea-store.css).
#}
<footer class="idea-footer" role="contentinfo">
  <div class="idea-container idea-footer-grid">

    <div class="idea-footer-brand">
      <p class="idea-eyebrow">{{ shop_name|default('BeMart') }}</p>
      <p class="idea-footer-copy">
        &copy; {{ "now"|date("Y") }} {{ shop_name|default('BeMart') }}
      </p>
    </div>

    <nav class="idea-footer-nav" aria-label="サイト情報">
      <a href="/help/about"       rel="goHelpAbout">このサイトについて</a>
      <a href="/help/privacy"     rel="goHelpPrivacy">プライバシーポリシー</a>
      <a href="/help/trade-law"   rel="goHelpTradeLaw">特定商取引法に基づく表記</a>
      <a href="/help/agreement"   rel="goHelpAgreement">利用規約</a>
      <a href="/help/guide"       rel="goHelpGuide">ご利用ガイド</a>
      <a href="/contact"          rel="goContactForm">お問い合わせ</a>
    </nav>

  </div>

  <div class="idea-container idea-admin-access">
    <a href="/admin/login" rel="nofollow">管理者ログイン</a>
  </div>
</footer>
