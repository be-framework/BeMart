{#
  BeMart storefront Block — category sub-navigation strip (PC).

  Self-contained include; no extends. Rendered inside the shared frame
  header region directly after Block/logo.html.twig.

  Data contract: src/Resource/Page/Products.php
    goProductList  →  /products?category_id={id}
    category_id values and their names are fixed in
    Products::categoryName() (ids 1-6).

  IdeaStore vocabulary: idea-chip-row, idea-chip-row a (pill links).
  No ec-* classes. No EC-CUBE runtime bindings.
#}
<nav class="idea-container" aria-label="カテゴリで絞り込む">
  <div class="idea-chip-row idea-chip-row--toolbar">
    <a href="/products" rel="goProductList">すべて</a>
    <a href="/products?name={{ '収納'|url_encode }}" rel="goProductList">収納</a>
    <a href="/products?name={{ '台所'|url_encode }}" rel="goProductList">台所</a>
    <a href="/products?name={{ '家具'|url_encode }}" rel="goProductList">家具</a>
    <a href="/products?name={{ '本と雑誌'|url_encode }}" rel="goProductList">本</a>
    <a href="/products?name={{ '音楽'|url_encode }}" rel="goProductList">音楽</a>
    <a href="/products?name={{ '工作の道具'|url_encode }}" rel="goProductList">工作</a>
  </div>
</nav>
