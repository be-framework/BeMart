{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}カート | IDEA STORE{% endblock %}
{% block content %}
{% set displayCarts = carts|default([])|filter(cart => cart.items|default([])|length > 0) %}
{% set progress = [
  { label: 'カート', state: 'is-active' },
  { label: '購入入口', state: '' },
  { label: 'ご注文手続き', state: '' },
  { label: '内容確認', state: '' },
  { label: '完了', state: '' }
] %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><span>Cart</span>
</nav>

<section class="idea-container idea-checkout-hero idea-checkout-hero--cart" aria-labelledby="idea-cart-title">
  <div>
    <p class="idea-eyebrow">Shopping cart</p>
    <h1 id="idea-cart-title" class="idea-title idea-title--compact"><span class="idea-title-line">選んだイデアを、</span><span class="idea-title-line">暮らしへ。</span></h1>
    <p class="idea-muted">数量を確認して、購入入口へ進みます。匿名のお客様も、まずはログイン／ゲスト購入の選択画面へご案内します。</p>
  </div>
  <div class="idea-checkout-status">
    <span>{{ displayCarts|length > 0 ? 'Ready' : 'Empty' }}</span>
    <strong>¥{{ totalPrice|default(0)|number_format }}</strong>
    <small>{{ displayCarts|length }} cart group{% if displayCarts|length != 1 %}s{% endif %}</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  {% for item in progress %}
    <span class="{{ item.state }}"><b>{{ loop.index }}</b>{{ item.label }}</span>
  {% endfor %}
</section>

<section class="idea-container idea-section idea-checkout-layout">
  <div class="idea-checkout-main">
    {% if displayCarts|length > 0 %}
      {% for cart in displayCarts %}
        <article class="idea-checkout-panel idea-cart-panel">
          <div class="idea-panel-head">
            <div>
              <p class="idea-eyebrow">{{ cart.saleTypeName|default('通常販売') }}</p>
              <h2 class="idea-section-title">カートの商品</h2>
            </div>
            <span class="idea-panel-total">¥{{ cart.totalPrice|default(0)|number_format }}</span>
          </div>

          <div class="idea-cart-list">
            {% for item in cart.items|default([]) %}
              {% set image = item.mainImage|default('/assets/idea-store/images/product/product-01.svg') %}
              {% if image starts with 'idea-store/' %}
                {% set image = '/save_image/' ~ image %}
              {% elseif image starts with 'save_image/' or image starts with 'assets/' %}
                {% set image = '/' ~ image %}
              {% endif %}
              {% set quantity = item.quantity|default(1) %}
              {% set unitPrice = item.price|default(0) %}
              <article class="idea-cart-item">
                <a class="idea-cart-item__image" href="/product?productCode={{ item.productCode }}">
                  <img src="{{ image }}" alt="{{ item.productName|default(item.productCode) }}">
                </a>
                <div class="idea-cart-item__body">
                  <p class="idea-card-kicker">{{ item.productCode }}</p>
                  <h3><a href="/product?productCode={{ item.productCode }}">{{ item.productName|default('IDEA STORE 商品') }}</a></h3>
                  {% if item.classCategoryName1|default('') %}
                    <p class="idea-muted">{{ item.className1|default('規格') }}：{{ item.classCategoryName1 }}</p>
                  {% endif %}
                  {% if item.classCategoryName2|default('') %}
                    <p class="idea-muted">{{ item.className2|default('規格') }}：{{ item.classCategoryName2 }}</p>
                  {% endif %}
                  <p class="idea-cart-item__price">¥{{ unitPrice|number_format }} × {{ quantity|number_format }}</p>
                </div>
                <div class="idea-cart-item__controls" aria-label="{{ item.productName|default(item.productCode) }}の数量操作">
                  <div class="idea-quantity-actions">
                    <form method="post" action="/cart/item">
                      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                      <input type="hidden" name="productCode" value="{{ item.productCode }}">
                      <input type="hidden" name="operation" value="down">
                      <input type="hidden" name="quantity" value="{{ quantity - 1 }}">
                      <button type="submit" aria-label="数量を減らす"{% if quantity <= 1 %} disabled{% endif %}>−</button>
                    </form>
                    <span>{{ quantity|number_format }}</span>
                    <form method="post" action="/cart/item">
                      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                      <input type="hidden" name="productCode" value="{{ item.productCode }}">
                      <input type="hidden" name="operation" value="up">
                      <input type="hidden" name="quantity" value="{{ quantity + 1 }}">
                      <button type="submit" aria-label="数量を増やす">＋</button>
                    </form>
                  </div>
                  <strong>¥{{ (unitPrice * quantity)|number_format }}</strong>
                  <form method="post" action="/cart/item">
                    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                    <input type="hidden" name="productCode" value="{{ item.productCode }}">
                    <input type="hidden" name="operation" value="remove">
                    <button class="idea-text-button" type="submit">削除</button>
                  </form>
                </div>
              </article>
            {% endfor %}
          </div>
        </article>
      {% endfor %}
    {% else %}
      <div class="idea-empty idea-empty--cart">
        <p class="idea-eyebrow">Your cart is empty</p>
        <h2>カートに商品はありません。</h2>
        <p class="idea-muted">暮らしの入口から、気になる道具を見つけてください。</p>
        <a class="idea-button" href="/products">商品を見つける</a>
      </div>
    {% endif %}
  </div>

  <aside class="idea-summary-panel" aria-label="ご注文概要">
    <p class="idea-eyebrow">Order summary</p>
    <dl>
      <div><dt>商品合計</dt><dd>¥{{ totalPrice|default(0)|number_format }}</dd></div>
      <div><dt>送料</dt><dd>¥{{ deliveryFeeTotal|default(0)|number_format }}</dd></div>
      <div class="idea-summary-total"><dt>合計</dt><dd>¥{{ (totalPrice|default(0) + deliveryFeeTotal|default(0))|number_format }}</dd></div>
    </dl>
    <a class="idea-button idea-button--wide{% if displayCarts|length == 0 %} idea-button--disabled{% endif %}" href="{% if displayCarts|length > 0 %}/shopping/login{% else %}/products{% endif %}">
      {% if displayCarts|length > 0 %}レジに進む{% else %}買い物を続ける{% endif %}
    </a>
    <a class="idea-link idea-summary-link" href="/products">カタログに戻る</a>
    <p class="idea-muted idea-summary-note">レジ入口は <strong>/shopping/login</strong> です。ログイン済みの方も、ここから安全に購入手続きを選べます。</p>
  </aside>
</section>
{% endblock %}
