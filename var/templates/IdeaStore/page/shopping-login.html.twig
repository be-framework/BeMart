{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}購入入口 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">Cart</a><span>/</span><span>Login</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-shopping-login-title">
  <div>
    <p class="idea-eyebrow">Checkout entrance</p>
    <h1 id="idea-shopping-login-title" class="idea-title idea-title--compact">購入方法を選ぶ</h1>
    <p class="idea-muted">JSONの401画面へ直接進ませず、会員ログインまたはゲスト購入を選べる入口を表示します。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Secure checkout</span>
    <strong>Login / Guest</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span class="is-active"><b>2</b>購入入口</span>
  <span><b>3</b>ご注文手続き</span>
  <span><b>4</b>完了</span>
</section>

<section class="idea-container idea-section idea-auth-choice">
  <article class="idea-checkout-panel idea-auth-panel">
    <p class="idea-eyebrow">Member checkout</p>
    <h2 class="idea-section-title">会員の方</h2>
    <p class="idea-muted">登録済みのメールアドレスでログインすると、お届け先情報を使って購入手続きへ進めます。</p>
    <form class="idea-auth-form" name="shopping_login" id="shopping_login" method="post" action="/login">
      <input type="hidden" name="mode" value="shopping">
      <input type="hidden" name="_target_path" value="/shopping">
      <input type="hidden" name="_failure_path" value="/shopping/login">
      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
      <label class="idea-field">メールアドレス
        {% if form is defined %}{{ form.input('email')|raw }}{% else %}<input type="email" name="email" autocomplete="email" placeholder="メールアドレス">{% endif %}
      </label>
      <label class="idea-field">パスワード
        {% if form is defined %}{{ form.input('password')|raw }}{% else %}<input type="password" name="password" autocomplete="current-password" placeholder="パスワード">{% endif %}
      </label>
      {% if message is defined and message %}
        <p class="idea-form-error">{{ message }}</p>
      {% endif %}
      <button class="idea-button idea-button--wide" type="submit">ログインして進む</button>
      <div class="idea-auth-links">
        <a class="idea-link" href="/forgot">ログイン情報をお忘れですか？</a>
        <a class="idea-link" href="/entry">新規会員登録</a>
      </div>
    </form>
  </article>

  <article class="idea-checkout-panel idea-auth-panel idea-auth-panel--guest">
    <p class="idea-eyebrow">Guest checkout</p>
    <h2 class="idea-section-title">会員登録せずに購入</h2>
    <p class="idea-muted">今回のお届け先と連絡先を入力して、ゲストとして購入手続きへ進みます。</p>
    <a class="idea-button idea-button--wide" href="/shopping/non-member">ゲスト購入へ進む</a>
    <a class="idea-link idea-summary-link" href="/cart">カートに戻る</a>
  </article>
</section>
{% endblock %}
