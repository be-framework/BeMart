{% extends 'IdeaStore/layout/base.html.twig' %}
{% set code = productCode|default(product.productCode|default(product.id|default(''))) %}
{% set name = productName|default(product.productName|default(product.name|default('IDEA STORE 商品'))) %}
{% set image = mainImage|default(product.image|default('/assets/idea-store/images/product/product-01.svg')) %}
{% if image starts with 'idea-store/' %}
  {% set image = '/save_image/' ~ image %}
{% elseif image starts with 'save_image/' or image starts with 'assets/' %}
  {% set image = '/' ~ image %}
{% endif %}
{% set categories = categoryNames|default(product.categoryNames|default([])) %}
{% set tags = tagNames|default(product.tagNames|default([])) %}
{% set classes = classNames|default(product.classNames|default([])) %}
{% set bodyDescription = description|default(product.description|default('住まいと自分時間を心地よくするための道具です。')) %}
{% set price = price02|default(product.price02|default(product.price|default(0))) %}
{% set stockQuantity = stock|default(product.stock|default(null)) %}
{% set purchasable = stockFind|default(product.stockFind|default(stockQuantity is same as(null) or stockQuantity > 0)) %}
{% block title %}{{ name }} | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/products">Catalog</a><span>/</span><span>{{ name }}</span>
</nav>
<article class="idea-container idea-product-detail idea-product-detail--premium">
  <div class="idea-product-gallery">
    <div class="idea-product-visual">
      <img src="{{ image }}" alt="{{ name }}">
    </div>
    <div class="idea-product-thumbs" aria-label="Product visual details">
      <img src="/assets/idea-store/images/editorial/editorial-01.svg" alt="暮らしの使用イメージ">
      <img src="/assets/idea-store/images/editorial/editorial-02.svg" alt="素材のイメージ">
      <img src="/assets/idea-store/images/editorial/editorial-04.svg" alt="部屋での佇まい">
    </div>
  </div>
  <div class="idea-product-info idea-product-buybox">
    <p class="idea-eyebrow">{{ categories|first|default('IDEA STORE') }}</p>
    <h1 class="idea-section-title">{{ name }}</h1>
    <p class="idea-lead">{{ bodyDescription }}</p>
    <p class="idea-price idea-detail-price">¥{{ price|number_format }}</p>
    <div class="idea-chip-row">
      {% for tag in tags %}<span>{{ tag }}</span>{% endfor %}
      {% for className in classes %}<span>{{ className }}</span>{% endfor %}
    </div>

    <form class="idea-cart-form" action="/cart/item" method="post">
      {% if purchasable %}
        <label>数量
          {% if form is defined %}
            {{ form.input('quantity')|raw }}
          {% else %}
            <input type="number" name="quantity" value="1" min="1">
          {% endif %}
        </label>
        <button type="submit" class="idea-button">カートに入れる</button>
      {% else %}
        <button type="button" class="idea-button" disabled>ただいま品切れ中です</button>
      {% endif %}
      {% if form is defined %}
        {{ form.input('productCode')|raw }}
        {{ form.input('csrfToken')|raw }}
      {% else %}
        <input type="hidden" name="productCode" value="{{ code }}">
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
      {% endif %}
    </form>

    <div class="idea-product-promises">
      <span>生活編集型カタログ</span>
      <span>FakeQuery showcase</span>
      <span>Performance ready</span>
    </div>

    <dl class="idea-spec-list">
      <div class="idea-spec-row"><dt>商品コード</dt><dd>{{ code }}</dd></div>
      <div class="idea-spec-row"><dt>カテゴリ</dt><dd>{{ categories|join(' / ')|default('IDEA STORE') }}</dd></div>
      <div class="idea-spec-row"><dt>タグ</dt><dd>{{ tags|join(' / ') }}</dd></div>
      <div class="idea-spec-row"><dt>在庫</dt><dd>{{ purchasable ? '在庫あり' : '在庫なし' }}</dd></div>
    </dl>
  </div>
</article>
{% set detailReviewSummary = reviewSummary|default({}) %}
{% set detailReviewCount = detailReviewSummary.reviewCount|default(0) %}
{% set detailAverageRating = detailReviewSummary.averageRating|default(null) %}
<section class="idea-container idea-section idea-review-section" aria-labelledby="idea-product-reviews-title">
  <div class="idea-section-head">
    <div>
      <p class="idea-eyebrow">Reviews</p>
      <h2 id="idea-product-reviews-title" class="idea-section-title">お客様レビュー</h2>
    </div>
    {% if detailReviewCount > 0 and detailAverageRating is not same as(null) %}
      <p class="idea-review-summary"><span class="idea-rating" aria-label="平均評価 {{ detailAverageRating|number_format(1, '.', '') }}">★★★★★ <span>{{ detailAverageRating|number_format(1, '.', '') }}</span></span><span>{{ detailReviewCount }}件</span></p>
    {% endif %}
  </div>
  {% if detailReviewCount > 0 and reviews|default([]) is not empty %}
    <div class="idea-review-list">
      {% for review in reviews %}
        <article class="idea-review-card">
          <div class="idea-review-card__head">
            <h3>{{ review.title }}</h3>
            <span class="idea-rating" aria-label="レビュー評価 {{ review.rating }}">★★★★★ <span>{{ review.rating }}</span></span>
          </div>
          <p>{{ review.body }}</p>
          <footer>{{ review.reviewer }} ・ <time datetime="{{ review.createdAt }}">{{ review.createdAt }}</time></footer>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="idea-empty idea-review-empty">
      <h2>まだレビューはありません。</h2>
      <p class="idea-muted">この商品の最初のレビューをお待ちしています。</p>
    </div>
  {% endif %}
</section>

<section class="idea-container idea-section idea-story-panel">
  <p class="idea-eyebrow">About this item</p>
  <h2>日々の手順を少し静かに整えるための道具。</h2>
  <p>商品詳細は、買うための情報だけでなく、暮らしの中でどう使うかを想像できる編集面として扱います。</p>
</section>
{% endblock %}
