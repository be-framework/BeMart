<section class="idea-container idea-commerce-hero idea-commerce-hero--cocoon" aria-labelledby="idea-home-title">
  <div class="idea-commerce-visual">
    <div class="idea-hero-image-card">
      <img src="/assets/idea-store/images/hero/hero-leaf-d.png" alt="日光と植物の影が落ちる部屋に、白磁、木、布の道具が静かに置かれたIDEA STOREの生活シーン">
      <div class="idea-commerce-copy">
        <p class="idea-eyebrow">IDEA STORE / イデアストア</p>
        <h1 id="idea-home-title" class="idea-title idea-title--commerce"><span>暮らしのイデアを、</span><span>見つけよう。</span></h1>
        <p class="idea-lead idea-lead--commerce">住まいと、自分時間を心地よく。日光と葉の影から、暮らしの道具を選ぶ。</p>
        <div class="idea-actions idea-actions--commerce">
          <a class="idea-button idea-button--hero" href="/products">商品を見つける</a>
          <a class="idea-link idea-link--hero" href="/products?orderby=price_low">3,000件のカタログ</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="idea-container idea-shop-lanes" aria-label="買い物の入口">
  <a href="/products?orderby=latest"><span>New arrivals</span><strong>新しく届いたもの</strong><small>今週の入荷を見る</small></a>
  <a href="/products?name=%E5%8F%B0%E6%89%80"><span>Kitchen tools</span><strong>台所を整える</strong><small>毎日の手順を静かに</small></a>
  <a href="/products?name=%E5%8F%8E%E7%B4%8D"><span>Storage edit</span><strong>しまう場所を作る</strong><small>小物から家具まで</small></a>
  <a href="/products?orderby=price_low"><span>Under ¥5,000</span><strong>手に取りやすい定番</strong><small>ギフトにも</small></a>
</section>

<section class="idea-container idea-section idea-section--tight">
  <div class="idea-section-head idea-section-head--center">
    <p class="idea-eyebrow">Shop by room and rhythm</p>
    <h2 class="idea-section-title">暮らしの入口</h2>
    <a class="idea-muted idea-view-all" href="/products">カテゴリ一覧</a>
  </div>
  <div class="idea-grid idea-category-grid idea-category-grid--commerce">
    {% for category in ideaCategories %}
      <a class="idea-card idea-category-card" href="{{ category.href }}">
        <img src="{{ category.image }}" alt="{{ category.name }}">
        <span class="idea-card-body">
          <span class="idea-card-kicker">{{ category.room }}</span>
          <strong class="idea-card-title">{{ category.name }}</strong>
          <span class="idea-muted">{{ category.description }}</span>
        </span>
      </a>
    {% endfor %}
  </div>
</section>

<section class="idea-container idea-section idea-section--tight">
  <div class="idea-section-head">
    <div>
      <p class="idea-eyebrow">New arrivals</p>
      <h2 class="idea-section-title">新しく届いたもの</h2>
    </div>
    <a class="idea-muted idea-view-all" href="/products">すべて見る</a>
  </div>
  <div class="idea-grid idea-product-grid idea-product-grid--commerce">
    {% for product in featuredProducts %}
      {% include 'IdeaStore/product/card.html.twig' with { product: product } %}
    {% endfor %}
  </div>
</section>



<section class="idea-container idea-section idea-editorial-commerce">
  <div class="idea-editorial-commerce__copy">
    <p class="idea-eyebrow">Life edit</p>
    <h2 class="idea-section-title">買う前から、暮らしの風景が見えること。</h2>
    <p class="idea-muted">大型モールの品数と、雑誌の編集感。その中間にある「選びやすい豊富さ」を目指します。</p>
    <a class="idea-button idea-button--light" href="/products?name=%E5%8F%B0%E6%89%80">台所の特集を見る</a>
  </div>
  <div class="idea-editorial-catalog-photo">
    <img src="/assets/idea-store/images/hero/hero-catalog-dense-b.png" alt="収納、器、本、音楽、工作道具が並ぶIDEA STOREのカタログビジュアル">
    <div>
      <span>Catalog edit</span>
      <strong>収納から器、本、音楽まで。横断して選べる生活道具。</strong>
    </div>
  </div>
</section>
<div class="idea-container idea-admin-access" aria-label="管理者向け入口">
  <a href="/admin/login" rel="nofollow">管理者ログイン</a>
</div>
{% endblock %}