  '外遊び': { eyebrow: 'Outdoor edit', title: '外の時間を、身軽に。', titleLines: ['外の時間を、', '身軽に。'], lead: 'ピクニック、散歩、週末の外時間。持ち出しやすく、戻しやすい道具です。', image: '/assets/idea-store/images/category/real/entry-outdoor.png' },
  '贈る日用品': { eyebrow: 'Gift edit', title: '気負わず渡せて、長く使える。', titleLines: ['気負わず渡せて、', '長く使える。'], lead: '小皿、布、文具。相手の暮らしに静かに残る日用品を集めました。', image: '/assets/idea-store/images/category/real/entry-gift.png' },
