  '文具': { eyebrow: 'Stationery edit', title: '書く時間を、整える。', titleLines: ['書く時間を、', '整える。'], lead: '紙、カードスタンド、筆記具。手を動かす時間に集中できる机をつくります。', image: '/assets/idea-store/images/category/real/entry-stationery.png' },
