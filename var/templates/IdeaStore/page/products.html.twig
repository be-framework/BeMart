} %}
{% set categoryHero = categoryHeroes[activeKeyword]|default(null) %}
{% if categoryHero %}
<section class="idea-container idea-collection-hero idea-collection-hero--visual">
  <img class="idea-collection-hero-image" src="{{ categoryHero.image }}" alt="{{ activeKeyword }}の暮らしの入口">
  <div class="idea-collection-hero-copy">
    <p class="idea-eyebrow">{{ categoryHero.eyebrow }}</p>
    <h1 class="idea-title idea-title--compact">
      {% if categoryHero.titleLines|default([]) is not empty %}
        {% for titleLine in categoryHero.titleLines %}<span class="idea-title-line">{{ titleLine }}</span>{% endfor %}
      {% else %}
        {{ categoryHero.title }}
      {% endif %}
    </h1>
    <p class="idea-muted">{{ categoryHero.lead }}</p>
    <form class="idea-catalog-search idea-catalog-search--overlay" action="/products" method="get" role="search">
      <input type="search" name="name" value="{{ activeKeyword }}" placeholder="例：収納、竹、イデア" aria-label="商品を検索">
      <button class="idea-button" type="submit">検索</button>
    </form>
  </div>
</section>
{% else %}
<section class="idea-container idea-collection-hero">
  <div>
    <p class="idea-eyebrow">Catalog</p>
    <h1 class="idea-title idea-title--compact"><span class="idea-title-line">暮らしを整える、</span><span class="idea-title-line">3,000のイデア。</span></h1>
    <p class="idea-muted">収納、台所、家具、本、音楽、工作の道具まで。mediumカタログで探索・検索・購入導線を検証するショーケースです。</p>
  </div>
  <form class="idea-catalog-search" action="/products" method="get" role="search">
    <input type="search" name="name" value="{{ activeKeyword }}" placeholder="例：収納、竹、イデア" aria-label="商品を検索">
    <button class="idea-button" type="submit">検索</button>
  </form>
</section>
{% endif %}

<section class="idea-container idea-section idea-catalog-body">
  <div class="idea-toolbar">
    <div>
      <p class="idea-eyebrow">{{ totalItemCount|default(products|default([])|length) }} items</p>
      <h2 class="idea-section-title">見つかった品々</h2>
    </div>
    <div class="idea-chip-row idea-chip-row--toolbar" aria-label="おすすめ検索">
      <a href="/products?name=%E5%8F%8E%E7%B4%8D">収納</a>
      <a href="/products?name=%E5%8F%B0%E6%89%80">台所</a>
      <a href="/products?name=%E6%9C%AC%E3%81%A8%E9%9B%91%E8%AA%8C">本</a>
      <a href="/products?name=%E9%9F%B3%E6%A5%BD">音楽</a>
      <a href="/products?name=%E5%B7%A5%E4%BD%9C%E3%81%AE%E9%81%93%E5%85%B7">工作</a>
      <a href="/products?name=%E7%AB%B9">竹</a>
      <a href="/products?name=%E3%82%A4%E3%83%87%E3%82%A2">すべて</a>
    </div>
    <div class="idea-sort-links">
      <a href="/products">新着順</a>
      <a href="/products?orderby=price_low">価格が低い順</a>
      <a href="/products?orderby=price_high">価格が高い順</a>
    </div>
  </div>
  {% if products|default([]) is not empty %}
    <div class="idea-catalog-layout">
      <aside class="idea-catalog-note">
        <p class="idea-eyebrow">Curation note</p>
        <h3>用途で探すと、選びやすい。</h3>
        <p>FakeQueryで3,000商品を読み込み、一覧・検索・詳細表示の体験を測ります。</p>
        <a href="/products?name=%E5%8F%8E%E7%B4%8D">収納から始める</a>
      </aside>
      <div class="idea-grid idea-product-grid">
        {% for product in products %}
          {% include 'IdeaStore/product/card.html.twig' with { product: product } %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="idea-empty">
      <h2>お探しの商品は見つかりませんでした。</h2>
      <p class="idea-muted">別のキーワードで検索するか、すべての商品をご覧ください。</p>
      <a class="idea-button" href="/products">すべての商品へ</a>
    </div>
  {% endif %}
</section>
{% endblock %}
