  '工作の道具': { eyebrow: 'Craft tools', title: '手を動かす時間を、整える。', titleLines: ['手を動かす時間を、', '整える。'], lead: '工具、紙、布、糸。作る前の机を整え、週末の小さな制作を支えます。', image: '/assets/idea-store/images/category/real/entry-craft.png' },
  '掃除とケア': { eyebrow: 'Care tools', title: '手入れの時間も、静かな習慣に。', titleLines: ['手入れの時間も、', '静かな習慣に。'], lead: 'ブラシ、クロス、収納箱。長く使うための日々の手入れを軽くします。', image: '/assets/idea-store/images/category/real/entry-cleaning.png' },
  'バス・ランドリー': { eyebrow: 'Bath and laundry', title: '洗う場所に、風通しを。', titleLines: ['洗う場所に、', '風通しを。'], lead: 'ランドリーバスケット、タオル、洗面まわり。水まわりを軽やかに整えます。', image: '/assets/idea-store/images/category/real/entry-bath.png' },
  'コーヒーとお茶': { eyebrow: 'Coffee and tea', title: '一杯の時間を、丁寧に。', titleLines: ['一杯の時間を、', '丁寧に。'], lead: 'ドリッパー、茶器、トレー。休む時間の手順を静かに整えます。', image: '/assets/idea-store/images/category/real/entry-coffee.png' },
