  '布': { eyebrow: 'Fabric edit', title: '触れるものから、季節を整える。', titleLines: ['触れるものから、', '季節を整える。'], lead: 'リネン、帆布、タオル。肌に触れる素材で、暮らしの温度を変えます。', image: '/assets/idea-store/images/category/real/entry-fabric.png' },
  '布とファブリック': { eyebrow: 'Fabric edit', title: '触れるものから、季節を整える。', titleLines: ['触れるものから、', '季節を整える。'], lead: 'リネン、帆布、タオル。肌に触れる素材で、暮らしの温度を変えます。', image: '/assets/idea-store/images/category/real/entry-fabric.png' },
  'デスク': { eyebrow: 'Desk tools', title: '働く時間に、余白をつくる。', titleLines: ['働く時間に、', '余白をつくる。'], lead: 'ペン、紙、スタンド、トレー。集中するための机まわりを静かに整えます。', image: '/assets/idea-store/images/category/real/entry-desk.png' },
  'デスク用品': { eyebrow: 'Desk tools', title: '働く時間に、余白をつくる。', titleLines: ['働く時間に、', '余白をつくる。'], lead: 'ペン、紙、スタンド、トレー。集中するための机まわりを静かに整えます。', image: '/assets/idea-store/images/category/real/entry-desk.png' },
  '本': { eyebrow: 'Reading edit', title: '読む時間を、部屋の景色に。', titleLines: ['読む時間を、', '部屋の景色に。'], lead: '本、雑誌、ブックエンド。読みかけの一冊が似合う場所をつくります。', image: '/assets/idea-store/images/category/real/entry-books.png' },
  '本と雑誌': { eyebrow: 'Reading edit', title: '読む時間を、部屋の景色に。', titleLines: ['読む時間を、', '部屋の景色に。'], lead: '本、雑誌、ブックエンド。読みかけの一冊が似合う場所をつくります。', image: '/assets/idea-store/images/category/real/entry-books.png' },
  '音楽': { eyebrow: 'Listening edit', title: '音の居場所を、暮らしの中に。', titleLines: ['音の居場所を、', '暮らしの中に。'], lead: 'レコード、ブラシ、小さな音の道具。部屋の空気を変える入口です。', image: '/assets/idea-store/images/category/real/entry-music.png' },
