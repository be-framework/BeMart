{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お客様情報の入力 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">Cart</a><span>/</span><a href="/shopping/login">Login</a><span>/</span><span>Guest</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-nonmember-title">
  <div>
    <p class="idea-eyebrow">Guest information</p>
    <h1 id="idea-nonmember-title" class="idea-title idea-title--compact">お客様情報の入力</h1>
    <p class="idea-muted">ゲスト購入に必要な連絡先とお届け先を入力してください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Guest checkout</span>
    <strong>Step 2</strong>
    <small>Shipping profile</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span class="is-active"><b>2</b>お客様情報</span>
  <span><b>3</b>ご注文手続き</span>
  <span><b>4</b>完了</span>
</section>

<section class="idea-container idea-section">
  <form class="idea-checkout-panel idea-guest-form h-adr" method="post" action="/shopping/non-member">
    <span class="p-country-name" aria-hidden="true">Japan</span>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Contact and address</p>
        <h2 class="idea-section-title">連絡先とお届け先</h2>
      </div>
      <a class="idea-link" href="/shopping/login">購入入口に戻る</a>
    </div>

    <div class="idea-form-grid idea-form-grid--two">
      <label class="idea-field">姓
        {% if form is defined %}{{ form.input('name01')|raw }}{% else %}<input type="text" name="name01" autocomplete="family-name" placeholder="姓">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('name01') }}</span>{% endif %}
      </label>
      <label class="idea-field">名
        {% if form is defined %}{{ form.input('name02')|raw }}{% else %}<input type="text" name="name02" autocomplete="given-name" placeholder="名">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('name02') }}</span>{% endif %}
      </label>
      <label class="idea-field">セイ
        {% if form is defined %}{{ form.input('kana01')|raw }}{% else %}<input type="text" name="kana01" placeholder="セイ">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('kana01') }}</span>{% endif %}
      </label>
      <label class="idea-field">メイ
        {% if form is defined %}{{ form.input('kana02')|raw }}{% else %}<input type="text" name="kana02" placeholder="メイ">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('kana02') }}</span>{% endif %}
      </label>
      <label class="idea-field idea-field--full">会社名（任意）
        {% if form is defined %}{{ form.input('companyName')|raw }}{% else %}<input type="text" name="companyName" autocomplete="organization">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('companyName') }}</span>{% endif %}
      </label>
      <label class="idea-field">メールアドレス
        {% if form is defined %}{{ form.input('email')|raw }}{% else %}<input type="email" name="email" autocomplete="email" placeholder="例：ec-cube@example.com">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('email') }}</span>{% endif %}
      </label>
      <label class="idea-field">メールアドレス（確認）
        {% if form is defined %}{{ form.input('email_confirm')|raw }}{% else %}<input type="email" name="email_confirm" autocomplete="email" placeholder="確認のためもう一度入力してください">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('email_confirm') }}</span>{% endif %}
      </label>
      <label class="idea-field">電話番号
        {% if form is defined %}{{ form.input('phoneNumber')|raw }}{% else %}<input type="tel" name="phoneNumber" autocomplete="tel">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('phoneNumber') }}</span>{% endif %}
      </label>
      <label class="idea-field">郵便番号
        {% if form is defined %}{{ form.input('postalCode')|raw }}{% else %}<input type="text" name="postalCode" autocomplete="postal-code">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('postalCode') }}</span>{% endif %}
      </label>
      <label class="idea-field">都道府県
        {% if form is defined %}
          {{ form.input('pref')|raw }}
        {% else %}
          <select name="pref" autocomplete="address-level1">
            <option value="">選択してください</option>
            {% for prefId in 1..47 %}<option value="{{ prefId }}">{{ prefId }}</option>{% endfor %}
          </select>
        {% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('pref') }}</span>{% endif %}
      </label>
      <label class="idea-field">市区町村
        {% if form is defined %}{{ form.input('addr01')|raw }}{% else %}<input type="text" name="addr01" autocomplete="address-level2" placeholder="市区町村名">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('addr01') }}</span>{% endif %}
      </label>
      <label class="idea-field">番地・建物名
        {% if form is defined %}{{ form.input('addr02')|raw }}{% else %}<input type="text" name="addr02" autocomplete="street-address" placeholder="番地・建物名">{% endif %}
        {% if form is defined %}<span class="idea-form-error">{{ form.error('addr02') }}</span>{% endif %}
      </label>
    </div>

    <div class="idea-form-actions">
      <button class="idea-button" type="submit">次へ</button>
      <a class="idea-link" href="/cart">カートに戻る</a>
    </div>
  </form>
</section>
{% endblock %}
