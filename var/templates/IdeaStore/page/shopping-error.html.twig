{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}購入エラー | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">Cart</a><span>/</span><span>Error</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-shopping-error-title">
  <div>
    <p class="idea-eyebrow">Checkout error</p>
    <h1 id="idea-shopping-error-title" class="idea-title idea-title--compact">購入手続きで問題が発生しました</h1>
    <p class="idea-muted">在庫・お支払い・セッション状態を確認して、もう一度お試しください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Needs attention</span>
    <strong>Retry</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<section class="idea-container idea-section">
  <div class="idea-empty idea-empty--cart">
    <p class="idea-eyebrow">Shopping error</p>
    <h2>カートから購入手続きをやり直してください。</h2>
    <p class="idea-muted">{{ message|default('注文内容の確認に失敗しました。') }}</p>
    <a class="idea-button" href="/cart">カートに戻る</a>
    <a class="idea-link idea-summary-link" href="/products">商品を見る</a>
  </div>
</section>
{% endblock %}
