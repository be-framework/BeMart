{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}ご注文内容の確認 | IDEA STORE{% endblock %}
{% block content %}
{% set orderItems = items|default([]) %}
{% set buyer = customer|default({}) %}
{% set hasOrder = preOrderId|default('') and orderItems|length > 0 %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">Cart</a><span>/</span><a href="/shopping">Checkout</a><span>/</span><span>Confirm</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-confirm-title">
  <div>
    <p class="idea-eyebrow">Order confirmation</p>
    <h1 id="idea-confirm-title" class="idea-title idea-title--compact">ご注文内容の確認</h1>
    <p class="idea-muted">内容を確認して、注文を確定してください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>{{ paymentMethodName|default('Payment') }}</span>
    <strong>¥{{ paymentTotal|default(total|default(0))|number_format }}</strong>
    <small>{{ buyer.email|default('confirm order') }}</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span><b>2</b>ご注文手続き</span>
  <span class="is-active"><b>3</b>内容確認</span>
  <span><b>4</b>完了</span>
</section>

{% if hasOrder %}
  <form class="idea-container idea-section idea-checkout-layout" method="post" action="/shopping/checkout">
    <input type="hidden" name="mode" value="checkout">
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
    <input type="hidden" name="preOrderId" value="{{ preOrderId }}">

    <div class="idea-checkout-main">
      <section class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Customer</p>
            <h2 class="idea-section-title">お客様情報</h2>
          </div>
          <a class="idea-link" href="/shopping">変更</a>
        </div>
        <div class="idea-info-list">
          <p><strong>{{ buyer.name01|default('') }} {{ buyer.name02|default('') }} 様</strong></p>
          <p>{{ buyer.email|default('') }}</p>
          <p>〒{{ buyer.postalCode|default('') }} {{ buyer.pref|default('') }} {{ buyer.addr01|default('') }} {{ buyer.addr02|default('') }}</p>
          <p>{{ buyer.phoneNumber|default('') }}</p>
        </div>
      </section>

      <section class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Delivery</p>
            <h2 class="idea-section-title">配送情報</h2>
          </div>
          <span class="idea-panel-total">¥{{ deliveryFeeTotal|default(0)|number_format }}</span>
        </div>
        <div class="idea-info-list">
          <p><strong>標準配送</strong></p>
          <p>お届け日：指定なし / お届け時間：指定なし</p>
        </div>
        <div class="idea-cart-list">
          {% for item in orderItems %}
            <article class="idea-cart-item">
              <div class="idea-cart-item__body">
                <h3>{{ item.productName|default(item.productCode|default('IDEA STORE 商品')) }}</h3>
                <p class="idea-muted">{{ item.productCode|default('') }}</p>
              </div>
              <p class="idea-cart-item__price">¥{{ item.unitPrice|default(0)|number_format }} × {{ item.quantity|default(1)|number_format }}</p>
              <strong>¥{{ item.totalPrice|default((item.unitPrice|default(0)) * (item.quantity|default(1)))|number_format }}</strong>
            </article>
          {% endfor %}
        </div>
      </section>

      <section class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Payment</p>
            <h2 class="idea-section-title">お支払い方法</h2>
          </div>
        </div>
        <div class="idea-info-list">
          <p><strong>{{ paymentMethodName|default('お支払い方法未選択') }}</strong></p>
          <p>手数料 ¥{{ charge|default(0)|number_format }}</p>
        </div>
      </section>
    </div>

    <aside class="idea-summary-panel">
      <p class="idea-eyebrow">Final check</p>
      <dl>
        <div><dt>小計</dt><dd>¥{{ subtotal|default(0)|number_format }}</dd></div>
        <div><dt>送料</dt><dd>¥{{ deliveryFeeTotal|default(0)|number_format }}</dd></div>
        <div><dt>手数料</dt><dd>¥{{ charge|default(0)|number_format }}</dd></div>
        {% if discount|default(0) %}<div><dt>値引き</dt><dd>-¥{{ discount|number_format }}</dd></div>{% endif %}
        <div><dt>消費税</dt><dd>¥{{ tax|default(0)|number_format }}</dd></div>
        <div class="idea-summary-total"><dt>お支払い合計</dt><dd>¥{{ paymentTotal|default(total|default(0))|number_format }}</dd></div>
      </dl>
      <button class="idea-button idea-button--wide" type="submit">注文する</button>
      <a class="idea-link idea-summary-link" href="/shopping">ご注文手続きに戻る</a>
    </aside>
  </form>
{% else %}
  <section class="idea-container idea-section">
    <div class="idea-empty idea-empty--cart">
      <p class="idea-eyebrow">Order not ready</p>
      <h2>確認できる注文内容がありません。</h2>
      <p class="idea-muted">{{ message|default('カートまたは購入手続きからやり直してください。') }}</p>
      <a class="idea-button" href="/cart">カートに戻る</a>
      <a class="idea-link idea-summary-link" href="/shopping">ご注文手続きへ戻る</a>
    </div>
  </section>
{% endif %}
{% endblock %}
