{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}ご注文手続き | IDEA STORE{% endblock %}
{% block content %}
{% set checkoutCarts = carts|default([])|filter(cart => cart.items|default([])|length > 0) %}
{% set canCheckoutNow = canCheckout|default(checkoutCarts|length > 0) %}
{% set address = defaultShippingAddress|default({}) %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">Cart</a><span>/</span><span>Checkout</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-shopping-title">
  <div>
    <p class="idea-eyebrow">Checkout review</p>
    <h1 id="idea-shopping-title" class="idea-title idea-title--compact">ご注文手続き</h1>
    <p class="idea-muted">お客様情報、お届け先、お支払い方法を確認して、注文内容の確認へ進みます。</p>
  </div>
  <div class="idea-checkout-status">
    <span>{{ name01|default('IDEA') }} {{ name02|default('STORE') }}</span>
    <strong>¥{{ (totalPrice|default(0) + deliveryFeeTotal|default(0))|number_format }}</strong>
    <small>{{ email|default('member checkout') }}</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span class="is-active"><b>2</b>ご注文手続き</span>
  <span><b>3</b>内容確認</span>
  <span><b>4</b>完了</span>
</section>

{% if canCheckoutNow %}
  <form class="idea-container idea-section idea-checkout-layout idea-checkout-form" method="post" action="/shopping/confirm">
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
    {% if preOrderId is defined %}
      <input type="hidden" name="preOrderId" value="{{ preOrderId }}">
    {% endif %}
    <div class="idea-checkout-main">
      <section class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Customer</p>
            <h2 class="idea-section-title">お客様情報</h2>
          </div>
          <a class="idea-link" href="/mypage/change">変更</a>
        </div>
        <div class="idea-info-list">
          <p><strong>{{ name01|default('') }} {{ name02|default('') }} 様</strong></p>
          <p>{{ email|default('') }}</p>
          <p>〒{{ address.postalCode|default('') }} {{ address.pref|default('') }} {{ address.addr01|default('') }} {{ address.addr02|default('') }}</p>
          <p>{{ address.phoneNumber|default('') }}</p>
        </div>
      </section>

      <section class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Delivery</p>
            <h2 class="idea-section-title">お届け先と配送</h2>
          </div>
          <a class="idea-link" href="/shopping/shipping">お届け先を選ぶ</a>
        </div>
        <div class="idea-form-grid idea-form-grid--three">
          <label class="idea-field">配送方法
            {% if form is defined %}{{ form.input('delivery')|raw }}{% else %}<select name="delivery"><option value="">標準配送</option></select>{% endif %}
          </label>
          <label class="idea-field">お届け日
            {% if form is defined %}{{ form.input('shipping_delivery_date')|raw }}{% else %}<select name="shipping_delivery_date"><option value="">指定なし</option></select>{% endif %}
          </label>
          <label class="idea-field">お届け時間
            {% if form is defined %}{{ form.input('delivery_time')|raw }}{% else %}<select name="delivery_time"><option value="">指定なし</option></select>{% endif %}
          </label>
        </div>
      </section>

      <section class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Payment</p>
            <h2 class="idea-section-title">お支払い方法</h2>
          </div>
        </div>
        <div class="idea-option-list">
          {% for payment in paymentMethods|default([]) %}
            <label class="idea-option-card">
              <input type="radio" name="payment" value="{{ payment.paymentMethodId }}" {% if loop.first %}checked{% endif %}>
              <span>{{ payment.paymentMethodName }}</span>
            </label>
          {% else %}
            <label class="idea-option-card">
              <input type="radio" name="payment" value="1" checked>
              <span>代金引換</span>
            </label>
          {% endfor %}
        </div>
        {% if form is defined %}<p class="idea-form-error">{{ form.error('payment') }}</p>{% endif %}
        <div class="idea-credit-card-fields" data-credit-card-fields hidden>
          <p class="idea-muted">Fake決済でも、注文確認へ進むにはテスト用カード情報の入力が必要です。実カード情報は保存されません。</p>
          <div class="idea-form-grid">
            <label class="idea-field">カード番号
              <input type="text" name="cardNumber" inputmode="numeric" autocomplete="cc-number" placeholder="4242 4242 4242 4242" maxlength="23" data-credit-card-input>
            </label>
            <label class="idea-field">カード名義
              <input type="text" name="cardName" autocomplete="cc-name" placeholder="IDEA TARO" maxlength="64" data-credit-card-input>
            </label>
            <label class="idea-field">有効期限（月）
              <input type="text" name="cardExpiryMonth" inputmode="numeric" autocomplete="cc-exp-month" placeholder="12" maxlength="2" data-credit-card-input>
            </label>
            <label class="idea-field">有効期限（年）
              <input type="text" name="cardExpiryYear" inputmode="numeric" autocomplete="cc-exp-year" placeholder="30" maxlength="4" data-credit-card-input>
            </label>
            <label class="idea-field">セキュリティコード
              <input type="text" name="cardSecurityCode" inputmode="numeric" autocomplete="cc-csc" placeholder="123" maxlength="4" data-credit-card-input>
            </label>
          </div>
        </div>
      </section>

      <section class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Message</p>
            <h2 class="idea-section-title">お問い合わせ</h2>
          </div>
        </div>
        <label class="idea-field idea-field--full">
          {% if form is defined %}{{ form.input('message')|raw }}{% else %}<textarea name="message" rows="6" placeholder="お問い合わせ事項がございましたら、こちらにご入力ください。"></textarea>{% endif %}
        </label>
        {% if form is defined %}<p class="idea-form-error">{{ form.error('message') }}</p>{% endif %}
      </section>
    </div>

    <aside class="idea-summary-panel">
      <p class="idea-eyebrow">Order summary</p>
      <div class="idea-mini-cart">
        {% for cart in checkoutCarts %}
          {% for item in cart.items|default([]) %}
            {% set quantity = item.quantity|default(1) %}
            {% set unitPrice = item.price|default(0) %}
            <div>
              <span>{{ item.productName|default(item.productCode|default('IDEA STORE 商品')) }} × {{ quantity|number_format }}</span>
              <strong>¥{{ (unitPrice * quantity)|number_format }}</strong>
            </div>
          {% endfor %}
        {% endfor %}
      </div>
      <dl>
        <div><dt>小計</dt><dd>¥{{ totalPrice|default(0)|number_format }}</dd></div>
        <div><dt>送料</dt><dd>¥{{ deliveryFeeTotal|default(0)|number_format }}</dd></div>
        <div class="idea-summary-total"><dt>合計</dt><dd>¥{{ (totalPrice|default(0) + deliveryFeeTotal|default(0))|number_format }}</dd></div>
      </dl>
      <button class="idea-button idea-button--wide" type="submit">確認する</button>
      <a class="idea-link idea-summary-link" href="/cart">カートに戻る</a>
    </aside>
  </form>
{% else %}
  <section class="idea-container idea-section">
    <div class="idea-empty idea-empty--cart">
      <p class="idea-eyebrow">No checkout items</p>
      <h2>購入手続きできる商品がありません。</h2>
      <p class="idea-muted">カートに商品を追加してから、購入入口へお進みください。</p>
      <a class="idea-button" href="/products">商品を見つける</a>
    </div>
  </section>
{% endif %}

<script>
(() => {
  const form = document.querySelector('.idea-checkout-form');
  if (!form) return;
  const cardFields = form.querySelector('[data-credit-card-fields]');
  if (!cardFields) return;
  const inputs = Array.from(cardFields.querySelectorAll('[data-credit-card-input]'));
  const syncCreditCardFields = () => {
    const checked = form.querySelector('input[name="payment"]:checked');
    const creditSelected = checked && checked.value === '2';
    cardFields.hidden = !creditSelected;
    inputs.forEach((input) => {
      input.disabled = !creditSelected;
      input.required = creditSelected;
    });
  };
  form.querySelectorAll('input[name="payment"]').forEach((input) => {
    input.addEventListener('change', syncCreditCardFields);
  });
  syncCreditCardFields();
})();
</script>
{% endblock %}
