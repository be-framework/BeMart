{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}ご注文完了 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">Cart</a><span>/</span><span>Complete</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-complete-title">
  <div>
    <p class="idea-eyebrow">Order complete</p>
    <h1 id="idea-complete-title" class="idea-title idea-title--compact">ご注文ありがとうございました</h1>
    <p class="idea-muted">ご注文を受け付けました。確認メールをご確認ください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Order number</span>
    <strong>{{ orderNo|default('IDEA STORE') ?: 'IDEA STORE' }}</strong>
    <small>Complete</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span><b>2</b>ご注文手続き</span>
  <span><b>3</b>内容確認</span>
  <span class="is-active"><b>4</b>完了</span>
</section>

<section class="idea-container idea-section">
  <div class="idea-checkout-panel">
    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Thank you</p>
        <h2 class="idea-section-title">暮らしのイデアをお届けします</h2>
      </div>
      {% if orderNo|default('') %}<span class="idea-panel-total">#{{ orderNo }}</span>{% endif %}
    </div>
    <div class="idea-info-list">
      <p>ただいま、ご注文の確認メールをお送りしました。</p>
      <p>万一メールが届かない場合は、お手数ですがお問い合わせください。</p>
      {% if completeMessage|default('') %}<p>{{ completeMessage|nl2br }}</p>{% endif %}
    </div>
    <div class="idea-form-actions">
      <a class="idea-button" href="/">トップへ戻る</a>
      <a class="idea-link" href="/products">商品を続けて見る</a>
      <a class="idea-link" href="/cart">カートを見る</a>
    </div>
  </div>
</section>
{% endblock %}
