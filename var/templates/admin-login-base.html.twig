{#
  BeMart admin LOGIN-CONTEXT layout (clean-room rebuild).

  Three pages extend this frame:
    Page/Admin/Login.html.twig          — `{% block main %}`
    Page/Admin/TwoFactorAuth.html.twig  — `{% block main %}`
    Page/Admin/TwoFactorAuthSet.html.twig — `{% block main %}` + `{% block javascript %}`

  Design system: idea-admin-* vocabulary (idea-admin.css).
  No EC-CUBE, no Bootstrap, no c-* / ec-* classes.
#}
<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title|default('ログイン') }} - {{ shop_name|default('BeMart') }}</title>
    <meta name="robots" content="noindex,nofollow">
    <link rel="icon" href="/assets/img/common/favicon.ico">
    <link rel="stylesheet" href="/assets/idea-store/css/idea-admin.css">
    {% block stylesheet %}{% endblock %}
</head>
<body class="idea-admin-login-page">
<noscript>
    <p class="idea-admin-notice idea-admin-notice--warning">JavaScript を有効にしてご利用ください</p>
</noscript>

<div class="idea-admin-login-wrap">
    {% block main %}{% endblock %}
</div>

{% block javascript %}{% endblock %}
</body>
</html>
