{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}商品カタログ | IDEA STORE{% endblock %}
{% block content %}
{#
  BeMart 商品一覧ページ — goProductList (page://self/products).

  Data contract: src/Resource/Page/Products.php / var/json_schema/get-products.json
  Links (#[Link] declarations):
    goProduct → /product
    goCart    → /cart
    goTop     → /

  Body:
    transitionId    — "goProductList"
    totalItemCount  — int
    products[]      — { id, productCode, name, productName, price02, stock, stockFind,
                        descriptionList, mainListImage, categoryNames[], tagNames[] }
    csrfToken       — string|null (present in body; not needed for GET searches)
    filters         — { name, nameKeyword, category_id, categoryName,
                        disp_number, orderby, pageno }
    pager           — { current, pageCount, previous, next, pages[] }
#}

{% set activeKeyword = filters.name|default(filters.nameKeyword|default('')) %}
{% set activeCategoryName = filters.categoryName|default('') %}
{% set currentPage = pager.current|default(1) %}
{% set dispNumber = filters.disp_number|default('20') %}
{% set activeOrderby = filters.orderby|default('') %}

{# Per-category hero copy (the IdeaStore "category landing" experience). When the
   active keyword matches a category, the catalog shows that category's curated
   hero instead of a plain search-result heading. #}
{% set categoryHeroes = {
  '収納': { eyebrow: 'Storage edit', titleLines: ['しまう場所を、', '暮らしの余白に。'], lead: '玄関、棚、机まわり。出したままでも静かに見える収納の道具を集めました。', image: '/assets/idea-store/images/category/real/entry-storage.png' },
  '台所': { eyebrow: 'Kitchen tools', titleLines: ['台所の手順を、', '少し静かに。'], lead: '朝の一杯、支度、片づけ。毎日の動きを軽くする器と道具を選びます。', image: '/assets/idea-store/images/category/real/entry-kitchen.png' },
  '家具': { eyebrow: 'Living with furniture', titleLines: ['小さな部屋にも、', '大きな時間を。'], lead: '椅子、棚、サイドテーブル。部屋の余白をつくる家具と小物の入口です。', image: '/assets/idea-store/images/category/real/entry-furniture.png' },
  '照明': { eyebrow: 'Lighting edit', titleLines: ['夜をやわらかく、', '読みやすく。'], lead: '読書、食卓、眠る前の時間。光の置き場所から部屋の表情を整えます。', image: '/assets/idea-store/images/category/real/entry-lighting.png' },
  '布とファブリック': { eyebrow: 'Fabric edit', titleLines: ['触れるものから、', '季節を整える。'], lead: 'リネン、帆布、タオル。肌に触れる素材で、暮らしの温度を変えます。', image: '/assets/idea-store/images/category/real/entry-fabric.png' },
  'デスク用品': { eyebrow: 'Desk tools', titleLines: ['働く時間に、', '余白をつくる。'], lead: 'ペン、紙、スタンド、トレー。集中するための机まわりを静かに整えます。', image: '/assets/idea-store/images/category/real/entry-desk.png' },
  '本と雑誌': { eyebrow: 'Reading edit', titleLines: ['読む時間を、', '部屋の景色に。'], lead: '本、雑誌、ブックエンド。読みかけの一冊が似合う場所をつくります。', image: '/assets/idea-store/images/category/real/entry-books.png' },
  '音楽': { eyebrow: 'Listening edit', titleLines: ['音の居場所を、', '暮らしの中に。'], lead: 'レコード、ブラシ、小さな音の道具。部屋の空気を変える入口です。', image: '/assets/idea-store/images/category/real/entry-music.png' },
  '工作の道具': { eyebrow: 'Craft tools', titleLines: ['手を動かす時間を、', '整える。'], lead: '工具、紙、布、糸。作る前の机を整え、週末の小さな制作を支えます。', image: '/assets/idea-store/images/category/real/entry-craft.png' },
  '掃除とケア': { eyebrow: 'Care tools', titleLines: ['手入れの時間も、', '静かな習慣に。'], lead: 'ブラシ、クロス、収納箱。長く使うための日々の手入れを軽くします。', image: '/assets/idea-store/images/category/real/entry-cleaning.png' },
  'バス・ランドリー': { eyebrow: 'Bath and laundry', titleLines: ['洗う場所に、', '風通しを。'], lead: 'ランドリーバスケット、タオル、洗面まわり。水まわりを軽やかに整えます。', image: '/assets/idea-store/images/category/real/entry-bath.png' },
  'コーヒーとお茶': { eyebrow: 'Coffee and tea', titleLines: ['一杯の時間を、', '丁寧に。'], lead: 'ドリッパー、茶器、トレー。休む時間の手順を静かに整えます。', image: '/assets/idea-store/images/category/real/entry-coffee.png' },
  '植物と庭': { eyebrow: 'Plants and garden', titleLines: ['窓辺に、', '小さな緑を。'], lead: '鉢、霧吹き、土まわりの道具。育てる時間を部屋の景色にします。', image: '/assets/idea-store/images/category/real/entry-garden.png' },
  'ペットと暮らす': { eyebrow: 'Living with pets', titleLines: ['人にも動物にも、', '心地よく。'], lead: 'ボウル台、布もの、収納。暮らしに自然に馴染むペット用品を選びます。', image: '/assets/idea-store/images/category/real/entry-pet.png' },
  '外遊び': { eyebrow: 'Outdoor edit', titleLines: ['外の時間を、', '身軽に。'], lead: 'ピクニック、散歩、週末の外時間。持ち出しやすく、戻しやすい道具です。', image: '/assets/idea-store/images/category/real/entry-outdoor.png' },
  '贈る日用品': { eyebrow: 'Gift edit', titleLines: ['気負わず渡せて、', '長く使える。'], lead: '小皿、布、文具。相手の暮らしに静かに残る日用品を集めました。', image: '/assets/idea-store/images/category/real/entry-gift.png' },
  '器と食卓': { eyebrow: 'Tableware edit', titleLines: ['食卓の余白を、', '器から。'], lead: '皿、カップ、カトラリー。ふだんの食事を少し穏やかにする道具です。', image: '/assets/idea-store/images/category/real/entry-tableware.png' },
  '文具': { eyebrow: 'Stationery edit', titleLines: ['書く時間を、', '整える。'], lead: '紙、カードスタンド、筆記具。手を動かす時間に集中できる机をつくります。', image: '/assets/idea-store/images/category/real/entry-stationery.png' },
  'オーディオ小物': { eyebrow: 'Audio objects', titleLines: ['音楽の居場所を、', '小さく整える。'], lead: 'ケーブル、ブラシ、小さな台。聴く前後の所作まで気持ちよく。', image: '/assets/idea-store/images/category/real/entry-audio.png' },
  '子どもと学び': { eyebrow: 'Kids and learning', titleLines: ['遊びながら、', '考える場所を。'], lead: '積み木、紙、収納。片づけまで含めて、家の中の学びを支えます。', image: '/assets/idea-store/images/category/real/entry-kids.png' }
} %}
{% set categoryHero = categoryHeroes[activeKeyword]|default(categoryHeroes[activeCategoryName]|default(null)) %}

{# --- breadcrumb --- #}
<nav class="idea-container idea-breadcrumb" aria-label="現在地">
  <a href="/" rel="goTop">ホーム</a>
  <span>/</span>
  {% if categoryHero %}
    <a href="/products">カタログ</a>
    <span>/</span>
    <span>{{ activeKeyword|default(activeCategoryName) }}</span>
  {% elseif activeCategoryName %}
    <a href="/products">カタログ</a>
    <span>/</span>
    <span>{{ activeCategoryName }}</span>
  {% elseif activeKeyword %}
    <a href="/products">カタログ</a>
    <span>/</span>
    <span>「{{ activeKeyword }}」の検索結果</span>
  {% else %}
    <span>カタログ</span>
  {% endif %}
</nav>

{# --- catalog hero / search block --- #}
{% if categoryHero %}
<section class="idea-container idea-collection-hero idea-collection-hero--visual" aria-labelledby="idea-catalog-heading">
  <img class="idea-collection-hero-image" src="{{ categoryHero.image }}" alt="{{ activeKeyword|default(activeCategoryName) }}の暮らしの入口">
  <div class="idea-collection-hero-copy">
    <p class="idea-eyebrow">{{ categoryHero.eyebrow }}</p>
    <h1 id="idea-catalog-heading" class="idea-title idea-title--compact">
      {% for titleLine in categoryHero.titleLines %}<span class="idea-title-line">{{ titleLine }}</span>{% endfor %}
    </h1>
    <p class="idea-muted">{{ categoryHero.lead }}</p>
    <form class="idea-catalog-search idea-catalog-search--overlay" action="/products" method="get" role="search">
      <input type="search" name="name" value="{{ activeKeyword }}" placeholder="キーワードで探す" aria-label="商品を検索">
      <button class="idea-button" type="submit">検索</button>
    </form>
  </div>
</section>
{% else %}
<section class="idea-container idea-collection-hero" aria-labelledby="idea-catalog-heading">
  <div>
    <p class="idea-eyebrow">Catalog</p>
    {% if activeKeyword %}
      <h1 id="idea-catalog-heading" class="idea-title idea-title--compact">
        <span class="idea-title-line">「{{ activeKeyword }}」</span>
        <span class="idea-title-line">の検索結果</span>
      </h1>
    {% else %}
      <h1 id="idea-catalog-heading" class="idea-title idea-title--compact">
        <span class="idea-title-line">暮らしに合う道具を、</span>
        <span class="idea-title-line">ここから選ぶ。</span>
      </h1>
    {% endif %}
    <p class="idea-muted">キーワードやカテゴリで絞り込めます。</p>
  </div>
  <form class="idea-catalog-search" action="/products" method="get" role="search">
    <input type="search" name="name" value="{{ activeKeyword }}" placeholder="キーワードで探す" aria-label="商品を検索">
    <button class="idea-button" type="submit">検索</button>
  </form>
</section>
{% endif %}

{# --- toolbar: item count + quick filters + sort --- #}
<section class="idea-container idea-section idea-catalog-body" aria-label="商品一覧">
  <div class="idea-toolbar">
    <div>
      <p class="idea-eyebrow">{{ totalItemCount|default(products|default([])|length) }} items</p>
      <h2 class="idea-section-title">
        {% if activeCategoryName %}
          {{ activeCategoryName }}の商品
        {% elseif activeKeyword %}
          検索結果
        {% else %}
          すべての商品
        {% endif %}
      </h2>
    </div>
    <div class="idea-chip-row idea-chip-row--toolbar" aria-label="カテゴリで絞り込む">
      <a href="/products">すべて</a>
      <a href="/products?name={{ '収納'|url_encode }}">収納</a>
      <a href="/products?name={{ '台所'|url_encode }}">台所</a>
      <a href="/products?name={{ '家具'|url_encode }}">家具</a>
      <a href="/products?name={{ '本と雑誌'|url_encode }}">本</a>
      <a href="/products?name={{ '音楽'|url_encode }}">音楽</a>
      <a href="/products?name={{ '工作の道具'|url_encode }}">工作</a>
    </div>
    <div class="idea-sort-links" aria-label="並び順">
      <a href="/products?name={{ activeKeyword|url_encode }}{% if filters.category_id|default('') %}&amp;category_id={{ filters.category_id }}{% endif %}&amp;disp_number={{ dispNumber }}">新着順</a>
      <a href="/products?name={{ activeKeyword|url_encode }}{% if filters.category_id|default('') %}&amp;category_id={{ filters.category_id }}{% endif %}&amp;orderby=price_low&amp;disp_number={{ dispNumber }}">価格が低い順</a>
      <a href="/products?name={{ activeKeyword|url_encode }}{% if filters.category_id|default('') %}&amp;category_id={{ filters.category_id }}{% endif %}&amp;orderby=price_high&amp;disp_number={{ dispNumber }}">価格が高い順</a>
    </div>
  </div>

  {# --- product grid or empty state --- #}
  {% if products|default([]) is not empty %}
    <div class="idea-catalog-layout">
      <aside class="idea-catalog-note" aria-label="カタログ案内">
        <p class="idea-eyebrow">Curation note</p>
        <h3>カテゴリから選ぶと、見つけやすい。</h3>
        <p>用途や素材で絞り込むと、暮らしに合う道具が見つかります。</p>
        <a href="/products">すべての商品を見る</a>
      </aside>
      <div class="idea-product-grid">
        {% for product in products %}
          {% include 'IdeaStore/product/card.html.twig' with { product: product } %}
        {% endfor %}
      </div>
    </div>

    {# --- pager --- #}
    {% if pager.pageCount|default(1) > 1 %}
      <nav class="idea-section idea-section--tight" aria-label="ページ移動">
        <div class="idea-chip-row" style="justify-content:center">
          {% if pager.previous %}
            <a class="idea-button idea-button--light"
               href="/products?name={{ activeKeyword|url_encode }}&amp;category_id={{ filters.category_id|default('') }}&amp;orderby={{ activeOrderby }}&amp;disp_number={{ dispNumber }}&amp;pageno={{ pager.previous }}">
              前のページ
            </a>
          {% endif %}
          {% for page in pager.pages|default([]) %}
            <a class="idea-chip-row{% if page == currentPage %} is-active{% endif %}"
               href="/products?name={{ activeKeyword|url_encode }}&amp;category_id={{ filters.category_id|default('') }}&amp;orderby={{ activeOrderby }}&amp;disp_number={{ dispNumber }}&amp;pageno={{ page }}"
               {% if page == currentPage %}aria-current="page"{% endif %}>
              {{ page }}
            </a>
          {% endfor %}
          {% if pager.next %}
            <a class="idea-button idea-button--light"
               href="/products?name={{ activeKeyword|url_encode }}&amp;category_id={{ filters.category_id|default('') }}&amp;orderby={{ activeOrderby }}&amp;disp_number={{ dispNumber }}&amp;pageno={{ pager.next }}">
              次のページ
            </a>
          {% endif %}
        </div>
      </nav>
    {% endif %}

  {% else %}
    <div class="idea-empty">
      <p class="idea-eyebrow">No results</p>
      <h2 class="idea-section-title">
        {% if activeKeyword %}
          「{{ activeKeyword }}」に一致する商品は見つかりませんでした。
        {% else %}
          商品が見つかりませんでした。
        {% endif %}
      </h2>
      <p class="idea-muted">別のキーワードで試すか、カテゴリから探してください。</p>
      <a class="idea-button" href="/products" rel="goProductList">すべての商品へ</a>
    </div>
  {% endif %}

</section>
{% endblock %}
