{#
  BeMart Product List page — EC-CUBE goProductList.

  PORT of EC-CUBE 4.3 default-theme `Product/list.twig`
  (src/Eccube/Resource/template/default/Product/list.twig).

  Markup skeleton, `ec-searchnavRole` / `ec-topicpath` / `ec-shelfRole`
  / `ec-shelfGrid` / `ec-pagerRole` / `ec-modal` classes and structure
  are kept verbatim from EC-CUBE. Only the dynamic bindings are rebound
  to the Products resource body (src/Resource/Page/Products.php):
    transitionId, totalItemCount, products[]

  NOTE — scope. The Products resource is now backed by the storefront
  catalog query (GetStorefrontProductListInput -> StorefrontProductListFetched):
  it projects every STATUS_VISIBLE product as `{id, name, price02}`. So
  this port renders the populated `ec-shelfGrid` branch of EC-CUBE's
  `Product/list.twig` when `totalItemCount > 0`, and the
  "お探しの商品は見つかりませんでした" empty-result branch otherwise.

  This is a SIMPLIFIED port (厳密移植 Grade-C, parity with the Cart port):
  the catalog row carries only the bare name + a single `price02`, with
  the `product_detail` link and the placeholder thumbnail. EC-CUBE's row
  additionally renders a per-item add-cart `<form>` (ProductClass selects
  + quantity), an `.ec-modal` add-cart dialog, the `disp_number` /
  `orderby` sort controls and an `.ec-pagerRole` pager — all of which
  need data the resource body does not carry (ProductClass joins, a
  Symfony FormView, pagination metadata). Those omissions are the
  enumerated residuals in ProductsHtmlRenderTest; category / keyword
  filtering + pagination are deferred to Phase 2.

  EC-CUBE-ism rebinding (see var/templates/README.md):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - the `block javascript` loop emits `eccube.productsClassCategories`
     keyed by the js-escaped product id; BeMart carries no ProductClass
     data so each value is an empty object literal.
#}
{% extends 'base.html.twig' %}

{% set body_class = 'product_page' %}
{% set route = 'product_list' %}
{% set title = '商品一覧' %}

{% block javascript %}
    <script>
        eccube.productsClassCategories = {
            {% for product in products %}
            "{{ product.id|escape('js') }}": {}{% if loop.last == false %}, {% endif %}
            {% endfor %}
        };

        $(function() {

            // 表示件数を変更
            $('.disp-number').change(function() {
                var dispNumber = $(this).val();
                $('#disp_number').val(dispNumber);
                $('#pageno').val(1);
                $("#form1").submit();
            });

            // 並び順を変更
            $('.order-by').change(function() {
                var orderBy = $(this).val();
                $('#orderby').val(orderBy);
                $('#pageno').val(1);
                $("#form1").submit();
            });

            $('.add-cart').on('click', function(e) {
                var $form = $(this).parents('li').find('form');

                // 個数フォームのチェック
                var $quantity = $form.parent().find('.quantity');
                if ($quantity.val() < 1) {
                    $quantity[0].setCustomValidity('1以上で入力してください。');
                    setTimeout(function() {
                        loadingOverlay('hide');
                    }, 100);
                    return true;
                } else {
                    $quantity[0].setCustomValidity('');
                }
                e.preventDefault();
                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method'),
                    data: $form.serialize(),
                    dataType: 'json',
                    beforeSend: function(xhr, settings) {
                        // Buttonを無効にする
                        $('.add-cart').prop('disabled', true);
                    }
                }).done(function(data) {
                    // レスポンス内のメッセージをalertで表示
                    $.each(data.messages, function() {
                        $('#ec-modal-header').text(this);
                    });

                    $('.ec-modal').show()

                    // カートブロックを更新する
                    $.ajax({
                        url: '{{ url('block_cart') }}',
                        type: 'GET',
                        dataType: 'html'
                    }).done(function(html) {
                        $('.ec-headerRole__cart').html(html);
                    });
                }).fail(function(data) {
                    alert('カートへの追加に失敗しました。');
                }).always(function(data) {
                    // Buttonを有効にする
                    $('.add-cart').prop('disabled', false);
                });
            });
        });

        $('.ec-modal-wrap').on('click', function(e) {
            // モーダル内の処理は外側にバブリングさせない
            e.stopPropagation();
        });
        $('.ec-modal-overlay, .ec-modal, .ec-modal-close, .ec-inlineBtn--cancel').on('click', function() {
            $('.ec-modal').hide()
        });
    </script>
{% endblock %}

{% block main %}
    <div class="ec-searchnavRole">
        <form name="form1" id="form1" method="get" action="?">
        </form>
        <div class="ec-searchnavRole__topicpath">
            <ol class="ec-topicpath">
                <li class="ec-topicpath__item"><a href="{{ url('product_list') }}">全て</a>
                </li>
            </ol>
        </div>
        <div class="ec-searchnavRole__infos">
            <div class="ec-searchnavRole__counter">
                {% if totalItemCount > 0 %}
                    <span class="ec-font-bold">{{ totalItemCount }}件</span><span>の商品が見つかりました</span>
                {% else %}
                    <span>お探しの商品は見つかりませんでした</span>
                {% endif %}
            </div>
        </div>
    </div>
    {% if totalItemCount > 0 %}
        <div class="ec-shelfRole">
            <ul class="ec-shelfGrid">
                {% for product in products %}
                    <li class="ec-shelfGrid__item">
                        <a href="{{ url('product_detail', {'id': product.id}) }}">
                            <p class="ec-shelfGrid__item-image">
                                <img src="{{ asset(product.mainListImage|default('assets/img/common/no_image_product.png'), 'save_image') }}" alt="{{ product.name }}" {% if loop.index > 5 %} loading="lazy"{% endif %}>
                            </p>
                            <p>{{ product.name }}</p>
                            <p class="price02-default">
                                {{ product.price02|price }}
                            </p>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
