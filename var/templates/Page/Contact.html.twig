{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お問い合わせ | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><span>お問い合わせ</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-contact-title">
  <div>
    <p class="idea-eyebrow">Contact us</p>
    <h1 id="idea-contact-title" class="idea-title idea-title--compact">お問い合わせ</h1>
    <p class="idea-muted">ご不明な点やご要望がございましたら、下記フォームよりお気軽にご連絡ください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Inquiry form</span>
    <strong>IDEA STORE</strong>
    <small>内容を確認後、担当者よりご連絡いたします</small>
  </div>
</section>

{% if message is defined and message %}
<section class="idea-container">
  <p class="idea-form-error idea-form-error--banner">{{ message }}</p>
</section>
{% endif %}

<section class="idea-container idea-section">
  <form class="idea-checkout-panel" method="post" action="/contact" novalidate>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Your details</p>
        <h2 class="idea-section-title">お名前・連絡先</h2>
      </div>
    </div>

    <div class="idea-form-grid idea-form-grid--two">
      <label class="idea-field">姓
        {{ form.input('contactName01')|raw }}
        <span class="idea-form-error">{{ form.error('contactName01') }}</span>
      </label>
      <label class="idea-field">名
        {{ form.input('contactName02')|raw }}
        <span class="idea-form-error">{{ form.error('contactName02') }}</span>
      </label>
      <label class="idea-field idea-field--full">メールアドレス
        {{ form.input('contactEmail')|raw }}
        <span class="idea-form-error">{{ form.error('contactEmail') }}</span>
      </label>
    </div>

    <div class="idea-panel-head idea-panel-head--inner">
      <div>
        <p class="idea-eyebrow">Message</p>
        <h2 class="idea-section-title">お問い合わせ内容</h2>
      </div>
    </div>

    <div class="idea-form-grid">
      <label class="idea-field idea-field--full">内容
        {{ form.input('contactContents')|raw }}
        <span class="idea-form-error">{{ form.error('contactContents') }}</span>
      </label>
    </div>

    <div class="idea-form-actions">
      <button class="idea-button idea-button--wide" type="submit" name="mode" value="confirm">確認画面へ</button>
    </div>
  </form>
</section>
{% endblock %}
