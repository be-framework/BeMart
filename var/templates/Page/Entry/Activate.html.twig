{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}メール認証完了 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><span>会員登録</span><span>/</span><span>メール認証完了</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-activate-title">
  <div>
    <p class="idea-eyebrow">Email verified</p>
    <h1 id="idea-activate-title" class="idea-title idea-title--compact">会員登録が完了しました</h1>
  </div>
  <div class="idea-checkout-status">
    <span>Account</span>
    <strong>IDEA STORE</strong>
    <small>ご登録ありがとうございます</small>
  </div>
</section>

<section class="idea-container idea-section idea-section--tight" aria-label="登録完了メッセージ">
  <div class="idea-checkout-panel">
    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">What's next</p>
        <h2 class="idea-section-title">ショッピングをはじめましょう</h2>
      </div>
    </div>
    <p class="idea-lead">
      メールアドレスの確認が取れました。登録したメールアドレスとパスワードでログインして、お買い物をお楽しみください。
    </p>
    <div class="idea-form-actions">
      <a class="idea-button idea-button--wide" href="/">トップページへ</a>
    </div>
  </div>
</section>
{% endblock %}
