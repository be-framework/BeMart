{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}会員登録の確認 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/entry">新規会員登録</a><span>/</span><span>内容の確認</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-entry-confirm-title">
  <div>
    <p class="idea-eyebrow">Registration review</p>
    <h1 id="idea-entry-confirm-title" class="idea-title idea-title--compact">入力内容の確認</h1>
    <p class="idea-muted">登録内容を確認し、問題がなければ「会員登録を完了する」ボタンを押してください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Member registration</span>
    <strong>Step 2</strong>
    <small>Confirm details</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="登録ステップ">
  <span><b>1</b>情報の入力</span>
  <span class="is-active"><b>2</b>内容の確認</span>
  <span><b>3</b>登録完了</span>
</section>

<section class="idea-container idea-section">
  <form class="idea-checkout-panel" method="post" action="/entry">
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Registration details</p>
        <h2 class="idea-section-title">登録情報</h2>
      </div>
    </div>

    <dl class="idea-info-list idea-info-list--defs">
      <div>
        <dt>お名前</dt>
        <dd>
          {{ name01|default('') }} {{ name02|default('') }}
          {{ form.input('name01')|raw }}
          {{ form.input('name02')|raw }}
        </dd>
      </div>
      <div>
        <dt>お名前（カナ）</dt>
        <dd>
          {{ kana01|default('') }} {{ kana02|default('') }}
          {{ form.input('kana01')|raw }}
          {{ form.input('kana02')|raw }}
        </dd>
      </div>
      <div>
        <dt>会社名</dt>
        <dd>
          {{ companyName|default('') }}
          {{ form.input('companyName')|raw }}
        </dd>
      </div>
      <div>
        <dt>住所</dt>
        <dd>
          <span>〒</span>{{ postalCode|default('') }}
          {{ pref|default('') }} {{ addr01|default('') }} {{ addr02|default('') }}
          {{ form.input('postalCode')|raw }}
          {{ form.input('pref')|raw }}
          {{ form.input('addr01')|raw }}
          {{ form.input('addr02')|raw }}
        </dd>
      </div>
      <div>
        <dt>電話番号</dt>
        <dd>
          {{ phoneNumber|default('') }}
          {{ form.input('phoneNumber')|raw }}
        </dd>
      </div>
      <div>
        <dt>メールアドレス</dt>
        <dd>
          {{ email|default('') }}
          {{ form.input('email')|raw }}
          {{ form.input('email_confirm')|raw }}
        </dd>
      </div>
      <div>
        <dt>パスワード</dt>
        <dd>
          ••••••••
          {{ form.input('password')|raw }}
          {{ form.input('password_confirm')|raw }}
        </dd>
      </div>
      <div>
        <dt>生年月日</dt>
        <dd>
          {{ birth|default('') }}
          {{ form.input('birth_year')|raw }}
          {{ form.input('birth_month')|raw }}
          {{ form.input('birth_day')|raw }}
        </dd>
      </div>
      <div>
        <dt>性別</dt>
        <dd>
          {{ sex|default('') }}
          {{ form.input('sex')|raw }}
        </dd>
      </div>
      <div>
        <dt>職業</dt>
        <dd>
          {{ job|default('') }}
          {{ form.input('job')|raw }}
        </dd>
      </div>
    </dl>

    {{ form.input('user_policy_check')|raw }}

    <div class="idea-form-actions">
      <button class="idea-button" type="submit" name="mode" value="complete">会員登録を完了する</button>
      <button class="idea-button idea-button--light" type="submit" name="mode" value="back">入力画面に戻る</button>
    </div>
  </form>
</section>
{% endblock %}
