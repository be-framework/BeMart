{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}仮登録完了 | IDEA STORE{% endblock %}

{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><span>仮登録完了</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-entry-complete-title">
  <div>
    <p class="idea-eyebrow">Member registration</p>
    <h1 id="idea-entry-complete-title" class="idea-title idea-title--compact">ご登録ありがとうございます</h1>
    <p class="idea-muted">仮登録が完了しました。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Registration</span>
    <strong>Pending</strong>
    <small>メール確認が必要です</small>
  </div>
</section>

<div class="idea-container idea-section">
  <div class="idea-checkout-panel" role="status" aria-live="polite">
    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Next step</p>
        <h2 class="idea-section-title">確認メールをお送りしました</h2>
      </div>
    </div>

    <p>ご登録いただいたメールアドレス宛に確認メールを送信しました。メール内のリンクをクリックして、本登録を完了してください。</p>
    <p class="idea-muted">メールが届かない場合は、迷惑メールフォルダをご確認ください。</p>

    <div class="idea-form-actions" style="margin-top:2rem;">
      <a class="idea-button" href="{{ _links.goTop.href|default('/') }}" rel="goTop">トップページへ戻る</a>
    </div>
  </div>
</div>
{% endblock %}
