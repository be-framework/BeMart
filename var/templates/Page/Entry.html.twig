{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}会員登録 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><span>会員登録</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-entry-title">
  <div>
    <p class="idea-eyebrow">Member registration</p>
    <h1 id="idea-entry-title" class="idea-title idea-title--compact">会員登録</h1>
    <p class="idea-muted">お名前・ご住所・メールアドレス・パスワードを入力して、会員登録を完了させてください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>New account</span>
    <strong>IDEA STORE</strong>
    <small>無料で登録できます</small>
  </div>
</section>

{% if message is defined and message %}
<section class="idea-container">
  <p class="idea-form-error idea-form-error--banner">{{ message }}</p>
</section>
{% endif %}

<section class="idea-container idea-section">
  <form class="idea-checkout-panel idea-entry-form h-adr" method="post" action="/entry" novalidate>
    <span class="p-country-name" aria-hidden="true">Japan</span>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Personal details</p>
        <h2 class="idea-section-title">お名前・フリガナ</h2>
      </div>
    </div>

    <div class="idea-form-grid idea-form-grid--two">
      <label class="idea-field">姓
        {{ form.input('name01')|raw }}
        <span class="idea-form-error">{{ form.error('name01') }}</span>
      </label>
      <label class="idea-field">名
        {{ form.input('name02')|raw }}
        <span class="idea-form-error">{{ form.error('name02') }}</span>
      </label>
      <label class="idea-field">セイ
        {{ form.input('kana01')|raw }}
        <span class="idea-form-error">{{ form.error('kana01') }}</span>
      </label>
      <label class="idea-field">メイ
        {{ form.input('kana02')|raw }}
        <span class="idea-form-error">{{ form.error('kana02') }}</span>
      </label>
      <label class="idea-field idea-field--full">会社名（任意）
        {{ form.input('companyName')|raw }}
        <span class="idea-form-error">{{ form.error('companyName') }}</span>
      </label>
    </div>

    <div class="idea-panel-head idea-panel-head--inner">
      <div>
        <p class="idea-eyebrow">Address</p>
        <h2 class="idea-section-title">ご住所</h2>
      </div>
    </div>

    <div class="idea-form-grid idea-form-grid--two">
      <label class="idea-field">郵便番号
        {{ form.input('postalCode')|raw }}
        <span class="idea-form-error">{{ form.error('postalCode') }}</span>
      </label>
      <label class="idea-field">都道府県
        {{ form.input('pref')|raw }}
        <span class="idea-form-error">{{ form.error('pref') }}</span>
      </label>
      <label class="idea-field">市区町村
        {{ form.input('addr01')|raw }}
        <span class="idea-form-error">{{ form.error('addr01') }}</span>
      </label>
      <label class="idea-field">番地・建物名
        {{ form.input('addr02')|raw }}
        <span class="idea-form-error">{{ form.error('addr02') }}</span>
      </label>
      <label class="idea-field">電話番号（任意）
        {{ form.input('phoneNumber')|raw }}
        <span class="idea-form-error">{{ form.error('phoneNumber') }}</span>
      </label>
    </div>

    <div class="idea-panel-head idea-panel-head--inner">
      <div>
        <p class="idea-eyebrow">Account</p>
        <h2 class="idea-section-title">メールアドレス・パスワード</h2>
      </div>
    </div>

    <div class="idea-form-grid idea-form-grid--two">
      <label class="idea-field">メールアドレス
        {{ form.input('email')|raw }}
        <span class="idea-form-error">{{ form.error('email') }}</span>
      </label>
      <label class="idea-field">メールアドレス（確認）
        {{ form.input('email_confirm')|raw }}
        <span class="idea-form-error">{{ form.error('email_confirm') }}</span>
      </label>
      <label class="idea-field">パスワード
        {{ form.input('password')|raw }}
        <span class="idea-form-error">{{ form.error('password') }}</span>
      </label>
      <label class="idea-field">パスワード（確認）
        {{ form.input('password_confirm')|raw }}
        <span class="idea-form-error">{{ form.error('password_confirm') }}</span>
      </label>
    </div>

    <div class="idea-panel-head idea-panel-head--inner">
      <div>
        <p class="idea-eyebrow">Profile</p>
        <h2 class="idea-section-title">プロフィール（任意）</h2>
      </div>
    </div>

    <div class="idea-form-grid idea-form-grid--two">
      <label class="idea-field idea-field--full">生年月日
        <span class="idea-birth-group">
          {{ form.input('birth_year')|raw }}
          <span aria-hidden="true">/</span>
          {{ form.input('birth_month')|raw }}
          <span aria-hidden="true">/</span>
          {{ form.input('birth_day')|raw }}
        </span>
        <span class="idea-form-error">{{ form.error('birth_year') }}</span>
      </label>
      <label class="idea-field">性別
        {{ form.input('sex')|raw }}
        <span class="idea-form-error">{{ form.error('sex') }}</span>
      </label>
      <label class="idea-field">職業
        {{ form.input('job')|raw }}
        <span class="idea-form-error">{{ form.error('job') }}</span>
      </label>
    </div>

    <div class="idea-form-actions idea-form-actions--policy">
      <label class="idea-option-card idea-option-card--policy">
        {{ form.input('user_policy_check')|raw }}
        <span><a class="idea-link" href="/help/agreement" target="_blank" rel="noopener noreferrer">利用規約</a>に同意してお進みください</span>
      </label>
      <span class="idea-form-error">{{ form.error('user_policy_check') }}</span>
    </div>

    <div class="idea-form-actions">
      <button class="idea-button idea-button--wide" type="submit" name="mode" value="confirm">登録する</button>
      <a class="idea-link" href="/">同意しない</a>
    </div>
  </form>
</section>
{% endblock %}
