{#
  BeMart admin Customer editor — clean-room build.

  DATA CONTRACT (src/Resource/Page/Admin/Customer.php onGet):
    customerId        string
    email             string
    name01            string
    name02            string
    kana01            string|null
    kana02            string|null
    companyName       string|null
    phoneNumber       string|null
    postalCode        string|null
    pref              int|null
    addr01            string|null
    addr02            string|null
    birth             string|null
    sex               int|null
    job               int|null
    customerStatus    int
    initialPoint      int
    orders            list<{orderNo, total, paymentTotal, orderDate, orderStatus}>
    orderCount        int
    totalSpent        int
    favorites         list<{productCode, productName, unitPrice}>
    favoriteCount     int
    form              AdminCustomerForm (pre-filled from body)

  FORM CONTRACT (src/Form/AdminCustomerForm.php):
    fields: name01, name02, kana01, kana02, company_name, postal_code,
            pref (select), addr01, addr02, email, phone_number,
            plain_password_first, plain_password_second,
            sex (radio), job (select), birth, point, note (textarea)

  ACTIONS (derived from resource method routing):
    POST /admin/customer?customerId=<id>  — save profile

  Back link: #[Link(rel: 'goCustomerList')] → /admin/customer-list
  Delivery edit link: /admin/customer-delivery-edit?customerId=<id>

  IdeaStore admin design vocabulary (idea-admin-*):
    idea-admin-layout       two-column editor shell (main col + side panel)
    idea-admin-panel        card section
    idea-admin-panel__head  section header row
    idea-admin-panel__body  section content area
    idea-admin-field        label + input row
    idea-admin-field__label label cell
    idea-admin-field__input input cell
    idea-admin-required     required badge
    idea-admin-error        inline field error
    idea-admin-toolbar      action bar anchored at the bottom
    idea-admin-toolbar__back back-nav link
    idea-admin-toolbar__actions submit group
    idea-admin-table-wrap / idea-admin-table  data table
    idea-admin-empty        empty-state block
    idea-admin-kpi-grid / idea-admin-kpi  summary figures
    idea-admin-notice       inline alert (error / info)
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-customer' %}
{% set title = '会員編集' %}
{% set sub_title = '会員管理' %}

{% block javascript %}
    <script src="//yubinbango.github.io/yubinbango/yubinbango.js" charset="UTF-8"></script>
{% endblock javascript %}

{% block main %}

{% if message is defined and message %}
  <p class="idea-admin-notice idea-admin-notice--error" role="alert">{{ message }}</p>
{% endif %}

<form
  id="customer_form"
  role="form"
  method="post"
  action="/admin/customer?customerId={{ customerId }}"
  class="h-adr"
  novalidate
>
  <span class="p-country-name" style="display:none;">Japan</span>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

  {# ── Summary KPIs (read-only) ─────────────────────────────────────────── #}
  <div class="idea-admin-kpi-grid">
    <div class="idea-admin-kpi">
      <div class="idea-admin-kpi__label">会員ID</div>
      <div class="idea-admin-kpi__value" style="font-size:1.1rem;">{{ customerId }}</div>
    </div>
    <div class="idea-admin-kpi">
      <div class="idea-admin-kpi__label">保有ポイント</div>
      <div class="idea-admin-kpi__value">{{ initialPoint }}</div>
    </div>
    <div class="idea-admin-kpi">
      <div class="idea-admin-kpi__label">注文件数</div>
      <div class="idea-admin-kpi__value">{{ orderCount }}</div>
    </div>
    <div class="idea-admin-kpi">
      <div class="idea-admin-kpi__label">累計購入額</div>
      <div class="idea-admin-kpi__value">{{ totalSpent }}</div>
    </div>
    <div class="idea-admin-kpi">
      <div class="idea-admin-kpi__label">お気に入り</div>
      <div class="idea-admin-kpi__value">{{ favoriteCount }}</div>
    </div>
  </div>

  <div class="idea-admin-layout">

    {# ── Primary column ────────────────────────────────────────────────── #}
    <div class="idea-admin-primary">

      {# Section: 氏名 #}
      <section class="idea-admin-panel" aria-labelledby="section-name">
        <div class="idea-admin-panel__head">
          <h3 id="section-name">氏名</h3>
        </div>
        <div class="idea-admin-panel__body">

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_name_name01">姓</label>
              <span class="idea-admin-required">必須</span>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('name01')|raw }}
              {% if form.error('name01') %}
                <span class="idea-admin-error">{{ form.error('name01') }}</span>
              {% endif %}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_name_name02">名</label>
              <span class="idea-admin-required">必須</span>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('name02')|raw }}
              {% if form.error('name02') %}
                <span class="idea-admin-error">{{ form.error('name02') }}</span>
              {% endif %}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_kana_kana01">セイ</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('kana01')|raw }}
              {% if form.error('kana01') %}
                <span class="idea-admin-error">{{ form.error('kana01') }}</span>
              {% endif %}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_kana_kana02">メイ</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('kana02')|raw }}
              {% if form.error('kana02') %}
                <span class="idea-admin-error">{{ form.error('kana02') }}</span>
              {% endif %}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_company_name">会社名</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('company_name')|raw }}
            </div>
          </div>

        </div>
      </section>

      {# Section: 連絡先 #}
      <section class="idea-admin-panel" aria-labelledby="section-contact">
        <div class="idea-admin-panel__head">
          <h3 id="section-contact">連絡先</h3>
        </div>
        <div class="idea-admin-panel__body">

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_email">メールアドレス</label>
              <span class="idea-admin-required">必須</span>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('email')|raw }}
              {% if form.error('email') %}
                <span class="idea-admin-error">{{ form.error('email') }}</span>
              {% endif %}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_phone_number">電話番号</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('phone_number')|raw }}
            </div>
          </div>

        </div>
      </section>

      {# Section: 住所 #}
      <section class="idea-admin-panel" aria-labelledby="section-address">
        <div class="idea-admin-panel__head">
          <h3 id="section-address">住所</h3>
        </div>
        <div class="idea-admin-panel__body">

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_postal_code">郵便番号</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('postal_code')|raw }}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_address_pref">都道府県</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('pref')|raw }}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_address_addr01">住所1</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('addr01')|raw }}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_address_addr02">住所2</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('addr02')|raw }}
            </div>
          </div>

        </div>
      </section>

      {# Section: パスワード #}
      <section class="idea-admin-panel" aria-labelledby="section-password">
        <div class="idea-admin-panel__head">
          <h3 id="section-password">パスワード変更</h3>
          <p class="idea-admin-panel__hint">変更する場合のみ入力してください。</p>
        </div>
        <div class="idea-admin-panel__body">

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_plain_password_first">新パスワード</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('plain_password_first')|raw }}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_plain_password_second">確認用</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('plain_password_second')|raw }}
            </div>
          </div>

        </div>
      </section>

      {# Section: 注文履歴 #}
      <section class="idea-admin-panel" aria-labelledby="section-orders">
        <div class="idea-admin-panel__head">
          <h3 id="section-orders">注文履歴</h3>
        </div>
        {% if orders is defined and orders|length > 0 %}
          <div class="idea-admin-table-wrap">
            <table class="idea-admin-table" id="order-history">
              <thead>
                <tr>
                  <th>注文番号</th>
                  <th>注文日</th>
                  <th>合計</th>
                  <th>決済合計</th>
                </tr>
              </thead>
              <tbody>
                {% for order in orders %}
                  <tr>
                    <td>{{ order.orderNo }}</td>
                    <td>{{ order.orderDate }}</td>
                    <td>{{ order.total }}</td>
                    <td>{{ order.paymentTotal }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="idea-admin-panel__body">
            <div class="idea-admin-empty" id="history_box">
              <p class="idea-admin-empty__title">注文履歴がありません</p>
            </div>
          </div>
        {% endif %}
      </section>

      {# Section: お気に入り #}
      <section class="idea-admin-panel" aria-labelledby="section-favorites">
        <div class="idea-admin-panel__head">
          <h3 id="section-favorites">お気に入り</h3>
        </div>
        {% if favorites is defined and favorites|length > 0 %}
          <div class="idea-admin-table-wrap">
            <table class="idea-admin-table" id="favorites-list">
              <thead>
                <tr>
                  <th>商品コード</th>
                  <th>商品名</th>
                  <th>単価</th>
                </tr>
              </thead>
              <tbody>
                {% for item in favorites %}
                  <tr>
                    <td>{{ item.productCode }}</td>
                    <td>{{ item.productName }}</td>
                    <td>{{ item.unitPrice }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="idea-admin-panel__body">
            <div class="idea-admin-empty">
              <p class="idea-admin-empty__title">お気に入りがありません</p>
            </div>
          </div>
        {% endif %}
      </section>

      {# Section: お届け先住所 #}
      <section class="idea-admin-panel" aria-labelledby="section-delivery">
        <div class="idea-admin-panel__head">
          <h3 id="section-delivery">お届け先住所</h3>
        </div>
        <div class="idea-admin-panel__body">
          <div class="idea-admin-empty" id="address_box">
            <p class="idea-admin-empty__title">お届け先が登録されていません</p>
          </div>
          <div style="text-align:center; margin-top:.75rem;">
            <a
              class="idea-admin-action"
              href="/admin/customer-delivery-edit?customerId={{ customerId }}"
            >
              <i class="fa fa-plus" aria-hidden="true"></i>
              お届け先を追加
            </a>
          </div>
        </div>
      </section>

      {# Section: 店舗メモ #}
      <section class="idea-admin-panel" aria-labelledby="section-note">
        <div class="idea-admin-panel__head">
          <h3 id="section-note">店舗メモ</h3>
          <p class="idea-admin-panel__hint">フロントには表示されません。</p>
        </div>
        <div class="idea-admin-panel__body">
          {{ form.input('note')|raw }}
        </div>
      </section>

    </div>

    {# ── Side panel ───────────────────────────────────────────────────── #}
    <aside class="idea-admin-side" aria-label="属性・ポイント">

      {# Section: 属性 #}
      <section class="idea-admin-panel" aria-labelledby="section-attrs">
        <div class="idea-admin-panel__head">
          <h3 id="section-attrs">属性</h3>
        </div>
        <div class="idea-admin-panel__body">

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label>性別</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('sex')|raw }}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_job">職業</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('job')|raw }}
            </div>
          </div>

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_birth">誕生日</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('birth')|raw }}
            </div>
          </div>

        </div>
      </section>

      {# Section: ポイント #}
      <section class="idea-admin-panel" aria-labelledby="section-point">
        <div class="idea-admin-panel__head">
          <h3 id="section-point">ポイント</h3>
        </div>
        <div class="idea-admin-panel__body">

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_customer_point">保有ポイント</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('point')|raw }}
            </div>
          </div>

        </div>
      </section>

    </aside>

  </div>

  {# ── Action toolbar ─────────────────────────────────────────────────── #}
  <div class="idea-admin-toolbar" role="navigation" aria-label="フォーム操作">
    <div class="idea-admin-toolbar__back">
      <a href="/admin/customer-list">
        <i class="fa fa-arrow-left" aria-hidden="true"></i>
        会員一覧
      </a>
    </div>
    <div class="idea-admin-toolbar__actions">
      <button class="idea-admin-action idea-admin-action--primary" type="submit">保存</button>
    </div>
  </div>

</form>

{% endblock %}
