{% extends 'admin-base.html.twig' %}

{% set route = 'admin-member-list' %}
{% set title = 'メンバー管理' %}
{% set sub_title = 'システム設定' %}

{#
  DATA CONTRACT (src/Resource/Page/Admin/MemberList.php onGet):
    members     list<{adminId, loginId, name, authority, work, sortNo}>
    count       int   — total rows returned
    filters     {nameKeyword: string|null, limit: int, offset: int}
    csrfToken   string — CSRF token (used by per-row delete forms)

  ACTIONS (derived from #[Link] on MemberList / Member resource):
    GET  /admin/member-list                           — goMemberList (this page, search)
    GET  /admin/member                                — goMember (detail / create form)
    POST /admin/member                                — doCreateMember
    PUT  /admin/member?_method=put                    — doUpdateMember
    DELETE /admin/member?loginId=…&_method=delete     — doDeleteMember

  authority: 0=システム管理者 / 1=店舗オーナー
  work:      0=非稼働 / 1=稼働

  Projection gaps (Wave 8 slice, FLAGGED):
    authority  — bare int only; no joined mtb_authority label available
    work       — bare int only; no joined mtb_work label available

  idea-admin vocabulary:
    idea-admin-list-toolbar   result count + action strip
    idea-admin-search-bar     keyword filter form
    idea-admin-count          result count chip
    idea-admin-action         button / link affordance
    idea-admin-action--primary   primary CTA
    idea-admin-action--destructive  danger action
    idea-admin-table-wrap     overflow container for the data table
    idea-admin-table          data table
    idea-admin-table__actions action cell (right-aligned, no-wrap)
    idea-admin-icon-btn       icon-only button
    idea-admin-badge          status chip
    idea-admin-badge--public  positive / active state
    idea-admin-badge--private neutral / restricted state
    idea-admin-empty          zero-result state
#}

{% block main %}

{# ── Keyword search form (GET, safe read — no CSRF) ── #}
<form
  id="member-search-form"
  method="get"
  action="/admin/member-list"
  role="search"
  aria-label="メンバー検索"
>
  <div class="idea-admin-search-bar">
    <input
      type="search"
      name="nameKeyword"
      value="{{ filters.nameKeyword|default('') }}"
      placeholder="名前で絞り込む"
      aria-label="名前キーワード"
    >
    <button class="idea-admin-action idea-admin-action--primary" type="submit">
      <i class="fa fa-search" aria-hidden="true"></i>
      検索
    </button>
  </div>
</form>

{# ── Toolbar: result count + register action ── #}
<div class="idea-admin-list-toolbar">
  <div class="idea-admin-list-toolbar__left">
    <span class="idea-admin-count">{{ count }}件</span>
  </div>
  <div class="idea-admin-list-toolbar__right">
    <a class="idea-admin-action idea-admin-action--primary" href="/admin/member">
      <i class="fa fa-plus" aria-hidden="true"></i>
      新規登録
    </a>
  </div>
</div>

{# ── Member table / empty state ── #}
{% if count %}

  <div class="idea-admin-table-wrap">
    <table class="idea-admin-table" aria-label="メンバー一覧">
      <thead>
        <tr>
          <th scope="col">名前</th>
          <th scope="col">ログインID</th>
          <th scope="col">権限</th>
          <th scope="col">稼働</th>
          <th scope="col" class="idea-admin-table__actions"></th>
        </tr>
      </thead>
      <tbody>
        {% for member in members %}
        <tr id="member-{{ member.loginId }}">

          <td>
            <a href="/admin/member?loginId={{ member.loginId|url_encode }}">
              {{ member.name }}
            </a>
          </td>

          <td>{{ member.loginId }}</td>

          <td>
            {# authority: 0=システム管理者, 1=店舗オーナー (bare int — no joined label) #}
            {% if member.authority is same as(0) %}
              <span class="idea-admin-badge idea-admin-badge--public">システム管理者</span>
            {% elseif member.authority is same as(1) %}
              <span class="idea-admin-badge idea-admin-badge--private">店舗オーナー</span>
            {% else %}
              <span class="idea-admin-badge">—</span>
            {% endif %}
          </td>

          <td>
            {# work: 0=非稼働, 1=稼働 (bare int — no joined label) #}
            {% if member.work is same as(1) %}
              <span class="idea-admin-badge idea-admin-badge--public">稼働</span>
            {% else %}
              <span class="idea-admin-badge idea-admin-badge--discontinued">非稼働</span>
            {% endif %}
          </td>

          <td class="idea-admin-table__actions">
            <a
              class="idea-admin-icon-btn"
              href="/admin/member?loginId={{ member.loginId|url_encode }}"
              aria-label="{{ member.name }}を編集"
            >
              <i class="fa fa-pencil" aria-hidden="true"></i>
            </a>
            <button
              class="idea-admin-icon-btn idea-admin-action--destructive"
              type="button"
              aria-label="{{ member.name }}を削除"
              aria-haspopup="dialog"
              onclick="document.getElementById('delete-dialog-{{ member.loginId|e('js') }}').showModal()"
            >
              <i class="fa fa-times" aria-hidden="true"></i>
            </button>
          </td>

        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Delete confirmation dialogs (one per row) ── #}
  {% for member in members %}
  <dialog
    id="delete-dialog-{{ member.loginId }}"
    aria-labelledby="delete-title-{{ member.loginId }}"
    style="border:1px solid rgba(205,191,170,.45);border-radius:12px;padding:0;max-width:30rem;width:90%;"
  >
    <div class="idea-admin-panel__head">
      <h3 id="delete-title-{{ member.loginId }}" style="margin:0;font-size:.9rem;font-weight:700;">削除の確認</h3>
    </div>
    <div class="idea-admin-panel__body">
      <p style="margin:0;font-size:.88rem;">
        <strong>{{ member.name }}</strong> を削除しますか？この操作は元に戻せません。
      </p>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:.6rem;padding:.75rem 1rem;border-top:1px solid rgba(205,191,170,.35);">
      <button
        class="idea-admin-action"
        type="button"
        onclick="this.closest('dialog').close()"
      >キャンセル</button>
      <form
        method="post"
        action="/admin/member?loginId={{ member.loginId|url_encode }}&_method=delete"
        style="display:contents;"
      >
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
        <input type="hidden" name="mode" value="member_form">
        <button class="idea-admin-action idea-admin-action--destructive" type="submit">
          削除
        </button>
      </form>
    </div>
  </dialog>
  {% endfor %}

{% else %}

  <div class="idea-admin-empty" role="status">
    <i class="fa fa-users fa-2x" aria-hidden="true"></i>
    <p class="idea-admin-empty__title">メンバーが登録されていません</p>
    <p style="font-size:.84rem;">
      <a class="idea-admin-action idea-admin-action--primary" href="/admin/member">
        <i class="fa fa-plus" aria-hidden="true"></i>
        新規登録
      </a>
    </p>
  </div>

{% endif %}

{% endblock %}
