{#
  BeMart admin Member editor — idea-admin clean-room build.

  DATA CONTRACT (src/Resource/Page/Admin/Member.php onGet):
    adminId     string   — opaque admin identifier
    loginId     string   — login identifier (used as resource key)
    name        string   — display name
    authority   int      — 0=システム管理者 / 1=店舗オーナー
    work        int      — 0=非稼働 / 1=稼働
    sortNo      int      — display order
    csrfToken   string   — CSRF token
    form        AdminMemberForm — pre-filled renderer (HTML context only)
    message     string?  — top-level error message on rejection
    errors      object?  — field errors map on rejection

  FORM CONTRACT (src/Form/AdminMemberForm.php):
    name             text      required (create + edit)
    loginId          text      required (create only — immutable after creation)
    password         password  required (create only)
    passwordConfirm  password  required (create only)
    authority        select    0=システム管理者 / 1=店舗オーナー
      field ids: admin_member_name, admin_member_loginId,
                 admin_member_password, admin_member_passwordConfirm,
                 admin_member_authority

  ACTIONS (#[Link] on Member resource):
    POST   /admin/member                           — doCreateMember (create)
    PUT    /admin/member?_method=put               — doUpdateMember (edit, name only)
    DELETE /admin/member?loginId=…&_method=delete  — doDeleteMember (edit)
  Back: goMemberList → /admin/member-list

  CSRF: csrfToken from resource body; field name "csrfToken".
  _method tunnel: hidden input in form action query.
  mode: name="mode" value="member_form" — signals browser-form path in resource.

  MODES:
    Create (loginId empty) — single-column focused form:
      sections: アカウント情報, パスワード, 権限
    Edit (loginId set) — two-column layout:
      overview strip (adminId, current status, role, sort order)
      primary: 名前 edit form
      side:    権限 badge (read-only) + 状態 metadata + delete danger zone

  idea-admin vocabulary:
    idea-admin-layout / idea-admin-primary / idea-admin-side
    idea-admin-panel / idea-admin-panel__head / idea-admin-panel__body
    idea-admin-field / idea-admin-field__label / idea-admin-field__input
    idea-admin-required / idea-admin-error / idea-admin-notice
    idea-admin-badge (--public / --private / --discontinued)
    idea-admin-spec-list / idea-admin-spec-row
    idea-admin-action (--primary / --destructive)
    idea-admin-toolbar / idea-admin-toolbar__back / idea-admin-toolbar__actions
    idea-admin-kpi-grid / idea-admin-kpi

  Per-page additions (idea-admin-* scoped, block stylesheet):
    idea-admin-create-wrap   centered narrow shell for create mode
    idea-admin-danger-zone   destructive-action section with red border accent
#}
{% extends 'admin-base.html.twig' %}

{% set isEdit = loginId is defined and loginId is not empty %}
{% set route = 'admin-member' %}
{% set title = isEdit ? 'メンバー編集' : 'メンバー登録' %}
{% set sub_title = 'システム設定' %}

{% block stylesheet %}
<style>
/* ── per-page additions (idea-admin-* scoped) ── */
.idea-admin-create-wrap {
  max-width: 560px;
  margin: 0 auto;
  display: grid;
  gap: 1rem;
}
.idea-admin-danger-zone {
  border: 1px solid rgba(169, 71, 46, .30);
  border-radius: var(--idea-admin-radius-panel, 12px);
  background: rgba(169, 71, 46, .04);
  padding: .9rem 1rem;
  display: grid;
  gap: .65rem;
}
.idea-admin-danger-zone__label {
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #a9472e;
  margin: 0;
}
.idea-admin-danger-zone__body {
  font-size: .82rem;
  color: var(--idea-muted, #6f675c);
  margin: 0;
}
</style>
{% endblock stylesheet %}

{% block main %}

{# ── Page-level error notice ──────────────────────────────────────── #}
{% if message is defined and message %}
<div class="idea-admin-notice idea-admin-notice--error" role="alert">
  <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
  {{ message }}
</div>
{% endif %}

{# ════════════════════════════════════════════════════════════════════
   CREATE MODE — single-column focused form
   ════════════════════════════════════════════════════════════════════ #}
{% if not isEdit %}

<form
  id="member_form"
  role="form"
  method="post"
  action="/admin/member"
  novalidate
>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
  <input type="hidden" name="mode" value="member_form">

  <div class="idea-admin-create-wrap">

    {# Section: アカウント情報 #}
    <section class="idea-admin-panel" aria-labelledby="section-account">
      <div class="idea-admin-panel__head">
        <h3 id="section-account">アカウント情報</h3>
      </div>
      <div class="idea-admin-panel__body">

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="admin_member_name">表示名</label>
            <span class="idea-admin-required">必須</span>
          </div>
          <div class="idea-admin-field__input">
            {{ form.input('name')|raw }}
            {% if form.error('name') %}
            <span class="idea-admin-error" role="alert">{{ form.error('name') }}</span>
            {% endif %}
          </div>
        </div>

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="admin_member_loginId">ログインID</label>
            <span class="idea-admin-required">必須</span>
          </div>
          <div class="idea-admin-field__input">
            {{ form.input('loginId')|raw }}
            {% if form.error('loginId') %}
            <span class="idea-admin-error" role="alert">{{ form.error('loginId') }}</span>
            {% endif %}
          </div>
        </div>

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="admin_member_authority">権限</label>
            <span class="idea-admin-required">必須</span>
          </div>
          <div class="idea-admin-field__input">
            {{ form.input('authority')|raw }}
            {% if form.error('authority') %}
            <span class="idea-admin-error" role="alert">{{ form.error('authority') }}</span>
            {% endif %}
          </div>
        </div>

      </div>
    </section>

    {# Section: パスワード (create only) #}
    <section class="idea-admin-panel" aria-labelledby="section-password">
      <div class="idea-admin-panel__head">
        <h3 id="section-password">パスワード</h3>
      </div>
      <div class="idea-admin-panel__body">

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="admin_member_password">パスワード</label>
            <span class="idea-admin-required">必須</span>
          </div>
          <div class="idea-admin-field__input">
            {{ form.input('password')|raw }}
            {% if form.error('password') %}
            <span class="idea-admin-error" role="alert">{{ form.error('password') }}</span>
            {% endif %}
          </div>
        </div>

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="admin_member_passwordConfirm">確認用</label>
            <span class="idea-admin-required">必須</span>
          </div>
          <div class="idea-admin-field__input">
            {{ form.input('passwordConfirm')|raw }}
            {% if form.error('passwordConfirm') %}
            <span class="idea-admin-error" role="alert">{{ form.error('passwordConfirm') }}</span>
            {% endif %}
          </div>
        </div>

      </div>
    </section>

  </div>{# .idea-admin-create-wrap #}

  <div class="idea-admin-toolbar" role="navigation" aria-label="フォーム操作">
    <div class="idea-admin-toolbar__back">
      <a href="/admin/member-list">
        <i class="fa fa-arrow-left" aria-hidden="true"></i>
        メンバー一覧
      </a>
    </div>
    <div class="idea-admin-toolbar__actions">
      <button class="idea-admin-action idea-admin-action--primary" type="submit">
        <i class="fa fa-user-plus" aria-hidden="true"></i>
        登録
      </button>
    </div>
  </div>

</form>

{# ════════════════════════════════════════════════════════════════════
   EDIT MODE — two-column layout with identity overview
   ════════════════════════════════════════════════════════════════════ #}
{% else %}

{# Overview KPI strip — read-only identity at a glance #}
<div class="idea-admin-kpi-grid" aria-label="管理者サマリ">
  <div class="idea-admin-kpi">
    <div class="idea-admin-kpi__label">ログインID</div>
    <div class="idea-admin-kpi__value" style="font-size:1rem;word-break:break-all;">{{ loginId }}</div>
  </div>
  <div class="idea-admin-kpi">
    <div class="idea-admin-kpi__label">権限</div>
    <div class="idea-admin-kpi__value" style="font-size:1rem;">
      {% if authority is same as(0) %}
        <span class="idea-admin-badge idea-admin-badge--public">システム管理者</span>
      {% else %}
        <span class="idea-admin-badge idea-admin-badge--private">店舗オーナー</span>
      {% endif %}
    </div>
  </div>
  <div class="idea-admin-kpi">
    <div class="idea-admin-kpi__label">稼働状態</div>
    <div class="idea-admin-kpi__value" style="font-size:1rem;">
      {% if work is same as(1) %}
        <span class="idea-admin-badge idea-admin-badge--public">稼働</span>
      {% else %}
        <span class="idea-admin-badge idea-admin-badge--discontinued">非稼働</span>
      {% endif %}
    </div>
  </div>
  <div class="idea-admin-kpi">
    <div class="idea-admin-kpi__label">表示順</div>
    <div class="idea-admin-kpi__value">{{ sortNo }}</div>
  </div>
</div>

<form
  id="member_form"
  role="form"
  method="post"
  action="/admin/member?_method=put"
  novalidate
>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
  <input type="hidden" name="mode" value="member_form">
  <input type="hidden" name="loginId" value="{{ loginId }}">

  <div class="idea-admin-layout">

    {# ── Primary column ────────────────────────────────────────────── #}
    <div class="idea-admin-primary">

      {# Section: 表示名 (the only mutable field on PUT) #}
      <section class="idea-admin-panel" aria-labelledby="section-name">
        <div class="idea-admin-panel__head">
          <h3 id="section-name">表示名</h3>
          <p class="idea-admin-panel__hint">管理画面上に表示される名前。</p>
        </div>
        <div class="idea-admin-panel__body">

          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_member_name">名前</label>
              <span class="idea-admin-required">必須</span>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('name')|raw }}
              {% if form.error('name') %}
              <span class="idea-admin-error" role="alert">{{ form.error('name') }}</span>
              {% endif %}
            </div>
          </div>

        </div>
      </section>

    </div>

    {# ── Side panel ────────────────────────────────────────────────── #}
    <aside class="idea-admin-side" aria-label="権限・削除">

      {# Section: 権限 (read-only on edit — role changes via dedicated flow) #}
      <section class="idea-admin-panel" aria-labelledby="section-authority">
        <div class="idea-admin-panel__head">
          <h3 id="section-authority">権限</h3>
        </div>
        <div class="idea-admin-panel__body">
          <dl class="idea-admin-spec-list">
            <div class="idea-admin-spec-row">
              <dt>ロール</dt>
              <dd>
                {% if authority is same as(0) %}
                  <span class="idea-admin-badge idea-admin-badge--public">システム管理者</span>
                {% else %}
                  <span class="idea-admin-badge idea-admin-badge--private">店舗オーナー</span>
                {% endif %}
              </dd>
            </div>
            <div class="idea-admin-spec-row">
              <dt>管理者ID</dt>
              <dd style="font-size:.76rem;word-break:break-all;color:var(--idea-muted);">{{ adminId }}</dd>
            </div>
          </dl>
        </div>
      </section>

      {# Section: 削除 — danger zone #}
      <section class="idea-admin-panel" aria-labelledby="section-danger">
        <div class="idea-admin-panel__head">
          <h3 id="section-danger" style="color:#a9472e;">削除</h3>
        </div>
        <div class="idea-admin-panel__body">
          <div class="idea-admin-danger-zone">
            <p class="idea-admin-danger-zone__label">危険な操作</p>
            <p class="idea-admin-danger-zone__body">
              このメンバーを削除すると元に戻せません。
            </p>
            <button
              class="idea-admin-action idea-admin-action--destructive"
              type="button"
              id="member-delete-btn"
            >
              <i class="fa fa-trash" aria-hidden="true"></i>
              削除
            </button>
          </div>
        </div>
      </section>

    </aside>

  </div>

  {# ── Action toolbar ────────────────────────────────────────────── #}
  <div class="idea-admin-toolbar" role="navigation" aria-label="フォーム操作">
    <div class="idea-admin-toolbar__back">
      <a href="/admin/member-list">
        <i class="fa fa-arrow-left" aria-hidden="true"></i>
        メンバー一覧
      </a>
    </div>
    <div class="idea-admin-toolbar__actions">
      <button class="idea-admin-action idea-admin-action--primary" type="submit">
        <i class="fa fa-save" aria-hidden="true"></i>
        保存
      </button>
    </div>
  </div>

</form>

{# Delete affordance — separate form; submitted via JS confirm dialog #}
<form
  id="member-delete-form"
  method="post"
  action="/admin/member?loginId={{ loginId|url_encode }}&_method=delete"
  aria-hidden="true"
>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
  <input type="hidden" name="loginId" value="{{ loginId }}">
  <input type="hidden" name="mode" value="member_form">
</form>

{% endif %}{# isEdit #}

{% endblock %}

{% block javascript %}
{% if isEdit %}
<script>
(function () {
  'use strict';
  var btn = document.getElementById('member-delete-btn');
  if (!btn) { return; }
  btn.addEventListener('click', function () {
    if (window.confirm('「{{ name|escape('js') }}」を削除してもよいですか？この操作は取り消せません。')) {
      document.getElementById('member-delete-form').submit();
    }
  });
}());
</script>
{% endif %}
{% endblock javascript %}
