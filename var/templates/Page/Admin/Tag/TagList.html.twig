{% extends 'admin-base.html.twig' %}
{#
  BeMart admin Tag list — clean-room rebuild.

  DATA CONTRACT (src/Resource/Page/Admin/Tag/TagList.php onGet):
    count   int                             — total tag count
    tags    list<{tagId: string, tagName: string}>
    form    AdminTagForm                    — inline-create input (tagName field)

  FORM CONTRACT (src/Form/AdminTagForm.php):
    fields: tagName (text, id=admin_tag_name)

  ACTIONS (derived from #[Link] annotations on the resource):
    POST   /admin/tag/tag-list              — doCreateTag
    DELETE /admin/tag/tag?tagId={id}       — doDeleteTag (via JS-driven confirm dialog)

  CSRF: csrfToken hidden input; no doUpdateTag declared in ALPS.

  IdeaStore admin design vocabulary (idea-admin-*):
    idea-admin-panel         card section
    idea-admin-panel__head   section header
    idea-admin-panel__body   section content
    idea-admin-field         label + input row
    idea-admin-required      required badge
    idea-admin-error         validation error text
    idea-admin-table-wrap    responsive table container
    idea-admin-table         data table
    idea-admin-action        button/link affordance
    idea-admin-icon-btn      compact icon-only button
    idea-admin-count         record count chip
    idea-admin-list-toolbar  top-of-list toolbar (left/right slots)
    idea-admin-empty         zero-state block
#}

{% set route = 'admin-tag-tag-list' %}
{% set title = 'タグ管理' %}
{% set sub_title = '商品管理' %}

{% block javascript %}
<script>
(function () {
    'use strict';

    /* ── Sort-order helpers ──────────────────────────────────────────── */
    var oldSortNos = [];
    document.querySelectorAll('[data-tag-id]').forEach(function (row) {
        oldSortNos.push(parseInt(row.dataset.sortNo || '0', 10));
    });
    oldSortNos.sort(function (a, b) { return b - a; });

    function pushSortNos() {
        var payload = {};
        var i = 0;
        document.querySelectorAll('[data-tag-id]').forEach(function (row) {
            payload[row.dataset.tagId] = oldSortNos[i];
            i++;
        });
        fetch('/admin/sort-no-move?masterType=tag&_method=put', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(payload).toString()
        }).finally(function () {
            redrawArrows();
        });
    }

    function redrawArrows() {
        var rows = document.querySelectorAll('[data-tag-id]');
        rows.forEach(function (row) {
            row.querySelector('.js-move-up').removeAttribute('disabled');
            row.querySelector('.js-move-down').removeAttribute('disabled');
        });
        if (rows.length > 0) {
            rows[0].querySelector('.js-move-up').setAttribute('disabled', '');
            rows[rows.length - 1].querySelector('.js-move-down').setAttribute('disabled', '');
        }
    }

    /* ── Up / Down buttons ───────────────────────────────────────────── */
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.js-move-up, .js-move-down');
        if (!btn) return;
        e.preventDefault();
        var row = btn.closest('[data-tag-id]');
        if (!row) return;
        if (btn.classList.contains('js-move-up') && row.previousElementSibling) {
            row.parentNode.insertBefore(row, row.previousElementSibling);
            pushSortNos();
        } else if (btn.classList.contains('js-move-down') && row.nextElementSibling) {
            row.parentNode.insertBefore(row.nextElementSibling, row);
            pushSortNos();
        }
    });

    /* ── Delete confirmation dialog ──────────────────────────────────── */
    var dialog = document.getElementById('js-delete-dialog');
    var dialogMsg = dialog ? dialog.querySelector('.js-dialog-message') : null;
    var dialogConfirm = dialog ? dialog.querySelector('.js-dialog-confirm') : null;

    document.addEventListener('click', function (e) {
        var trigger = e.target.closest('[data-delete-url]');
        if (!trigger || !dialog) return;
        e.preventDefault();
        if (dialogMsg) dialogMsg.textContent = trigger.dataset.deleteMessage || '';
        if (dialogConfirm) dialogConfirm.href = trigger.dataset.deleteUrl;
        dialog.removeAttribute('hidden');
        dialog.setAttribute('aria-modal', 'true');
        if (dialogConfirm) dialogConfirm.focus();
    });

    document.addEventListener('click', function (e) {
        if (!dialog) return;
        if (e.target.closest('.js-dialog-cancel') || e.target === dialog) {
            dialog.setAttribute('hidden', '');
            dialog.removeAttribute('aria-modal');
        }
    });

    document.addEventListener('keydown', function (e) {
        if (!dialog || dialog.hasAttribute('hidden')) return;
        if (e.key === 'Escape') {
            dialog.setAttribute('hidden', '');
            dialog.removeAttribute('aria-modal');
        }
    });

    redrawArrows();
}());
</script>
{% endblock %}

{% block main %}

{# ── Count toolbar ──────────────────────────────────────────────────────── #}
<div class="idea-admin-list-toolbar">
    <div class="idea-admin-list-toolbar__left">
        <span class="idea-admin-count">{{ count }} 件</span>
    </div>
</div>

{# ── Inline-create form ─────────────────────────────────────────────────── #}
<section class="idea-admin-panel" aria-labelledby="section-create-tag">
    <div class="idea-admin-panel__head">
        <h3 id="section-create-tag">新規タグ登録</h3>
    </div>
    <div class="idea-admin-panel__body">
        <form
            role="form"
            method="post"
            action="/admin/tag/tag-list"
            aria-label="タグ新規登録フォーム"
        >
            <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
            <div class="idea-admin-field">
                <div class="idea-admin-field__label">
                    <label for="admin_tag_name">タグ名</label>
                    <span class="idea-admin-required">必須</span>
                </div>
                <div class="idea-admin-field__input">
                    {{ form.input('tagName')|raw }}
                    {% if form.error('tagName') %}
                        <span class="idea-admin-error">{{ form.error('tagName') }}</span>
                    {% endif %}
                </div>
            </div>
            <div style="margin-top:.75rem; text-align:right;">
                <button class="idea-admin-action idea-admin-action--primary" type="submit">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    登録
                </button>
            </div>
        </form>
    </div>
</section>

{# ── Tag list ───────────────────────────────────────────────────────────── #}
{% if tags is empty %}
    <div class="idea-admin-empty">
        <span class="idea-admin-empty__title">タグが登録されていません</span>
        <p>上のフォームから新しいタグを登録してください。</p>
    </div>
{% else %}
    <div class="idea-admin-table-wrap" style="margin-top:1rem;">
        <table class="idea-admin-table" aria-label="タグ一覧">
            <thead>
                <tr>
                    <th scope="col" style="width:2.5rem;"></th>
                    <th scope="col" style="width:5rem;">ID</th>
                    <th scope="col">タグ名</th>
                    <th scope="col" class="idea-admin-table__actions">操作</th>
                </tr>
            </thead>
            <tbody id="js-tag-list">
                {% for Tag in tags %}
                <tr data-tag-id="{{ Tag.tagId }}" data-sort-no="">
                    <td style="cursor:move; color:var(--idea-muted); text-align:center;">
                        <i class="fa fa-bars" aria-hidden="true"></i>
                    </td>
                    <td>{{ Tag.tagId }}</td>
                    <td>{{ Tag.tagName }}</td>
                    <td class="idea-admin-table__actions">
                        <button
                            class="idea-admin-icon-btn js-move-up"
                            type="button"
                            title="上へ"
                            aria-label="{{ Tag.tagName }} を上へ移動"
                        ><i class="fa fa-arrow-up" aria-hidden="true"></i></button>
                        <button
                            class="idea-admin-icon-btn js-move-down"
                            type="button"
                            title="下へ"
                            aria-label="{{ Tag.tagName }} を下へ移動"
                        ><i class="fa fa-arrow-down" aria-hidden="true"></i></button>
                        <a
                            class="idea-admin-icon-btn idea-admin-text-btn--danger"
                            href="#"
                            data-delete-url="/admin/tag/tag?tagId={{ Tag.tagId }}"
                            data-delete-message="{{ Tag.tagName }} を削除してよろしいですか？"
                            aria-label="{{ Tag.tagName }} を削除"
                            title="削除"
                        ><i class="fa fa-trash" aria-hidden="true"></i></a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p style="margin-top:.6rem; color:var(--idea-muted); font-size:.8rem;">
        <i class="fa fa-info-circle" aria-hidden="true"></i>
        行をドラッグして並び順を変更できます。
    </p>
{% endif %}

{# ── Delete confirmation dialog ─────────────────────────────────────────── #}
<div
    id="js-delete-dialog"
    role="dialog"
    aria-labelledby="js-delete-dialog-title"
    hidden
    style="
        position:fixed; inset:0; z-index:200;
        display:flex; align-items:center; justify-content:center;
        background:rgba(41,37,31,.45);
    "
>
    <div class="idea-admin-panel" style="max-width:420px; width:92%; padding:0; overflow:hidden;">
        <div class="idea-admin-panel__head">
            <h3 id="js-delete-dialog-title" style="color:#a9472e;">
                <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                削除の確認
            </h3>
        </div>
        <div class="idea-admin-panel__body">
            <p class="js-dialog-message" style="margin:0;"></p>
        </div>
        <div style="
            display:flex; justify-content:flex-end; gap:.6rem;
            padding:.75rem 1rem;
            border-top:1px solid rgba(205,191,170,.4);
        ">
            <button
                class="idea-admin-action js-dialog-cancel"
                type="button"
            >キャンセル</button>
            <a
                class="idea-admin-action idea-admin-action--destructive js-dialog-confirm"
                href="#"
                data-method="delete"
            >
                <i class="fa fa-trash" aria-hidden="true"></i>
                削除する
            </a>
        </div>
    </div>
</div>

{% endblock %}
