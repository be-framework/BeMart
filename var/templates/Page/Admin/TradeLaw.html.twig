{#
  BeMart admin trade-law settings — EC-CUBE Setting/Shop/tradelaw.twig.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-trade-law' %}
{% set title = '特定商取引法設定' %}
{% set sub_title = '店舗設定' %}

{% block main %}
    <form method="post" action="/admin/trade-law">
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default(csrf_token()) }}">
        <input type="hidden" name="mode" value="trade_law_form">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="d-inline-block">
                                <span>特定商取引法設定</span>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <table class="table tabel-sm">
                                <thead>
                                <tr>
                                    <th class="align-middle text-center" width="600">
                                        <span>名称</span>
                                    </th>
                                    <th class="align-middle text-center">
                                        <span>説明</span>
                                    </th>
                                    <th class="align-middle text-center" width="300">
                                        <span>注文確認画面に表示</span>
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for TradeLaw in tradeLawRows %}
                                    <tr id="tradeLawRow_{{ loop.index }}">
                                        <td class="align-middle" width="600">
                                            {{ form.input(TradeLaw.nameKey)|raw }}
                                            {% if form.error(TradeLaw.nameKey) %}{{ form.error(TradeLaw.nameKey) }}{% endif %}
                                        </td>
                                        <td class="align-middle">
                                            {{ form.input(TradeLaw.descriptionKey)|raw }}
                                            {% if form.error(TradeLaw.descriptionKey) %}{{ form.error(TradeLaw.descriptionKey) }}{% endif %}
                                        </td>
                                        <td class="align-middle text-center" width="300">
                                            {{ form.input(TradeLaw.displayOrderScreenKey)|raw }}
                                            {% if form.error(TradeLaw.displayOrderScreenKey) %}{{ form.error(TradeLaw.displayOrderScreenKey) }}{% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="c-conversionArea">
                        <div class="c-conversionArea__container">
                            <div class="row justify-content-between align-items-center">
                                <div class="col-6">
                                    <div class="c-conversionArea__leftBlockItem"></div>
                                </div>
                                <div class="col-6">
                                    <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                                        <div class="col-auto">
                                            <button class="btn btn-ec-conversion px-5" type="submit">保存</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
