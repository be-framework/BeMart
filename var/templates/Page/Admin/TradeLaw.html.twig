{#
  BeMart admin — 特定商取引法設定 (doUpdateTradeLaw / goTradeLawList)

  DATA CONTRACT  src/Resource/Page/Admin/TradeLaw.php  onGet
  ─────────────────────────────────────────────────────────────
  tradeLawRows   list<{id, name, description, displayOrderScreen,
                        nameKey, descriptionKey, displayOrderScreenKey}>
  tradeLawBody   string         raw blob (read-only reference)
  csrfToken      string         required
  form           AdminTradeLawForm  (form.input / form.error)
  changed        bool|null      present after POST redirect; null on GET
  message        string|null    error message (403 / 400)

  FORM FIELDS  src/Form/AdminTradeLawForm.php
  ─────────────────────────────────────────────────────────────
  trade_law_{1-6}_name                 text
  trade_law_{1-6}_description          textarea  rows=3
  trade_law_{1-6}_displayOrderScreen   checkbox  value="1"
  (field names carried per-row in row.nameKey / row.descriptionKey / row.displayOrderScreenKey)

  ACTION
  ─────────────────────────────────────────────────────────────
  POST /admin/trade-law   doUpdateTradeLaw  (CsrfProtected, mode=trade_law_form)
    → 303 redirect to /admin/trade-law

  LINKS (from #[Link] annotations)
  ─────────────────────────────────────────────────────────────
  goTop          /admin
  goContentCss   /admin/content/css

  idea-admin vocabulary
  ─────────────────────────────────────────────────────────────
  idea-admin-layout         two-column editor (primary + side)
  idea-admin-primary        primary column
  idea-admin-side           sticky side column
  idea-admin-panel          card container
  idea-admin-panel__head    card heading strip
  idea-admin-panel__body    card content area
  idea-admin-field          label + input row (9rem label / 1fr input)
  idea-admin-field__label   label cell
  idea-admin-field__input   input cell + error slot
  idea-admin-error          inline validation message
  idea-admin-notice         page-level status strip
  idea-admin-toolbar        fixed bottom action bar
  idea-admin-toolbar__back  back-nav slot
  idea-admin-toolbar__actions  submit cluster
  idea-admin-action         button / link affordance
  idea-admin-action--primary   primary CTA style
  idea-admin-badge          status chip
  idea-admin-badge--public  shown-on-checkout variant
  idea-admin-badge--private hidden-from-checkout variant
  idea-admin-spec-list / idea-admin-spec-row  read-only key/value rows
#}
{% extends 'admin-base.html.twig' %}

{% set route     = 'admin-trade-law' %}
{% set title     = '特定商取引法設定' %}
{% set sub_title = '設定' %}

{% block stylesheet %}
<style>
/* ── Per-row item card ─────────────────────────────────────────────── */
.idea-admin-tradelaw-card {
  display: grid;
  grid-template-columns: 2rem 1fr;
  gap: 0 .85rem;
  align-items: start;
  padding: .85rem 1rem;
  border-bottom: 1px solid rgba(205, 191, 170, .28);
}
.idea-admin-tradelaw-card:last-child {
  border-bottom: none;
}
.idea-admin-tradelaw-card__index {
  padding-top: .6rem;
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .05em;
  color: var(--idea-stone-2);
  text-transform: uppercase;
  text-align: center;
}
.idea-admin-tradelaw-card__fields {
  display: grid;
  gap: .55rem;
}

/* name field — short, single-line */
.idea-admin-tradelaw-card__name {
  display: grid;
  grid-template-columns: 7rem 1fr;
  gap: .5rem;
  align-items: center;
}
.idea-admin-tradelaw-card__name label {
  font-size: .82rem;
  font-weight: 700;
  color: var(--idea-muted);
}

/* description field — textarea, full width */
.idea-admin-tradelaw-card__desc {
  display: grid;
  grid-template-columns: 7rem 1fr;
  gap: .5rem;
  align-items: start;
}
.idea-admin-tradelaw-card__desc label {
  padding-top: .5rem;
  font-size: .82rem;
  font-weight: 700;
  color: var(--idea-muted);
}

/* visibility toggle row */
.idea-admin-tradelaw-card__toggle {
  display: flex;
  align-items: center;
  gap: .55rem;
  padding-left: 7.5rem;
}
.idea-admin-tradelaw-card__toggle label {
  font-size: .82rem;
  font-weight: 700;
  color: var(--idea-ink);
  cursor: pointer;
}

/* checkbox styling */
.idea-admin-tradelaw-checkbox {
  accent-color: var(--idea-olive);
  width: 1rem;
  height: 1rem;
  cursor: pointer;
  flex-shrink: 0;
}

/* input / textarea inside the card (not wrapped in idea-admin-field) */
.idea-admin-tradelaw-card__fields input[type="text"],
.idea-admin-tradelaw-card__fields textarea {
  width: 100%;
  border: 1px solid var(--idea-stone);
  border-radius: var(--idea-admin-radius-input);
  background: rgba(255, 253, 248, .95);
  color: var(--idea-ink);
  font: inherit;
  font-size: .88rem;
  padding: .4rem .65rem;
  outline: none;
  transition: border-color .15s, box-shadow .15s;
}
.idea-admin-tradelaw-card__fields input[type="text"] {
  min-height: 2.2rem;
}
.idea-admin-tradelaw-card__fields textarea {
  min-height: 5rem;
  resize: vertical;
}
.idea-admin-tradelaw-card__fields input:focus,
.idea-admin-tradelaw-card__fields textarea:focus {
  border-color: var(--idea-olive);
  box-shadow: 0 0 0 3px rgba(82, 107, 85, .15);
}

/* side panel: live badge per row */
.idea-admin-tradelaw-summary {
  display: grid;
  gap: .45rem;
}
.idea-admin-tradelaw-summary__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: .5rem;
  padding: .4rem 0;
  border-bottom: 1px solid rgba(205, 191, 170, .28);
  font-size: .82rem;
}
.idea-admin-tradelaw-summary__row:last-child {
  border-bottom: none;
}
.idea-admin-tradelaw-summary__name {
  font-weight: 700;
  color: var(--idea-ink);
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
</style>
{% endblock %}

{% block main %}
<form
  id="trade_law_form"
  role="form"
  method="post"
  action="/admin/trade-law"
  novalidate
>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
  <input type="hidden" name="mode" value="trade_law_form">

  {# ── Page-level notices ──────────────────────────────────────── #}
  {% if changed is defined and changed == false %}
  <div class="idea-admin-notice" role="status" aria-live="polite">
    <i class="fa fa-check-circle" aria-hidden="true"></i>
    変更はありませんでした（保存済みの内容と同一です）。
  </div>
  {% endif %}

  {% if changed is defined and changed == true %}
  <div class="idea-admin-notice" role="status" aria-live="polite">
    <i class="fa fa-check-circle" aria-hidden="true"></i>
    特定商取引法の設定を保存しました。
  </div>
  {% endif %}

  {% if message is defined and message %}
  <div class="idea-admin-notice idea-admin-notice--error" role="alert">
    <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
    {{ message }}
  </div>
  {% endif %}

  <div class="idea-admin-layout">

    {# ════════════════════════════════════════════════════════════
       Primary column — item cards
    ════════════════════════════════════════════════════════════ #}
    <div class="idea-admin-primary">

      <section class="idea-admin-panel" aria-labelledby="section-tradelaw-items">
        <div class="idea-admin-panel__head">
          <h3 id="section-tradelaw-items">
            <i class="fa fa-balance-scale fa-fw" aria-hidden="true"></i>
            開示項目
          </h3>
          <p class="idea-admin-panel__hint">
            購入フロー（注文確認画面）に表示する法定開示項目を編集します。
          </p>
        </div>

        {# ── Item rows ────────────────────────────────────────── #}
        {% if tradeLawRows is not empty %}
          {% for row in tradeLawRows %}
          <div class="idea-admin-tradelaw-card"
               data-row-index="{{ row.id }}"
               aria-label="項目 {{ row.id }}">

            <div class="idea-admin-tradelaw-card__index"
                 aria-hidden="true">{{ row.id }}</div>

            <div class="idea-admin-tradelaw-card__fields">

              {# name #}
              <div class="idea-admin-tradelaw-card__name">
                <label for="{{ row.nameKey|replace({'_': '-'}) }}-label">項目名</label>
                <div>
                  {{ form.input(row.nameKey)|raw }}
                  {% if form.error(row.nameKey) %}
                  <span class="idea-admin-error" role="alert">
                    {{ form.error(row.nameKey) }}
                  </span>
                  {% endif %}
                </div>
              </div>

              {# description #}
              <div class="idea-admin-tradelaw-card__desc">
                <label for="{{ row.descriptionKey|replace({'_': '-'}) }}-label">説明内容</label>
                <div>
                  {{ form.input(row.descriptionKey)|raw }}
                  {% if form.error(row.descriptionKey) %}
                  <span class="idea-admin-error" role="alert">
                    {{ form.error(row.descriptionKey) }}
                  </span>
                  {% endif %}
                </div>
              </div>

              {# displayOrderScreen toggle #}
              <div class="idea-admin-tradelaw-card__toggle">
                {{ form.input(row.displayOrderScreenKey)|raw }}
                <label>注文確認画面に表示する</label>
                {% if form.error(row.displayOrderScreenKey) %}
                <span class="idea-admin-error" role="alert">
                  {{ form.error(row.displayOrderScreenKey) }}
                </span>
                {% endif %}
              </div>

            </div>
          </div>
          {% endfor %}
        {% else %}
          <div class="idea-admin-panel__body">
            <div class="idea-admin-empty">
              <i class="fa fa-inbox fa-2x" aria-hidden="true"></i>
              <p class="idea-admin-empty__title">開示項目がまだ登録されていません。</p>
            </div>
          </div>
        {% endif %}

      </section>

    </div>

    {# ════════════════════════════════════════════════════════════
       Side panel — summary + related links
    ════════════════════════════════════════════════════════════ #}
    <aside class="idea-admin-side" aria-label="設定状況サマリー">

      {# Live status summary: one badge per row showing visibility #}
      <section class="idea-admin-panel" aria-labelledby="section-summary">
        <div class="idea-admin-panel__head">
          <h3 id="section-summary">
            <i class="fa fa-list-check fa-fw" aria-hidden="true"></i>
            表示状況
          </h3>
        </div>
        <div class="idea-admin-panel__body">
          {% if tradeLawRows is not empty %}
          <div class="idea-admin-tradelaw-summary" id="tradelaw-summary">
            {% for row in tradeLawRows %}
            <div class="idea-admin-tradelaw-summary__row"
                 id="summary-row-{{ row.id }}">
              <span class="idea-admin-tradelaw-summary__name"
                    id="summary-name-{{ row.id }}">
                {{ row.name|default('（名称未設定）') }}
              </span>
              <span class="idea-admin-badge {{ row.displayOrderScreen ? 'idea-admin-badge--public' : 'idea-admin-badge--private' }}"
                    id="summary-badge-{{ row.id }}">
                {{ row.displayOrderScreen ? '表示' : '非表示' }}
              </span>
            </div>
            {% endfor %}
          </div>
          {% else %}
          <p style="font-size:.82rem;color:var(--idea-muted);">項目がありません。</p>
          {% endif %}
        </div>
      </section>

      {# Related navigation #}
      <section class="idea-admin-panel" aria-labelledby="section-related">
        <div class="idea-admin-panel__head">
          <h3 id="section-related">
            <i class="fa fa-link fa-fw" aria-hidden="true"></i>
            関連リンク
          </h3>
        </div>
        <div class="idea-admin-panel__body">
          <nav aria-label="関連ページ" style="display:grid;gap:.5rem;">
            <a class="idea-admin-action" href="/admin/index">
              <i class="fa fa-home fa-fw" aria-hidden="true"></i>
              ダッシュボード
            </a>
            <a class="idea-admin-action" href="/admin/content/css">
              <i class="fa fa-code fa-fw" aria-hidden="true"></i>
              CSS 管理
            </a>
            <a class="idea-admin-action" href="/help/trade-law" target="_blank" rel="noopener">
              <i class="fa fa-eye fa-fw" aria-hidden="true"></i>
              公開ページを確認
              <i class="fa fa-external-link-alt fa-xs" aria-hidden="true"></i>
            </a>
          </nav>
        </div>
      </section>

    </aside>

  </div>

  {# ── Action toolbar ──────────────────────────────────────────── #}
  <div class="idea-admin-toolbar" role="navigation" aria-label="フォーム操作">
    <div class="idea-admin-toolbar__back">
      <a href="/admin/index">
        <i class="fa fa-backward" aria-hidden="true"></i>
        ダッシュボードに戻る
      </a>
    </div>
    <div class="idea-admin-toolbar__actions">
      <button class="idea-admin-action idea-admin-action--primary" type="submit">
        <i class="fa fa-save" aria-hidden="true"></i>
        設定を保存
      </button>
    </div>
  </div>

</form>
{% endblock %}

{% block javascript %}
<script>
(function () {
  'use strict';

  /**
   * Live side-panel sync:
   * - Mirror the name input text into summary-name-{n} as the user types.
   * - Toggle the badge class and text when the visibility checkbox changes.
   *
   * Reads the row index from data-row-index on each card container.
   */
  document.querySelectorAll('.idea-admin-tradelaw-card').forEach(function (card) {
    var rowId = card.getAttribute('data-row-index');
    if (!rowId) return;

    var summaryName  = document.getElementById('summary-name-'  + rowId);
    var summaryBadge = document.getElementById('summary-badge-' + rowId);

    /* name input: first input[type=text] inside the card */
    var nameInput = card.querySelector('input[type="text"]');
    if (nameInput && summaryName) {
      nameInput.addEventListener('input', function () {
        summaryName.textContent = nameInput.value || '（名称未設定）';
      });
    }

    /* checkbox: the displayOrderScreen field */
    var checkbox = card.querySelector('input[type="checkbox"]');
    if (checkbox && summaryBadge) {
      checkbox.addEventListener('change', function () {
        var visible = checkbox.checked;
        summaryBadge.textContent = visible ? '表示' : '非表示';
        summaryBadge.className   = 'idea-admin-badge ' +
          (visible ? 'idea-admin-badge--public' : 'idea-admin-badge--private');
      });
    }
  });
}());
</script>
{% endblock %}
