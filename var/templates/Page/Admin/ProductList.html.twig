{% extends 'admin-base.html.twig' %}

{% set route = 'admin-product' %}
{% set title = '商品一覧' %}
{% set sub_title = '商品管理' %}

{% block javascript %}
<script>
(function () {
    /* ── Bulk-select toggle ── */
    function syncBulkBar() {
        var checked = document.querySelectorAll('input[id^="check_"]:checked');
        var bar = document.getElementById('bulk-bar');
        if (bar) { bar.hidden = checked.length === 0; }
    }

    var checkAll = document.getElementById('trigger_check_all');
    if (checkAll) {
        checkAll.addEventListener('change', function () {
            document.querySelectorAll('input[id^="check_"]').forEach(function (cb) {
                cb.checked = checkAll.checked;
            });
            syncBulkBar();
        });
    }

    document.querySelectorAll('input[id^="check_"]').forEach(function (cb) {
        cb.addEventListener('change', function () {
            if (checkAll) { checkAll.checked = false; }
            syncBulkBar();
        });
    });

    /* ── Bulk status submit ── */
    document.querySelectorAll('.action-submit').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var form = document.getElementById('form_bulk');
            if (!form) { return; }
            var checked = form.querySelectorAll('input:checkbox[name^="productCodes"]:checked');
            if (!checked.length) { alert('please check'); return; }

            var csrfInput = document.createElement('input');
            csrfInput.type = 'hidden';
            csrfInput.name = 'csrfToken';
            csrfInput.value = btn.getAttribute('token-for-anchor');
            form.appendChild(csrfInput);

            var statusInput = document.createElement('input');
            statusInput.type = 'hidden';
            statusInput.name = 'productStatus';
            statusInput.value = btn.dataset.productStatus;
            form.appendChild(statusInput);

            form.action = btn.dataset.action;
            form.submit();
        });
    });

    /* ── Bulk delete modal ── */
    var bulkDeleteBtn = document.getElementById('bulkDelete');
    var bulkDeleteDone = document.getElementById('bulkDeleteDone');
    if (bulkDeleteBtn) {
        bulkDeleteBtn.addEventListener('click', function () {
            var modal = document.getElementById('bulkDeleteModal');
            var btns = modal.querySelectorAll('button');
            var bodyP = modal.querySelector('.idea-admin-dialog__body p');
            var progress = modal.querySelector('.idea-admin-progress');
            var bar = modal.querySelector('.idea-admin-progress__bar');

            btns.forEach(function (b) { b.disabled = true; });
            if (bodyP) { bodyP.textContent = '削除中...'; }
            if (progress) { progress.hidden = false; }

            var checkedList = document.querySelectorAll('input[type=checkbox][data-delete-url]:checked');
            var total = checkedList.length;
            var done = 0;

            var promises = Array.from(checkedList).map(function (cb) {
                return fetch(cb.dataset.deleteUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'csrfToken=' + encodeURIComponent(cb.getAttribute('token-for-anchor')),
                }).then(function (r) { return r.json(); }).finally(function () {
                    done++;
                    if (bar) { bar.style.width = (done / total * 100) + '%'; }
                });
            });

            Promise.allSettled(promises).then(function (results) {
                results.forEach(function (r) {
                    if (r.status === 'fulfilled' && r.value && r.value.success === false) {
                        var li = document.createElement('li');
                        li.textContent = r.value.message || 'エラー';
                        document.getElementById('bulkErrors').appendChild(li);
                    }
                });
                if (progress) { progress.hidden = true; }
                if (bodyP) { bodyP.textContent = '削除処理が完了しました'; }
                btns.forEach(function (b) { b.disabled = false; });
                if (bulkDeleteBtn) { bulkDeleteBtn.hidden = true; }
                if (bulkDeleteDone) { bulkDeleteDone.hidden = false; }
            });
        });
    }

    if (bulkDeleteDone) {
        bulkDeleteDone.addEventListener('click', function () {
            location.reload(true);
        });
    }
}());
</script>
{% endblock javascript %}

{% block main %}

{# ── Search form ── #}
<form id="search_form" method="get" action="/admin/product-list">
    <div class="idea-admin-search-bar">
        <label for="admin_search_product_id">
            <i class="fa fa-search" aria-hidden="true"></i>
            商品名 / コード
        </label>
        {{ searchForm.input('nameKeyword')|raw }}
        <button type="submit" class="idea-admin-action idea-admin-action--primary">
            <i class="fa fa-search" aria-hidden="true"></i>
            検索
        </button>
    </div>

    {# Detail search — Phase 2 axes (category / tag / status / stock / dates) are
       not yet supported by the resource; the panel structure is present but the
       filter widgets are intentionally empty.  #}
    <details id="searchDetail">
        <summary class="idea-admin-text-btn">
            <i class="fa fa-plus-square-o" aria-hidden="true"></i>
            詳細検索
        </summary>
        <div class="idea-admin-panel" style="margin-top:.6rem;">
            <div class="idea-admin-panel__body">
                <div class="idea-admin-field">
                    <div class="idea-admin-field__label"><label>カテゴリ</label></div>
                    <div class="idea-admin-field__input"></div>
                </div>
                <div class="idea-admin-field">
                    <div class="idea-admin-field__label"><label>タグ</label></div>
                    <div class="idea-admin-field__input"></div>
                </div>
                <div class="idea-admin-field">
                    <div class="idea-admin-field__label"><label>公開ステータス</label></div>
                    <div class="idea-admin-field__input"></div>
                </div>
                <div class="idea-admin-field">
                    <div class="idea-admin-field__label"><label>在庫</label></div>
                    <div class="idea-admin-field__input"></div>
                </div>
                <div class="idea-admin-field">
                    <div class="idea-admin-field__label"><label>登録日</label></div>
                    <div class="idea-admin-field__input"></div>
                </div>
                <div class="idea-admin-field">
                    <div class="idea-admin-field__label"><label>更新日</label></div>
                    <div class="idea-admin-field__input"></div>
                </div>
            </div>
        </div>
    </details>

    <p class="idea-admin-count" style="margin-top:.75rem;">
        検索結果：{{ count }}件が該当しました
    </p>
</form>

{# ── List toolbar ── #}
<div class="idea-admin-list-toolbar" style="margin-top:1rem;">
    <div class="idea-admin-list-toolbar__left">
        <a class="idea-admin-action idea-admin-action--primary" href="/admin/product-new">
            <i class="fa fa-plus" aria-hidden="true"></i>
            商品登録
        </a>
    </div>
    <div class="idea-admin-list-toolbar__right">
        <a class="idea-admin-action" href="/admin/product-csv" rel="goExportProduct">
            <i class="fa fa-cloud-download" aria-hidden="true"></i>
            CSV ダウンロード
        </a>
        <a class="idea-admin-action" href="/admin/csv-config">
            <i class="fa fa-cog" aria-hidden="true"></i>
            CSV 出力項目設定
        </a>
    </div>
</div>

{% if count %}

{# ── Bulk-action form ── #}
<form id="form_bulk" method="POST" action="">

    {# Bulk bar — hidden until a checkbox is checked #}
    <div id="bulk-bar" class="idea-admin-list-toolbar" hidden>
        <div class="idea-admin-list-toolbar__left">
            <span class="idea-admin-count">一括操作</span>
            <div class="idea-admin-btn-group" role="group">
                <button type="button"
                        class="idea-admin-action action-submit"
                        data-action="/admin/product-bulk-status"
                        data-product-status="1"
                        token-for-anchor="{{ csrf_token_for_anchor('admin_product_bulk_product_status') }}">
                    公開
                </button>
                <button type="button"
                        class="idea-admin-action action-submit"
                        data-action="/admin/product-bulk-status"
                        data-product-status="2"
                        token-for-anchor="{{ csrf_token_for_anchor('admin_product_bulk_product_status') }}">
                    非公開
                </button>
                <button type="button"
                        class="idea-admin-action action-submit"
                        data-action="/admin/product-bulk-status"
                        data-product-status="3"
                        token-for-anchor="{{ csrf_token_for_anchor('admin_product_bulk_product_status') }}">
                    廃止
                </button>
            </div>
            <button type="button"
                    class="idea-admin-action idea-admin-action--destructive"
                    onclick="document.getElementById('bulkDeleteModal').hidden=false">
                <i class="fa fa-trash" aria-hidden="true"></i>
                削除
            </button>
        </div>
    </div>

    {# ── Product grid ── #}
    <div class="idea-admin-table-wrap">
        <table class="idea-admin-table">
            <thead>
                <tr>
                    <th class="idea-admin-table__check">
                        <input type="checkbox" id="trigger_check_all" aria-label="全選択">
                    </th>
                    <th>画像</th>
                    <th>
                        <span class="idea-admin-table__sort">
                            商品名 <i class="fa fa-arrow-up" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th>
                        <span class="idea-admin-table__sort">
                            コード <i class="fa fa-arrow-up" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th>価格</th>
                    <th>
                        <span class="idea-admin-table__sort">
                            在庫 <i class="fa fa-arrow-up" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th>
                        <span class="idea-admin-table__sort">
                            ステータス <i class="fa fa-arrow-up" aria-hidden="true"></i>
                        </span>
                    </th>
                    <th class="idea-admin-table__actions"></th>
                </tr>
            </thead>
            <tbody>
            {% for Product in products %}
                <tr id="ex-product-{{ Product.productCode }}">
                    <td class="idea-admin-table__check">
                        <input type="checkbox"
                               name="productCodes[]"
                               value="{{ Product.productCode }}"
                               id="check_{{ Product.productCode }}"
                               data-delete-url="/admin/product?productCode={{ Product.productCode }}&_method=delete"
                               token-for-anchor="{{ csrf_token_for_anchor('admin_product_delete') }}">
                    </td>
                    <td class="idea-admin-table__thumb">
                        <a href="/admin/product/edit?productCode={{ Product.productCode }}">
                            {% if Product.imagePath %}
                                {# imagePath is already root-absolute (ProductFactory);
                                   asset() would double the leading slash. #}
                                <img src="{{ Product.imagePath }}"
                                     alt="{{ Product.productName }}">
                            {% else %}
                                <img src="{{ asset('assets/img/common/no_image_product.png', 'save_image') }}"
                                     alt="{{ Product.productName }}">
                            {% endif %}
                        </a>
                    </td>
                    <td>
                        <a href="/admin/product/edit?productCode={{ Product.productCode }}"
                           rel="goProduct">
                            {{ Product.productName }}
                        </a>
                        {% if Product.categoryNames is not empty %}
                            <div style="margin-top:.25rem;">
                                {% for cat in Product.categoryNames %}
                                    <span class="idea-admin-badge idea-admin-badge--private">{{ cat }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                        {% if Product.tagNames is not empty %}
                            <div style="margin-top:.2rem;">
                                {% for tag in Product.tagNames %}
                                    <span class="idea-admin-badge">{{ tag }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </td>
                    <td>{{ Product.productCode }}</td>
                    <td>{{ Product.price02|price }}</td>
                    <td>
                        {% if Product.stock is null %}
                            無制限
                        {% else %}
                            {{ Product.stock }}
                        {% endif %}
                    </td>
                    <td>
                        {% if Product.productStatus == 1 %}
                            <span class="idea-admin-badge idea-admin-badge--public">公開</span>
                        {% elseif Product.productStatus == 2 %}
                            <span class="idea-admin-badge idea-admin-badge--private">非公開</span>
                        {% else %}
                            <span class="idea-admin-badge idea-admin-badge--discontinued">廃止</span>
                        {% endif %}
                    </td>
                    <td class="idea-admin-table__actions">
                        <a class="idea-admin-icon-btn"
                           href="/product?productCode={{ Product.productCode }}"
                           target="_blank"
                           title="ストアで表示"
                           rel="goProduct">
                            <i class="fa fa-eye" aria-hidden="true"></i>
                        </a>
                        <button type="button"
                                class="idea-admin-icon-btn"
                                title="複製"
                                onclick="document.getElementById('confirmModal-{{ Product.productCode }}').hidden=false">
                            <i class="fa fa-copy" aria-hidden="true"></i>
                        </button>

                        {# Copy-confirm dialog #}
                        <div id="confirmModal-{{ Product.productCode }}"
                             class="idea-admin-dialog-backdrop" hidden>
                            <div class="idea-admin-dialog" role="dialog"
                                 aria-labelledby="confirmModal-label-{{ Product.productCode }}">
                                <div class="idea-admin-dialog__head">
                                    <h5 id="confirmModal-label-{{ Product.productCode }}" class="idea-admin-dialog__title">
                                        商品を複製しますか？
                                    </h5>
                                    <button type="button" class="idea-admin-text-btn"
                                            onclick="document.getElementById('confirmModal-{{ Product.productCode }}').hidden=true">
                                        <i class="fa fa-times" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="idea-admin-dialog__body">
                                    <p>{{ Product.productName }} を複製します。続けてよろしいですか？</p>
                                </div>
                                <div class="idea-admin-dialog__foot">
                                    <button type="button" class="idea-admin-action"
                                            onclick="document.getElementById('confirmModal-{{ Product.productCode }}').hidden=true">
                                        キャンセル
                                    </button>
                                    <a href="/admin/product-copy?productCode={{ Product.productCode }}"
                                       class="idea-admin-action idea-admin-action--primary"
                                       data-confirm="false"
                                       data-method="post"
                                       token-for-anchor="{{ csrf_token_for_anchor('admin_product_product_copy') }}">
                                        複製
                                    </a>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

</form>

{# ── Bulk-delete confirmation dialog ── #}
<div id="bulkDeleteModal" class="idea-admin-dialog-backdrop" hidden>
    <div class="idea-admin-dialog" role="dialog" aria-labelledby="bulkDeleteModal-label">
        <div class="idea-admin-dialog__head">
            <h5 id="bulkDeleteModal-label" class="idea-admin-dialog__title">
                選択商品を削除しますか？
            </h5>
            <button type="button" class="idea-admin-text-btn"
                    onclick="document.getElementById('bulkDeleteModal').hidden=true">
                <i class="fa fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="idea-admin-dialog__body">
            <p>この操作は元に戻せません。削除してよろしいですか？</p>
            <ul id="bulkErrors"></ul>
            <div class="idea-admin-progress" hidden>
                <div class="idea-admin-progress__bar" style="width:0%" role="progressbar"
                     aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
        <div class="idea-admin-dialog__foot">
            <button type="button" class="idea-admin-action"
                    onclick="document.getElementById('bulkDeleteModal').hidden=true">
                キャンセル
            </button>
            <button type="button" class="idea-admin-action idea-admin-action--destructive" id="bulkDelete">
                <i class="fa fa-trash" aria-hidden="true"></i>
                削除
            </button>
            <button type="button" class="idea-admin-action" id="bulkDeleteDone" hidden>
                完了
            </button>
        </div>
    </div>
</div>

{% else %}

<div class="idea-admin-empty">
    <i class="fa fa-inbox fa-2x" aria-hidden="true"></i>
    <p class="idea-admin-empty__title">該当する商品が見つかりませんでした</p>
    <p>検索条件を変えてもう一度お試しください</p>
</div>

{% endif %}

{% endblock %}
