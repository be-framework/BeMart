{% extends 'admin-base.html.twig' %}

{% set route = 'admin-category-csv' %}
{% set title = csvTitle %}
{% set sub_title = '商品管理' %}

{% block stylesheet %}
<style>
.idea-admin-dropzone {
    border: 2px dashed var(--idea-border, #d6c9b2);
    border-radius: var(--idea-admin-radius-panel);
    padding: 2.5rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: border-color .2s, background .2s;
    background: transparent;
}
.idea-admin-dropzone.is-over {
    border-color: var(--idea-olive, #6b7c3f);
    background: rgba(107, 124, 63, .06);
}
.idea-admin-dropzone__icon {
    font-size: 2.25rem;
    color: var(--idea-muted, #9c8e79);
    margin-bottom: .75rem;
    display: block;
    pointer-events: none;
}
.idea-admin-dropzone__label {
    font-size: .9375rem;
    color: var(--idea-muted, #9c8e79);
    pointer-events: none;
}
.idea-admin-dropzone__filename {
    margin-top: .6rem;
    font-size: .875rem;
    font-weight: 700;
    color: var(--idea-olive, #6b7c3f);
    min-height: 1.25em;
}
.idea-admin-col-spec {
    font-size: .8125rem;
}
.idea-admin-col-spec dt {
    font-weight: 700;
    color: var(--idea-ink, #2e2a24);
    padding-top: .5rem;
}
.idea-admin-col-spec dd {
    margin: 0 0 .25rem 0;
    color: var(--idea-muted, #9c8e79);
}
.idea-admin-col-spec__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4em;
    height: 1.4em;
    border-radius: 50%;
    background: var(--idea-border, #d6c9b2);
    color: var(--idea-ink, #2e2a24);
    font-size: .75rem;
    font-weight: 700;
    margin-right: .4rem;
    flex-shrink: 0;
}
</style>
{% endblock %}

{% block main %}
<form method="post"
      action="/admin/category/csv"
      enctype="multipart/form-data"
      novalidate
      id="category-csv-upload-form"
      aria-label="カテゴリCSVアップロード">

    <input type="hidden" name="csrfToken"
           value="{{ csrfToken|default(csrf_token('admin_csv_import')) }}">

    <div class="idea-admin-layout">

        {# ── Primary: upload panel ── #}
        <section class="idea-admin-primary">

            <div class="idea-admin-panel">
                <div class="idea-admin-panel__head">
                    <h3>
                        <i class="fa fa-upload fa-fw" aria-hidden="true"></i>
                        CSVファイルを選択
                    </h3>
                </div>
                <div class="idea-admin-panel__body">

                    {# Drag-and-drop zone — clicking it triggers the hidden file input #}
                    <div class="idea-admin-dropzone"
                         id="dropzone"
                         role="button"
                         tabindex="0"
                         aria-label="CSVファイルをドラッグ＆ドロップ、またはクリックして選択">
                        <i class="fa fa-file-alt idea-admin-dropzone__icon" aria-hidden="true"></i>
                        <span class="idea-admin-dropzone__label">
                            ファイルをここにドラッグ＆ドロップ<br>
                            またはクリックして選択
                        </span>
                        <div class="idea-admin-dropzone__filename" id="chosen-filename" aria-live="polite"></div>
                    </div>

                    {# Real file input — visually hidden, driven by the dropzone #}
                    {{ form.input('import_file')|raw }}
                    {% if form.error('import_file') %}
                        <span class="idea-admin-error" role="alert">{{ form.error('import_file') }}</span>
                    {% endif %}

                    {# Template download — contextual helper adjacent to upload #}
                    <p style="margin-top:1.25rem; font-size:.875rem;">
                        <i class="fa fa-cloud-download fa-fw" aria-hidden="true"></i>
                        フォーマットサンプル:
                        <a href="/admin/category/csv"
                           rel="{{ skeletonRoute }}"
                           class="idea-admin-text-btn">
                            雛形CSVをダウンロード
                        </a>
                    </p>

                </div>
            </div>

            {# Notice: expected behaviour on import #}
            <div class="idea-admin-notice idea-admin-notice--info" style="margin-top:1rem;">
                <i class="fa fa-info-circle" aria-hidden="true"></i>
                <strong>カテゴリIDが空の行</strong>は新規登録、
                <strong>既存IDを指定した行</strong>は更新します。
                削除フラグ <code>1</code> を指定すると対象カテゴリを削除します。
            </div>

        </section>

        {# ── Side: column spec quick-reference ── #}
        <aside class="idea-admin-side">

            <div class="idea-admin-panel">
                <div class="idea-admin-panel__head">
                    <h3>
                        <i class="fa fa-table fa-fw" aria-hidden="true"></i>
                        列仕様
                    </h3>
                </div>
                <div class="idea-admin-panel__body">
                    <dl class="idea-admin-col-spec">
                        {% for col in columns %}
                            <dt>
                                <span class="idea-admin-col-spec__index" aria-hidden="true">{{ loop.index }}</span>
                                {{ col.name }}
                            </dt>
                            {% if col.description %}
                                <dd>{{ col.description }}</dd>
                            {% else %}
                                <dd>&nbsp;</dd>
                            {% endif %}
                        {% endfor %}
                    </dl>
                </div>
            </div>

        </aside>

    </div>

    {# ── Sticky bottom toolbar ── #}
    <div class="idea-admin-toolbar">
        <div class="idea-admin-toolbar__back">
            <a href="/admin/product-list" rel="goProductList">
                <i class="fa fa-chevron-left fa-fw" aria-hidden="true"></i>
                商品管理へ戻る
            </a>
        </div>
        <div class="idea-admin-toolbar__actions">
            <button type="submit"
                    class="idea-admin-action idea-admin-action--primary"
                    id="upload-submit-btn">
                <i class="fa fa-upload fa-fw" aria-hidden="true"></i>
                アップロード
            </button>
        </div>
    </div>

</form>
{% endblock %}

{% block javascript %}
<script>
(function () {
    'use strict';

    var fileInput = document.querySelector('#category-csv-upload-form input[type="file"]');
    var dropzone  = document.getElementById('dropzone');
    var filename  = document.getElementById('chosen-filename');

    if (!fileInput || !dropzone) { return; }

    /* Hide the raw file input — dropzone is the interaction surface */
    fileInput.style.cssText = 'position:absolute;width:1px;height:1px;opacity:0;overflow:hidden';

    function showName(name) {
        if (filename) { filename.textContent = name ? name : ''; }
    }

    /* Click / keyboard activation */
    dropzone.addEventListener('click', function () { fileInput.click(); });
    dropzone.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
    });

    fileInput.addEventListener('change', function () {
        if (fileInput.files && fileInput.files.length) {
            showName(fileInput.files[0].name);
        }
    });

    /* Drag-and-drop */
    ['dragenter', 'dragover'].forEach(function (ev) {
        dropzone.addEventListener(ev, function (e) {
            e.preventDefault();
            dropzone.classList.add('is-over');
        });
    });
    ['dragleave', 'dragend', 'drop'].forEach(function (ev) {
        dropzone.addEventListener(ev, function (e) {
            e.preventDefault();
            dropzone.classList.remove('is-over');
        });
    });
    dropzone.addEventListener('drop', function (e) {
        e.preventDefault();
        var dt = e.dataTransfer;
        if (!dt || !dt.files.length) { return; }

        /* Transfer dropped files to the real input via DataTransfer */
        try {
            fileInput.files = dt.files;
        } catch (_) {
            /* Safari fallback: nothing we can do without a real input transfer */
        }
        showName(dt.files[0].name);
    });
}());
</script>
{% endblock %}
