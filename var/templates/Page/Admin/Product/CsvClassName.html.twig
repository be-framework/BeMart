{% extends 'admin-base.html.twig' %}

{% set route      = 'admin-product-csv-class-name' %}
{% set title      = csvTitle %}
{% set sub_title  = '商品管理' %}

{% block stylesheet %}
<style>
/* ── Drop zone ──────────────────────────────────────────────────────────── */
.idea-admin-dropzone {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .65rem;
  padding: 2.25rem 1.5rem;
  border: 2px dashed var(--idea-stone);
  border-radius: var(--idea-admin-radius-panel);
  background: var(--idea-surface-soft);
  cursor: pointer;
  transition: border-color .18s, background .18s;
  text-align: center;
}
.idea-admin-dropzone:hover,
.idea-admin-dropzone.is-drag-over {
  border-color: var(--idea-olive);
  background: rgba(82, 107, 85, .06);
}
.idea-admin-dropzone__icon {
  font-size: 2rem;
  color: var(--idea-stone-2);
}
.idea-admin-dropzone.is-drag-over .idea-admin-dropzone__icon {
  color: var(--idea-olive);
}
.idea-admin-dropzone__label {
  font-size: .9rem;
  font-weight: 700;
  color: var(--idea-ink);
}
.idea-admin-dropzone__hint {
  font-size: .78rem;
  color: var(--idea-muted);
}
.idea-admin-dropzone__filename {
  display: none;
  align-items: center;
  gap: .45rem;
  padding: .35rem .75rem;
  background: rgba(82, 107, 85, .1);
  border-radius: 999px;
  font-size: .8rem;
  font-weight: 700;
  color: var(--idea-olive);
}
.idea-admin-dropzone__filename.is-visible { display: inline-flex; }

/* ── Format table disclosure ────────────────────────────────────────────── */
.idea-admin-disclosure__toggle {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  font-size: .82rem;
  font-weight: 700;
  color: var(--idea-muted);
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  transition: color .14s;
}
.idea-admin-disclosure__toggle:hover { color: var(--idea-ink); }
.idea-admin-disclosure__caret { transition: transform .18s; font-size: .72rem; }
.idea-admin-disclosure__toggle[aria-expanded="true"] .idea-admin-disclosure__caret {
  transform: rotate(90deg);
}
.idea-admin-disclosure__body[hidden] { display: none; }

/* ── Column spec badge ──────────────────────────────────────────────────── */
.idea-admin-col-optional {
  display: inline-flex;
  align-items: center;
  padding: .06rem .38rem;
  border-radius: var(--idea-admin-radius-badge);
  background: rgba(205, 191, 170, .28);
  color: var(--idea-muted);
  font-size: .68rem;
  font-weight: 800;
  letter-spacing: .04em;
  white-space: nowrap;
}
</style>
{% endblock %}

{% block main %}
<form method="post"
      action="/admin/product/csv-class-name"
      enctype="multipart/form-data"
      novalidate
      aria-label="{{ csvTitle }}">
  <input type="hidden" name="csrfToken"
         value="{{ csrfToken|default(csrf_token('admin_csv_import')) }}">

  {# ── Upload panel ──────────────────────────────────────────────────────── #}
  <div class="idea-admin-panel" style="max-width: 640px; margin-bottom: 1.25rem;">
    <div class="idea-admin-panel__head">
      <h3>{{ csvTitle }}</h3>
      <span class="idea-admin-panel__hint">CSV ファイルを選択してインポート</span>
    </div>
    <div class="idea-admin-panel__body">

      {# Drop zone wraps the hidden file input #}
      <label class="idea-admin-dropzone" id="dropzone-label" for="admin_csv_import_import_file">
        <span class="idea-admin-dropzone__icon" aria-hidden="true">
          <i class="fa fa-file-csv"></i>
        </span>
        <span class="idea-admin-dropzone__label">ファイルをドロップまたはクリックして選択</span>
        <span class="idea-admin-dropzone__hint">.csv 形式 · UTF-8 推奨</span>
        <span class="idea-admin-dropzone__filename" id="dropzone-filename" aria-live="polite">
          <i class="fa fa-check-circle" aria-hidden="true"></i>
          <span id="dropzone-filename-text"></span>
        </span>
        {# Render the actual file input but visually hide it inside the label #}
        <span style="position:absolute;opacity:0;pointer-events:none;width:0;height:0;overflow:hidden;">
          {{ form.input('import_file')|raw }}
        </span>
      </label>

      {% if form.error('import_file') %}
      <p class="idea-admin-error" role="alert">{{ form.error('import_file') }}</p>
      {% endif %}

      {# Skeleton download — secondary affordance #}
      <p style="font-size:.82rem; margin:0;">
        <a class="idea-admin-meta__link"
           href="/admin/class-name/class-name-export"
           rel="goExportClassName">
          <i class="fa fa-download" aria-hidden="true"></i>
          雛形 CSV をダウンロード
        </a>
        <span style="color:var(--idea-muted); margin-left:.5rem;">
          — 新規作成時のフォーマット確認に使用
        </span>
      </p>

      {# ── Format disclosure ─────────────────────────────────────────────── #}
      <div>
        <button type="button"
                class="idea-admin-disclosure__toggle"
                aria-expanded="false"
                aria-controls="format-table"
                id="format-toggle">
          <i class="fa fa-angle-right idea-admin-disclosure__caret" aria-hidden="true"></i>
          CSV フォーマット（{{ columns|length }} 列）
        </button>
        <div id="format-table"
             class="idea-admin-disclosure__body"
             role="region"
             aria-labelledby="format-toggle"
             hidden
             style="margin-top:.75rem;">
          <div class="idea-admin-table-wrap">
            <table class="idea-admin-table">
              <thead>
                <tr>
                  <th>列名</th>
                  <th>説明</th>
                </tr>
              </thead>
              <tbody>
                {# 規格名ID is optional (新規登録の場合は空) — first row #}
                {% for col in columns %}
                  <tr>
                    <td>
                      <span style="font-weight:700;">{{ col.name }}</span>
                      {% if loop.first %}
                        <span class="idea-admin-col-optional" style="margin-left:.4rem;">省略可</span>
                      {% else %}
                        <span class="idea-admin-required" style="margin-left:.4rem;">必須</span>
                      {% endif %}
                    </td>
                    <td style="color:var(--idea-muted);">
                      {% if col.description %}
                        {{ col.description }}
                      {% else %}
                        —
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>{# /panel__body #}
  </div>{# /panel #}

  {# ── Bottom toolbar ────────────────────────────────────────────────────── #}
  <div class="idea-admin-toolbar">
    <div class="idea-admin-toolbar__back">
      <a href="/admin/product-list" rel="goProductList">
        <i class="fa fa-arrow-left" aria-hidden="true"></i>
        商品管理へ戻る
      </a>
    </div>
    <div class="idea-admin-toolbar__actions">
      <button type="submit"
              class="idea-admin-action idea-admin-action--primary"
              id="csv-submit-btn"
              disabled>
        <i class="fa fa-upload" aria-hidden="true"></i>
        インポート実行
      </button>
    </div>
  </div>

</form>
{% endblock %}

{% block javascript %}
<script>
(function () {
  'use strict';

  var fileInput  = document.getElementById('admin_csv_import_import_file');
  var dropzone   = document.getElementById('dropzone-label');
  var filenameEl = document.getElementById('dropzone-filename');
  var filenameText = document.getElementById('dropzone-filename-text');
  var submitBtn  = document.getElementById('csv-submit-btn');
  var toggle     = document.getElementById('format-toggle');
  var body       = document.getElementById('format-table');

  /* File selection — update UI and enable submit */
  function onFileChange() {
    var file = fileInput && fileInput.files && fileInput.files[0];
    if (file) {
      filenameText.textContent = file.name;
      filenameEl.classList.add('is-visible');
      submitBtn.removeAttribute('disabled');
    } else {
      filenameEl.classList.remove('is-visible');
      submitBtn.setAttribute('disabled', '');
    }
  }

  if (fileInput) {
    fileInput.addEventListener('change', onFileChange);
  }

  /* Drag-and-drop visual feedback */
  if (dropzone) {
    ['dragenter', 'dragover'].forEach(function (evt) {
      dropzone.addEventListener(evt, function (e) {
        e.preventDefault();
        dropzone.classList.add('is-drag-over');
      });
    });
    ['dragleave', 'drop'].forEach(function (evt) {
      dropzone.addEventListener(evt, function () {
        dropzone.classList.remove('is-drag-over');
      });
    });
    dropzone.addEventListener('drop', function (e) {
      e.preventDefault();
      if (fileInput && e.dataTransfer && e.dataTransfer.files.length) {
        fileInput.files = e.dataTransfer.files;
        onFileChange();
      }
    });
  }

  /* Format disclosure toggle */
  if (toggle && body) {
    toggle.addEventListener('click', function () {
      var expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      body.hidden = expanded;
    });
  }
}());
</script>
{% endblock %}
