{#
  BeMart admin — Product Variant (SKU) editor — clean-room build.

  DATA CONTRACT (src/Resource/Page/Admin/Product/ProductClass.php onGet):
    productCode  string                    — parent product identifier
    form         AdminProductClassForm     — per-row editable fields
    classes      array<int, object>|null   — existing variant rows; [] on new product

  FORM FIELDS (src/Form/AdminProductClassForm.php):
    price02          text  — required  — selling price (tax-excl)
    stock            text             — unit stock; ignored when stock_unlimited is set
    stock_unlimited  checkbox         — 1 = unlimited stock
    product_code     text             — SKU / product code per variant
    delivery_fee     text             — per-variant shipping surcharge

  CLASSES ITEM SHAPE (var/json_schema/get-admin-product-product-class.json):
    classNameId       string|null  — opaque variant-axis ID
    classCategoryId   string|null  — opaque variant-value ID
    className         string|null  — variant axis label (e.g. "カラー")
    classCategoryName string|null  — variant value label (e.g. "レッド")
    productCode       string|null  — per-SKU product code
    stock             int|null     — unit stock (null = unlimited)
    price02           int|null     — per-SKU selling price

  LINKS (Resource #[Link] annotations):
    goProduct     GET  /admin/product/edit   — back to parent product editor
    goProductList GET  /admin/product-list   — back to product list

  No POST/PUT on this resource — GET-only blank-editor renderer.
  Variant mutation is scoped to a separate resource endpoint.

  DESIGN VOCABULARY (public/assets/idea-store/css/idea-admin.css):
    idea-admin-shell / idea-admin-content (landmark from admin-base.html.twig)
    idea-admin-page-header / idea-admin-page-title / idea-admin-page-subtitle
    idea-admin-panel / idea-admin-panel__head / idea-admin-panel__body
    idea-admin-field__label / idea-admin-field__input
    idea-admin-required / idea-admin-error
    idea-admin-table-wrap / idea-admin-table
    idea-admin-action / idea-admin-action--primary
    idea-admin-toolbar / idea-admin-toolbar__back / idea-admin-toolbar__actions
    idea-admin-empty / idea-admin-notice--info
    idea-admin-kpi-grid / idea-admin-kpi
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-product-product-class' %}
{% set title = '商品バリエーション' %}
{% set sub_title = productCode is not empty ? productCode : '新規' %}

{% block stylesheet %}
<style>
/* ── Page-local additions (idea-admin-* naming) ────────────────────────────── */

.idea-admin-variant-grid {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 1.25rem;
  align-items: start;
  max-width: var(--idea-admin-content-max);
}

.idea-admin-variant-form-col {
  display: grid;
  gap: .75rem;
}

.idea-admin-variant-form-subrow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .65rem;
}

.idea-admin-stock-toggle {
  display: flex;
  align-items: center;
  gap: .55rem;
  padding: .55rem .75rem;
  border-radius: var(--idea-admin-radius-input);
  border: 1px solid rgba(205,191,170,.35);
  background: var(--idea-surface-soft);
}

.idea-admin-stock-toggle input[type="checkbox"] {
  accent-color: var(--idea-olive);
  width: 1rem;
  height: 1rem;
  cursor: pointer;
  flex-shrink: 0;
}

.idea-admin-stock-toggle label {
  font-size: .82rem;
  color: var(--idea-muted);
  cursor: pointer;
  user-select: none;
}

.idea-admin-variant-axis {
  display: flex;
  flex-direction: column;
  gap: .1rem;
}

.idea-admin-variant-axis__name {
  font-size: .84rem;
  font-weight: 700;
  color: var(--idea-ink);
}

.idea-admin-variant-axis__value {
  font-size: .76rem;
  color: var(--idea-muted);
}

.idea-admin-sku-code {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  font-size: .78rem;
  color: var(--idea-muted);
  word-break: break-all;
}

.idea-admin-price-num {
  font-variant-numeric: tabular-nums;
  font-size: .86rem;
}

.idea-admin-stock-num {
  font-variant-numeric: tabular-nums;
  font-size: .86rem;
}

.idea-admin-stock-num--unlimited {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  font-size: .76rem;
  font-weight: 700;
  color: var(--idea-olive);
}

.idea-admin-stock-num--low {
  color: #a9472e;
  font-weight: 700;
}

@media (max-width: 1020px) {
  .idea-admin-variant-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .idea-admin-variant-form-subrow {
    grid-template-columns: 1fr;
  }
}
</style>
{% endblock %}

{% block main %}

{# ── Context banner (shows parent product SKU) ─────────────────────────────── #}
{% if productCode is not empty %}
<div class="idea-admin-notice idea-admin-notice--info" role="status">
  <i class="fa fa-tag" aria-hidden="true"></i>
  <span>商品 <strong>{{ productCode }}</strong> のバリエーション（SKU）管理</span>
</div>
{% endif %}

<div class="idea-admin-variant-grid">

  {# ── Left: existing variants table ──────────────────────────────────────── #}
  <div>

    {% if classes is not empty %}

      {# KPI summary strip #}
      {% set totalVariants = classes|length %}
      {% set unlimitedCount = 0 %}
      {% set lowStockCount  = 0 %}
      {% for row in classes %}
        {% if row.stock is null %}{% set unlimitedCount = unlimitedCount + 1 %}{% endif %}
        {% if row.stock is not null and row.stock < 5 %}{% set lowStockCount = lowStockCount + 1 %}{% endif %}
      {% endfor %}

      <div class="idea-admin-kpi-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 1rem;">
        <div class="idea-admin-kpi">
          <div class="idea-admin-kpi__label">バリエーション</div>
          <div class="idea-admin-kpi__value">{{ totalVariants }}</div>
        </div>
        <div class="idea-admin-kpi {{ unlimitedCount > 0 ? 'idea-admin-kpi--positive' : '' }}">
          <div class="idea-admin-kpi__label">在庫無制限</div>
          <div class="idea-admin-kpi__value">{{ unlimitedCount }}</div>
        </div>
        <div class="idea-admin-kpi {{ lowStockCount > 0 ? 'idea-admin-kpi--negative' : '' }}">
          <div class="idea-admin-kpi__label">在庫少 (&lt;5)</div>
          <div class="idea-admin-kpi__value">{{ lowStockCount }}</div>
        </div>
      </div>

      <div class="idea-admin-table-wrap">
        <table class="idea-admin-table" aria-label="バリエーション一覧">
          <thead>
            <tr>
              <th scope="col">バリエーション</th>
              <th scope="col">SKUコード</th>
              <th scope="col" style="text-align: right;">販売価格</th>
              <th scope="col" style="text-align: right;">在庫</th>
            </tr>
          </thead>
          <tbody>
            {% for row in classes %}
            <tr>
              <td>
                <div class="idea-admin-variant-axis">
                  {% if row.className is not empty %}
                    <span class="idea-admin-variant-axis__name">{{ row.className }}</span>
                  {% endif %}
                  {% if row.classCategoryName is not empty %}
                    <span class="idea-admin-variant-axis__value">{{ row.classCategoryName }}</span>
                  {% endif %}
                  {% if row.className is empty and row.classCategoryName is empty %}
                    <span class="idea-admin-variant-axis__value">—</span>
                  {% endif %}
                </div>
              </td>
              <td>
                {% if row.productCode is not empty %}
                  <span class="idea-admin-sku-code">{{ row.productCode }}</span>
                {% else %}
                  <span style="color: var(--idea-stone);">—</span>
                {% endif %}
              </td>
              <td style="text-align: right;">
                {% if row.price02 is not null %}
                  <span class="idea-admin-price-num">¥{{ row.price02|number_format }}</span>
                {% else %}
                  <span style="color: var(--idea-stone);">—</span>
                {% endif %}
              </td>
              <td style="text-align: right;">
                {% if row.stock is null %}
                  <span class="idea-admin-stock-num--unlimited">
                    <i class="fa fa-infinity" aria-hidden="true"></i>
                    無制限
                  </span>
                {% elseif row.stock < 5 %}
                  <span class="idea-admin-stock-num idea-admin-stock-num--low" title="在庫わずか">{{ row.stock }}</span>
                {% else %}
                  <span class="idea-admin-stock-num">{{ row.stock }}</span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

    {% else %}

      <div class="idea-admin-empty" role="status">
        <i class="fa fa-cubes fa-2x" aria-hidden="true" style="color: var(--idea-stone);"></i>
        <div class="idea-admin-empty__title">バリエーションがありません</div>
        <p style="font-size: .84rem; margin: 0; color: var(--idea-muted);">
          右のフォームから最初のバリエーションを追加してください。
        </p>
      </div>

    {% endif %}

  </div>{# /left #}

  {# ── Right: new variant entry form ──────────────────────────────────────── #}
  <div>
    <section class="idea-admin-panel" aria-labelledby="section-add-variant">
      <div class="idea-admin-panel__head">
        <h3 id="section-add-variant">
          <i class="fa fa-plus-circle" aria-hidden="true" style="color: var(--idea-olive); margin-right: .3em;"></i>
          バリエーション追加
        </h3>
      </div>
      <div class="idea-admin-panel__body">

        <form
          id="idea-product-class-form"
          role="form"
          method="post"
          action="/admin/product/product-class"
          novalidate
        >
          <input type="hidden" name="parentProductCode" value="{{ productCode|default('') }}">

          <div class="idea-admin-variant-form-col">

            {# 販売価格 — required #}
            <div>
              <div style="display: flex; align-items: center; gap: .45rem; margin-bottom: .35rem;">
                <label for="product_class_price02" style="font-size: .84rem; font-weight: 700;">販売価格</label>
                <span class="idea-admin-required">必須</span>
              </div>
              <div class="idea-admin-field__input">
                {{ form.input('price02')|raw }}
                {% if form.error('price02') %}
                  <span class="idea-admin-error" role="alert">{{ form.error('price02') }}</span>
                {% endif %}
              </div>
            </div>

            {# SKUコード + 配送料 — side by side on wider layout #}
            <div class="idea-admin-variant-form-subrow">

              <div>
                <label for="product_class_code" style="display: block; font-size: .84rem; font-weight: 700; margin-bottom: .35rem;">
                  SKUコード
                </label>
                <div class="idea-admin-field__input">
                  {{ form.input('product_code')|raw }}
                </div>
              </div>

              <div>
                <label for="product_class_delivery_fee" style="display: block; font-size: .84rem; font-weight: 700; margin-bottom: .35rem;">
                  配送料加算
                </label>
                <div class="idea-admin-field__input">
                  {{ form.input('delivery_fee')|raw }}
                </div>
              </div>

            </div>

            {# 在庫 + 在庫無制限 — grouped #}
            <div>
              <label for="product_class_stock" style="display: block; font-size: .84rem; font-weight: 700; margin-bottom: .35rem;">
                在庫数
              </label>
              <div class="idea-admin-field__input" style="margin-bottom: .55rem;">
                {{ form.input('stock')|raw }}
              </div>
              <div class="idea-admin-stock-toggle">
                {{ form.input('stock_unlimited')|raw }}
                <label for="product_class_stock_unlimited">在庫無制限（数量入力を無効化）</label>
              </div>
            </div>

            {# Submit #}
            <div style="display: flex; justify-content: flex-end; padding-top: .25rem;">
              <button
                type="submit"
                class="idea-admin-action idea-admin-action--primary"
                aria-label="このバリエーションを追加する"
              >
                <i class="fa fa-plus" aria-hidden="true"></i>
                追加
              </button>
            </div>

          </div>{# /variant-form-col #}

        </form>

      </div>{# /panel__body #}
    </section>
  </div>{# /right #}

</div>{# /variant-grid #}

{# ── Fixed bottom toolbar ──────────────────────────────────────────────────── #}
<div class="idea-admin-toolbar" role="toolbar" aria-label="ページアクション">
  <div class="idea-admin-toolbar__back">
    {% if productCode is not empty %}
    <a href="/admin/product/edit?productCode={{ productCode|url_encode }}" rel="goProduct">
      <i class="fa fa-angle-left" aria-hidden="true"></i>
      商品編集へ戻る
    </a>
    {% else %}
    <a href="/admin/product-list" rel="goProductList">
      <i class="fa fa-angle-left" aria-hidden="true"></i>
      商品一覧
    </a>
    {% endif %}
  </div>
  <div class="idea-admin-toolbar__actions">
    <a href="/admin/product-list" class="idea-admin-action" rel="goProductList">
      <i class="fa fa-list" aria-hidden="true"></i>
      商品一覧
    </a>
  </div>
</div>

{% endblock %}

{% block javascript %}
<script>
(function () {
  'use strict';

  // Disable stock input when "在庫無制限" is checked
  var unlimitedCb = document.getElementById('product_class_stock_unlimited');
  var stockInput  = document.getElementById('product_class_stock');

  if (unlimitedCb && stockInput) {
    function applyStockToggle() {
      var unlimited = unlimitedCb.checked;
      stockInput.disabled = unlimited;
      stockInput.style.opacity = unlimited ? '0.35' : '1';
      if (unlimited) { stockInput.value = ''; }
    }
    applyStockToggle();
    unlimitedCb.addEventListener('change', applyStockToggle);
  }

  // Auto-expand "商品管理" nav group in the sidebar
  var productNavBtn = document.querySelector('[aria-controls="nav-product"]');
  if (productNavBtn) {
    var sub = document.getElementById('nav-product');
    if (sub) {
      productNavBtn.setAttribute('aria-expanded', 'true');
      sub.hidden = false;
    }
  }
}());
</script>
{% endblock %}
