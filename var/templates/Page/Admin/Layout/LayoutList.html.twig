{% extends 'admin-base.html.twig' %}

{% set route = 'admin-layout-layout-list' %}
{% set title = 'レイアウト一覧' %}
{% set sub_title = 'コンテンツ管理' %}

{#
  DATA CONTRACT  (src/Resource/Page/Admin/Layout/LayoutList.php onGet)
    count      int                       — 登録レイアウト総数
    layouts    list<{                    — レイアウト行
                 layoutId:   string,     —   不透明な文字列ID (例: lo-pc-default)
                 layoutName: string,     —   表示名 (例: PC標準)
                 deviceType: int         —   10 = PC, 2 = モバイル
               }>

  ACTIONS  (src/Resource/Page/Admin/Layout/LayoutList.php #[Link])
    goLayout       GET /admin/layout/layout?layoutId={layoutId}  — レイアウト編集へ
    doUpdateLayout PUT /admin/layout/layout                       — 名称更新 (Layout.twig 側)

  DESIGN VOCABULARY  public/assets/idea-store/css/idea-admin.css
    idea-admin-kpi            — 集計カード
    idea-admin-table-wrap     — テーブルコンテナ
    idea-admin-table          — データテーブル
    idea-admin-badge          — デバイス種別チップ
    idea-admin-action         — リンクボタン
    idea-admin-icon-btn       — アイコンアクション
    idea-admin-empty          — 空状態

  INTENTIONAL OMISSIONS  (ALPS 契約に存在しない)
    - 新規作成: goLayoutList は create リンクを持たない (Wave 9 CMS slice)
    - 削除: doDeleteLayout は ALPS に存在しない
    - layouts[].pages: AdminLayoutListFetched に page join なし
#}

{% block main %}

{# ── KPI strip ── #}
<div class="idea-admin-kpi-grid" style="grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); margin-bottom: 1.25rem;">
  <div class="idea-admin-kpi">
    <div class="idea-admin-kpi__label">登録レイアウト数</div>
    <div class="idea-admin-kpi__value">{{ count }}</div>
    <div class="idea-admin-kpi__sub">PC + モバイル</div>
  </div>
</div>

{# ── Layout table / empty state ── #}
{% if count %}

  <div class="idea-admin-table-wrap">
    <table class="idea-admin-table" aria-label="レイアウト一覧">
      <thead>
        <tr>
          <th scope="col">デバイス</th>
          <th scope="col">レイアウト名</th>
          <th scope="col">ID</th>
          <th scope="col" class="idea-admin-table__actions"></th>
        </tr>
      </thead>
      <tbody>
        {% for layout in layouts %}
        <tr id="layout-row-{{ layout.layoutId }}">

          <td>
            {% if layout.deviceType == 10 %}
              <span class="idea-admin-badge idea-admin-badge--public" title="PC">
                <i class="fa fa-desktop" aria-hidden="true" style="margin-right:.3rem;"></i>
                PC
              </span>
            {% elseif layout.deviceType == 2 %}
              <span class="idea-admin-badge idea-admin-badge--private" title="モバイル">
                <i class="fa fa-mobile" aria-hidden="true" style="margin-right:.3rem;"></i>
                モバイル
              </span>
            {% else %}
              <span class="idea-admin-badge" title="デバイス種別 {{ layout.deviceType }}">
                <i class="fa fa-question-circle" aria-hidden="true" style="margin-right:.3rem;"></i>
                {{ layout.deviceType }}
              </span>
            {% endif %}
          </td>

          <td>
            <a
              class="idea-admin-meta__link"
              href="/admin/layout/layout?layoutId={{ layout.layoutId }}"
              rel="goLayout"
            >{{ layout.layoutName }}</a>
          </td>

          <td style="color: var(--idea-muted); font-size: .78rem; font-family: monospace;">
            {{ layout.layoutId }}
          </td>

          <td class="idea-admin-table__actions">
            {# goLayout: レイアウト編集 (名称変更 + ブロック配置) #}
            <a
              class="idea-admin-action"
              href="/admin/layout/layout?layoutId={{ layout.layoutId }}"
              rel="goLayout"
              aria-label="{{ layout.layoutName }}を編集"
            >
              <i class="fa fa-pencil" aria-hidden="true"></i>
              編集
            </a>
          </td>

        </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4">{{ count }}件</td>
        </tr>
      </tfoot>
    </table>
  </div>

{% else %}

  <div class="idea-admin-empty" role="status">
    <i class="fa fa-th-large fa-2x" aria-hidden="true"></i>
    <p class="idea-admin-empty__title">レイアウトが登録されていません</p>
    <p style="font-size:.84rem;">システム管理者に連絡してシードデータを確認してください。</p>
  </div>

{% endif %}

{% endblock %}
