{#
  BeMart admin Layout list — EC-CUBE goLayoutList.

  PORT of EC-CUBE 4.3 admin-theme `Content/layout_list.twig`
  (src/Eccube/Resource/template/admin/Content/layout_list.twig).

  DATA/LIST page. Extends the admin frame (`admin-base.html.twig`). The
  markup skeleton + `c-*` / `ec-*` / Bootstrap classes are kept verbatim
  from EC-CUBE; only the dynamic bindings are rebound to the LayoutList
  resource body (src/Resource/Page/Admin/Layout/LayoutList.php — body
  carries `count` + `layouts`, a list of {layoutId, layoutName,
  deviceType}).

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `url(route, params)` -> deterministic `/{route}?{query}`
     (`BeMartTwigExtension`).
   - `{% for Layout in Layouts %}` -> the resource body's `layouts` list.
   - `Layout.DeviceType.id` -> the body carries `deviceType` (10 = PC,
     2 = mobile — EC-CUBE's `DeviceType::DEVICE_TYPE_PC` is 10); the
     desktop / mobile icon is chosen from it.
   - `Layout.isDefault()` -> EC-CUBE marks stock layouts undeletable. The
     AdminLayoutListFetched projection carries no default flag, and ALPS
     exposes neither create nor delete for layouts (LayoutList resource
     has only GET + a doUpdateLayout link). The delete button is OMITTED.
     Enumerated as residual.
   - `Layout.pages` (the per-layout page join) -> NOT carried by the
     AdminLayoutListFetched projection (the layout->page join was out of
     the Wave 9 CMS slice). The collapse body renders the empty-state
     message. Enumerated as residual — MISSING-BODY-FIELD: `layouts[].pages`.
   - `csrf_token_for_anchor()` on the delete `<a>` -> EC-CUBE per-request
     CSRF widget. OMITTED. EC-CUBE-runtime only — enumerated as residual.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin_content_layout' %}
{% set title = 'レイアウト管理' %}
{% set sub_title = 'コンテンツ管理' %}

{% block javascript %}
    <script>
        $(function() {
            // 削除モーダルのhrefとmessageの変更
            $('#DeleteModal').on('shown.bs.modal', function(event) {
                var target = $(event.relatedTarget);
                // hrefの変更
                $(this).find('[data-method="delete"]').attr('href', target.data('url'));

                // messageの変更
                $(this).find('p.modal-message').text(target.data('message'));
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="d-block mb-3">
                    <a class="btn btn-ec-regular" href="{{ url('admin_content_layout_new') }}">新規作成</a>
                </div>
                {# layouts #}
                {% for Layout in layouts %}
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    {% if Layout.deviceType == 10 %}
                                        {% set icon = 'fa-desktop' %}
                                    {% else %}
                                        {% set icon = 'fa-mobile' %}
                                    {% endif %}
                                    <i class="fa fa-fw {{ icon }} fa-lg me-2"></i>
                                    <a class="card-title align-middle"
                                       href="{{ url('admin_content_layout_edit', { id : Layout.layoutId } ) }}">{{ Layout.layoutName }}</a>
                                </div>
                                <div class="col-4 text-end">
                                    <a href="#layout-{{ Layout.layoutId }}" data-bs-toggle="collapse" aria-expanded="false" aria-controls="layout-{{ Layout.layoutId }}">
                                        <i class="fa fa-angle-down fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        {# Pages #}
                        <div class="collapse ec-cardCollapse" id="layout-{{ Layout.layoutId }}">
                            <div class="p-0 empty-item">
                                <div class="d-block p-3">
                                    <span class="text-muted">ページが登録されていません</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                <div class="modal fade" id="DeleteModal" tabindex="-1" role="dialog" aria-labelledby="DeleteModal" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">削除します</h5>
                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="modal-message"><!-- jsでメッセージを挿入 --></p>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-ec-sub w-25" type="button" data-bs-dismiss="modal">キャンセル</button>
                                <a href="#" class="btn btn-ec-delete"  data-method="delete" data-confirm="false">
                                    削除
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
