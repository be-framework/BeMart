                                                     class="d-block p-3 ui-sortable">
                                                    <p class="fw-bold mb-2">#footer</p>
                                                    <div class="target-placeholder d-block text-center border-ec-dashed p-3"><span class="text-ec-gray">ブロックをドラッグ＆ドロップ</span></div>
                                                </div>
                                            </div>
                                            <div class="d-block border border-ec-gray border-top-0 border-end-0 border-start-0">
                                                <div id="position_11"
                                                     class="d-block p-3 ui-sortable">
                                                    <p class="fw-bold mb-2">#drawer</p>
                                                    <div class="target-placeholder d-block text-center border-ec-dashed p-3"><span class="text-ec-gray">ブロックをドラッグ＆ドロップ</span></div>
                                                </div>
                                            </div>
                                            <div class="d-block">
                                                <div id="position_12"
                                                     class="d-block p-3 border-top-0 border-end-0 border-start-0 ui-sortable">
                                                    <p class="fw-bold mb-2"></body>タグ直前</p>
                                                    <div class="target-placeholder d-block text-center border-ec-dashed p-3"><span class="text-ec-gray">ブロックをドラッグ＆ドロップ</span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-3 p-2">
                                        <div id="unused-block" class="d-block border border-ec-gray">
                                            <div id="position_13" class="d-block p-3 ui-sortable">
                                                <p class="fw-bold mb-2">未使用ブロック</p>
                                                <div class="mb-3">
                                                    <div class="row">
                                                        <div class="col">
                                                            <div class="input-group mb-3">
                                                                <div class="input-group-text">
                                                                    <span id="basic-addon1"><i class="fa fa-search"></i></span>
                                                                </div>
                                                                <input id="search-block" class="form-control" type="search" aria-label="Search">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal fade" id="clickStreamConfirm" tabindex="-1" role="dialog" aria-labelledby="clickStreamConfirm" aria-hidden="true">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">ブロックを移動</h5>
                                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>ブロックの移動先を選択してください</p>
                                                <div>
                                                    <select id="move-section" class="form-select">
                                                    </select>
                                                    <input type="hidden" id="target-block" />
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-ec-regular w-25" type="button" data-bs-dismiss="modal">キャンセル</button>
                                                <button id="move-to-section" class="btn btn-ec-conversion w-25" type="button" data-bs-dismiss="modal">移動</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal fade" id="codePreview" tabindex="-1" role="dialog" aria-labelledby="codePreview" aria-hidden="true">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">ブロックのコードプレビュー</h5>
                                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>編集が必要な場合はブロック編集画面から編集してください（この時レイアウト設定は保存されません）</p>
                                                <div id="block-source-code" class="d-block border bg-ec-lightGray p-2"></div>
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-ec-regular" type="button" data-bs-dismiss="modal">キャンセル</button>
                                                <button id="block-edit" class="btn btn-ec-conversion w-25" type="button" data-bs-dismiss="modal">コードを編集</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="context-menu" style="display: none">
                                    <div class='list-group'>
                                        <a href='javascript:;' class='context-moveup list-group-item list-group-item-action border-0'>
                                            <i class='fa fa-long-arrow-up me-1'></i>上に移動
                                        </a>
                                        <a href='javascript:;' class='context-movedown list-group-item list-group-item-action border-0'>
                                            <i class='fa fa-long-arrow-down me-1'></i>下に移動
                                        </a>
                                        <a href='javascript:;' class='context-movesection list-group-item list-group-item-action border-0'>
                                            <i class='fa fa-arrows me-1'></i>セクションに移動
                                        </a>
                                        <a href='javascript:;' class='context-preview list-group-item list-group-item-action border-0'>
                                            <i class='fa fa-code me-1'></i>コードプレビュー
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="target-placeholder" style="display: none"><div class="target-placeholder d-block text-center border-ec-dashed p-3"><span class="text-ec-gray">ブロックをドラッグ＆ドロップ</span></div></div>
            <div class="c-conversionArea">
                <div class="c-conversionArea__container">
                    <div class="row justify-content-between align-items-center">
                        <div class="col-6">
                            <div class="c-conversionArea__leftBlockItem">
                                <a class="c-baseLink" href="{{ url('admin_content_layout') }}"><i class="fa fa-backward" aria-hidden="true"></i><span>レイアウト管理</span></a>
                            </div>
                        </div>
                        <div class="col-6">
                            <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                                <div class="col-auto">
                                    <button class="btn btn-ec-conversion px-5" type="submit">登録</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
