{% extends 'admin-base.html.twig' %}

{% set route = 'admin-index' %}
{% set title = '並び順を変更する' %}
{% set sub_title = '管理画面' %}

{% block main %}
<div class="idea-admin-content">
    <h2 class="idea-admin-content__title">並び順を変更する</h2>
    <div class="idea-admin-section">
        <dl class="idea-admin-dl">
            <dt>masterType</dt>
            <dd><code>{{ masterType|default('') }}</code></dd>
            <dt>rowId</dt>
            <dd><code>{{ rowId|default('') }}</code></dd>
            <dt>sortNo</dt>
            <dd><code>{{ sortNo|default('') }}</code></dd>
        </dl>
    </div>
</div>
{% endblock %}
