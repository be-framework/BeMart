{% extends 'admin-base.html.twig' %}

{% set route = 'admin-customer-list' %}
{% set title = '会員一覧' %}
{% set sub_title = '会員管理' %}

{#
  DATA CONTRACT (src/Resource/Page/Admin/CustomerList.php onGet):
    customers        list<{customerId, email, name01, name02, customerStatus, postalCode}>
    count            int    — total rows returned
    filters          {nameKeyword: string|null, emailKeyword: string|null}
    csrfToken        string — CSRF token for doDeleteCustomer POST
    searchForm       AdminCustomerSearchForm — field: multi (free-text keyword)

  ACTIONS (derived from resource #[Link] annotations):
    GET  /admin/customer-list                — goCustomerList (this page, search)
    GET  /admin/customer?customerId=…        — goCustomer (detail)
    POST /admin/delete-customer              — doDeleteCustomer

  customerStatus: 1=仮会員, 2=本会員, 3=退会

  Design vocabulary: idea-admin-* (public/assets/idea-store/css/idea-admin.css)
    idea-admin-search-bar    keyword filter bar
    idea-admin-panel         collapsible detail-search section
    idea-admin-list-toolbar  result toolbar (count + CSV actions)
    idea-admin-table-wrap    overflow wrapper for the data table
    idea-admin-table         data table
    idea-admin-badge         status chip
    idea-admin-action        action button / link
    idea-admin-empty         zero-result state
#}

{% block main %}
{# ── Keyword search form (GET, no CSRF — safe read) ── #}
<form
  id="customer-search-form"
  method="get"
  action="/admin/customer-list"
  role="search"
  aria-label="会員検索"
>
  <div class="idea-admin-search-bar">
    {{ searchForm.input('multi')|raw }}
    <button class="idea-admin-action idea-admin-action--primary" type="submit">
      <i class="fa fa-search" aria-hidden="true"></i>
      検索
    </button>
  </div>

  {# ── Detail search panel (Phase 2 filters — fields not yet declared) ── #}
  <details class="idea-admin-panel" style="margin-bottom:1rem;">
    <summary style="padding:.72rem 1rem;font-size:.84rem;font-weight:700;cursor:pointer;list-style:none;display:flex;align-items:center;gap:.5rem;">
      <i class="fa fa-plus-square-o" aria-hidden="true"></i>
      詳細検索
    </summary>
    <div class="idea-admin-panel__body" aria-label="詳細検索条件（Phase 2 追加予定）">

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem .75rem;">

        <div>
          <label style="font-size:.82rem;font-weight:700;">会員種別</label>
          {# Phase 2: customerStatus filter field #}
        </div>
        <div>
          <label style="font-size:.82rem;font-weight:700;">購入商品名</label>
          {# Phase 2: buyProductName filter field #}
        </div>

        <div>
          <label style="font-size:.82rem;font-weight:700;">性別</label>
          {# Phase 2: sex filter field #}
        </div>
        <div>
          <label style="font-size:.82rem;font-weight:700;">購入金額</label>
          {# Phase 2: buyTotalStart — buyTotalEnd range #}
        </div>

        <div>
          <label style="font-size:.82rem;font-weight:700;">誕生月</label>
          {# Phase 2: birthMonth filter field #}
        </div>
        <div>
          <label style="font-size:.82rem;font-weight:700;">購入件数</label>
          {# Phase 2: buyTimesStart — buyTimesEnd range #}
        </div>

        <div>
          <label style="font-size:.82rem;font-weight:700;">誕生日</label>
          {# Phase 2: birthStart — birthEnd range #}
        </div>
        <div>
          <label style="font-size:.82rem;font-weight:700;">登録日</label>
          {# Phase 2: createDatetimeStart — createDatetimeEnd range #}
        </div>

        <div>
          <label style="font-size:.82rem;font-weight:700;">都道府県</label>
          {# Phase 2: pref filter field #}
        </div>
        <div>
          <label style="font-size:.82rem;font-weight:700;">更新日</label>
          {# Phase 2: updateDatetimeStart — updateDatetimeEnd range #}
        </div>

        <div>
          <label style="font-size:.82rem;font-weight:700;">電話番号</label>
          {# Phase 2: phoneNumber filter field #}
        </div>
        <div>
          <label style="font-size:.82rem;font-weight:700;">最終購入日</label>
          {# Phase 2: lastBuyStart — lastBuyEnd range #}
        </div>

      </div>

    </div>
  </details>

</form>

{# ── Result toolbar ── #}
<div class="idea-admin-list-toolbar">
  <div class="idea-admin-list-toolbar__left">
    <span class="idea-admin-count">
      {{ count }}件
    </span>
  </div>
  {% if count %}
  <div class="idea-admin-list-toolbar__right">
    <a class="idea-admin-action" href="/admin/customer-csv">
      <i class="fa fa-cloud-download" aria-hidden="true"></i>
      CSV出力
    </a>
    <a class="idea-admin-action" href="/admin/csv-config">
      <i class="fa fa-cog" aria-hidden="true"></i>
      CSV出力項目設定
    </a>
  </div>
  {% endif %}
</div>

{# ── Customer table / empty state ── #}
{% if count %}
  <div class="idea-admin-table-wrap">
    <table class="idea-admin-table" aria-label="会員一覧">
      <thead>
        <tr>
          <th scope="col">会員ID</th>
          <th scope="col">お名前</th>
          <th scope="col">メールアドレス</th>
          <th scope="col">ステータス</th>
          <th scope="col" class="idea-admin-table__actions"></th>
        </tr>
      </thead>
      <tbody>
        {% for customer in customers %}
        <tr id="ex-customer-{{ customer.customerId }}">

          <td>{{ customer.customerId }}</td>

          <td>
            <a
              class="idea-admin-meta__link"
              href="/admin/customer?customerId={{ customer.customerId }}"
            >{{ customer.name01 }}&nbsp;{{ customer.name02 }}</a>
          </td>

          <td>{{ customer.email }}</td>

          <td>
            {% if customer.customerStatus == 1 %}
              <span class="idea-admin-badge idea-admin-badge--private">仮会員</span>
            {% elseif customer.customerStatus == 2 %}
              <span class="idea-admin-badge idea-admin-badge--public">本会員</span>
            {% else %}
              <span class="idea-admin-badge idea-admin-badge--discontinued">退会</span>
            {% endif %}
          </td>

          <td class="idea-admin-table__actions">
            {# Delete: POST /admin/delete-customer (doDeleteCustomer) #}
            <button
              class="idea-admin-icon-btn idea-admin-action--destructive"
              type="button"
              aria-label="{{ customer.email }}を削除"
              aria-controls="delete-dialog-{{ customer.customerId }}"
              aria-haspopup="dialog"
              onclick="document.getElementById('delete-dialog-{{ customer.customerId }}').showModal()"
            >
              <i class="fa fa-times" aria-hidden="true"></i>
            </button>
          </td>

        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Delete confirmation dialogs ── #}
  {% for customer in customers %}
  <dialog
    id="delete-dialog-{{ customer.customerId }}"
    aria-labelledby="delete-title-{{ customer.customerId }}"
    style="border:1px solid rgba(205,191,170,.45);border-radius:12px;padding:0;max-width:30rem;width:90%;"
  >
    <div class="idea-admin-panel__head">
      <h3 id="delete-title-{{ customer.customerId }}" style="margin:0;font-size:.9rem;font-weight:700;">削除の確認</h3>
    </div>
    <div class="idea-admin-panel__body">
      <p style="margin:0;font-size:.88rem;">
        この操作は元に戻せません。<strong>{{ customer.email }}</strong> を削除しますか？
      </p>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:.6rem;padding:.75rem 1rem;border-top:1px solid rgba(205,191,170,.35);">
      <button
        class="idea-admin-action"
        type="button"
        onclick="this.closest('dialog').close()"
      >キャンセル</button>
      <form method="post" action="/admin/delete-customer" style="display:contents;">
        <input type="hidden" name="customerId" value="{{ customer.customerId }}">
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
        <button class="idea-admin-action idea-admin-action--destructive" type="submit">
          削除
        </button>
      </form>
    </div>
  </dialog>
  {% endfor %}

{% else %}

  <div class="idea-admin-empty" role="status">
    <i class="fa fa-users fa-2x" aria-hidden="true"></i>
    <p class="idea-admin-empty__title">該当する会員が見つかりません</p>
    <p style="font-size:.84rem;">検索条件を変えて再度お試しください。</p>
  </div>

{% endif %}

{% endblock %}
