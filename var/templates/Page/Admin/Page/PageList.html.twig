{#
  BeMart admin Page list — EC-CUBE goPageList.

  PORT of EC-CUBE 4.3 admin-theme `Content/page.twig`
  (src/Eccube/Resource/template/admin/Content/page.twig).

  DATA/LIST page. Extends the admin frame (`admin-base.html.twig`). The
  markup skeleton + `c-*` / `ec-*` / Bootstrap classes are kept verbatim
  from EC-CUBE; only the dynamic bindings are rebound to the PageList
  resource body (src/Resource/Page/Admin/Page/PageList.php — body carries
  `count` + `pages`, a list of {pageId, pageName, pageUrl, pageFileName,
  pageEditType}).

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `canonical-url route, params)` -> deterministic `/{route}?{query}`
     (`BeMartTwigExtension`).
   - `{% for Page in Pages %}` -> the resource body's `pages` list.
   - `router.routecollection.get(Page.url).path` -> Symfony router lookup
     (the route-name column). BeMart has no Symfony router, so the
     ルーティング名 cell shows the bare `pageUrl` (EC-CUBE's `{% else %}`
     branch). Enumerated as residual.
   - `Page.layouts` (the per-page PC/Mobile layout join) -> NOT carried by
     the AdminPageListFetched projection (the page->layout join was out of
     the Wave 9 CMS slice). The レイアウト名 column renders empty, not
     invented. Enumerated as residual — MISSING-BODY-FIELD: `pages[].layouts`.
   - `Page.edit_type` -> the body carries `pageEditType` (2 = system /
     EDIT_TYPE_DEFAULT, 0 = EDIT_TYPE_USER). The delete affordance shows
     only for user pages (`pageEditType == 0`).
   - `csrf_token_for_anchor()` on the delete `<a>` -> EC-CUBE per-request
     CSRF widget. OMITTED. EC-CUBE-runtime only — enumerated as residual.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-page-page-list' %}
{% set title = 'ページ管理' %}
{% set sub_title = 'コンテンツ管理' %}

{% block javascript %}
    <script>
        // searchWordの実行
        $('#search-page').on('input', function() {
            searchWord($(this).val(), $('table.table tbody tr'));
        });
    </script>
{% endblock javascript %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="row justify-content-between mb-2">
                    <div class="col-9">
                        <a class="btn btn-ec-regular" href="/admin/page/page">
                            新規作成
                        </a>
                    </div>
                    <div class="col-3">
                        <div class="row">
                            <div class="col">
                                <div class="input-group mb-3">
                                    <div class="input-group-text">
                                        <span id="basic-addon1"><i class="fa fa-search"></i></span>
                                    </div>
                                    <input id="search-page" class="form-control" type="search" aria-label="Search">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card rounded border-0 mb-4">
                    <div class="card-body p-0">
                        <table class="table table-sm">
                            <thead>
                            <th class="border-0 pt-2 pb-2 ps-3">ページ名</th>
                            <th class="border-0 pt-2 pb-2 ps-3">ルーティング名</th>
                            <th class="border-0 pt-2 pb-2 ps-3">URL</th>
                            <th class="border-0 pt-2 pb-2 ps-3">ファイル名</th>
                            <th class="border-0 pt-2 pb-2">レイアウト名</th>
                            <th class="border-0 pt-2 pb-2 pe-3"></th>
                            </thead>
                            {% for Page in pages %}
                                <tr id="ex-page-{{ Page.pageId }}">
                                    <td class="align-middle ps-3">
                                        <a href="/admin/page/page?pageId={{ Page.pageId }}">{{ Page.pageName }}</a>
                                    </td>
                                    <td class="align-middle ps-3 text-break">
                                        {{ Page.pageUrl }}
                                    </td>
                                    <td class="align-middle ps-3 text-break">
                                        {{ Page.pageUrl }}
                                    </td>
                                    <td class="align-middle ps-3 text-break">
                                        {% if Page.pageFileName %}{{ Page.pageFileName }}.twig{% endif %}
                                    </td>
                                    {# TODO レイアウトの数にかかわらず高さを揃えたい #}
                                    <td class="align-middle pb-4 text-nowrap">
                                    </td>
                                    <td class="align-middle pe-3">
                                        <div class="row justify-content-end">
                                            {% if Page.pageEditType == 0 %}
                                                <div class="col-auto text-center" data-bs-toggle="tooltip" data-bs-placement="top" title="削除">
                                                    <a class="btn btn-ec-actionIcon" data-bs-toggle="modal" data-bs-target="#delete_{{ Page.pageId }}">
                                                        <i class="fa fa-close fa-lg text-secondary" aria-hidden="true"></i>
                                                    </a>
                                                </div>
                                                <div class="modal fade" id="delete_{{ Page.pageId }}" tabindex="-1" role="dialog"
                                                     aria-labelledby="delete_{{ Page.pageId }}" aria-hidden="true">
                                                    <div class="modal-dialog" role="document">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title fw-bold">削除します</h5>
                                                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close">

                                                                </button>
                                                            </div>
                                                            <div class="modal-body text-start">
                                                                <p class="text-start">この操作はあとから取り消すことができません。「{{ Page.pageName }}」を削除してよろしいですか？</p>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button class="btn btn-ec-sub" type="button" data-bs-dismiss="modal">キャンセル</button>
                                                                <a class="btn btn-ec-delete" href="/admin/page/page?pageId={{ Page.pageId }}&_method=delete"
                                                                         data-confirm="false">削除</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
