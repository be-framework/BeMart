{#
  BeMart admin — パスワード変更 (doChangePassword)

  Resource contract (src/Resource/Page/Admin/ChangePassword.php):
    GET  body.form   AdminChangePasswordForm — renders via form.input()/form.error()
    POST /admin/change-password  fields: current_password, change_password_first,
                                         change_password_second, csrfToken
    Link goAdminHome → /admin/index

  Password policy enforced by AdminPasswordChanged Final: 8–32 characters;
  new password must match confirmation; current password must verify.

  Design decisions (clean-room, no EC-CUBE mirror):
  - Narrow centered card — this is a security-sensitive, single-purpose
    action; a wide editor layout adds noise. Max 480 px card keeps the
    user's eye on what matters.
  - Three-step visual separation: current credential / new credential /
    confirm. Helps users understand why three fields exist.
  - Inline strength hint rendered by vanilla JS (no library). Updates as
    the user types the new password.
  - Fixed bottom toolbar with a single primary action and a back link,
    consistent with other idea-admin editor pages.
  - No sidebar-layout (idea-admin-layout two-column) — irrelevant side
    panel would occupy 300 px for nothing on this narrow task.
#}
{% extends 'admin-base.html.twig' %}

{% set route   = 'admin-change-password' %}
{% set title   = 'パスワード変更' %}
{% set sub_title = 'セキュリティ' %}

{% block stylesheet %}
<style>
/* ── narrow centered card ──────────────────────────────────────── */
.idea-admin-pw-card {
  max-width: 480px;
  margin: 0 auto;
}

/* ── strength meter ────────────────────────────────────────────── */
.idea-admin-pw-strength {
  margin-top: .35rem;
}
.idea-admin-pw-strength__bar {
  height: 4px;
  border-radius: 999px;
  background: var(--idea-stone);
  overflow: hidden;
}
.idea-admin-pw-strength__fill {
  height: 100%;
  border-radius: 999px;
  width: 0;
  transition: width .25s, background-color .25s;
}
.idea-admin-pw-strength__label {
  font-size: .72rem;
  color: var(--idea-muted);
  margin-top: .2rem;
}

/* ── toggle visibility button ──────────────────────────────────── */
.idea-admin-pw-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.idea-admin-pw-wrap input {
  padding-right: 2.6rem !important;
  flex: 1;
}
.idea-admin-pw-toggle {
  position: absolute;
  right: .55rem;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--idea-muted);
  font-size: .9rem;
  padding: .25rem;
  line-height: 1;
  transition: color .14s;
}
.idea-admin-pw-toggle:hover { color: var(--idea-ink); }

/* ── policy hint list ──────────────────────────────────────────── */
.idea-admin-pw-policy {
  list-style: none;
  margin: .45rem 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: .2rem;
}
.idea-admin-pw-policy li {
  font-size: .76rem;
  color: var(--idea-muted);
  display: flex;
  align-items: center;
  gap: .3rem;
}
.idea-admin-pw-policy li.is-ok { color: var(--idea-olive); }
.idea-admin-pw-policy li .policy-icon { font-size: .7rem; }
</style>
{% endblock %}

{% block main %}
<div class="idea-admin-pw-card">

  <div class="idea-admin-page-header">
    <h1 class="idea-admin-page-title">
      <i class="fa fa-lock" aria-hidden="true"></i>
      パスワード変更
    </h1>
    <span class="idea-admin-page-subtitle">セキュリティ</span>
  </div>

  {% if message is defined and message %}
  <div class="idea-admin-notice idea-admin-notice--error" role="alert" aria-live="polite">
    <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
    {{ message }}
  </div>
  {% endif %}

  <form
    id="change_password_form"
    method="post"
    action="/admin/change-password"
    novalidate
    aria-label="パスワード変更フォーム"
  >
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    {# ── Step 1: current credential ─────────────────────────────── #}
    <section class="idea-admin-panel" aria-labelledby="section-current">
      <div class="idea-admin-panel__head">
        <h3 id="section-current">
          <i class="fa fa-key" aria-hidden="true"></i>
          現在のパスワード
        </h3>
      </div>
      <div class="idea-admin-panel__body">

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="admin_change_password_current_password">現在のパスワード</label>
            <span class="idea-admin-required">必須</span>
          </div>
          <div class="idea-admin-field__input">
            <div class="idea-admin-pw-wrap">
              {{ form.input('current_password')|raw }}
              <button
                type="button"
                class="idea-admin-pw-toggle"
                aria-label="パスワードを表示"
                data-target="admin_change_password_current_password"
              ><i class="fa fa-eye" aria-hidden="true"></i></button>
            </div>
            {% if form.error('current_password') %}
            <span class="idea-admin-error" role="alert">{{ form.error('current_password') }}</span>
            {% endif %}
          </div>
        </div>

      </div>
    </section>

    {# ── Step 2 & 3: new credential ─────────────────────────────── #}
    <section class="idea-admin-panel" aria-labelledby="section-new">
      <div class="idea-admin-panel__head">
        <h3 id="section-new">
          <i class="fa fa-shield-halved" aria-hidden="true"></i>
          新しいパスワード
        </h3>
        <span class="idea-admin-panel__hint">8〜32文字</span>
      </div>
      <div class="idea-admin-panel__body">

        {# new password with strength meter #}
        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="admin_change_password_change_password_first">新しいパスワード</label>
            <span class="idea-admin-required">必須</span>
          </div>
          <div class="idea-admin-field__input">
            <div class="idea-admin-pw-wrap">
              {{ form.input('change_password_first')|raw }}
              <button
                type="button"
                class="idea-admin-pw-toggle"
                aria-label="パスワードを表示"
                data-target="admin_change_password_change_password_first"
              ><i class="fa fa-eye" aria-hidden="true"></i></button>
            </div>
            {% if form.error('change_password_first') %}
            <span class="idea-admin-error" role="alert">{{ form.error('change_password_first') }}</span>
            {% endif %}
            <div class="idea-admin-pw-strength" aria-hidden="true">
              <div class="idea-admin-pw-strength__bar">
                <div class="idea-admin-pw-strength__fill" id="pw-strength-fill"></div>
              </div>
              <p class="idea-admin-pw-strength__label" id="pw-strength-label"></p>
            </div>
            <ul class="idea-admin-pw-policy" aria-live="polite">
              <li id="policy-length">
                <span class="policy-icon"><i class="fa fa-circle-xmark" aria-hidden="true"></i></span>
                8文字以上32文字以下
              </li>
            </ul>
          </div>
        </div>

        {# confirm #}
        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="admin_change_password_change_password_second">確認用パスワード</label>
            <span class="idea-admin-required">必須</span>
          </div>
          <div class="idea-admin-field__input">
            <div class="idea-admin-pw-wrap">
              {{ form.input('change_password_second')|raw }}
              <button
                type="button"
                class="idea-admin-pw-toggle"
                aria-label="パスワードを表示"
                data-target="admin_change_password_change_password_second"
              ><i class="fa fa-eye" aria-hidden="true"></i></button>
            </div>
            {% if form.error('change_password_second') %}
            <span class="idea-admin-error" role="alert">{{ form.error('change_password_second') }}</span>
            {% endif %}
            <p class="idea-admin-pw-strength__label" id="pw-match-hint" aria-live="polite"></p>
          </div>
        </div>

      </div>
    </section>

  </form>

</div>{# /.idea-admin-pw-card #}

{# ── Fixed bottom toolbar ───────────────────────────────────────── #}
<div class="idea-admin-toolbar" role="toolbar" aria-label="フォーム操作">
  <div class="idea-admin-toolbar__back">
    <a href="/admin/index" rel="goAdminHome">
      <i class="fa fa-angle-left" aria-hidden="true"></i>
      ホームへ戻る
    </a>
  </div>
  <div class="idea-admin-toolbar__actions">
    <button
      type="submit"
      form="change_password_form"
      class="idea-admin-action idea-admin-action--primary"
    >
      <i class="fa fa-check" aria-hidden="true"></i>
      パスワードを変更
    </button>
  </div>
</div>
{% endblock %}

{% block javascript %}
<script>
(function () {
  'use strict';

  /* ── visibility toggle ───────────────────────────────────────── */
  document.querySelectorAll('.idea-admin-pw-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var targetId = btn.dataset.target;
      var input = document.getElementById(targetId);
      if (!input) return;
      var isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      var icon = btn.querySelector('i');
      if (icon) {
        icon.className = isHidden ? 'fa fa-eye-slash' : 'fa fa-eye';
      }
      btn.setAttribute('aria-label', isHidden ? 'パスワードを隠す' : 'パスワードを表示');
    });
  });

  /* ── strength meter ──────────────────────────────────────────── */
  var firstInput  = document.getElementById('admin_change_password_change_password_first');
  var secondInput = document.getElementById('admin_change_password_change_password_second');
  var fill        = document.getElementById('pw-strength-fill');
  var label       = document.getElementById('pw-strength-label');
  var matchHint   = document.getElementById('pw-match-hint');
  var policyLen   = document.getElementById('policy-length');

  var LEVELS = [
    { max: 0,  pct: 0,   color: '',                        text: '' },
    { max: 7,  pct: 20,  color: 'var(--idea-clay)',        text: '短すぎます' },
    { max: 11, pct: 45,  color: '#c09020',                 text: '普通' },
    { max: 19, pct: 72,  color: 'var(--idea-olive)',       text: '強い' },
    { max: 32, pct: 100, color: 'var(--idea-focus)',       text: '非常に強い' },
  ];

  function evalStrength(pw) {
    var len = pw.length;
    if (len === 0) return LEVELS[0];
    if (len <= 7)  return LEVELS[1];
    if (len <= 11) return LEVELS[2];
    if (len <= 19) return LEVELS[3];
    return LEVELS[4];
  }

  function updatePolicy(pw) {
    var len = pw.length;
    var ok = len >= 8 && len <= 32;
    if (policyLen) {
      policyLen.className = ok ? 'is-ok' : '';
      var icon = policyLen.querySelector('.policy-icon i');
      if (icon) icon.className = ok ? 'fa fa-circle-check' : 'fa fa-circle-xmark';
    }
  }

  function updateMatch() {
    if (!firstInput || !secondInput || !matchHint) return;
    var first  = firstInput.value;
    var second = secondInput.value;
    if (second.length === 0) {
      matchHint.textContent = '';
      matchHint.style.color = '';
      return;
    }
    if (first === second) {
      matchHint.textContent = '一致しています';
      matchHint.style.color = 'var(--idea-olive)';
    } else {
      matchHint.textContent = '一致していません';
      matchHint.style.color = 'var(--idea-clay)';
    }
  }

  if (firstInput) {
    firstInput.addEventListener('input', function () {
      var pw  = firstInput.value;
      var lvl = evalStrength(pw);
      if (fill) {
        fill.style.width           = lvl.pct + '%';
        fill.style.backgroundColor = lvl.color;
      }
      if (label) label.textContent = lvl.text;
      updatePolicy(pw);
      updateMatch();
    });
  }

  if (secondInput) {
    secondInput.addEventListener('input', updateMatch);
  }
}());
</script>
{% endblock %}
