{#
  BeMart admin パスワード変更 — EC-CUBE admin change_password.

  PORT of EC-CUBE 4.3 admin-theme `change_password.twig`
  (src/Eccube/Resource/template/admin/change_password.twig).

  This is a top-level wave FORM/CRUD page. It extends the standard admin
  frame (`admin-base.html.twig`, the port of EC-CUBE's admin
  `default_frame.twig`). The markup skeleton + `c-*` / `ec-*` /
  Bootstrap classes are kept verbatim from EC-CUBE; only the dynamic
  bindings are rebound to the ChangePassword resource body
  (src/Resource/Page/Admin/ChangePassword.php).

  FORM-PAGE recipe (Ray.WebFormModule — see var/templates/README.md):
  the ChangePassword resource exposes an
  {@see \MyVendor\BeMart\Form\AdminChangePasswordForm} as `body['form']`.
  The inputs render through that real form object:

    {{ form.input('current_password')|raw }}
    {{ form.input('change_password_first')|raw }}
    {{ form.input('change_password_second')|raw }}

  EC-CUBE renders the same inputs through the Symfony FormView
  (`form_widget(form.current_password)` etc.); Ray.WebFormModule is
  BeMart's BEAR-idiomatic equivalent. EC-CUBE's `change_password` field
  is a `RepeatedType` (`.first` / `.second`); AbstractForm is flat, so
  the pair is two flat fields — see `AdminChangePasswordForm`.

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `form_widget(form._token)` -> EC-CUBE per-request CSRF widget. The
     hidden `_token` input is kept (structure) with an empty value;
     EC-CUBE-runtime only — enumerated as residual.
   - `form_errors(...)` -> inline field errors. The thin-renderer
     ChangePassword resource has no Be domain verdict to bridge (the be/
     layer is frozen for this wave — see the resource doc), so the
     inline-error <span>s render only when the form carries a bridged
     error; with the empty form they render nothing, exactly as EC-CUBE
     renders nothing for a pristine form.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin_change_password' %}
{% set title = 'パスワード変更' %}
{% set sub_title = '' %}

{% block main %}
    <form method="post" action="">
        <input type="hidden" id="admin_change_password__token" name="_token" value="{{ csrfToken|default('') }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    <div class="d-inline-block">
                                        <span class="card-title">パスワード変更</span>
                                    </div>
                                </div>
                                <div class="col-4 text-end">
                                    <a data-bs-toggle="collapse" href="#basicConfig" aria-expanded="false" aria-controls="basicConfig"><i class="fa fa-angle-up fa-lg"></i></a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="basicConfig">
                            <div class="card-body">
                                <!-- 現在のパスワード -->
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <div class="d-inline-block">
                                            <span>現在のパスワード</span>
                                            <span class="badge bg-primary ms-1">必須</span>
                                        </div>
                                    </div>
                                    <div class="col">
                                        {{ form.input('current_password')|raw }}
                                        {% if form.error('current_password') %}<span class="invalid-feedback d-block">{{ form.error('current_password') }}</span>{% endif %}
                                    </div>
                                </div>
                                <!-- 新しいパスワード -->
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <div class="d-inline-block">
                                            <span>新しいパスワード</span>
                                            <span class="badge bg-primary ms-1">必須</span>
                                        </div>
                                    </div>
                                    <div class="col">
                                        {{ form.input('change_password_first')|raw }}
                                        {% if form.error('change_password_first') %}<span class="invalid-feedback d-block">{{ form.error('change_password_first') }}</span>{% endif %}
                                    </div>
                                </div>
                                <!-- 新しいパスワード -->
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <div class="d-inline-block">
                                            <span>新しいパスワード(確認)</span>
                                            <span class="badge bg-primary ms-1">必須</span>
                                        </div>
                                    </div>
                                    <div class="col">
                                        {{ form.input('change_password_second')|raw }}
                                        {% if form.error('change_password_second') %}<span class="invalid-feedback d-block">{{ form.error('change_password_second') }}</span>{% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- /.card -->
                </div>
            </div>

            <div class="c-conversionArea">
                <div class="c-conversionArea__container">
                    <div class="row justify-content-between align-items-center">
                        <div class="col-6">
                            <div class="c-conversionArea__leftBlockItem"></div>
                        </div>
                        <div class="col-6">
                            <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-ec-conversion px-5">登録</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
