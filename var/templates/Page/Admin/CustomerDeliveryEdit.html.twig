{#
  BeMart admin customer delivery-address editor — EC-CUBE Customer/delivery_edit.twig.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin_customer_address_edit' %}
{% set title = 'お届け先編集' %}
{% set sub_title = '会員管理' %}

{% block main %}
    <form role="form" method="post" action="" id="form1" name="form1" novalidate>
        <input type="hidden" name="_token" value="{{ csrfToken|default(csrf_token('bemart')) }}">
        <input type="hidden" name="customer_id" value="{{ customerId|default('') }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    <span class="card-title">お届け先</span>
                                </div>
                                <div class="col-4 text-end">
                                    <a data-bs-toggle="collapse" href="#deliveryAddress" aria-expanded="false" aria-controls="deliveryAddress">
                                        <i class="fa fa-angle-up fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="deliveryAddress">
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>お名前</span>
                                        <span class="badge bg-primary ms-1">必須</span>
                                    </div>
                                    <div class="col">
                                        <div class="row">
                                            <div class="col">
                                                {{ form.input('name01')|raw }}
                                                {% if form.error('name01') %}<span class="invalid-feedback d-block">{{ form.error('name01') }}</span>{% endif %}
                                            </div>
                                            <div class="col">
                                                {{ form.input('name02')|raw }}
                                                {% if form.error('name02') %}<span class="invalid-feedback d-block">{{ form.error('name02') }}</span>{% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>お名前(カナ)</span>
                                    </div>
                                    <div class="col">
                                        <div class="row">
                                            <div class="col">{{ form.input('kana01')|raw }}</div>
                                            <div class="col">{{ form.input('kana02')|raw }}</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>会社名</span>
                                    </div>
                                    <div class="col">
                                        {{ form.input('company_name')|raw }}
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>郵便番号</span>
                                    </div>
                                    <div class="col">
                                        {{ form.input('postal_code')|raw }}
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>都道府県</span>
                                    </div>
                                    <div class="col">
                                        {{ form.input('pref')|raw }}
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>住所</span>
                                    </div>
                                    <div class="col">
                                        <div class="mb-2">{{ form.input('addr01')|raw }}</div>
                                        <div>{{ form.input('addr02')|raw }}</div>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-3">
                                        <span>電話番号</span>
                                    </div>
                                    <div class="col">
                                        {{ form.input('phone_number')|raw }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="{{ customerId ? url('admin_customer_edit', { id: customerId }) : url('admin_customer') }}">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>会員編集ページに戻る</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button type="submit" class="btn btn-ec-conversion px-5">登録</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
