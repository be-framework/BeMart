{% extends 'admin-base.html.twig' %}

{% set title = 'カテゴリCSV' %}
{% set sub_title = 'カテゴリ管理' %}

{% block main %}
    <form method="post" action="/admin/category/csv" enctype="multipart/form-data">
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default(csrf_token()) }}">
        <textarea name="csv" rows="8" cols="80"></textarea>
        <button type="submit">CSV登録</button>
    </form>
    <a href="/admin/order/export-order">受注CSV</a>
{% endblock %}
