<script>
(function () {
    'use strict';

    // ── Utility ─────────────────────────────────────────────────────────────

    /**
     * @param {string} selector
     * @param {Element|Document} [ctx]
     * @returns {Element|null}
     */
    function qs(selector, ctx) {
        return (ctx || document).querySelector(selector);
    }

    /**
     * @param {string} selector
     * @param {Element|Document} [ctx]
     * @returns {NodeList}
     */
    function qsa(selector, ctx) {
        return (ctx || document).querySelectorAll(selector);
    }

    /** @returns {string} */
    function getCsrfToken() {
        var field = qs('#form-bulk input[name="csrfToken"]');
        return field ? field.value : '';
    }

    /**
     * POST via fetch. Returns a Promise resolving with the JSON body.
     * @param {string} url
     * @param {Object} data
     * @returns {Promise<any>}
     */
    function postJson(url, data) {
        var params = new URLSearchParams();
        Object.keys(data).forEach(function (k) {
            if (data[k] !== undefined && data[k] !== null) {
                params.append(k, data[k]);
            }
        });
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: params.toString()
        }).then(function (res) {
            if (!res.ok) {
                return Promise.reject(new Error('HTTP ' + res.status));
            }
            return res.json().catch(function () { return {}; });
        });
    }

    // ── Dialog (native <dialog>) ─────────────────────────────────────────────

    var dialog = qs('#idea-admin-confirmation-dialog');
    if (!dialog) { return; }

    var dialogTitle   = qs('.idea-admin-dialog__title', dialog);
    var dialogMessage = qs('.idea-admin-dialog__message', dialog);
    var dialogActions = qs('.idea-admin-dialog__actions', dialog);
    var dialogProgress = qs('.idea-admin-dialog__progress', dialog);
    var progressBar   = qs('.idea-admin-progress__bar', dialog);
    var errorList     = qs('.idea-admin-dialog__errors', dialog);
    var mailPreview   = qs('.idea-admin-dialog__mail-preview', dialog);
    var notificationMailRow = qs('.idea-admin-dialog__notification-row', dialog);
    var confirmBtn    = qs('[data-action="confirm"]', dialog);
    var cancelBtn     = qs('[data-action="cancel"]', dialog);

    /**
     * Reset the dialog to its initial state before showing.
     * @param {string} title
     * @param {string} message
     * @param {string} buttonLabel
     */
    function openDialog(title, message, buttonLabel) {
        if (dialogTitle)   { dialogTitle.textContent = title; }
        if (dialogMessage) { dialogMessage.textContent = message; }
        if (confirmBtn)    { confirmBtn.textContent = buttonLabel; }
        if (dialogProgress) { dialogProgress.hidden = true; }
        if (dialogActions)  { dialogActions.hidden = false; }
        if (errorList)      { errorList.innerHTML = ''; errorList.hidden = true; }
        if (progressBar)    { progressBar.style.width = '0%'; }
        if (mailPreview)    { mailPreview.innerHTML = ''; mailPreview.hidden = true; }
        dialog.showModal();
    }

    function closeDialog() {
        dialog.close();
    }

    if (cancelBtn) {
        cancelBtn.addEventListener('click', closeDialog);
    }

    dialog.addEventListener('click', function (e) {
        // close on backdrop click (click on dialog element itself)
        if (e.target === dialog) { closeDialog(); }
    });

    // ── Progress helpers ─────────────────────────────────────────────────────

    var currentCount = 0;
    var totalCount   = 0;

    function startProgress(total) {
        currentCount = 0;
        totalCount   = total;
        if (dialogProgress) { dialogProgress.hidden = false; }
        if (dialogActions)  { dialogActions.hidden = true; }
        if (progressBar)    { progressBar.style.width = '0%'; }
    }

    function advanceProgress(result) {
        currentCount++;
        if (progressBar) {
            progressBar.style.width = (currentCount / totalCount * 100).toFixed(1) + '%';
        }
        if (result && result.message && errorList) {
            var li = document.createElement('li');
            li.className = 'idea-admin-dialog__error-item idea-admin-dialog__error-item--notice';
            li.textContent = result.message;
            errorList.appendChild(li);
            errorList.hidden = false;
        }
    }

    function failProgress() {
        if (!errorList) { return; }
        var li = document.createElement('li');
        li.className = 'idea-admin-dialog__error-item idea-admin-dialog__error-item--error';
        li.textContent = 'システムエラーが発生しました';
        errorList.appendChild(li);
        errorList.hidden = false;
    }

    function finishProgress(message) {
        if (dialogProgress) { dialogProgress.hidden = true; }
        if (dialogActions)  { dialogActions.hidden = false; }
        if (confirmBtn)     { confirmBtn.hidden = true; }
        if (dialogMessage)  { dialogMessage.textContent = message || '完了しました。'; }
    }

    // ── Status update (single order) ─────────────────────────────────────────

    /**
     * @param {Element} trigger  — the clicked button/link with data-* attrs
     */
    function initSimpleStatusUpdate(trigger) {
        var updateUrl  = trigger.dataset.updateStatusUrl;
        var statusId   = trigger.dataset.updateStatusId;
        var previewUrl = trigger.dataset.previewNotifyMailUrl;

        if (notificationMailRow) { notificationMailRow.hidden = false; }

        if (previewUrl && mailPreview) {
            fetch(previewUrl)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    mailPreview.innerHTML = html;
                    mailPreview.hidden = false;
                })
                .catch(function () {});
        }

        openDialog(
            '対応状況を変更します',
            '対応状況を変更します。同時に行う操作を選択してから［実行］ボタンを押してください。この操作は取り消すことができません。',
            '実行'
        );

        confirmBtn.onclick = function () {
            var notifyMail = qs('input#notification-mail:checked');
            startProgress(1);
            var mailCount = 0;

            postJson(updateUrl, {
                orderStatus: statusId,
                notificationMail: notifyMail ? notifyMail.value : undefined,
                csrfToken: getCsrfToken()
            })
                .then(function (result) {
                    if (result && result.mail) { mailCount++; }
                    advanceProgress(result);
                    var suffix = mailCount > 0 ? mailCount + '件のメールを送信しました。' : '';
                    finishProgress('完了しました。' + suffix);
                })
                .catch(function () {
                    failProgress();
                    finishProgress('エラーが発生しました。');
                });
        };
    }

    // ── Status update (bulk) ─────────────────────────────────────────────────

    function initBulkStatusUpdate() {
        var bulkStatusSelect = qs('#option-bulk-status');
        if (!bulkStatusSelect || bulkStatusSelect.value === '') {
            alert('対応状況を選択してください');
            return false;
        }

        if (notificationMailRow) { notificationMailRow.hidden = true; }

        openDialog(
            '対応状況の変更',
            '選択した受注の対応状況を一括変更します。この操作は取り消すことができません。',
            '実行'
        );

        var targets = Array.from(qsa('input[data-id]:checked'));
        confirmBtn.onclick = function () {
            startProgress(targets.length);
            var chain = Promise.resolve();
            targets.forEach(function (input) {
                chain = chain.then(function () {
                    return postJson(input.dataset.updateStatusUrl, {
                        orderStatus: bulkStatusSelect.value,
                        csrfToken: getCsrfToken()
                    })
                        .then(function (result) { advanceProgress(result); })
                        .catch(function () { failProgress(); });
                });
            });
            chain.then(function () { finishProgress(); });
        };
        return true;
    }

    // ── Mail send (single) ────────────────────────────────────────────────────

    function initSimpleSendMail(trigger) {
        var notifyUrl  = trigger.dataset.notifyMailUrl;
        var previewUrl = trigger.dataset.previewNotifyMailUrl;

        if (notificationMailRow) { notificationMailRow.hidden = true; }

        if (previewUrl && mailPreview) {
            fetch(previewUrl)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    mailPreview.innerHTML = html;
                    mailPreview.hidden = false;
                })
                .catch(function () {});
        }

        openDialog(
            '出荷お知らせメールを送信します',
            '出荷お知らせメールを送信します。メールの文面を確認してから［送信］ボタンを押してください。この操作は取り消すことができません。',
            '送信'
        );

        confirmBtn.onclick = function () {
            startProgress(1);
            postJson(notifyUrl, { csrfToken: getCsrfToken() })
                .then(function (result) {
                    advanceProgress(result);
                    finishProgress('完了しました。');
                })
                .catch(function () {
                    failProgress();
                    finishProgress('エラーが発生しました。');
                });
        };
    }

    // ── Mail send (bulk) ─────────────────────────────────────────────────────

    function initBulkSendMail() {
        var targets = Array.from(qsa('input[data-preview-notify-mail-url]:checked'));
        if (!targets.length) { return false; }

        if (notificationMailRow) { notificationMailRow.hidden = true; }

        var firstPreviewUrl = targets[0].dataset.previewNotifyMailUrl;
        if (firstPreviewUrl && mailPreview) {
            fetch(firstPreviewUrl)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    mailPreview.innerHTML = html;
                    mailPreview.hidden = false;
                })
                .catch(function () {});
        }

        openDialog(
            '出荷お知らせメールを送信します',
            '出荷お知らせメールを送信します。メールの文面を確認してから［送信］ボタンを押してください。この操作は取り消すことができません。',
            '送信'
        );

        confirmBtn.onclick = function () {
            var mailTargets = Array.from(qsa('input[data-notify-mail-url]:checked'));
            startProgress(mailTargets.length || 1);
            var chain = Promise.resolve();
            mailTargets.forEach(function (input) {
                chain = chain.then(function () {
                    return postJson(input.dataset.notifyMailUrl, { csrfToken: getCsrfToken() })
                        .then(function (result) { advanceProgress(result); })
                        .catch(function () { failProgress(); });
                });
            });
            chain.then(function () { finishProgress(); });
        };
        return true;
    }

    // ── Event delegation ─────────────────────────────────────────────────────

    document.addEventListener('click', function (e) {
        var trigger = e.target.closest('[data-modal-type]');
        if (!trigger) { return; }
        e.preventDefault();

        var modalType    = trigger.dataset.modalType;    // 'status' | 'mail'
        var isBulk       = trigger.dataset.bulkUpdate === 'true';

        if (modalType === 'status') {
            if (isBulk) {
                initBulkStatusUpdate();
            } else {
                initSimpleStatusUpdate(trigger);
            }
        } else if (modalType === 'mail') {
            if (isBulk) {
                initBulkSendMail();
            } else {
                initSimpleSendMail(trigger);
            }
        }
    });

}());
</script>
