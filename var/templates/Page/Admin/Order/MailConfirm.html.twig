{#
  BeMart admin order-mail confirm — EC-CUBE admin-theme
  `Order/mail_confirm.twig`.

  PORT of EC-CUBE 4.3 `src/Eccube/Resource/template/admin/Order/mail_confirm.twig`
  — the 受注メール確認 step between the mail composer and the actual
  send. It extends the admin frame (`admin-base.html.twig`).

  Tier-2 port note: EC-CUBE renders the composed subject / body as a
  read-only preview here. The Be domain re-sends the order-confirmation
  mail keyed by orderNo only, so the composed-content preview is Phase
  2 scope — the page renders the confirm-and-send shell, and the
  composed-content block is dropped as an enumerated residual.

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `canonical-url route, params)` -> deterministic `/{route}?{query}`.
   - `csrf_token()` hidden input -> `csrfToken|default('')`.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-order-mail-confirm' %}
{% set title = '受注メール確認' %}
{% set sub_title = '受注管理' %}

{% block main %}
    <form role="form" method="post" action="/admin/order/send-mail?orderNo={{ orderNo }}" id="mail_confirm_form" name="form1" novalidate>
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
        <input type="hidden" name="orderNo" value="{{ orderNo|default('') }}">
        <input type="hidden" name="mode" value="complete">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <span class="card-title">送信内容の確認</span>
                        </div>
                        <div class="card-body">
                            <p>以下の内容でメールを送信します。よろしければ「送信する」を押してください。</p>
                            <div class="bg-light p-4 bg-ec-formGray" id="mail_confirm_body" style="word-wrap: break-word; word-break:break-all"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="/admin/order/send-mail?orderNo={{ orderNo }}">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>戻る</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button type="submit" class="btn btn-ec-conversion px-5">送信する</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
