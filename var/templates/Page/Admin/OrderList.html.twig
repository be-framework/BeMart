{% extends 'admin-base.html.twig' %}

{% set route = 'admin-order-list' %}
{% set title = '受注一覧' %}
{% set sub_title = '受注管理' %}

{% block main %}

    {# --- keyword search bar ------------------------------------------ #}
    <form id="search_form" method="get" action="/admin/order-list"
          class="idea-admin-search-bar">
        <div class="idea-admin-field">
            <label class="idea-admin-field__label" for="admin_search_order_multi">
                <i class="fa fa-search fa-fw" aria-hidden="true"></i>
                注文番号・会員ID・メールアドレス
            </label>
            <div class="idea-admin-field__input">
                {{ searchForm.input('multi')|raw }}
            </div>
        </div>
        <div class="idea-admin-list-toolbar">
            <div class="idea-admin-list-toolbar__left">
                <button type="submit" class="idea-admin-action idea-admin-action--primary">
                    <i class="fa fa-search fa-fw" aria-hidden="true"></i>
                    絞り込む
                </button>
                <span class="idea-admin-count">
                    {{ count }} 件
                </span>
            </div>
            <div class="idea-admin-list-toolbar__right">
                <a class="idea-admin-action" href="/admin/order/export-order">
                    <i class="fa fa-download fa-fw" aria-hidden="true"></i>
                    受注CSV
                </a>
                <a class="idea-admin-action" href="/admin/order/export-shipping">
                    <i class="fa fa-download fa-fw" aria-hidden="true"></i>
                    出荷CSV
                </a>
                <a class="idea-admin-action idea-admin-action--primary"
                   href="/admin/order/create" rel="doCreateOrder">
                    <i class="fa fa-plus fa-fw" aria-hidden="true"></i>
                    新規受注
                </a>
            </div>
        </div>
    </form>

    {# --- order grid -------------------------------------------------- #}
    {% if count %}

        <div class="idea-admin-table-wrap">
            <table class="idea-admin-table" id="search_result">
                <thead>
                    <tr>
                        <th class="idea-admin-table__check">
                            <input type="checkbox" id="toggle_check_all"
                                   aria-label="全件選択">
                        </th>
                        <th>注文番号</th>
                        <th>会員ID</th>
                        <th>注文日</th>
                        <th>対応状況</th>
                        <th>支払合計</th>
                        <th class="idea-admin-table__actions">操作</th>
                    </tr>
                </thead>
                <tbody>
                {% for Order in orders %}
                    <tr id="order-{{ Order.orderNo }}">
                        <td class="idea-admin-table__check">
                            <input type="checkbox"
                                   id="check_{{ Order.orderNo }}"
                                   name="ids[]"
                                   value="{{ Order.orderNo }}"
                                   data-update-status-url="/admin/order-status?orderNo={{ Order.orderNo }}"
                                   aria-label="{{ Order.orderNo }}">
                        </td>
                        <td>
                            <a href="/admin/order?orderNo={{ Order.orderNo }}"
                               rel="goOrder">
                                {{ Order.orderNo }}
                            </a>
                        </td>
                        <td>{{ Order.customerId }}</td>
                        <td>{{ Order.orderDate }}</td>
                        <td>
                            {% set statusLabels = {
                                1: '新規受付',
                                3: '注文取消',
                                4: '対応中',
                                5: '発送済み',
                                6: '入金済み',
                                7: '決済処理中',
                                8: '購入処理中',
                                9: '返品'
                            } %}
                            <span class="idea-admin-badge">
                                {{ statusLabels[Order.orderStatus] ?? Order.orderStatus }}
                            </span>
                        </td>
                        <td>{{ Order.paymentTotal|price }}</td>
                        <td class="idea-admin-table__actions">
                            <a class="idea-admin-icon-btn"
                               href="/admin/order?orderNo={{ Order.orderNo }}"
                               rel="goOrder"
                               title="詳細">
                                <i class="fa fa-pencil fa-fw" aria-hidden="true"></i>
                            </a>
                            <a class="idea-admin-icon-btn"
                               href="/admin/order/export-order-pdf?ids[]={{ Order.orderNo }}"
                               title="納品書出力">
                                <i class="fa fa-file-text fa-fw" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

    {% else %}

        <div class="idea-admin-empty">
            <i class="fa fa-inbox fa-3x" aria-hidden="true"></i>
            <p class="idea-admin-empty__title">該当する受注がありません</p>
        </div>

    {% endif %}

{% endblock %}
