{% extends 'admin-base.html.twig' %}

{% set route = 'admin-store-plugin' %}
{% set title = 'プラグイン管理' %}
{% set sub_title = 'オーナーズストア' %}

{#
  DATA CONTRACT (src/Resource/Page/Admin/PluginList.php):
    plugins    list<{pluginCode, pluginName, pluginVersion, installed, enabled}>
    count      int — total rows

  ACTIONS (derived from resource #[Link] annotations):
    GET    /admin/plugin-list              — goPluginList (this page)
    POST   /admin/plugin-list             — doInstallPlugin (install: pluginCode, pluginName, pluginVersion)
    POST   /admin/plugin-enable           — doEnablePlugin  (pluginCode)
    POST   /admin/plugin-disable          — doDisablePlugin (pluginCode)
    DELETE /admin/plugin                  — doUninstallPlugin (pluginCode) via _method=delete

  Design vocabulary: idea-admin-* (public/assets/idea-store/css/idea-admin.css)
    idea-admin-panel         card/section wrapper
    idea-admin-panel__head   card header
    idea-admin-panel__body   card body
    idea-admin-list-toolbar  result toolbar (count)
    idea-admin-table-wrap    overflow wrapper for the data table
    idea-admin-table         data table
    idea-admin-badge         status chip (--public / --private)
    idea-admin-action        action button / link (--primary / --destructive)
    idea-admin-icon-btn      icon-only button
    idea-admin-empty         zero-result state

  Omitted (out-of-scope / no projection data):
    - Owners-store card (officialPlugins): EC-CUBE.co marketplace API not ported
    - Per-plugin update-archive upload form (plugin_forms): not in PluginListFetched
    - Per-plugin config-page link (configPages): not in PluginListFetched
    - CSRF token on anchor-based transitions: handled by BEAR layer middleware
#}

{% block main %}

{# ── Install panel ── #}
<div class="idea-admin-panel" style="margin-bottom:1.5rem;">
  <div class="idea-admin-panel__head">
    <h3>プラグインのインストール</h3>
  </div>
  <div class="idea-admin-panel__body">
    <form
      id="plugin-install-form"
      method="post"
      action="/admin/plugin-list"
      aria-label="プラグインインストール"
    >
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:.75rem;align-items:end;">

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="install-plugin-code">
              プラグインコード
              <span class="idea-admin-required">必須</span>
            </label>
          </div>
          <div class="idea-admin-field__input">
            <input
              id="install-plugin-code"
              type="text"
              name="pluginCode"
              required
              maxlength="128"
              placeholder="Vendor/PluginName"
              autocomplete="off"
            >
          </div>
        </div>

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="install-plugin-name">
              プラグイン名
              <span class="idea-admin-required">必須</span>
            </label>
          </div>
          <div class="idea-admin-field__input">
            <input
              id="install-plugin-name"
              type="text"
              name="pluginName"
              required
              maxlength="128"
              placeholder="My Plugin"
              autocomplete="off"
            >
          </div>
        </div>

        <div class="idea-admin-field">
          <div class="idea-admin-field__label">
            <label for="install-plugin-version">
              バージョン
              <span class="idea-admin-required">必須</span>
            </label>
          </div>
          <div class="idea-admin-field__input">
            <input
              id="install-plugin-version"
              type="text"
              name="pluginVersion"
              required
              maxlength="255"
              placeholder="1.0.0"
              autocomplete="off"
            >
          </div>
        </div>

        <div>
          <button class="idea-admin-action idea-admin-action--primary" type="submit">
            <i class="fa fa-download" aria-hidden="true"></i>
            インストール
          </button>
        </div>

      </div>
    </form>
  </div>
</div>

{# ── Result toolbar ── #}
<div class="idea-admin-list-toolbar">
  <div class="idea-admin-list-toolbar__left">
    <span class="idea-admin-count">{{ count }}件</span>
  </div>
</div>

{# ── Plugin table / empty state ── #}
{% if count > 0 %}

  <div class="idea-admin-table-wrap">
    <table class="idea-admin-table" aria-label="インストール済みプラグイン">
      <thead>
        <tr>
          <th scope="col">プラグイン名</th>
          <th scope="col">バージョン</th>
          <th scope="col">コード</th>
          <th scope="col">状態</th>
          <th scope="col" class="idea-admin-table__actions"></th>
        </tr>
      </thead>
      <tbody>
        {% for plugin in plugins %}
        <tr id="plugin-{{ plugin.pluginCode }}">

          <td>{{ plugin.pluginName }}</td>

          <td>{{ plugin.pluginVersion }}</td>

          <td>
            <code style="font-size:.82rem;">{{ plugin.pluginCode }}</code>
          </td>

          <td>
            {% if plugin.enabled %}
              <span class="idea-admin-badge idea-admin-badge--public">有効</span>
            {% else %}
              <span class="idea-admin-badge idea-admin-badge--private">無効</span>
            {% endif %}
          </td>

          <td class="idea-admin-table__actions">

            {# Enable: POST /admin/plugin-enable (doEnablePlugin) — shown when disabled #}
            {% if not plugin.enabled %}
            <form
              method="post"
              action="/admin/plugin-enable"
              aria-label="{{ plugin.pluginName }}を有効化"
              style="display:inline;"
            >
              <input type="hidden" name="pluginCode" value="{{ plugin.pluginCode }}">
              <button
                class="idea-admin-icon-btn"
                type="submit"
                aria-label="{{ plugin.pluginName }}を有効化"
                title="有効化"
              >
                <i class="fa fa-play" aria-hidden="true"></i>
              </button>
            </form>
            {% endif %}

            {# Disable: POST /admin/plugin-disable (doDisablePlugin) — shown when enabled #}
            {% if plugin.enabled %}
            <form
              method="post"
              action="/admin/plugin-disable"
              aria-label="{{ plugin.pluginName }}を無効化"
              style="display:inline;"
            >
              <input type="hidden" name="pluginCode" value="{{ plugin.pluginCode }}">
              <button
                class="idea-admin-icon-btn"
                type="submit"
                aria-label="{{ plugin.pluginName }}を無効化"
                title="無効化"
              >
                <i class="fa fa-pause" aria-hidden="true"></i>
              </button>
            </form>
            {% endif %}

            {# Uninstall: only when disabled (safe guard matching EC-CUBE UX) #}
            {% if not plugin.enabled %}
            <button
              class="idea-admin-icon-btn idea-admin-action--destructive"
              type="button"
              aria-label="{{ plugin.pluginName }}を削除"
              aria-haspopup="dialog"
              onclick="document.getElementById('uninstall-dialog-{{ plugin.pluginCode|replace({'/':'-'})|lower }}').showModal()"
              title="削除"
            >
              <i class="fa fa-times" aria-hidden="true"></i>
            </button>
            {% endif %}

          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Uninstall confirmation dialogs ── #}
  {% for plugin in plugins %}
  {% if not plugin.enabled %}
  <dialog
    id="uninstall-dialog-{{ plugin.pluginCode|replace({'/':'-'})|lower }}"
    aria-labelledby="uninstall-title-{{ plugin.pluginCode|replace({'/':'-'})|lower }}"
    style="border:1px solid rgba(205,191,170,.45);border-radius:12px;padding:0;max-width:28rem;width:90%;"
  >
    <div class="idea-admin-panel__head">
      <h3 id="uninstall-title-{{ plugin.pluginCode|replace({'/':'-'})|lower }}" style="margin:0;font-size:.9rem;font-weight:700;">削除の確認</h3>
    </div>
    <div class="idea-admin-panel__body">
      <p style="margin:0;font-size:.88rem;">
        <strong>{{ plugin.pluginName }}</strong> ({{ plugin.pluginCode }}) を削除しますか？この操作は元に戻せません。
      </p>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:.6rem;padding:.75rem 1rem;border-top:1px solid rgba(205,191,170,.35);">
      <button
        class="idea-admin-action"
        type="button"
        onclick="this.closest('dialog').close()"
      >キャンセル</button>
      {# DELETE /admin/plugin (doUninstallPlugin) via hidden _method #}
      <form method="post" action="/admin/plugin" style="display:contents;">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="pluginCode" value="{{ plugin.pluginCode }}">
        <button class="idea-admin-action idea-admin-action--destructive" type="submit">
          削除
        </button>
      </form>
    </div>
  </dialog>
  {% endif %}
  {% endfor %}

{% else %}

  <div class="idea-admin-empty" role="status">
    <i class="fa fa-plug fa-2x" aria-hidden="true"></i>
    <p class="idea-admin-empty__title">インストール済みプラグインはありません</p>
    <p style="font-size:.84rem;">上のフォームからプラグインをインストールしてください。</p>
  </div>

{% endif %}

{% endblock %}
