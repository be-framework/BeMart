{% extends 'admin-base.html.twig' %}

{#
  BeMart admin Delivery list — clean-room build.

  DATA CONTRACT (src/Resource/Page/Admin/Delivery/DeliveryList.php onGet):
    count        int    — total number of delivery masters
    deliveries   list<{deliveryId: string, deliveryName: string, visible: bool}>

  ACTIONS (from #[Link] annotations and onPost signature):
    GET    /admin/delivery/delivery-list  — goDeliveryList (this page)
    POST   /admin/delivery/delivery-list  — doCreateDelivery (name + visible)
    GET    /admin/delivery/delivery       — goDelivery (single-row edit)
    PUT    /admin/delivery/delivery       — doUpdateDelivery
    DELETE /admin/delivery/delivery       — doDeleteDelivery

  FORM CONTRACT (src/Form/AdminDeliveryForm.php):
    deliveryName  text      required (isNotBlank)
    visible       checkbox  optional, value "1"

  CSRF: csrfToken body field; hidden input name="csrfToken".

  IdeaStore admin design vocabulary (idea-admin-*):
    idea-admin-shell          app shell (from admin-base)
    idea-admin-content        main content region (from admin-base)
    idea-admin-panel          card section
    idea-admin-panel__head    section header
    idea-admin-panel__body    section body
    idea-admin-list-toolbar   list count + action bar
    idea-admin-table-wrap     scrollable table wrapper
    idea-admin-table          data table
    idea-admin-badge          visible/hidden status chip
    idea-admin-action         button / link affordance
    idea-admin-icon-btn       compact icon affordance in table rows (edit/delete)
    idea-admin-empty          empty-state block
    idea-admin-field          label + input row (create form)
    idea-admin-field__label   label cell
    idea-admin-field__input   input cell
    idea-admin-required       required badge
#}

{% set route = 'admin-delivery-delivery-list' %}
{% set title = '配送方法設定' %}
{% set sub_title = '店舗設定' %}

{% block main %}

<section class="idea-admin-panel" aria-labelledby="delivery-create-heading">
  <div class="idea-admin-panel__head">
    <h3 id="delivery-create-heading">新規登録</h3>
  </div>
  <div class="idea-admin-panel__body">
    <form
      id="idea-delivery-create-form"
      role="form"
      method="post"
      action="/admin/delivery/delivery-list"
      novalidate
    >
      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

      <div class="idea-admin-field">
        <div class="idea-admin-field__label">
          <label for="delivery_name">配送方法名</label>
          <span class="idea-admin-required">必須</span>
        </div>
        <div class="idea-admin-field__input">
          <input
            type="text"
            id="delivery_name"
            name="deliveryName"
            value=""
            required
          >
        </div>
      </div>

      <div class="idea-admin-field">
        <div class="idea-admin-field__label">
          <label for="delivery_visible">表示</label>
        </div>
        <div class="idea-admin-field__input">
          <input
            type="checkbox"
            id="delivery_visible"
            name="visible"
            value="1"
            checked
          >
        </div>
      </div>

      <div style="margin-top: .75rem;">
        <button type="submit" class="idea-admin-action idea-admin-action--primary">
          <i class="fa fa-plus" aria-hidden="true"></i>
          登録
        </button>
      </div>
    </form>
  </div>
</section>

<section class="idea-admin-panel" aria-labelledby="delivery-list-heading" style="margin-top: 1.25rem;">
  <div class="idea-admin-panel__head">
    <h3 id="delivery-list-heading">配送方法一覧</h3>
    <span class="idea-admin-count">{{ count }}件</span>
  </div>
  <div class="idea-admin-panel__body" style="padding: 0;">

    {% if deliveries is empty %}
      <div class="idea-admin-empty">
        <i class="fa fa-truck fa-2x" aria-hidden="true"></i>
        <p class="idea-admin-empty__title">配送方法が登録されていません</p>
        <p>上のフォームから最初の配送方法を登録してください。</p>
      </div>
    {% else %}
      <div class="idea-admin-table-wrap">
        <table class="idea-admin-table" aria-label="配送方法一覧">
          <thead>
            <tr>
              <th scope="col">配送方法名</th>
              <th scope="col">表示状態</th>
              <th scope="col" class="idea-admin-table__actions">操作</th>
            </tr>
          </thead>
          <tbody>
            {% for delivery in deliveries %}
              <tr id="delivery-row-{{ delivery.deliveryId }}">
                <td>
                  <a
                    href="/admin/delivery/delivery?deliveryId={{ delivery.deliveryId }}"
                    rel="goDelivery"
                    class="idea-admin-meta__link"
                  >{{ delivery.deliveryName }}</a>
                </td>
                <td>
                  {% if delivery.visible %}
                    <span class="idea-admin-badge idea-admin-badge--public">表示</span>
                  {% else %}
                    <span class="idea-admin-badge idea-admin-badge--private">非表示</span>
                  {% endif %}
                </td>
                <td class="idea-admin-table__actions">
                  <a
                    href="/admin/delivery/delivery?deliveryId={{ delivery.deliveryId }}"
                    rel="goDelivery"
                    class="idea-admin-icon-btn"
                    title="編集"
                    aria-label="{{ delivery.deliveryName }} を編集"
                  >
                    <i class="fa fa-pencil" aria-hidden="true"></i>
                  </a>
                  <button
                    type="button"
                    class="idea-admin-icon-btn"
                    data-delivery-id="{{ delivery.deliveryId }}"
                    data-delivery-name="{{ delivery.deliveryName }}"
                    data-delete-url="/admin/delivery/delivery?deliveryId={{ delivery.deliveryId }}&amp;_method=delete"
                    aria-label="{{ delivery.deliveryName }} を削除"
                    title="削除"
                    id="delete-btn-{{ delivery.deliveryId }}"
                  >
                    <i class="fa fa-trash" aria-hidden="true"></i>
                  </button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

  </div>
</section>

{# Delete confirmation dialog — rendered once, populated via JS #}
<dialog
  id="idea-delivery-delete-dialog"
  aria-labelledby="delete-dialog-title"
  aria-describedby="delete-dialog-desc"
  style="border: 1px solid rgba(205,191,170,.55); border-radius: 12px; padding: 1.5rem; max-width: 26rem; box-shadow: 0 10px 32px rgba(41,37,31,.12);"
>
  <form
    id="idea-delivery-delete-form"
    method="post"
    action=""
    rel="doDeleteDelivery"
  >
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
    <h4 id="delete-dialog-title" style="margin: 0 0 .75rem; font-size: 1rem;">配送方法を削除しますか？</h4>
    <p id="delete-dialog-desc" style="margin: 0 0 1.25rem; font-size: .88rem; color: var(--idea-muted);">
      この操作は取り消せません。
    </p>
    <div style="display: flex; gap: .65rem; justify-content: flex-end;">
      <button type="button" class="idea-admin-action" id="idea-delivery-delete-cancel">キャンセル</button>
      <button type="submit" class="idea-admin-action idea-admin-action--destructive">削除</button>
    </div>
  </form>
</dialog>

{% endblock %}

{% block javascript %}
<script>
(function () {
  var dialog = document.getElementById('idea-delivery-delete-dialog');
  var form   = document.getElementById('idea-delivery-delete-form');
  var cancelBtn = document.getElementById('idea-delivery-delete-cancel');

  document.querySelectorAll('[data-delete-url]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      form.action = btn.dataset.deleteUrl;
      if (dialog.showModal) {
        dialog.showModal();
      }
    });
  });

  if (cancelBtn) {
    cancelBtn.addEventListener('click', function () {
      dialog.close();
    });
  }
}());
</script>
{% endblock %}
