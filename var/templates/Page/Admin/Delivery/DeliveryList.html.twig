{#
  BeMart admin Delivery list — EC-CUBE goDeliveryList (配送方法設定).

  PORT of EC-CUBE 4.3 admin-theme `Setting/Shop/delivery.twig`
  (src/Eccube/Resource/template/admin/Setting/Shop/delivery.twig).

  Setting/Shop section, DATA/LIST page (sortable). It extends the admin
  frame (`admin-base.html.twig`, the port of EC-CUBE's admin
  `default_frame.twig`), not the storefront `base.html.twig`. The markup
  skeleton + `c-*` / `ec-*` / Bootstrap classes are kept verbatim from
  EC-CUBE; only the dynamic bindings are rebound to the DeliveryList
  resource body (src/Resource/Page/Admin/Delivery/DeliveryList.php —
  body carries `count` + `deliveries`, a list of {deliveryId,
  deliveryName, visible}).

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `url(route, params)` -> deterministic `/{route}?{query}`
     (`BeMartTwigExtension`).
   - `{% for Delivery in Deliveries %}` -> the resource body's
     `deliveries` list. EC-CUBE keys the row + actions by `Delivery.id`;
     the AdminDeliveryListFetched projection surfaces `deliveryId`, so
     BeMart keys the row + actions by `deliveryId`. Same anchors, same
     classes.
   - `Delivery.name` / `Delivery.service_name` -> the projection
     surfaces only `deliveryName`. dtb_delivery.service_name is NOT
     carried by DeliveryEntity (out of the Wave 9 admin slice), so the
     ` / {{ service_name }}` suffix is omitted. FLAGGED missing-body-field
     — enumerated as residual.
   - `Delivery.sortNo` -> the AdminDeliveryListFetched projection does
     NOT carry the sort_no column (dtb_delivery.sort_no is tracked
     inside DeliveryStorage, not projected). The `data-sort-no`
     attribute renders empty. FLAGGED missing-body-field.
   - `csrf_token_for_anchor()` on the visible-toggle / delete `<a>` ->
     EC-CUBE per-request CSRF widget. OMITTED exactly as the storefront
     ports omit it. EC-CUBE-runtime only — enumerated as residual.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin_setting_shop_delivery' %}
{% set title = '配送方法一覧' %}
{% set sub_title = '店舗設定' %}

{% block javascript %}
    <script>
        $(function() {
            var oldSortNos = [];
            $('.sortable-item').each(function() {
                oldSortNos.push(this.dataset.sortNo);
            });
            oldSortNos.sort(function(a, b) {
                return a - b;
            }).reverse();
            // 並び替え後にsort noを更新
            var updateSortNo = function() {
                var newSortNos = {};
                var i = 0;
                $('.sortable-item').each(function() {
                    newSortNos[this.dataset.id] = oldSortNos[i];
                    i++;
                });
                $.ajax({
                    url: '{{ url('admin_setting_shop_delivery_sort_no_move') }}',
                    type: 'POST',
                    data: newSortNos
                }).always(function() {
                    $(".modal-backdrop").remove();
                });
            };
            // 最初と最後の↑↓を再描画
            var redrawDisableAllows = function() {
                var items = $('.sortable-item');
                items.find('a').removeClass('disabled');
                items.first().find('a.action-up').addClass('disabled');
                items.last().find('a.action-down').addClass('disabled');
            };
            // オーバレイ後, 表示順の更新を行う
            var moveSortNo = function() {
                $('body').append($('<div class="modal-backdrop show"></div>'));
                updateSortNo();
                redrawDisableAllows();
            };
            // Drag and Drop
            $(".sortable-container").sortable({
                items: '> .sortable-item',
                cursor: 'move',
                update: function(e, ui) {
                    moveSortNo();
                }
            });
            // Up
            $('.sortable-item').on('click', 'a.action-up', function(e) {
                e.preventDefault();
                var current = $(this).parents('li');
                if (current.prev().hasClass('sortable-item')) {
                    current.prev().before(current);
                    moveSortNo();
                }
            });
            // Down
            $('.sortable-item').on('click', 'a.action-down', function(e) {
                e.preventDefault();
                var current = $(this).parents('li');
                if (current.next().hasClass('sortable-item')) {
                    current.next().after(current);
                    moveSortNo();
                }
            });

            // 削除モーダルのhrefとmessageの変更
            $('#DeleteModal').on('shown.bs.modal', function(event) {
                var target = $(event.relatedTarget);
                // hrefの変更
                $(this).find('[data-post-action="delete"]').attr('href', target.data('url'));

                // messageの変更
                $(this).find('p.modal-message').text(target.data('message'));
            });
        });
    </script>
{% endblock %}

{% block main %}
    <form name="form1" method="post" action="{{ url('admin_setting_shop_delivery') }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="d-block mb-3">
                        <a class="btn btn-ec-regular" href="{{ url('admin_setting_shop_delivery_new') }}">新規作成</a>
                    </div>
                    <div class="card rounded border-0 mb-4">
                        <div class="card-body p-0">
                            <div class="card rounded border-0">
                                <ul class="list-group list-group-flush sortable-container">
                                    <li class="list-group-item">
                                        <div class="row">
                                            <div class="col-auto"><strong>&nbsp;</strong></div>
                                            <div class="col-auto"><strong>ID</strong></div>
                                            <div class="col-2"><strong>配送業者名</strong></div>
                                        </div>
                                    </li>
                                    {% if deliveries|length > 0 %}
                                        {% for Delivery in deliveries %}
                                            <li id="ex-delivery-{{ Delivery.deliveryId }}" class="list-group-item sortable-item" data-id="{{ Delivery.deliveryId }}" data-sort-no="{{ Delivery.sortNo|default('') }}">
                                                <div class="row justify-content-around">
                                                    <div class="col-auto d-flex align-items-center"><i class="fa fa-bars text-ec-gray"></i></div>
                                                    <div class="col-auto d-flex align-items-center">{{ Delivery.deliveryId }}</div>
                                                    <div class="col d-flex align-items-center">
                                                        <a href="{{ url('admin_setting_shop_delivery_edit', {id: Delivery.deliveryId} ) }}">
                                                            {{ Delivery.deliveryName }}
                                                        </a>
                                                    </div>
                                                    <div class="col-auto text-end">
                                                        <a href="#" class="btn btn-ec-actionIcon me-2 action-up {% if loop.first %}disabled{% endif %}" data-bs-toggle="tooltip" data-bs-placement="top" title="上へ">
                                                            <i class="fa fa-arrow-up fa-lg text-secondary"></i>
                                                        </a>
                                                        <a href="#" class="btn btn-ec-actionIcon me-2 action-down {% if loop.last %}disabled{% endif %}" data-bs-toggle="tooltip" data-bs-placement="top" title="下へ">
                                                            <i class="fa fa-arrow-down fa-lg text-secondary"></i>
                                                        </a>
                                                        <a class="btn btn-ec-actionIcon me-2 action-visible" href="{{ url('admin_setting_shop_delivery_visibility', {'id': Delivery.deliveryId }) }}"
                                                           data-bs-toggle="tooltip" data-bs-placement="top" title="{{ Delivery.visible ? '非表示にする' : '表示する' }}"
                                                           data-confirm="false" >
                                                            <i class="fa fa-toggle-{{ Delivery.visible ? 'on' : 'off' }} fa-lg text-secondary" aria-hidden="true"></i>
                                                        </a>
                                                        <div class="d-inline-block me-2" data-bs-toggle="tooltip" data-bs-placement="top"
                                                             title="削除">
                                                            <a class="btn btn-ec-actionIcon" data-bs-toggle="modal" data-bs-target="#DeleteModal"
                                                               data-url="{{ url('admin_setting_shop_delivery_delete', {id: Delivery.deliveryId} ) }}"
                                                               data-message="この操作はあとから取り消すことができません。「{{ Delivery.deliveryName }}」を削除してよろしいですか？">
                                                                <i class="fa fa-close fa-lg"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    {% endif %}
                                </ul>
                                <!-- 削除モーダル -->
                                <div class="modal fade" id="DeleteModal" tabindex="-1" role="dialog"
                                     aria-labelledby="DeleteModal" aria-hidden="true">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold">
                                                    削除します
                                                </h5>
                                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close">

                                                </button>
                                            </div>
                                            <div class="modal-body text-start">
                                                <p class="text-start modal-message"><!-- jsでメッセージを挿入 --></p>
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-ec-sub" type="button" data-bs-dismiss="modal">
                                                    キャンセル
                                                </button>
                                                <a class="btn btn-ec-delete" href="#"
                                                   data-confirm="false">
                                                    削除
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <p>ドラッグ＆ドロップやボタン操作で表示順を変更できます。</p>
                </div>
            </div>
        </div>
    </form>

{% endblock %}
