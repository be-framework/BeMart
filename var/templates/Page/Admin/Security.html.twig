{% extends 'admin-base.html.twig' %}

{% set route = 'admin-security' %}
{% set title = 'セキュリティ設定' %}
{% set sub_title = 'システム' %}

{% block main %}
<form method="post" action="/admin/security?_method=put" novalidate>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-admin-layout">
        <div class="idea-admin-primary">

            {# ── Admin URL ────────────────────────────────────────────────── #}
            <section class="idea-admin-panel" aria-labelledby="panel-admin-url">
                <div class="idea-admin-panel__head">
                    <h3 id="panel-admin-url">
                        <i class="fa fa-link fa-fw" aria-hidden="true"></i>
                        管理 URL
                    </h3>
                </div>
                <div class="idea-admin-panel__body">
                    <div class="idea-admin-field">
                        <div class="idea-admin-field__label">
                            <label for="admin_security_admin_route_dir">管理ディレクトリ</label>
                            <span class="idea-admin-required">必須</span>
                        </div>
                        <div class="idea-admin-field__input">
                            {{ form.input('adminRouteDir')|raw }}
                            <span class="idea-admin-error">{{ form.error('adminRouteDir')|default('') }}</span>
                        </div>
                    </div>
                </div>
            </section>

            {# ── Admin IP restrictions ─────────────────────────────────── #}
            <section class="idea-admin-panel" aria-labelledby="panel-admin-ip">
                <div class="idea-admin-panel__head">
                    <h3 id="panel-admin-ip">
                        <i class="fa fa-shield-halved fa-fw" aria-hidden="true"></i>
                        管理画面 IP 制限
                    </h3>
                    <p class="idea-admin-panel__hint">改行区切りで IP アドレスまたは CIDR を入力します。</p>
                </div>
                <div class="idea-admin-panel__body">
                    <div class="idea-admin-field">
                        <div class="idea-admin-field__label">
                            <label for="admin_security_admin_allow_hosts">許可リスト</label>
                        </div>
                        <div class="idea-admin-field__input">
                            {{ form.input('adminAllowHosts')|raw }}
                        </div>
                    </div>
                    <div class="idea-admin-field">
                        <div class="idea-admin-field__label">
                            <label for="admin_security_admin_deny_hosts">拒否リスト</label>
                        </div>
                        <div class="idea-admin-field__input">
                            {{ form.input('adminDenyHosts')|raw }}
                        </div>
                    </div>
                </div>
            </section>

            {# ── Front IP restrictions ─────────────────────────────────── #}
            <section class="idea-admin-panel" aria-labelledby="panel-front-ip">
                <div class="idea-admin-panel__head">
                    <h3 id="panel-front-ip">
                        <i class="fa fa-globe fa-fw" aria-hidden="true"></i>
                        フロント IP 制限
                    </h3>
                    <p class="idea-admin-panel__hint">改行区切りで IP アドレスまたは CIDR を入力します。</p>
                </div>
                <div class="idea-admin-panel__body">
                    <div class="idea-admin-field">
                        <div class="idea-admin-field__label">
                            <label for="admin_security_front_allow_hosts">許可リスト</label>
                        </div>
                        <div class="idea-admin-field__input">
                            {{ form.input('frontAllowHosts')|raw }}
                        </div>
                    </div>
                    <div class="idea-admin-field">
                        <div class="idea-admin-field__label">
                            <label for="admin_security_front_deny_hosts">拒否リスト</label>
                        </div>
                        <div class="idea-admin-field__input">
                            {{ form.input('frontDenyHosts')|raw }}
                        </div>
                    </div>
                </div>
            </section>

            {# ── Connection settings ───────────────────────────────────── #}
            <section class="idea-admin-panel" aria-labelledby="panel-connection">
                <div class="idea-admin-panel__head">
                    <h3 id="panel-connection">
                        <i class="fa fa-lock fa-fw" aria-hidden="true"></i>
                        接続
                    </h3>
                </div>
                <div class="idea-admin-panel__body">
                    <div class="idea-admin-field">
                        <div class="idea-admin-field__label">
                            <label for="admin_security_force_ssl">SSL 強制</label>
                        </div>
                        <div class="idea-admin-field__input">
                            {{ form.input('forceSsl')|raw }}
                            {% if not isSecureRequest %}
                                <span class="idea-admin-notice idea-admin-notice--warning" role="alert">
                                    <i class="fa fa-triangle-exclamation" aria-hidden="true"></i>
                                    HTTPS 接続ではないため SSL 強制は有効になりません。
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="idea-admin-field">
                        <div class="idea-admin-field__label">
                            <label for="admin_security_trusted_hosts">信頼するホスト名</label>
                            <span class="idea-admin-required">必須</span>
                        </div>
                        <div class="idea-admin-field__input">
                            {{ form.input('trustedHosts')|raw }}
                            <span class="idea-admin-error">{{ form.error('trustedHosts')|default('') }}</span>
                        </div>
                    </div>
                </div>
            </section>

        </div>{# /.idea-admin-primary #}
    </div>{# /.idea-admin-layout #}

    <div class="idea-admin-toolbar">
        <div class="idea-admin-toolbar__back">
            <a href="/admin/index">
                <i class="fa fa-angle-left" aria-hidden="true"></i>
                ホーム
            </a>
        </div>
        <div class="idea-admin-toolbar__actions">
            <button type="submit" class="idea-admin-action idea-admin-action--primary">
                <i class="fa fa-floppy-disk" aria-hidden="true"></i>
                保存
            </button>
        </div>
    </div>
</form>
{% endblock %}
