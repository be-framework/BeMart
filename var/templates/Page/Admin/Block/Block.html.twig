{% extends 'admin-base.html.twig' %}
{#
  BeMart admin Block edit/create — clean-room rebuild.

  DATA CONTRACT (src/Resource/Page/Admin/Block/Block.php onGet):
    blockId       string   — empty string for new-block form, row ID for edit
    blockName     string   — block display name (empty on new)
    blockFileName string   — twig template file name without .twig extension
    blockDeletable bool    — false for system blocks that cannot be deleted
    csrfToken     string   — per-request token
    form          AdminBlockForm — fields: blockName, blockFileName, block_html

  FORM CONTRACT (src/Form/AdminBlockForm.php):
    blockName     text  id=block_name
    blockFileName text  id=block_file_name
    block_html    textarea  id=block_block_html  disabled (not persisted yet)

  ACTIONS (derived from #[Link] on Block.php):
    PUT    /admin/block/block?blockId={id}&_method=put  — doUpdateBlock (edit)
    POST   /admin/block/block-list                      — doCreateBlock (new)
    DELETE /admin/block/block?blockId={id}&_method=delete — doDeleteBlock

  idea-admin vocabulary used:
    idea-admin-panel / idea-admin-panel__head / idea-admin-panel__body
    idea-admin-field / idea-admin-field__label / idea-admin-field__input
    idea-admin-required
    idea-admin-error
    idea-admin-action / idea-admin-action--primary / idea-admin-action--destructive
    idea-admin-toolbar / idea-admin-toolbar__back / idea-admin-toolbar__actions
    idea-admin-notice / idea-admin-notice--error
    idea-admin-dialog / idea-admin-dialog-backdrop (delete confirm)
#}

{% set route = 'admin-block-block' %}
{% set title = 'ブロック管理' %}
{% set sub_title = 'コンテンツ管理' %}

{% block javascript %}
<script>
(function () {
    'use strict';

    /* ── ACE editor setup ────────────────────────────────────────────────── */
    if (typeof ace !== 'undefined') {
        ace.require('ace/ext/language_tools');
        var editor = ace.edit('js-block-editor');
        editor.session.setMode('ace/mode/twig');
        editor.setTheme('ace/theme/tomorrow');
        editor.setValue({{ blockHtml|default('')|json_encode|raw }});
        editor.setOptions({
            enableBasicAutocompletion: true,
            enableSnippets: true,
            enableLiveAutocompletion: true,
            showInvisibles: true
        });
        var editorEl = document.getElementById('js-block-editor');
        if (editorEl && typeof ResizeObserver !== 'undefined') {
            new ResizeObserver(function () { editor.resize(); }).observe(editorEl);
        }
    }

    /* ── Sync hidden textarea on submit ──────────────────────────────────── */
    var blockForm = document.getElementById('js-block-form');
    if (blockForm) {
        blockForm.addEventListener('submit', function () {
            var hidden = document.getElementById('block_block_html');
            if (hidden && typeof editor !== 'undefined') {
                hidden.value = editor.getValue();
            }
        });
    }

    /* ── Delete confirmation dialog ──────────────────────────────────────── */
    var deleteDialog = document.getElementById('js-delete-dialog');
    var deleteConfirm = deleteDialog ? deleteDialog.querySelector('.js-dialog-confirm') : null;

    document.addEventListener('click', function (e) {
        var trigger = e.target.closest('[data-delete-trigger]');
        if (!trigger || !deleteDialog) return;
        e.preventDefault();
        deleteDialog.removeAttribute('hidden');
        if (deleteConfirm) deleteConfirm.focus();
    });

    document.addEventListener('click', function (e) {
        if (!deleteDialog) return;
        if (e.target.closest('.js-dialog-cancel') || e.target === deleteDialog) {
            deleteDialog.setAttribute('hidden', '');
        }
    });

    document.addEventListener('keydown', function (e) {
        if (!deleteDialog || deleteDialog.hasAttribute('hidden')) return;
        if (e.key === 'Escape') deleteDialog.setAttribute('hidden', '');
    });
}());
</script>
{% endblock %}

{% block main %}

{# ── Error notice ────────────────────────────────────────────────────────── #}
{% if message is defined and message %}
<div class="idea-admin-notice idea-admin-notice--error" role="alert">
    <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
    {{ message }}
</div>
{% endif %}

{# ── Block settings form ─────────────────────────────────────────────────── #}
<form
    id="js-block-form"
    role="form"
    method="post"
    action="{% if blockId is defined and blockId %}/admin/block/block?blockId={{ blockId }}&_method=put{% else %}/admin/block/block-list{% endif %}"
    aria-label="ブロック設定フォーム"
>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <section class="idea-admin-panel" aria-labelledby="section-block-settings">
        <div class="idea-admin-panel__head">
            <h3 id="section-block-settings">ブロック設定</h3>
        </div>
        <div class="idea-admin-panel__body">

            {# ── Block name ──────────────────────────────────────────────── #}
            <div class="idea-admin-field">
                <div class="idea-admin-field__label">
                    <label for="block_name">ブロック名</label>
                    <span class="idea-admin-required">必須</span>
                </div>
                <div class="idea-admin-field__input">
                    {{ form.input('blockName')|raw }}
                    {% if form.error('blockName') %}
                        <span class="idea-admin-error">{{ form.error('blockName') }}</span>
                    {% endif %}
                </div>
            </div>

            {# ── File name ───────────────────────────────────────────────── #}
            <div class="idea-admin-field">
                <div class="idea-admin-field__label">
                    <label for="block_file_name">ファイル名</label>
                    <span class="idea-admin-required">必須</span>
                </div>
                <div class="idea-admin-field__input">
                    <div style="display:flex; align-items:center; gap:.5rem;">
                        {{ form.input('blockFileName')|raw }}
                        <span style="white-space:nowrap; color:var(--idea-muted); font-size:.88rem;">.twig</span>
                    </div>
                    {% if form.error('blockFileName') %}
                        <span class="idea-admin-error">{{ form.error('blockFileName') }}</span>
                    {% endif %}
                </div>
            </div>

            {# ── Template source (ACE editor shell) ──────────────────────── #}
            <div class="idea-admin-field">
                <div class="idea-admin-field__label">
                    <label for="js-block-editor">コード</label>
                    <span class="idea-admin-required">必須</span>
                </div>
                <div class="idea-admin-field__input">
                    <div
                        id="js-block-editor"
                        style="height:480px; border:1px solid var(--idea-stone); border-radius:var(--idea-admin-radius-input);"
                        aria-label="Twig テンプレートエディタ"
                    ></div>
                    <div style="display:none;">
                        {{ form.input('block_html')|raw }}
                    </div>
                    {% if form.error('block_html') %}
                        <span class="idea-admin-error">{{ form.error('block_html') }}</span>
                    {% endif %}
                </div>
            </div>

        </div>
    </section>

    {# ── Sticky action toolbar ────────────────────────────────────────────── #}
    <div class="idea-admin-toolbar">
        <div class="idea-admin-toolbar__back">
            <a href="/admin/block/block-list">
                <i class="fa fa-arrow-left" aria-hidden="true"></i>
                ブロック一覧
            </a>
        </div>
        <div class="idea-admin-toolbar__actions">
            {% if blockId is defined and blockId and blockDeletable is defined and blockDeletable %}
                <button
                    class="idea-admin-action idea-admin-action--destructive"
                    type="button"
                    data-delete-trigger="true"
                    aria-label="このブロックを削除"
                >
                    <i class="fa fa-trash" aria-hidden="true"></i>
                    削除
                </button>
            {% endif %}
            <button class="idea-admin-action idea-admin-action--primary" type="submit">
                <i class="fa fa-save" aria-hidden="true"></i>
                保存
            </button>
        </div>
    </div>
</form>

{# ── Delete confirmation dialog ──────────────────────────────────────────── #}
{% if blockId is defined and blockId and blockDeletable is defined and blockDeletable %}
<div
    id="js-delete-dialog"
    role="dialog"
    aria-labelledby="js-delete-dialog-title"
    aria-modal="true"
    hidden
    style="
        position:fixed; inset:0; z-index:200;
        display:flex; align-items:center; justify-content:center;
        background:rgba(41,37,31,.45);
    "
>
    <div class="idea-admin-panel" style="max-width:440px; width:92%; padding:0; overflow:hidden;">
        <div class="idea-admin-panel__head">
            <h3 id="js-delete-dialog-title" style="color:#a9472e;">
                <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                ブロックを削除します
            </h3>
        </div>
        <div class="idea-admin-panel__body">
            <p style="margin:0;">この操作は取り消せません。「{{ blockName }}」を削除してよろしいですか？</p>
        </div>
        <div style="
            display:flex; justify-content:flex-end; gap:.6rem;
            padding:.75rem 1rem;
            border-top:1px solid rgba(205,191,170,.4);
        ">
            <button class="idea-admin-action js-dialog-cancel" type="button">キャンセル</button>
            <a
                class="idea-admin-action idea-admin-action--destructive js-dialog-confirm"
                href="/admin/block/block?blockId={{ blockId }}&_method=delete"
            >
                <i class="fa fa-trash" aria-hidden="true"></i>
                削除する
            </a>
        </div>
    </div>
</div>
{% endif %}

{% endblock %}
