{% extends 'admin-base.html.twig' %}

{% set route = 'admin-setting-system-login-history' %}
{% set title = 'ログイン履歴' %}
{% set sub_title = 'システム設定' %}

{#
  DATA CONTRACT (src/Resource/Page/Admin/LoginHistory.php onGet):
    entries   list<{timestamp: string, loginId: string, success: bool, clientIp: string}>
    count     int   — total rows returned

  QUERY PARAM:
    limit     int (default 50) — result cap; passed as GET param, no CSRF required

  LINKS (#[Link] on resource):
    goSecurity    GET  /admin/security
    goMemberList  GET  /admin/member-list

  Design vocabulary: idea-admin-* (public/assets/idea-store/css/idea-admin.css)
    idea-admin-list-toolbar   result count toolbar
    idea-admin-table-wrap     overflow wrapper
    idea-admin-table          data grid
    idea-admin-badge          success/failure chip
    idea-admin-empty          zero-result state
    idea-admin-action         navigation link button
#}

{% block main %}

{# ── Result toolbar ── #}
<div class="idea-admin-list-toolbar">
  <div class="idea-admin-list-toolbar__left">
    <span class="idea-admin-count">{{ count }} 件</span>
  </div>
  <div class="idea-admin-list-toolbar__right">
    <a class="idea-admin-action" href="/admin/security" rel="goSecurity">
      <i class="fa fa-shield fa-fw" aria-hidden="true"></i>
      セキュリティ設定
    </a>
    <a class="idea-admin-action" href="/admin/member-list" rel="goMemberList">
      <i class="fa fa-users fa-fw" aria-hidden="true"></i>
      メンバー管理
    </a>
  </div>
</div>

{# ── Login-history grid / empty state ── #}
{% if entries is not empty %}

  <div class="idea-admin-table-wrap">
    <table class="idea-admin-table" aria-label="ログイン履歴一覧">
      <thead>
        <tr>
          <th scope="col">ログインID</th>
          <th scope="col">IPアドレス</th>
          <th scope="col">試行日時</th>
          <th scope="col">結果</th>
        </tr>
      </thead>
      <tbody>
        {% for entry in entries %}
        <tr>
          <td>{{ entry.loginId }}</td>
          <td>{{ entry.clientIp }}</td>
          <td>{{ entry.timestamp }}</td>
          <td>
            {% if entry.success %}
              <span class="idea-admin-badge idea-admin-badge--public">成功</span>
            {% else %}
              <span class="idea-admin-badge idea-admin-badge--discontinued">失敗</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

{% else %}

  <div class="idea-admin-empty" role="status">
    <i class="fa fa-history fa-2x" aria-hidden="true"></i>
    <p class="idea-admin-empty__title">ログイン履歴がありません</p>
  </div>

{% endif %}

{% endblock %}
