{% extends 'admin-base.html.twig' %}

{% set route = 'admin-class-category-class-category-list' %}
{% set title = '規格分類管理' %}
{% set sub_title = '商品管理' %}

{% block stylesheet %}
<style>
/* ── Drag handle ── */
.idea-admin-drag-handle {
    cursor: grab;
    color: var(--idea-muted);
    padding: .25rem .4rem;
    touch-action: none;
    line-height: 1;
}
.idea-admin-drag-handle:active { cursor: grabbing; }

/* ── Category row ── */
.idea-admin-cat-row {
    display: grid;
    grid-template-columns: 1.8rem 1fr auto;
    align-items: center;
    gap: .6rem;
    padding: .55rem .75rem;
    border-bottom: 1px solid rgba(205, 191, 170, .3);
}
.idea-admin-cat-row:last-child { border-bottom: none; }
.idea-admin-cat-row.is-dragging {
    opacity: .5;
    background: rgba(245, 237, 224, .6);
}
.idea-admin-cat-row.is-over { outline: 2px dashed var(--idea-olive); outline-offset: -2px; }

/* ── Inline edit mode ── */
.idea-admin-cat-view,
.idea-admin-cat-edit { display: contents; }
.idea-admin-cat-edit { display: none; }
.idea-admin-cat-row.is-editing .idea-admin-cat-view { display: none; }
.idea-admin-cat-row.is-editing .idea-admin-cat-edit { display: contents; }

.idea-admin-cat-name { font-size: .93rem; }
.idea-admin-cat-actions { display: flex; gap: .3rem; align-items: center; white-space: nowrap; }

.idea-admin-inline-input {
    border: 1px solid var(--idea-stone);
    border-radius: var(--idea-admin-radius-input);
    padding: .28rem .55rem;
    font: inherit;
    font-size: .88rem;
    color: var(--idea-ink);
    background: rgba(255, 253, 248, .97);
    outline: none;
    transition: border-color .15s, box-shadow .15s;
    min-width: 0;
    width: 100%;
}
.idea-admin-inline-input:focus {
    border-color: var(--idea-olive);
    box-shadow: 0 0 0 3px rgba(82, 107, 85, .15);
}

.idea-admin-action--sm {
    padding: .28rem .7rem;
    font-size: .8rem;
}

/* ── Delete dialog ── */
#idea-delete-dialog {
    border: none;
    background: transparent;
    padding: 0;
}
#idea-delete-dialog::backdrop { background: rgba(41, 37, 31, .45); }

/* ── Sort order indicator (hidden, updated by JS) ── */
.idea-admin-cat-order-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: rgba(205, 191, 170, .25);
    color: var(--idea-muted);
    font-size: .72rem;
    font-weight: 700;
}
</style>
{% endblock stylesheet %}

{% block main %}

{# ── Toolbar: count + back link + CSV ── #}
<div class="idea-admin-list-toolbar">
    <div class="idea-admin-list-toolbar__left">
        <a class="idea-admin-text-btn"
           href="/admin/class-name/class-name-list"
           rel="goClassNameList">
            <i class="fa fa-arrow-left" aria-hidden="true"></i>
            規格一覧へ戻る
        </a>
        {% if classNameId %}
            <span class="idea-admin-count" style="margin-left:.75rem;">{{ count }}件</span>
        {% else %}
            <span class="idea-admin-count" style="margin-left:.75rem;">全 {{ count }}件</span>
        {% endif %}
    </div>
    <div class="idea-admin-list-toolbar__right">
        <a class="idea-admin-action"
           href="/admin/class-category/class-category-export{% if classNameId %}?classNameId={{ classNameId|url_encode }}{% endif %}">
            <i class="fa fa-download" aria-hidden="true"></i>
            CSV出力
        </a>
        <a class="idea-admin-action" href="/admin/csv-config">
            <i class="fa fa-cog" aria-hidden="true"></i>
            CSV設定
        </a>
    </div>
</div>

{# ── Axis context panel (shown only when scoped to a classNameId) ── #}
{% if classNameId %}
<div class="idea-admin-panel" style="margin-bottom:1.25rem;">
    <div class="idea-admin-panel__body">
        <dl class="idea-admin-spec-list">
            <div class="idea-admin-spec-row">
                <dt>規格 ID</dt>
                <dd>{{ classNameId }}</dd>
            </div>
        </dl>
    </div>
</div>
{% endif %}

{# ── Create form ── #}
<div class="idea-admin-panel" style="margin-bottom:1.25rem;">
    <div class="idea-admin-panel__head">
        <h3>
            <i class="fa fa-plus-circle" aria-hidden="true"></i>
            新しい規格分類を追加
        </h3>
    </div>
    <div class="idea-admin-panel__body">
        <form id="idea-create-form"
              method="post"
              action="/admin/class-category/class-category-list">
            {% if classNameId %}
                <input type="hidden" name="classNameId" value="{{ classNameId }}">
            {% endif %}
            <div class="idea-admin-field">
                <div class="idea-admin-field__label">
                    <label for="admin_class_category_name">
                        分類名
                        <span class="idea-admin-required">必須</span>
                    </label>
                </div>
                <div class="idea-admin-field__input">
                    {{ form.input('classCategoryName')|raw }}
                    <span class="idea-admin-error">{{ form.error('classCategoryName')|raw }}</span>
                </div>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:.75rem;">
                <button class="idea-admin-action idea-admin-action--primary" type="submit">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    登録
                </button>
            </div>
        </form>
    </div>
</div>

{# ── Category list ── #}
{% if classCategories is not empty %}
<div class="idea-admin-panel">
    <div class="idea-admin-panel__head">
        <h3>規格分類一覧</h3>
        <span class="idea-admin-panel__hint">
            <i class="fa fa-arrows-v" aria-hidden="true"></i>
            行をドラッグして順序を変更できます
        </span>
    </div>
    <div class="idea-admin-panel__body" style="padding:0;">
        <div id="idea-cat-list" aria-label="規格分類リスト" role="list">
            {% for cat in classCategories %}
            <div class="idea-admin-cat-row"
                 id="cat-row-{{ cat.classCategoryId }}"
                 data-class-category-id="{{ cat.classCategoryId }}"
                 data-class-name-id="{{ cat.classNameId }}"
                 data-name="{{ cat.name }}"
                 draggable="true"
                 role="listitem">

                {# -- view mode -- #}
                <div class="idea-admin-cat-view">
                    <span class="idea-admin-drag-handle" aria-label="並び替え">
                        <i class="fa fa-bars" aria-hidden="true"></i>
                    </span>
                </div>
                <div class="idea-admin-cat-view">
                    <span class="idea-admin-cat-name">{{ cat.name }}</span>
                </div>
                <div class="idea-admin-cat-view idea-admin-cat-actions">
                    <button class="idea-admin-icon-btn js-edit-open"
                            type="button"
                            data-cat-id="{{ cat.classCategoryId }}"
                            aria-label="名前を編集">
                        <i class="fa fa-pencil" aria-hidden="true"></i>
                    </button>
                    <button class="idea-admin-icon-btn js-delete-open"
                            type="button"
                            data-cat-id="{{ cat.classCategoryId }}"
                            data-cat-name="{{ cat.name }}"
                            aria-label="削除">
                        <i class="fa fa-trash" aria-hidden="true"></i>
                    </button>
                </div>

                {# -- edit mode (toggled by JS) -- #}
                <div class="idea-admin-cat-edit">
                    {# placeholder for drag handle column — keeps grid alignment #}
                    <span></span>
                </div>
                <div class="idea-admin-cat-edit" style="grid-column: 2 / -1;">
                    <form class="idea-admin-inline-edit-form"
                          method="post"
                          action="/admin/class-category/class-category?classCategoryId={{ cat.classCategoryId|url_encode }}&amp;_method=put"
                          style="display:flex;gap:.5rem;align-items:center;">
                        <input class="idea-admin-inline-input"
                               type="text"
                               name="classCategoryName"
                               value="{{ cat.name }}"
                               aria-label="分類名"
                               required>
                        <button class="idea-admin-action idea-admin-action--primary idea-admin-action--sm"
                                type="submit">確定</button>
                        <button class="idea-admin-action idea-admin-action--sm js-edit-cancel"
                                type="button"
                                data-cat-id="{{ cat.classCategoryId }}">キャンセル</button>
                    </form>
                </div>

            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% else %}
<div class="idea-admin-empty">
    <span class="idea-admin-empty__title">規格分類がまだありません</span>
    <span>上のフォームから最初の分類を追加してください。</span>
</div>
{% endif %}

{# ── Delete confirmation dialog ── #}
<dialog id="idea-delete-dialog" aria-labelledby="idea-delete-title">
    <div class="idea-admin-panel" style="min-width:20rem;max-width:28rem;">
        <div class="idea-admin-panel__head">
            <h3 id="idea-delete-title">規格分類の削除</h3>
        </div>
        <div class="idea-admin-panel__body">
            <p id="idea-delete-message"></p>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:.65rem;padding:.75rem 1rem;border-top:1px solid rgba(205,191,170,.4);">
            <button class="idea-admin-action" id="idea-delete-cancel" type="button">キャンセル</button>
            <form id="idea-delete-form" method="post" action="" style="margin:0;">
                <button class="idea-admin-action idea-admin-action--destructive" type="submit">削除する</button>
            </form>
        </div>
    </div>
</dialog>

{% endblock main %}

{% block javascript %}
<script>
(function () {
    'use strict';

    /* ────────────────────────────────────────────────
       Inline edit toggle
    ──────────────────────────────────────────────── */
    function rowById(catId) {
        return document.getElementById('cat-row-' + catId);
    }

    function openEdit(catId) {
        var row = rowById(catId);
        if (!row) { return; }
        row.classList.add('is-editing');
        var input = row.querySelector('.idea-admin-inline-input');
        if (input) { input.focus(); input.select(); }
    }

    function closeEdit(catId) {
        var row = rowById(catId);
        if (!row) { return; }
        row.classList.remove('is-editing');
    }

    document.querySelectorAll('.js-edit-open').forEach(function (btn) {
        btn.addEventListener('click', function () {
            openEdit(btn.dataset.catId);
        });
    });

    document.querySelectorAll('.js-edit-cancel').forEach(function (btn) {
        btn.addEventListener('click', function () {
            closeEdit(btn.dataset.catId);
        });
    });

    /* ────────────────────────────────────────────────
       Delete dialog
    ──────────────────────────────────────────────── */
    var dialog       = document.getElementById('idea-delete-dialog');
    var deleteForm   = document.getElementById('idea-delete-form');
    var deleteMsg    = document.getElementById('idea-delete-message');
    var deleteCancel = document.getElementById('idea-delete-cancel');

    document.querySelectorAll('.js-delete-open').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var catId   = btn.dataset.catId;
            var catName = btn.dataset.catName;
            deleteMsg.textContent = '「' + catName + '」を削除します。この操作は取り消せません。';
            deleteForm.action = '/admin/class-category/class-category'
                + '?classCategoryId=' + encodeURIComponent(catId)
                + '&_method=delete';
            dialog.showModal();
        });
    });

    if (deleteCancel) {
        deleteCancel.addEventListener('click', function () { dialog.close(); });
    }

    /* ────────────────────────────────────────────────
       Drag-and-drop reorder (native HTML5)
       Visual-only at Phase 3 — no sort-no persistence
       endpoint is wired in BeMart yet.
    ──────────────────────────────────────────────── */
    var list = document.getElementById('idea-cat-list');
    if (!list) { return; }

    var dragging = null;

    list.addEventListener('dragstart', function (e) {
        var row = e.target.closest('.idea-admin-cat-row');
        if (!row) { return; }
        dragging = row;
        row.classList.add('is-dragging');
        e.dataTransfer.effectAllowed = 'move';
    });

    list.addEventListener('dragend', function () {
        if (dragging) { dragging.classList.remove('is-dragging'); }
        list.querySelectorAll('.is-over').forEach(function (el) {
            el.classList.remove('is-over');
        });
        dragging = null;
    });

    list.addEventListener('dragover', function (e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        var target = e.target.closest('.idea-admin-cat-row');
        if (!target || target === dragging) { return; }
        list.querySelectorAll('.is-over').forEach(function (el) {
            el.classList.remove('is-over');
        });
        target.classList.add('is-over');
    });

    list.addEventListener('drop', function (e) {
        e.preventDefault();
        var target = e.target.closest('.idea-admin-cat-row');
        if (!target || target === dragging || !dragging) { return; }
        target.classList.remove('is-over');

        var rows   = Array.from(list.querySelectorAll('.idea-admin-cat-row'));
        var fromIdx = rows.indexOf(dragging);
        var toIdx   = rows.indexOf(target);

        if (fromIdx < toIdx) {
            target.after(dragging);
        } else {
            target.before(dragging);
        }
    });

    /* ── Keyboard reorder (↑ / ↓ on drag handle) ── */
    list.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') { return; }
        var handle = e.target.closest('.idea-admin-drag-handle');
        if (!handle) { return; }
        e.preventDefault();
        var row  = handle.closest('.idea-admin-cat-row');
        if (!row) { return; }
        if (e.key === 'ArrowUp' && row.previousElementSibling) {
            row.previousElementSibling.before(row);
            handle.focus();
        } else if (e.key === 'ArrowDown' && row.nextElementSibling) {
            row.nextElementSibling.after(row);
            handle.focus();
        }
    });

    /* Make drag handles keyboard-focusable */
    list.querySelectorAll('.idea-admin-drag-handle').forEach(function (h) {
        h.setAttribute('tabindex', '0');
        h.setAttribute('role', 'button');
    });
}());
</script>
{% endblock javascript %}
