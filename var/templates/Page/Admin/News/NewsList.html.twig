{% extends 'admin-base.html.twig' %}

{#
  BeMart admin News list — clean-room idea-admin rebuild.

  DATA CONTRACT (src/Resource/Page/Admin/News/NewsList.php onGet):
    count  integer — total number of news items
    news   array   — list of {newsId, newsTitle, newsDescription,
                              newsUrl, publishDate, linkMethod}
      newsId          string       — opaque identifier (e.g. "nw-welcome")
      newsTitle       string       — headline (maxLength 32)
      newsDescription string|null — body text (maxLength 2000)
      newsUrl         string|null — optional link target (maxLength 2048)
      publishDate     string       — ISO-8601 datetime
      linkMethod      bool         — false=same window, true=target="_blank"

  ACTIONS (from resource #[Link] annotations):
    doCreateNews  POST   /admin/news/news-list
    goNews        GET    /admin/news/news?newsId=<id>     (edit)
    doUpdateNews  PUT    /admin/news/news?newsId=<id>&_method=put
    doDeleteNews  DELETE /admin/news/news?newsId=<id>&_method=delete

  idea-admin vocabulary used:
    idea-admin-kpi           summary count card
    idea-admin-list-toolbar  top bar: count + primary CTA
    idea-admin-count         muted item count label
    idea-admin-table-wrap    responsive table container
    idea-admin-table         data table
    idea-admin-badge         status / attribute chips
    idea-admin-action        action buttons
    idea-admin-icon-btn      compact icon button (edit / delete)
    idea-admin-empty         empty state placeholder
    idea-admin-dialog-*      vanilla-JS confirm dialog
#}

{% set route = 'admin-news-news-list' %}
{% set title = '新着情報' %}
{% set sub_title = 'コンテンツ管理' %}

{% block stylesheet %}
<style>
.idea-admin-news-url-cell {
  max-width: 14rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: .8rem;
  color: var(--idea-muted);
}
.idea-admin-news-url-cell a {
  color: var(--idea-olive);
  text-decoration: none;
}
.idea-admin-news-url-cell a:hover {
  text-decoration: underline;
}
.idea-admin-news-date {
  white-space: nowrap;
  font-size: .82rem;
  font-variant-numeric: tabular-nums;
  color: var(--idea-muted);
}
</style>
{% endblock %}

{% block main %}

{# ── Summary strip ─────────────────────────────────────────────────────── #}
<div class="idea-admin-kpi-grid" style="grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); margin-bottom: 1.25rem;">
  <div class="idea-admin-kpi">
    <div class="idea-admin-kpi__label">記事数</div>
    <div class="idea-admin-kpi__value">{{ count|default(0) }}</div>
    <div class="idea-admin-kpi__sub">公開中の新着情報</div>
  </div>
</div>

{# ── List toolbar: count label + new-article CTA ───────────────────────── #}
<div class="idea-admin-list-toolbar">
  <div class="idea-admin-list-toolbar__left">
    <span class="idea-admin-count">全 {{ count|default(0) }} 件</span>
  </div>
  <div class="idea-admin-list-toolbar__right">
    <a class="idea-admin-action idea-admin-action--primary"
       href="/admin/news/news"
       rel="doCreateNews">
      <i class="fa fa-plus" aria-hidden="true"></i>
      新規作成
    </a>
  </div>
</div>

{# ── News table ────────────────────────────────────────────────────────── #}
{% if news is not empty %}

<div class="idea-admin-table-wrap" role="region" aria-label="新着情報一覧">
  <table class="idea-admin-table">
    <thead>
      <tr>
        <th>公開日時</th>
        <th>タイトル</th>
        <th>リンク先</th>
        <th>開き方</th>
        <th class="idea-admin-table__actions">操作</th>
      </tr>
    </thead>
    <tbody>
      {% for item in news %}
      <tr data-news-id="{{ item.newsId }}">

        {# 公開日時 #}
        <td class="idea-admin-news-date">
          {{ item.publishDate|slice(0, 10) }}
        </td>

        {# タイトル — links to the edit page #}
        <td>
          <a href="/admin/news/news?newsId={{ item.newsId|url_encode }}"
             rel="goNews"
             style="font-weight: 700; color: var(--idea-ink); text-decoration: none;">
            {{ item.newsTitle }}
          </a>
          {% if item.newsDescription %}
          <p style="margin: .2rem 0 0; font-size: .77rem; color: var(--idea-muted);
                     overflow: hidden; display: -webkit-box;
                     -webkit-line-clamp: 1; -webkit-box-orient: vertical;">
            {{ item.newsDescription|striptags|slice(0, 80) }}
          </p>
          {% endif %}
        </td>

        {# URL — shown as a clipped link or an empty dash #}
        <td class="idea-admin-news-url-cell">
          {% if item.newsUrl %}
            <a href="{{ item.newsUrl }}"
               {% if item.linkMethod %}target="_blank" rel="noopener noreferrer"{% endif %}>
              {{ item.newsUrl }}
            </a>
          {% else %}
            <span style="color: var(--idea-stone);">—</span>
          {% endif %}
        </td>

        {# linkMethod badge #}
        <td>
          {% if item.linkMethod %}
            <span class="idea-admin-badge idea-admin-badge--public">別ウィンドウ</span>
          {% else %}
            <span class="idea-admin-badge idea-admin-badge--private">同一ウィンドウ</span>
          {% endif %}
        </td>

        {# Actions: edit + delete #}
        <td class="idea-admin-table__actions">
          <a class="idea-admin-icon-btn"
             href="/admin/news/news?newsId={{ item.newsId|url_encode }}"
             rel="goNews"
             title="編集">
            <i class="fa fa-pencil" aria-hidden="true"></i>
          </a>
          <button
            class="idea-admin-icon-btn"
            type="button"
            title="削除"
            data-news-id="{{ item.newsId }}"
            data-news-title="{{ item.newsTitle|e('html_attr') }}"
            onclick="newsListOpenDelete(this)"
            style="color: #a9472e; border-color: rgba(169,71,46,.3);"
          >
            <i class="fa fa-trash" aria-hidden="true"></i>
          </button>
        </td>

      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="5">{{ count|default(0) }} 件</td>
      </tr>
    </tfoot>
  </table>
</div>

{% else %}

{# ── Empty state ───────────────────────────────────────────────────────── #}
<div class="idea-admin-empty" role="status">
  <i class="fa fa-newspaper-o fa-2x" aria-hidden="true"></i>
  <p class="idea-admin-empty__title">新着情報がありません</p>
  <p>「新規作成」ボタンから最初の記事を追加してください。</p>
  <a class="idea-admin-action idea-admin-action--primary"
     href="/admin/news/news"
     rel="doCreateNews">
    <i class="fa fa-plus" aria-hidden="true"></i>
    新規作成
  </a>
</div>

{% endif %}

{# ── Delete confirm dialog ─────────────────────────────────────────────── #}
<div class="idea-admin-dialog-backdrop" id="news-delete-dialog" hidden aria-modal="true" role="dialog"
     aria-labelledby="news-delete-dialog-title">
  <div class="idea-admin-dialog">
    <div class="idea-admin-dialog__head">
      <h2 class="idea-admin-dialog__title" id="news-delete-dialog-title">記事を削除します</h2>
      <button class="idea-admin-icon-btn" type="button"
              onclick="newsListCloseDelete()" aria-label="閉じる">
        <i class="fa fa-times" aria-hidden="true"></i>
      </button>
    </div>
    <div class="idea-admin-dialog__body">
      <p id="news-delete-dialog-msg">この操作は取り消せません。削除してよろしいですか？</p>
    </div>
    <div class="idea-admin-dialog__foot">
      <button class="idea-admin-action" type="button" onclick="newsListCloseDelete()">キャンセル</button>
      <form id="news-delete-form" method="post" action="" style="display:inline;">
        <input type="hidden" name="_method" value="delete">
        <button class="idea-admin-action idea-admin-action--destructive" type="submit">
          <i class="fa fa-trash" aria-hidden="true"></i>
          削除する
        </button>
      </form>
    </div>
  </div>
</div>

{% endblock %}

{% block javascript %}
<script>
(function () {
  var dialog = document.getElementById('news-delete-dialog');
  var form   = document.getElementById('news-delete-form');
  var msg    = document.getElementById('news-delete-dialog-msg');

  window.newsListOpenDelete = function (btn) {
    var id    = btn.getAttribute('data-news-id');
    var title = btn.getAttribute('data-news-title');
    form.action = '/admin/news/news?newsId=' + encodeURIComponent(id) + '&_method=delete';
    if (msg) {
      msg.textContent = '「' + title + '」を削除します。この操作は取り消せません。';
    }
    dialog.hidden = false;
    dialog.focus();
  };

  window.newsListCloseDelete = function () {
    dialog.hidden = true;
  };

  if (dialog) {
    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) { newsListCloseDelete(); }
    });
    document.addEventListener('keydown', function (e) {
      if (!dialog.hidden && e.key === 'Escape') { newsListCloseDelete(); }
    });
  }
}());
</script>
{% endblock %}
