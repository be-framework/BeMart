{% extends 'admin-base.html.twig' %}

{#
  BeMart admin News editor — idea-admin clean-room build.

  DATA CONTRACT (src/Resource/Page/Admin/News/News.php onGet):
    newsId          string|null — opaque news identifier; null/empty = create mode
    newsTitle       string      — headline text (maxLength 32)
    newsDescription string|null — body text (maxLength 2000)
    newsUrl         string|null — optional link target (maxLength 2048)
    publishDate     string      — ISO-8601 publication datetime
    linkMethod      bool        — false=same window, true=target="_blank"
    csrfToken       string      — per-request CSRF token
    form            AdminNewsForm — pre-filled renderer (HTML context only)

  FORM CONTRACT (src/Form/AdminNewsForm.php):
    publishDate     text      id=admin_news_publish_date   required
    newsTitle       text      id=admin_news_title          required
    newsUrl         text      id=admin_news_url
    linkMethod      checkbox  id=admin_news_link_method    value="1"
    newsDescription textarea  id=admin_news_description    rows=8

  ACTIONS (derived from resource #[Link] annotations):
    POST   /admin/news/news-list                             — doCreateNews (new)
    PUT    /admin/news/news?newsId=<id>&_method=put          — doUpdateNews (edit)
    DELETE /admin/news/news?newsId=<id>&_method=delete       — doDeleteNews (edit)

  Back link (#[Link] rel=goNewsList): /admin/news/news-list

  idea-admin vocabulary used:
    idea-admin-layout       two-column editor shell
    idea-admin-primary      main editor column
    idea-admin-panel        section card
    idea-admin-panel__head  section header
    idea-admin-panel__body  section content area
    idea-admin-field        label + input row
    idea-admin-field__label label cell
    idea-admin-field__input input cell
    idea-admin-required     required badge
    idea-admin-error        inline validation message
    idea-admin-notice       page-level alert strip
    idea-admin-toolbar      action bar
    idea-admin-toolbar__back back-nav link
    idea-admin-toolbar__actions submit + delete cluster
    idea-admin-action       button/link affordance
    idea-admin-panel__hint  supplementary hint text
#}

{% set isEdit = newsId is defined and newsId is not empty %}
{% set route = 'admin-news-news' %}
{% set title = '新着情報' %}
{% set sub_title = 'コンテンツ管理' %}

{% block main %}

{% if message is defined and message %}
<div class="idea-admin-notice idea-admin-notice--error" role="alert">
  <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
  {{ message }}
</div>
{% endif %}

<form
  id="news_form"
  role="form"
  method="post"
  action="{{ isEdit ? '/admin/news/news?newsId=' ~ newsId|url_encode ~ '&_method=put' : '/admin/news/news-list' }}"
  novalidate
>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

  <div class="idea-admin-layout">

    {# ── Primary column ─────────────────────────────────────────── #}
    <div class="idea-admin-primary">

      {# Section: 記事情報 #}
      <section class="idea-admin-panel" aria-labelledby="section-news-info">
        <div class="idea-admin-panel__head">
          <h3 id="section-news-info">記事情報</h3>
        </div>
        <div class="idea-admin-panel__body">

          {# 公開日時 — required #}
          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_news_publish_date">公開日時</label>
              <span class="idea-admin-required">必須</span>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('publishDate')|raw }}
              {% if form.error('publishDate') %}
              <span class="idea-admin-error">{{ form.error('publishDate') }}</span>
              {% endif %}
            </div>
          </div>

          {# タイトル — required #}
          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_news_title">タイトル</label>
              <span class="idea-admin-required">必須</span>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('newsTitle')|raw }}
              {% if form.error('newsTitle') %}
              <span class="idea-admin-error">{{ form.error('newsTitle') }}</span>
              {% endif %}
            </div>
          </div>

          {# URL — optional #}
          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_news_url">URL</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('newsUrl')|raw }}
              {% if form.error('newsUrl') %}
              <span class="idea-admin-error">{{ form.error('newsUrl') }}</span>
              {% endif %}
              <p class="idea-admin-panel__hint">リンク先のURLを入力してください。</p>
            </div>
          </div>

          {# linkMethod — checkbox: open in new window #}
          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label>リンク</label>
            </div>
            <div class="idea-admin-field__input">
              <input type="hidden" name="linkMethod" value="0">
              <label for="admin_news_link_method">
                <input id="admin_news_link_method" type="checkbox" name="linkMethod" value="1"{% if linkMethod|default(false) %} checked{% endif %}>
                別ウィンドウで開く
              </label>
              {% if form.error('linkMethod') %}
              <span class="idea-admin-error">{{ form.error('linkMethod') }}</span>
              {% endif %}
            </div>
          </div>

          {# 本文 — optional textarea #}
          <div class="idea-admin-field">
            <div class="idea-admin-field__label">
              <label for="admin_news_description">本文</label>
            </div>
            <div class="idea-admin-field__input">
              {{ form.input('newsDescription')|raw }}
              {% if form.error('newsDescription') %}
              <span class="idea-admin-error">{{ form.error('newsDescription') }}</span>
              {% endif %}
              <p class="idea-admin-panel__hint">本文を入力してください。</p>
            </div>
          </div>

        </div>
      </section>

    </div>{# /idea-admin-primary #}

  </div>{# /idea-admin-layout #}

  {# ── Action toolbar ──────────────────────────────────────────── #}
  <div class="idea-admin-toolbar" role="navigation" aria-label="フォーム操作">
    <div class="idea-admin-toolbar__back">
      <a href="/admin/news/news-list">
        <i class="fa fa-backward" aria-hidden="true"></i>
        一覧に戻る
      </a>
    </div>
    <div class="idea-admin-toolbar__actions">
      {% if isEdit %}
      <button
        class="idea-admin-action idea-admin-action--destructive"
        type="button"
        onclick="document.getElementById('news-delete-form').submit();"
      >
        <i class="fa fa-trash" aria-hidden="true"></i>
        削除
      </button>
      {% endif %}
      <button class="idea-admin-action idea-admin-action--primary" type="submit">
        <i class="fa fa-save" aria-hidden="true"></i>
        {{ isEdit ? '保存' : '登録' }}
      </button>
    </div>
  </div>

</form>

{# Delete affordance — separate form for clean method routing #}
{% if isEdit %}
<form
  id="news-delete-form"
  method="post"
  action="/admin/news/news?newsId={{ newsId|url_encode }}&_method=delete"
  aria-hidden="true"
>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
</form>
{% endif %}

{% endblock %}
