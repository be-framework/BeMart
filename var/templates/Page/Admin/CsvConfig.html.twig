{% extends 'admin-base.html.twig' %}

{% set route = 'admin-csv-config' %}
{% set title = 'CSV出力設定' %}
{% set sub_title = '店舗設定' %}

{#
  DATA CONTRACT (src/Resource/Page/Admin/CsvConfig.php onGet):
    form             object — AdminCsvConfigForm (csvType select, csvOutput/csvNotOutput multiselect)
    csvType          int    — 1=商品 2=会員 3=受注 4=配送
    csrfToken        string
    outputColumns    array<string,string>  — {columnKey: label}  currently enabled
    notOutputColumns array<string,string>  — {columnKey: label}  currently disabled

  POST CONTRACT (onPost):
    csvType                       int
    csrfToken                     string
    columns[N][columnName]        string  — field key
    columns[N][enabled]           0|1     — 1=output
    columns[N][sortNo]            int     — 1-based position

  LINKS:
    doUpdateCsv   POST page://self/admin/csv-config
    goTop         GET  page://self/admin
    goExportProduct GET page://self/admin/product-csv

  DESIGN: idea-admin-* vocabulary (public/assets/idea-store/css/idea-admin.css)
  Per-page additions in block stylesheet: idea-admin-col-* namespace.
  JS: vanilla only, no jQuery/Bootstrap/EC-CUBE bundles.
  Drag-and-drop single-pane: all columns in one sortable list, toggle
  enabled/disabled inline. Superior to dual-listbox: all columns always
  visible, order changed by drag rather than repeated button clicks.
#}

{% block stylesheet %}
<style>
/* ── CSV column editor extras (idea-admin-col-* namespace) ──────────────── */

.idea-admin-col-type-bar {
  display: flex;
  align-items: center;
  gap: .5rem;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
}
.idea-admin-col-type-bar label {
  font-size: .84rem;
  font-weight: 700;
  color: var(--idea-muted);
  white-space: nowrap;
}
.idea-admin-col-type-bar select {
  border: 1px solid var(--idea-stone);
  border-radius: var(--idea-admin-radius-input);
  background: var(--idea-surface);
  color: var(--idea-ink);
  font: inherit;
  font-size: .88rem;
  padding: .42rem .7rem;
  outline: none;
  cursor: pointer;
  transition: border-color .15s;
}
.idea-admin-col-type-bar select:focus {
  border-color: var(--idea-olive);
  box-shadow: 0 0 0 3px rgba(82, 107, 85, .15);
}

/* Column list */
.idea-admin-col-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: .45rem;
}

.idea-admin-col-row {
  display: grid;
  grid-template-columns: 1.8rem 1fr auto;
  align-items: center;
  gap: .6rem;
  padding: .6rem .75rem;
  background: var(--idea-surface);
  border: 1px solid rgba(205, 191, 170, .5);
  border-radius: var(--idea-admin-radius-input);
  cursor: grab;
  transition: background .12s, border-color .12s, box-shadow .12s, opacity .15s;
  user-select: none;
}
.idea-admin-col-row:active { cursor: grabbing; }
.idea-admin-col-row.is-dragging {
  box-shadow: 0 8px 24px rgba(41, 37, 31, .14);
  border-color: var(--idea-stone-2);
  z-index: 10;
  opacity: .88;
}
.idea-admin-col-row.is-over {
  border-color: var(--idea-olive);
  background: rgba(82, 107, 85, .06);
}
.idea-admin-col-row.is-disabled {
  opacity: .5;
  background: var(--idea-surface-soft);
}

/* Drag handle */
.idea-admin-col-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--idea-stone-2);
  font-size: .85rem;
  cursor: grab;
}
.idea-admin-col-handle:active { cursor: grabbing; }

/* Column label */
.idea-admin-col-label {
  font-size: .88rem;
  font-weight: 600;
  color: var(--idea-ink);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Toggle switch */
.idea-admin-col-toggle {
  position: relative;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: .4rem;
}
.idea-admin-col-toggle input[type="checkbox"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}
.idea-admin-col-toggle-track {
  width: 2.2rem;
  height: 1.2rem;
  border-radius: 999px;
  background: rgba(205, 191, 170, .6);
  border: 1px solid var(--idea-stone);
  position: relative;
  cursor: pointer;
  transition: background .18s, border-color .18s;
  flex: 0 0 auto;
}
.idea-admin-col-toggle input:checked + .idea-admin-col-toggle-track {
  background: var(--idea-olive);
  border-color: var(--idea-olive);
}
.idea-admin-col-toggle-track::after {
  content: '';
  position: absolute;
  top: .1rem;
  left: .1rem;
  width: .88rem;
  height: .88rem;
  border-radius: 50%;
  background: var(--idea-surface);
  box-shadow: 0 1px 3px rgba(41, 37, 31, .18);
  transition: transform .18s;
}
.idea-admin-col-toggle input:checked + .idea-admin-col-toggle-track::after {
  transform: translateX(.95rem);
}

/* Hint bar below list */
.idea-admin-col-hint {
  margin-top: .7rem;
  font-size: .78rem;
  color: var(--idea-muted);
  display: flex;
  align-items: center;
  gap: .4rem;
}
</style>
{% endblock %}

{% block javascript %}
<script>
(function () {
  'use strict';

  /* ── CSV type switcher ────────────────────────────────────────────────── */
  var typeSelect = document.getElementById('csv-type-select');
  if (typeSelect) {
    typeSelect.addEventListener('change', function () {
      location.href = '/admin/csv-config?csvType=' + encodeURIComponent(this.value);
    });
  }

  /* ── Drag-and-drop sortable list ──────────────────────────────────────── */
  var list = document.getElementById('col-sortable-list');
  if (!list) { return; }

  var dragged = null;

  function getRows() {
    return Array.prototype.slice.call(list.querySelectorAll('.idea-admin-col-row[data-col]'));
  }

  list.addEventListener('dragstart', function (e) {
    var row = e.target.closest('.idea-admin-col-row[data-col]');
    if (!row) { return; }
    dragged = row;
    row.classList.add('is-dragging');
    e.dataTransfer.effectAllowed = 'move';
  });

  list.addEventListener('dragend', function () {
    if (dragged) { dragged.classList.remove('is-dragging'); }
    dragged = null;
    getRows().forEach(function (r) { r.classList.remove('is-over'); });
  });

  list.addEventListener('dragover', function (e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    var row = e.target.closest('.idea-admin-col-row[data-col]');
    if (!row || row === dragged) { return; }
    getRows().forEach(function (r) { r.classList.remove('is-over'); });
    row.classList.add('is-over');
  });

  list.addEventListener('dragleave', function (e) {
    var row = e.target.closest('.idea-admin-col-row[data-col]');
    if (row) { row.classList.remove('is-over'); }
  });

  list.addEventListener('drop', function (e) {
    e.preventDefault();
    var target = e.target.closest('.idea-admin-col-row[data-col]');
    if (!target || !dragged || target === dragged) { return; }
    /* Insert dragged before target */
    list.insertBefore(dragged, target);
    target.classList.remove('is-over');
    updateHiddenFields();
  });

  /* ── Toggle: grey out row when disabled ─────────────────────────────── */
  list.addEventListener('change', function (e) {
    var cb = e.target;
    if (cb.type !== 'checkbox') { return; }
    var row = cb.closest('.idea-admin-col-row[data-col]');
    if (!row) { return; }
    if (cb.checked) {
      row.classList.remove('is-disabled');
    } else {
      row.classList.add('is-disabled');
    }
    updateHiddenFields();
  });

  /* ── Build hidden columns[] fields on submit ─────────────────────────── */
  function updateHiddenFields() {
    var container = document.getElementById('col-hidden-fields');
    if (!container) { return; }
    container.innerHTML = '';
    getRows().forEach(function (row, index) {
      var col = row.dataset.col;
      var cb  = row.querySelector('input[type="checkbox"]');
      var enabled = cb && cb.checked ? '1' : '0';
      addHidden(container, 'columns[' + index + '][columnName]', col);
      addHidden(container, 'columns[' + index + '][enabled]',    enabled);
      addHidden(container, 'columns[' + index + '][sortNo]',     String(index + 1));
    });
  }

  function addHidden(container, name, value) {
    var input = document.createElement('input');
    input.type  = 'hidden';
    input.name  = name;
    input.value = value;
    container.appendChild(input);
  }

  var form = document.getElementById('csv-config-form');
  if (form) {
    form.addEventListener('submit', function () {
      updateHiddenFields();
    });
  }

  /* Initialise hidden fields on load so a plain submit without drag works */
  updateHiddenFields();
}());
</script>
{% endblock %}

{% block main %}

{# ── CSV type selector ──────────────────────────────────────────────────── #}
<div class="idea-admin-col-type-bar">
  <label for="csv-type-select">CSV 種別</label>
  <select id="csv-type-select" aria-label="CSV 種別を選択">
    <option value="1"{% if csvType == 1 %} selected{% endif %}>商品 CSV</option>
    <option value="2"{% if csvType == 2 %} selected{% endif %}>会員 CSV</option>
    <option value="3"{% if csvType == 3 %} selected{% endif %}>受注 CSV</option>
    <option value="4"{% if csvType == 4 %} selected{% endif %}>配送 CSV</option>
  </select>
</div>

{# ── Main form ──────────────────────────────────────────────────────────── #}
<form id="csv-config-form" method="post" action="/admin/csv-config" novalidate>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
  <input type="hidden" name="csvType"   value="{{ csvType|default(3) }}">

  {# Hidden fields are written by JS on submit (or on each drag/toggle) #}
  <div id="col-hidden-fields" aria-hidden="true"></div>

  <div class="idea-admin-panel">
    <div class="idea-admin-panel__head">
      <h3>
        <i class="fa fa-table fa-fw" aria-hidden="true"></i>
        出力カラム設定
      </h3>
      <p class="idea-admin-panel__hint">ドラッグで並べ替え、トグルで出力のオン/オフ</p>
    </div>
    <div class="idea-admin-panel__body">

      {# Build a combined ordered list: enabled columns first (sorted by existing order), then disabled #}
      <ul id="col-sortable-list" class="idea-admin-col-list" aria-label="CSV 出力カラム一覧">

        {# Enabled columns (output) #}
        {% for key, label in outputColumns %}
          <li class="idea-admin-col-row"
              data-col="{{ key|e }}"
              draggable="true"
              aria-label="{{ label|e }}">
            <span class="idea-admin-col-handle" aria-hidden="true">
              <i class="fa fa-grip-vertical"></i>
            </span>
            <span class="idea-admin-col-label">{{ label }}</span>
            <label class="idea-admin-col-toggle" title="出力する">
              <input type="checkbox" checked aria-label="{{ label|e }} を出力する">
              <span class="idea-admin-col-toggle-track"></span>
            </label>
          </li>
        {% endfor %}

        {# Disabled columns (not output) #}
        {% for key, label in notOutputColumns %}
          <li class="idea-admin-col-row is-disabled"
              data-col="{{ key|e }}"
              draggable="true"
              aria-label="{{ label|e }}（出力しない）">
            <span class="idea-admin-col-handle" aria-hidden="true">
              <i class="fa fa-grip-vertical"></i>
            </span>
            <span class="idea-admin-col-label">{{ label }}</span>
            <label class="idea-admin-col-toggle" title="出力しない">
              <input type="checkbox" aria-label="{{ label|e }} を出力する">
              <span class="idea-admin-col-toggle-track"></span>
            </label>
          </li>
        {% endfor %}

      </ul>

      <p class="idea-admin-col-hint">
        <i class="fa fa-info-circle" aria-hidden="true"></i>
        行をドラッグして出力順を変更できます。トグルをオンにしたカラムのみ CSV に出力されます。
      </p>

    </div>{# /.idea-admin-panel__body #}
  </div>{# /.idea-admin-panel #}

  {# ── Bottom toolbar ──────────────────────────────────────────────────── #}
  <div class="idea-admin-toolbar">
    <div class="idea-admin-toolbar__back">
      <a href="/admin" rel="goTop">
        <i class="fa fa-chevron-left fa-fw" aria-hidden="true"></i>
        ダッシュボードに戻る
      </a>
    </div>
    <div class="idea-admin-toolbar__actions">
      <a href="/admin/product-csv" rel="goExportProduct" class="idea-admin-action">
        <i class="fa fa-download fa-fw" aria-hidden="true"></i>
        商品 CSV 出力
      </a>
      <button type="submit" class="idea-admin-action idea-admin-action--primary">
        <i class="fa fa-save fa-fw" aria-hidden="true"></i>
        保存
      </button>
    </div>
  </div>

</form>

{% endblock %}
