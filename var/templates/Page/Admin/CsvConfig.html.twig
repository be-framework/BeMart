{#
  BeMart admin CSV config — EC-CUBE Setting/Shop/csv.twig.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-csv-config' %}
{% set title = 'CSV出力項目設定' %}
{% set sub_title = '店舗設定' %}

{% block javascript %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            function byId(id) {
                return document.getElementById(id);
            }

            function moveSelected(fromId, toId) {
                var from = byId(fromId);
                var to = byId(toId);
                if (!from || !to) {
                    return;
                }

                Array.prototype.slice.call(from.selectedOptions).forEach(function(option) {
                    option.selected = false;
                    to.appendChild(option);
                });
            }

            function moveAll(fromId, toId) {
                var from = byId(fromId);
                var to = byId(toId);
                if (!from || !to) {
                    return;
                }

                Array.prototype.slice.call(from.options).forEach(function(option) {
                    option.selected = false;
                    to.appendChild(option);
                });
            }

            function bind(id, callback) {
                var element = byId(id);
                if (element) {
                    element.addEventListener('click', callback);
                }
            }

            bind('add', function() { moveSelected('csv-not-output', 'csv-output'); });
            bind('add-all', function() { moveAll('csv-not-output', 'csv-output'); });
            bind('remove', function() { moveSelected('csv-output', 'csv-not-output'); });
            bind('remove-all', function() { moveAll('csv-output', 'csv-not-output'); });

            Array.prototype.slice.call(document.querySelectorAll('.move')).forEach(function(button) {
                button.addEventListener('click', function() {
                    var output = byId('csv-output');
                    if (!output) {
                        return;
                    }

                    var selected = Array.prototype.slice.call(output.selectedOptions);
                    if (selected.length === 0) {
                        return;
                    }

                    if (button.dataset.value === 'up') {
                        selected.forEach(function(option) {
                            if (option.previousElementSibling) {
                                output.insertBefore(option, option.previousElementSibling);
                            }
                        });
                    } else {
                        selected.reverse().forEach(function(option) {
                            if (option.nextElementSibling) {
                                output.insertBefore(option.nextElementSibling, option);
                            }
                        });
                    }
                });
            });

            Array.prototype.slice.call(document.querySelectorAll('.move-most')).forEach(function(button) {
                button.addEventListener('click', function() {
                    var output = byId('csv-output');
                    if (!output) {
                        return;
                    }

                    var selected = Array.prototype.slice.call(output.selectedOptions);
                    if (selected.length === 0) {
                        return;
                    }

                    if (button.dataset.value === 'top') {
                        selected.reverse().forEach(function(option) {
                            output.insertBefore(option, output.firstChild);
                        });
                    } else {
                        selected.forEach(function(option) {
                            output.appendChild(option);
                        });
                    }
                });
            });

            var csvType = byId('csv-type');
            if (csvType) {
                csvType.addEventListener('change', function() {
                    var csvType = this.value;
                    location.href = '/admin/csv-config?csvType=' + encodeURIComponent(csvType);
                });
            }

            var form = byId('csv-form');
            if (form) {
                form.addEventListener('submit', function() {
                    selectAllOptions('csv-not-output');
                    selectAllOptions('csv-output');
                    var existing = byId('csv-columns');
                    if (existing) {
                        existing.remove();
                    }

                    var columns = document.createElement('div');
                    columns.id = 'csv-columns';
                    columns.hidden = true;
                    var sortNo = 0;
                    appendColumns(columns, 'csv-output', sortNo, true);
                    sortNo += optionCount('csv-output');
                    appendColumns(columns, 'csv-not-output', sortNo, false);
                    form.appendChild(columns);
                });
            }

            function selectAllOptions(selectId) {
                var select = byId(selectId);
                if (!select) {
                    return;
                }

                Array.prototype.slice.call(select.options).forEach(function(option) {
                    option.selected = true;
                });
            }

            function optionCount(selectId) {
                var select = byId(selectId);
                return select ? select.options.length : 0;
            }

            function appendColumns(container, selectId, offset, enabled) {
                var select = byId(selectId);
                if (!select) {
                    return;
                }

                Array.prototype.slice.call(select.options).forEach(function(option, index) {
                    appendColumn(container, offset + index, option.value, enabled);
                });
            }

            function appendColumn(container, index, columnName, enabled) {
                appendHidden(container, 'columns[' + index + '][columnName]', columnName);
                appendHidden(container, 'columns[' + index + '][enabled]', enabled ? '1' : '0');
                appendHidden(container, 'columns[' + index + '][sortNo]', String(index + 1));
            }

            function appendHidden(container, name, value) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                container.appendChild(input);
            }
        });
    </script>
{% endblock %}

{% block main %}
    <form id="csv-form" method="post" action="/admin/csv-config" data-alps="doUpdateCsv">
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default(csrf_token()) }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" title="各種のデータをCSVで出力できます。出力したい項目をこちらで設定することが可能です。">
                                <span>CSV出力項目</span><i class="fa fa-question-circle fa-lg ms-1"></i>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row mb-4 justify-content-between">
                                <div class="col-2">
                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" title="設定したいCSVの種類を指定してください。">
                                        <span>CSV種別</span>
                                        <i class="fa fa-question-circle fa-lg ms-1"></i>
                                    </div>
                                </div>
                                <div class="col-6">
                                    {{ form.input('csvType')|raw }}
                                </div>
                                <div class="col"></div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-4">
                                    <div class="mb-3">
                                        <label for="csv-not-output">出力しない項目</label>
                                        {{ form.input('csvNotOutput')|raw }}
                                    </div>
                                </div>
                                <div class="col-2 align-self-center">
                                    <div class="row mb-2">
                                        <div class="col text-center"><span>操作項目</span></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div class="btn btn-ec-regular w-100" id="add"><i class="fa fa-arrow-right" aria-hidden="true"></i><span>&nbsp;出力</span></div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div class="btn btn-ec-regular w-100" id="remove"><i class="fa fa-arrow-left" aria-hidden="true"></i><span>&nbsp;解除</span></div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div class="btn btn-ec-regular w-100" id="add-all"><i class="fa fa-arrow-circle-right" aria-hidden="true"></i><span>&nbsp;すべて出力</span></div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div class="btn btn-ec-regular w-100" id="remove-all"><i class="fa fa-arrow-circle-left" aria-hidden="true"></i><span>&nbsp;すべて解除</span></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="mb-3">
                                        <label for="csv-output">出力する項目</label>
                                        {{ form.input('csvOutput')|raw }}
                                    </div>
                                </div>
                                <div class="col-2 align-self-center">
                                    <div class="row mb-2">
                                        <div class="col text-center"><span>項目順序</span></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div class="btn btn-ec-regular w-100 move" data-value="up"><i class="fa fa-arrow-up" aria-hidden="true"></i><span>&nbsp;ひとつ上へ</span></div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div class="btn btn-ec-regular w-100 move" data-value="down"><i class="fa fa-arrow-down" aria-hidden="true"></i><span>&nbsp;ひとつ下へ</span></div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div class="btn btn-ec-regular w-100 move-most" data-value="top"><i class="fa fa-arrow-circle-up" aria-hidden="true"></i><span>&nbsp;一番上へ</span></div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col text-center">
                                            <div class="btn btn-ec-regular w-100 move-most" data-value="bottom"><i class="fa fa-arrow-circle-down" aria-hidden="true"></i><span>&nbsp;一番下へ</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <p></p>
                            任意の項目を押して選択してから［項目操作］ボタンで移動し、CSV出力する項目を設定してください。<br>
                            出力する項目の順序は［項目順序］ボタンで変更することができます。<br>
                            複数の項目を選択する場合はctrlキー（Macの場合はcommandキー）を押しながら項目を押します。shiftキーを押しながら選択すると範囲選択ができます。
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem"></div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5" type="submit">登録</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
