{#
  BeMart admin shop base-info editor — EC-CUBE Setting/Shop/shop_master.twig.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-base-info' %}
{% set title = '店舗基本情報' %}
{% set sub_title = '店舗設定' %}

{% block main %}
    <form role="form" method="post" action="/admin/base-info" id="shop_master_form" name="form1" novalidate>
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default(csrf_token()) }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <span class="card-title">店舗情報</span>
                        </div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>会社名</span>
                                </div>
                                <div class="col">
                                    {{ form.input('company_name')|raw }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>店名</span>
                                    <span class="badge bg-primary ms-1">必須</span>
                                </div>
                                <div class="col">
                                    {{ form.input('shop_name')|raw }}
                                    {% if form.error('shop_name') %}<span class="invalid-feedback d-block">{{ form.error('shop_name') }}</span>{% endif %}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>店名(カナ)</span>
                                </div>
                                <div class="col">
                                    {{ form.input('shop_kana')|raw }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>店名(英語)</span>
                                </div>
                                <div class="col">
                                    {{ form.input('shop_name_eng')|raw }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>郵便番号</span>
                                </div>
                                <div class="col">
                                    {{ form.input('postal_code')|raw }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>都道府県</span>
                                </div>
                                <div class="col">
                                    {{ form.input('pref')|raw }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>住所</span>
                                </div>
                                <div class="col">
                                    <div class="mb-2">{{ form.input('addr01')|raw }}</div>
                                    <div>{{ form.input('addr02')|raw }}</div>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>電話番号</span>
                                </div>
                                <div class="col">
                                    {{ form.input('phone_number')|raw }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>営業時間</span>
                                </div>
                                <div class="col">
                                    {{ form.input('business_hour')|raw }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>メールアドレス</span>
                                </div>
                                <div class="col">
                                    {{ form.input('email01')|raw }}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3">
                                    <span>ショップからのメッセージ</span>
                                </div>
                                <div class="col">
                                    {{ form.input('shop_message')|raw }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem"></div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button type="submit" class="btn btn-ec-conversion px-5">登録</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
