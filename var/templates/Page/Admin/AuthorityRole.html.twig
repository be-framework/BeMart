{% extends 'admin-base.html.twig' %}
{#
  BeMart admin Authority Rule editor — idea-admin clean-room design.

  DATA CONTRACT (src/Resource/Page/Admin/AuthorityRole.php onGet):
    authorityOptions  array   — [{id: int, label: string}, ...]
                               0=システム管理者 / 1=店舗オーナー
    rules             array   — [{authority: int, denyUrl: string}, ...]
    csrfToken         string  — CSRF token

  ACTIONS (derived from #[Link] on AuthorityRole resource):
    POST   /admin/authority-role   — doUpdateAuthorityRole
                                     body: AuthorityRoles[N][Authority], AuthorityRoles[N][deny_url]
    GET    /admin/member-list      — goMemberList (back-nav)

  UX DESIGN RATIONALE:
    - Single-page rule editor: authority+denyUrl table rows add/remove inline
    - Side panel shows the authority legend (read-only reference)
    - KPI count chip reflects current unsaved row count live
    - Row index is rewritten on submission so sparse arrays never reach server
    - All JS is vanilla — no jQuery, no Bootstrap helpers
#}

{% set route = 'admin-authority-role' %}
{% set title = '権限ルール管理' %}
{% set sub_title = 'システム設定' %}

{% block stylesheet %}
<style>
.idea-admin-rule-table {
  width: 100%;
  border-collapse: collapse;
}
.idea-admin-rule-table thead th {
  padding: .45rem .6rem;
  font-size: .78rem;
  font-weight: 600;
  color: var(--idea-muted);
  border-bottom: 1px solid var(--idea-border);
  text-align: left;
}
.idea-admin-rule-table tbody tr {
  border-bottom: 1px solid var(--idea-border);
}
.idea-admin-rule-table tbody tr:last-child {
  border-bottom: none;
}
.idea-admin-rule-table td {
  padding: .4rem .5rem;
  vertical-align: middle;
}
.idea-admin-rule-table td.idea-admin-rule-table__url {
  width: 100%;
}
.idea-admin-rule-table td.idea-admin-rule-table__role {
  width: 11rem;
  min-width: 11rem;
}
.idea-admin-rule-table td.idea-admin-rule-table__action {
  width: 2.6rem;
  text-align: center;
}
.idea-admin-rule-url-input {
  width: 100%;
  font-family: var(--idea-font-mono, monospace);
  font-size: .84rem;
  padding: .3rem .5rem;
  border: 1px solid var(--idea-border);
  border-radius: 4px;
  background: var(--idea-surface);
  color: var(--idea-text);
}
.idea-admin-rule-url-input:focus {
  outline: 2px solid var(--idea-accent);
  outline-offset: 1px;
}
.idea-admin-rule-url-input::placeholder {
  color: var(--idea-muted);
}
.idea-admin-rule-select {
  width: 100%;
  padding: .3rem .5rem;
  border: 1px solid var(--idea-border);
  border-radius: 4px;
  background: var(--idea-surface);
  color: var(--idea-text);
  font-size: .84rem;
}
.idea-admin-rule-del-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.8rem;
  height: 1.8rem;
  border: none;
  border-radius: 4px;
  background: transparent;
  color: var(--idea-muted);
  cursor: pointer;
  font-size: .9rem;
  transition: background .15s, color .15s;
}
.idea-admin-rule-del-btn:hover {
  background: var(--idea-danger-bg, #fef2f2);
  color: var(--idea-danger, #dc2626);
}
.idea-admin-rule-add-row {
  padding: .5rem .6rem;
}
.idea-admin-rule-count-chip {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-size: .78rem;
  font-weight: 600;
  color: var(--idea-muted);
  background: var(--idea-surface-alt, rgba(0,0,0,.04));
  border-radius: 999px;
  padding: .18rem .7rem;
}
</style>
{% endblock %}

{% block javascript %}
<script>
(function () {
  'use strict';

  var AUTHORITY_OPTIONS = {{ authorityOptions|json_encode|raw }};

  function buildOptionHtml(selectedId) {
    return AUTHORITY_OPTIONS.map(function (opt) {
      var sel = (parseInt(selectedId, 10) === opt.id) ? ' selected' : '';
      return '<option value="' + opt.id + '"' + sel + '>' + opt.label + '</option>';
    }).join('');
  }

  function reindex(tbody) {
    var rows = tbody.querySelectorAll('tr[data-rule-row]');
    rows.forEach(function (row, idx) {
      row.querySelector('select').name = 'AuthorityRoles[' + idx + '][Authority]';
      row.querySelector('input[type="text"]').name = 'AuthorityRoles[' + idx + '][deny_url]';
    });
    updateCount(rows.length);
  }

  function updateCount(n) {
    var chip = document.getElementById('idea-admin-rule-count');
    if (chip) {
      chip.textContent = n + ' 件';
    }
  }

  function buildRow(idx, authorityId, denyUrl) {
    var tr = document.createElement('tr');
    tr.setAttribute('data-rule-row', '');
    tr.innerHTML =
      '<td class="idea-admin-rule-table__role">' +
        '<select name="AuthorityRoles[' + idx + '][Authority]" class="idea-admin-rule-select">' +
          buildOptionHtml(authorityId) +
        '</select>' +
      '</td>' +
      '<td class="idea-admin-rule-table__url">' +
        '<input type="text" name="AuthorityRoles[' + idx + '][deny_url]"' +
          ' class="idea-admin-rule-url-input"' +
          ' value="' + escAttr(denyUrl) + '"' +
          ' placeholder="/admin/setting/system/security"' +
          ' aria-label="拒否URL">' +
      '</td>' +
      '<td class="idea-admin-rule-table__action">' +
        '<button type="button" class="idea-admin-rule-del-btn" aria-label="この行を削除">' +
          '<i class="fa fa-times" aria-hidden="true"></i>' +
        '</button>' +
      '</td>';
    tr.querySelector('.idea-admin-rule-del-btn').addEventListener('click', function () {
      var tbody = tr.parentElement;
      tr.remove();
      reindex(tbody);
    });
    return tr;
  }

  function escAttr(str) {
    return (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  document.addEventListener('DOMContentLoaded', function () {
    var tbody = document.getElementById('idea-admin-rule-tbody');
    if (!tbody) return;

    // Attach delete handlers to server-rendered rows
    tbody.querySelectorAll('.idea-admin-rule-del-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var row = btn.closest('tr[data-rule-row]');
        if (row) {
          row.remove();
          reindex(tbody);
        }
      });
    });

    // Add row button
    var addBtn = document.getElementById('idea-admin-rule-add');
    if (addBtn) {
      addBtn.addEventListener('click', function () {
        var rows = tbody.querySelectorAll('tr[data-rule-row]');
        var nextIdx = rows.length;
        // Default authority: last row's selected value, or first option
        var lastSelect = rows.length > 0
          ? rows[rows.length - 1].querySelector('select')
          : null;
        var defaultAuth = lastSelect ? lastSelect.value : (AUTHORITY_OPTIONS.length > 0 ? AUTHORITY_OPTIONS[0].id : 1);
        var newRow = buildRow(nextIdx, defaultAuth, '');
        tbody.appendChild(newRow);
        newRow.querySelector('input[type="text"]').focus();
        updateCount(tbody.querySelectorAll('tr[data-rule-row]').length);
      });
    }

    updateCount(tbody.querySelectorAll('tr[data-rule-row]').length);
  });
}());
</script>
{% endblock %}

{% block main %}
<form name="form1" method="post" action="/admin/authority-role" id="authority-role-form" role="form" novalidate>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

  {% if message is defined and message %}
  <div class="idea-admin-notice idea-admin-notice--info" role="status">
    <i class="fa fa-check-circle" aria-hidden="true"></i>
    {{ message }}
  </div>
  {% endif %}

  <div class="idea-admin-layout">

    {# ── Primary column: rule table ─────────────────────────────────── #}
    <div class="idea-admin-primary">

      <section class="idea-admin-panel" aria-labelledby="section-rules">

        <div class="idea-admin-panel__head">
          <h3 id="section-rules">
            URL アクセス拒否ルール
            <span class="idea-admin-rule-count-chip" id="idea-admin-rule-count" aria-live="polite">
              {{ rules|length }} 件
            </span>
          </h3>
        </div>

        <p class="idea-admin-panel__hint" style="padding: .5rem 1rem 0;">
          権限ごとに管理画面の特定 URL へのアクセスを拒否します。
          店舗オーナーに制限したいパスを追加してください。例:
          <code>/admin/setting/system/security</code>
        </p>

        <div class="idea-admin-panel__body" style="padding: .6rem 0 0;">

          <div class="idea-admin-table-wrap">
            <table class="idea-admin-rule-table" aria-label="権限ルール一覧">
              <thead>
                <tr>
                  <th scope="col">権限</th>
                  <th scope="col">拒否URL</th>
                  <th scope="col" aria-label="操作"></th>
                </tr>
              </thead>
              <tbody id="idea-admin-rule-tbody">
                {% for rule in rules %}
                <tr data-rule-row>
                  <td class="idea-admin-rule-table__role">
                    <select
                      name="AuthorityRoles[{{ loop.index0 }}][Authority]"
                      class="idea-admin-rule-select"
                      aria-label="権限レベル"
                    >
                      {% for option in authorityOptions %}
                      <option
                        value="{{ option.id }}"
                        {% if option.id == rule.authority %}selected{% endif %}
                      >{{ option.label }}</option>
                      {% endfor %}
                    </select>
                  </td>
                  <td class="idea-admin-rule-table__url">
                    <input
                      type="text"
                      name="AuthorityRoles[{{ loop.index0 }}][deny_url]"
                      class="idea-admin-rule-url-input"
                      value="{{ rule.denyUrl }}"
                      placeholder="/admin/setting/system/security"
                      aria-label="拒否URL"
                    >
                  </td>
                  <td class="idea-admin-rule-table__action">
                    <button
                      type="button"
                      class="idea-admin-rule-del-btn"
                      aria-label="この行を削除"
                    >
                      <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                  </td>
                </tr>
                {% else %}
                {# empty state — JS add-row fills this #}
                <tr id="idea-admin-rule-empty" aria-hidden="true">
                  <td colspan="3" class="idea-admin-empty" style="padding:1.4rem; text-align:center;">
                    <span class="idea-admin-empty__title">ルールがありません</span>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          <div class="idea-admin-rule-add-row">
            <button
              type="button"
              id="idea-admin-rule-add"
              class="idea-admin-text-btn"
              aria-label="ルール行を追加"
            >
              <i class="fa fa-plus" aria-hidden="true"></i>
              行を追加
            </button>
          </div>

        </div>
      </section>

    </div>

    {# ── Side panel: authority legend ────────────────────────────────── #}
    <aside class="idea-admin-side" aria-label="権限レベルの説明">

      <section class="idea-admin-panel" aria-labelledby="section-legend">
        <div class="idea-admin-panel__head">
          <h3 id="section-legend">権限レベル</h3>
        </div>
        <div class="idea-admin-panel__body">
          {% for option in authorityOptions %}
          <div class="idea-admin-spec-row">
            <dt>
              {% if option.id == 0 %}
              <span class="idea-admin-badge idea-admin-badge--public">{{ option.label }}</span>
              {% else %}
              <span class="idea-admin-badge idea-admin-badge--private">{{ option.label }}</span>
              {% endif %}
            </dt>
            <dd style="font-size:.8rem; color:var(--idea-muted); margin-top:.25rem;">
              {% if option.id == 0 %}
                全機能にアクセス可能。拒否ルールの対象外。
              {% else %}
                拒否ルールに登録されたURLへのアクセスが制限されます。
              {% endif %}
            </dd>
          </div>
          {% endfor %}
        </div>
      </section>

      <section class="idea-admin-panel" aria-labelledby="section-nav">
        <div class="idea-admin-panel__head">
          <h3 id="section-nav">関連ページ</h3>
        </div>
        <div class="idea-admin-panel__body">
          <a href="/admin/member-list" class="idea-admin-text-btn" rel="goMemberList">
            <i class="fa fa-users" aria-hidden="true"></i>
            メンバー一覧
          </a>
        </div>
      </section>

    </aside>

  </div>

  {# ── Action toolbar ──────────────────────────────────────────────── #}
  <div class="idea-admin-toolbar" role="navigation" aria-label="フォーム操作">
    <div class="idea-admin-toolbar__back">
      <a href="/admin/member-list" rel="goMemberList">
        <i class="fa fa-backward" aria-hidden="true"></i>
        メンバー一覧に戻る
      </a>
    </div>
    <div class="idea-admin-toolbar__actions">
      <button class="idea-admin-action idea-admin-action--primary" type="submit">
        <i class="fa fa-save" aria-hidden="true"></i>
        保存
      </button>
    </div>
  </div>

</form>
{% endblock %}
