{#
  BeMart admin Authority management — EC-CUBE Setting/System/authority.twig.

  Tier-2 port. `AuthorityRole::onGet()` supplies the form body shape for
  the URL-deny rule editor; the POST transition already exists as
  `doUpdateAuthorityRole`.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-authority-role' %}
{% set title = '権限管理' %}
{% set sub_title = 'システム設定' %}

{% block javascript %}
    <script>
        $(function() {
            var $collectionHolder = $('#table-authority');
            var index = $collectionHolder.find('.authority-rule').length;

            $('.add').click(function() {
                index++;
                var newForm = '<tr class="authority-rule"><td><select name="AuthorityRoles[' + index + '][Authority]" class="form-select">{% for option in authorityOptions %}<option value="{{ option.id }}">{{ option.label }}</option>{% endfor %}</select></td><td><input type="text" name="AuthorityRoles[' + index + '][deny_url]" class="form-control"></td><td class="text-center"><button type="button" class="btn btn-ec-regular delete">削除</button></td></tr>';
                var $lastRow = $('#table-authority tbody > tr:last');
                $lastRow.after(newForm);
            });

            $(document).on('click', '.delete', function() {
                $(this).parent('td').parent('tr').remove();
                var idx = $collectionHolder.find('.authority-rule').length;
                if (idx == 0) {
                    $('#table-authority tbody').append('<tr class="authority-rule"><td><select name="AuthorityRoles[0][Authority]" class="form-select">{% for option in authorityOptions %}<option value="{{ option.id }}">{{ option.label }}</option>{% endfor %}</select></td><td><input type="text" name="AuthorityRoles[0][deny_url]" class="form-control"></td><td class="text-center"><button type="button" class="btn btn-ec-regular delete">削除</button></td></tr>');
                }
            });
        });
    </script>
{% endblock javascript %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <form name="form1" method="post" action="/admin/authority-role" class="doUpdateAuthorityRole">
                    <input type="hidden" name="csrfToken" value="{{ csrfToken|default(csrf_token()) }}">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <span class="card-title">権限設定</span>
                        </div>
                        <div class="card-body">
                            <p>権限ごとにアクセスを拒否する管理画面URLを設定します。</p>
                            <p>例：<code>/setting/system/security</code></p>
                            <div class="table-responsive">
                                <table id="table-authority" class="table table-striped table-condensed with-border">
                                    <thead>
                                    <tr>
                                        <th style="width: 210px;">権限</th>
                                        <th>拒否URL</th>
                                        <th style="width: 80px;"></th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for rule in rules %}
                                        <tr class="authority-rule">
                                            <td>
                                                <select name="AuthorityRoles[{{ loop.index0 }}][Authority]" class="form-select">
                                                    {% for option in authorityOptions %}
                                                        <option value="{{ option.id }}"{% if option.id == rule.authority %} selected{% endif %}>{{ option.label }}</option>
                                                    {% endfor %}
                                                </select>
                                            </td>
                                            <td>
                                                <input type="text" name="AuthorityRoles[{{ loop.index0 }}][deny_url]" class="form-control" value="{{ rule.denyUrl }}">
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-ec-regular delete">削除</button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            <p>
                                <button type="button" class="btn btn-ec-regular add">行を追加</button>
                            </p>
                        </div>
                    </div>
                    <div class="c-conversionArea">
                        <div class="c-conversionArea__container">
                            <div class="row justify-content-between align-items-center">
                                <div class="col-6">
                                    <div class="c-conversionArea__leftBlockItem"></div>
                                </div>
                                <div class="col-6">
                                    <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                                        <div class="col-auto">
                                            <button class="btn btn-ec-conversion px-5" type="submit">登録</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
