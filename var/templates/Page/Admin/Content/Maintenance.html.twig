{#
  BeMart admin メンテナンス管理 — EC-CUBE goMaintenance.

  PORT of EC-CUBE 4.3 admin-theme `Content/maintenance.twig`
  (src/Eccube/Resource/template/admin/Content/maintenance.twig).

  DATA page with a single toggle button. Extends the admin frame
  (`admin-base.html.twig`). The markup skeleton + `c-*` / `ec-*` /
  Bootstrap classes are kept verbatim from EC-CUBE; only the dynamic
  bindings are rebound.

  The Maintenance resource (src/Resource/Page/Admin/Content/Maintenance.php)
  is a thin HTML renderer — see its port header (the toggle POST is an
  operational action, not a domain mutation). `body['isMaintenance']`
  drives which toggle button shows; it defaults to false (the
  fresh-install off-state).

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `canonical-url route)`         -> deterministic `/{route}` (BeMartTwigExtension).
   - `{{ '...'|trans|nl2br }}` -> the ja literal with the `nl2br` Twig
     builtin kept (the maintenance message is multi-line).
   - `form_widget(form._token)` -> EC-CUBE per-request CSRF widget. The
     hidden `_token` input is kept (structure) with an empty value;
     EC-CUBE-runtime only — enumerated as residual.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-content-maintenance' %}
{% set title = 'メンテナンス管理' %}
{% set sub_title = 'コンテンツ管理' %}

{% block main %}
    <form method="post" action="/admin/content/maintenance?_method=put">
        <input type="hidden" id="maintenance__token" name="csrfToken" value="{{ csrfToken|default('') }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col"><span class="card-title">メンテナンスモード</span></div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-auto">
                                    <span>{{ 'メンテナンスモードを有効にすると、SHOPの機能を一時的に停止し、管理画面のみアクセス可能な状態となります。
※プラグインのインストール/有効/無効/削除時には、自動的にメンテナンスモードに切り替わります。
'|nl2br }}</span>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-auto">
                                    {% if isMaintenance %}
                                    <input type="hidden" name="maintenance" value="off">
                                    <button type="submit" class="btn btn-ec-conversion">無効にする</button>
                                    {% else %}
                                    <input type="hidden" name="maintenance" value="on">
                                    <button type="submit" class="btn btn-ec-conversion">有効にする</button>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
