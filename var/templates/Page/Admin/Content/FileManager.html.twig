{#
  BeMart admin ファイル管理 — EC-CUBE goFileManager.

  PORT of EC-CUBE 4.3 admin-theme `Content/file.twig`
  (src/Eccube/Resource/template/admin/Content/file.twig).

  FORM page (the user_data file manager). Extends the admin frame
  (`admin-base.html.twig`). The markup skeleton + `c-*` / `ec-*` /
  Bootstrap classes are kept verbatim from EC-CUBE; only the dynamic
  bindings are rebound.

  The FileManager resource (src/Resource/Page/Admin/Content/FileManager.php)
  is a thin HTML renderer — see its port header (EC-CUBE's FileController
  is a filesystem file manager with no Be domain). The body renders the
  fresh / empty-directory state.

  FORM-PAGE recipe (Ray.WebFormModule — see var/templates/README.md): the
  resource exposes an {@see \MyVendor\BeMart\Form\AdminFileForm} as
  `body['form']`. The upload + new-folder inputs render through that real
  form object:
    {{ form.input('file')|raw }}          <- real <input type=file>
    {{ form.input('create_file')|raw }}   <- real <input type=text>

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `canonical-url route)`         -> deterministic `/{route}` (BeMartTwigExtension).
   - `form_widget(form._token)` -> EC-CUBE per-request CSRF widget. The
     hidden `_token` input is kept (structure) with an empty value;
     EC-CUBE-runtime only — enumerated as residual.
   - the `{% block javascript %}` file-tree / breadcrumb runtime
     (`tpl_javascript`, `paths`, `now_dir_list`, `file_manager.js`) ->
     client-side file-manager runtime; the markup shells are kept, the
     JS payload variables render empty (the resource carries no file
     tree). Enumerated as residual.
   - `arrFileList` -> empty (the FileManager renderer lists no files —
     see its port header). The `{% for file in arrFileList %}` loop
     produces no rows; the table renders empty. Enumerated as residual —
     MISSING-BODY-FIELD: `arrFileList` (the user_data file listing).
   - `tpl_is_top_dir` -> false (at the user_data root): the parent-dir
     "go up" row is omitted.
   - `{% form_theme %}` -> Symfony form-theme runtime. Dropped.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-content-file' %}
{% set title = 'ファイル管理' %}
{% set sub_title = 'コンテンツ管理' %}

{% block stylesheet %}
    <style>
        .copy-file-path {
            display: none;
        }
    </style>
{% endblock stylesheet %}

{% block main %}
    <form name="form1" id="form1" method="post" action="?" enctype="multipart/form-data">
        <input type="hidden" name="mode" value=""/>
        <input type="hidden" name="now_file" value="{{ tplNowDir|default('') }}"/>
        <input type="hidden" name="now_dir" value="{{ tplNowDir|default('') }}"/>
        <input type="hidden" name="tree_select_file" value="{{ tplNowDir|default('') }}"/>
        <input type="hidden" name="tree_status" value=""/>
        <input type="hidden" name="select_file" value=""/>
        <input type="hidden" id="file__token" name="csrfToken" value="{{ csrfToken|default('') }}">
        <div class="c-outsideBlock">
            <div class="c-outsideBlock__contents">
                <nav aria-label="breadcrumb" role="navigation">
                    <ol class="breadcrumb mb-2 p-0" id="bread"></ol>
                </nav>
                <div class="card rounded border-0 mb-4">
                    <div class="card-header"><span class="card-title">ファイル・フォルダを追加</span></div>
                    <div class="card-body">
                        <div id="upload_box__file" class="row mb-2">
                            <div class="col-2" data-bs-toggle="tooltip" data-bs-placement="top" title="ファイルの追加は複数ファイルを選択してアップロードできます。"><span>ファイルを追加</span><i class="fa fa-question-circle fa-lg ms-1"></i></div>
                            <div class="col mb-3">
                                <div class="mb-2">
                                    {{ form.input('file')|raw }}
                                </div>
                                <div class="mb-2">
                                    <a class="btn btn-ec-conversion action-upload" href="javascript:;">アップロード</a>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-2"><span>フォルダを追加</span></div>
                            <div class="col">
                                <div class="row">
                                    <div class="col-3">
                                        {{ form.input('create_file')|raw }}
                                    </div>
                                    <div class="col-auto">
                                        <a class="btn btn-ec-regular action-create" href="javascript:">新規作成</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="c-contentsArea__cols">
                <div class="c-contentsArea__primaryCol">
                    <div class="c-primaryCol">
                        <div class="card rounded border-0 mb-4">
                            <div class="card-header">
                                <div class="row">
                                    <div class="col-8"><span class="card-title">このフォルダ内のファイル</span></div>
                                    <div class="col-4 text-end"><a data-bs-toggle="collapse" href="#fileList" aria-expanded="false" aria-controls="fileList"><i class="fa fa-angle-up fa-lg"></i></a></div>
                                </div>
                            </div>
                            <div class="collapse show ec-cardCollapse" id="fileList">
                                <div class="card-body p-0">

                                    <table class="table">
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="c-contentsArea__secondaryCol">
                    <div class="c-secondaryCol">
                        <div class="card rounded border-0 mb-4">
                            <div class="card-header">
                                <div class="row">
                                    <div class="col-8"><span class="card-title">フォルダ構成</span></div>
                                    <div class="col-4 text-end"><a data-bs-toggle="collapse" href="#folderDirectory" aria-expanded="false" aria-controls="folderDirectory"><i class="fa fa-lg fa-angle-down"></i></a></div>
                                </div>
                            </div>
                            <div class="collapse show ec-cardCollapse" id="folderDirectory">
                                <div class="card-body">
                                    <div class="c-directoryTree--folder mb-3">
                                        <ul id="directory_userdata" class="list-unstyled">
                                            <li>
                                                <label class="collapsed" data-bs-toggle="collapse" href="#directory_userdata" aria-expanded="false" aria-controls="directory_userdata">user_data</label>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
