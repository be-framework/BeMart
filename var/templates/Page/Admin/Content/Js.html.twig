{#
  BeMart admin — カスタマイズ JavaScript 編集
  Resource: page://self/admin/content/js (GET + PUT)
  Form:     AdminJsForm  (field: js / id: form_js)
  Action:   POST /admin/content/js?_method=put
            Fields: js, mode=content_operation_form, csrfToken
  Design:   idea-admin-* vocabulary. No EC-CUBE / Bootstrap / jQuery.
#}
{% extends 'admin-base.html.twig' %}

{% set route     = 'admin-content-js' %}
{% set title     = 'JavaScript 編集' %}
{% set sub_title = 'コンテンツ管理' %}

{% block stylesheet %}
<style>
/* ── page-scoped additions (idea-admin-* naming) ── */
.idea-admin-js-editor-wrap {
  position: relative;
}
.idea-admin-js-editor-wrap textarea {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  font-size: .84rem;
  line-height: 1.6;
  min-height: 540px;
  resize: vertical;
  white-space: pre;
  overflow-wrap: normal;
  overflow-x: auto;
  tab-size: 2;
}
.idea-admin-js-char-count {
  font-size: .74rem;
  color: var(--idea-muted);
  font-variant-numeric: tabular-nums;
  margin-left: auto;
}
.idea-admin-js-saved-indicator {
  display: none;
  align-items: center;
  gap: .3rem;
  font-size: .76rem;
  font-weight: 700;
  color: var(--idea-olive);
}
.idea-admin-js-saved-indicator.is-visible {
  display: inline-flex;
}
</style>
{% endblock %}

{% block main %}
<form id="js-edit-form"
      method="post"
      action="/admin/content/js?_method=put">

    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
    <input type="hidden" name="mode"      value="content_operation_form">

    {# ── info notice ────────────────────────────────────────────────────── #}
    <div class="idea-admin-notice idea-admin-notice--info" role="note">
        <i class="fa fa-circle-info fa-fw" aria-hidden="true"></i>
        ここで保存した JavaScript はストアフロントの全ページに読み込まれます。
        構文エラーがないことを確認してから保存してください。
    </div>

    {# ── editor panel ────────────────────────────────────────────────────── #}
    <div class="idea-admin-panel idea-admin-js-editor-wrap">

        <div class="idea-admin-panel__head">
            <h3><i class="fa fa-code fa-fw" aria-hidden="true"></i> カスタマイズ JavaScript</h3>
            <span class="idea-admin-panel__hint">customize.js に書き出されます</span>
            <span class="idea-admin-js-char-count" id="js-char-count" aria-live="polite"></span>
            <span class="idea-admin-js-saved-indicator" id="js-saved-indicator" aria-live="polite">
                <i class="fa fa-check-circle fa-fw" aria-hidden="true"></i>保存済み
            </span>
        </div>

        <div class="idea-admin-panel__body">
            <div class="idea-admin-field__input">
                {{ form.input('js')|raw }}
                {% if form.error('js') %}
                    <span class="idea-admin-error" role="alert">{{ form.error('js') }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── fixed bottom toolbar ─────────────────────────────────────────────── #}
    <div class="idea-admin-toolbar" role="toolbar" aria-label="ページ操作">
        <div class="idea-admin-toolbar__back">
            <a href="/admin/content/css">
                <i class="fa fa-arrow-left fa-fw" aria-hidden="true"></i>CSS 管理へ
            </a>
        </div>
        <div class="idea-admin-toolbar__actions">
            <button type="submit"
                    id="js-save-btn"
                    class="idea-admin-action idea-admin-action--primary">
                <i class="fa fa-floppy-disk fa-fw" aria-hidden="true"></i>
                保存
            </button>
        </div>
    </div>

</form>
{% endblock %}

{% block javascript %}
<script>
(function () {
    'use strict';

    var ta      = document.getElementById('form_js');
    var counter = document.getElementById('js-char-count');
    var saved   = document.getElementById('js-saved-indicator');
    var form    = document.getElementById('js-edit-form');

    function updateCount() {
        if (!ta || !counter) { return; }
        var n = ta.value.length;
        counter.textContent = n.toLocaleString('ja-JP') + ' 文字';
    }

    if (ta) {
        updateCount();
        ta.addEventListener('input', function () {
            updateCount();
            if (saved) { saved.classList.remove('is-visible'); }
        });
    }

    /* Mark "saved" state on successful redirect-back (URL unchanged = fresh GET). */
    if (saved && window.location.search === '') {
        var marker = sessionStorage.getItem('bemart-js-saved');
        if (marker === '1') {
            sessionStorage.removeItem('bemart-js-saved');
            saved.classList.add('is-visible');
        }
    }

    if (form) {
        form.addEventListener('submit', function () {
            sessionStorage.setItem('bemart-js-saved', '1');
        });
    }
}());
</script>
{% endblock %}
