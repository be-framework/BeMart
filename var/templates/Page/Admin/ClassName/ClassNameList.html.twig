{% extends 'admin-base.html.twig' %}

{% set route = 'admin-class-name-class-name-list' %}
{% set title = '規格管理' %}
{% set sub_title = '商品管理' %}

{% block main %}
<div class="idea-admin-list-toolbar">
    <div class="idea-admin-list-toolbar__left">
        <span class="idea-admin-count">{{ count }}件</span>
    </div>
    <div class="idea-admin-list-toolbar__right">
        <a class="idea-admin-action" href="/admin/class-name/class-name-export">
            <i class="fa fa-download" aria-hidden="true"></i>
            CSV出力
        </a>
        <a class="idea-admin-action" href="/admin/csv-config">
            <i class="fa fa-cog" aria-hidden="true"></i>
            CSV項目設定
        </a>
    </div>
</div>

<div class="idea-admin-panel" style="margin-bottom:1.25rem">
    <div class="idea-admin-panel__head">
        <h3>新規登録</h3>
    </div>
    <div class="idea-admin-panel__body">
        <form method="post" action="/admin/class-name/class-name-list">
            <div class="idea-admin-field">
                <div class="idea-admin-field__label">
                    <label for="admin_class_name_name">
                        規格名
                        <span class="idea-admin-required">必須</span>
                    </label>
                </div>
                <div class="idea-admin-field__input">
                    {{ form.input('classNameLabel')|raw }}
                    <span class="idea-admin-error">{{ form.error('classNameLabel')|raw }}</span>
                </div>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:.75rem">
                <button class="idea-admin-action idea-admin-action--primary" type="submit">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    登録
                </button>
            </div>
        </form>
    </div>
</div>

{% if classNames is not empty %}
<div class="idea-admin-table-wrap">
    <table class="idea-admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>規格名</th>
                <th class="idea-admin-table__actions">操作</th>
            </tr>
        </thead>
        <tbody id="class-name-list">
            {% for className in classNames %}
                <tr id="row-{{ className.classNameId }}"
                    class="idea-admin-class-name-row"
                    data-class-name-id="{{ className.classNameId }}">
                    <td>{{ className.classNameId }}</td>
                    <td>
                        <span class="idea-admin-class-name-view">
                            <a href="/admin/class-category/class-category-list?classNameId={{ className.classNameId }}"
                               rel="goClassCategoryList">
                                {{ className.name }}
                            </a>
                        </span>
                        <span class="idea-admin-class-name-edit" hidden>
                            <form method="post"
                                  action="/admin/class-name/class-name?classNameId={{ className.classNameId|url_encode }}&amp;_method=put">
                                <input type="text" class="idea-admin-inline-input"
                                       name="classNameLabel" value="{{ className.name }}"
                                       aria-label="規格名">
                                <button class="idea-admin-action idea-admin-action--primary idea-admin-action--sm"
                                        type="submit">確定</button>
                                <button class="idea-admin-action idea-admin-action--sm js-edit-cancel"
                                        type="button"
                                        data-class-name-id="{{ className.classNameId }}">キャンセル</button>
                            </form>
                        </span>
                    </td>
                    <td class="idea-admin-table__actions">
                        <button class="idea-admin-icon-btn js-edit-open"
                                type="button"
                                data-class-name-id="{{ className.classNameId }}"
                                aria-label="編集">
                            <i class="fa fa-pencil" aria-hidden="true"></i>
                        </button>
                        <button class="idea-admin-icon-btn js-delete-open"
                                type="button"
                                data-class-name-id="{{ className.classNameId }}"
                                data-class-name="{{ className.name }}"
                                aria-label="削除">
                            <i class="fa fa-trash" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="idea-admin-empty">
    <span class="idea-admin-empty__title">規格がまだ登録されていません</span>
    <span>上のフォームから最初の規格名を登録してください。</span>
</div>
{% endif %}

{# ── Delete confirmation dialog ── #}
<dialog id="idea-delete-dialog" aria-labelledby="idea-delete-title">
    <div class="idea-admin-panel" style="min-width:20rem;max-width:28rem">
        <div class="idea-admin-panel__head">
            <h3 id="idea-delete-title">規格の削除</h3>
        </div>
        <div class="idea-admin-panel__body">
            <p id="idea-delete-message"></p>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:.65rem;padding:.75rem 1rem;border-top:1px solid rgba(205,191,170,.4)">
            <button class="idea-admin-action" id="idea-delete-cancel" type="button">キャンセル</button>
            <form id="idea-delete-form" method="post" action="" style="margin:0">
                <button class="idea-admin-action idea-admin-action--destructive" type="submit">削除する</button>
            </form>
        </div>
    </div>
</dialog>
{% endblock %}

{% block javascript %}
<style>
.idea-admin-inline-input {
    border: 1px solid var(--idea-stone);
    border-radius: var(--idea-admin-radius-input);
    padding: .3rem .55rem;
    font: inherit;
    font-size: .88rem;
    color: var(--idea-ink);
    background: rgba(255,253,248,.95);
    outline: none;
    transition: border-color .15s, box-shadow .15s;
}
.idea-admin-inline-input:focus {
    border-color: var(--idea-olive);
    box-shadow: 0 0 0 3px rgba(82,107,85,.15);
}
.idea-admin-action--sm {
    padding: .3rem .75rem;
    font-size: .8rem;
}
#idea-delete-dialog {
    border: none;
    background: transparent;
    padding: 0;
}
#idea-delete-dialog::backdrop {
    background: rgba(41,37,31,.45);
}
</style>
<script>
(function () {
    var dialog = document.getElementById('idea-delete-dialog');
    var deleteForm = document.getElementById('idea-delete-form');
    var deleteMessage = document.getElementById('idea-delete-message');
    var deleteCancel = document.getElementById('idea-delete-cancel');

    // Edit open
    document.querySelectorAll('.js-edit-open').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.dataset.classNameId;
            var row = document.querySelector('[data-class-name-id="' + id + '"]');
            row.querySelector('.idea-admin-class-name-view').hidden = true;
            row.querySelector('.idea-admin-class-name-edit').hidden = false;
        });
    });

    // Edit cancel
    document.querySelectorAll('.js-edit-cancel').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.dataset.classNameId;
            var row = document.querySelector('[data-class-name-id="' + id + '"]');
            row.querySelector('.idea-admin-class-name-view').hidden = false;
            row.querySelector('.idea-admin-class-name-edit').hidden = true;
        });
    });

    // Delete open
    document.querySelectorAll('.js-delete-open').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.dataset.classNameId;
            var name = btn.dataset.className;
            deleteMessage.textContent = '「' + name + '」を削除します。この操作は取り消せません。';
            deleteForm.action = '/admin/class-name/class-name?classNameId='
                + encodeURIComponent(id) + '&_method=delete';
            dialog.showModal();
        });
    });

    deleteCancel.addEventListener('click', function () {
        dialog.close();
    });
}());
</script>
{% endblock %}
