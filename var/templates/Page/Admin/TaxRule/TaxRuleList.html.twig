{% extends 'admin-base.html.twig' %}
{#
  BeMart admin Tax-rule list — clean-room build (idea-admin design language).

  DATA CONTRACT (src/Resource/Page/Admin/TaxRule/TaxRuleList.php onGet):
    count       int          — total number of tax-rule rows
    taxRules    list<{taxRuleId: string, taxRate: float,
                      roundingType: int, applyDate: string}>
    form        AdminTaxRuleForm — inline-create inputs (taxRate, applyDate)

  FORM CONTRACT (src/Form/AdminTaxRuleForm.php):
    fields: taxRate (number, id=tax_rule_tax_rate),
            applyDate (datetime-local, id=tax_rule_apply_date)

  ACTIONS (derived from ALPS #[Link] declarations):
    POST   /admin/tax-rule/tax-rule-list — doCreateTaxRule  (create new rule)
    DELETE /admin/tax-rule/tax-rule      — doDeleteTaxRule  (remove one rule)
      via GET  ?taxRuleId=…&_method=delete  (method-override)

  CSRF: csrfToken from resource body; field name "csrfToken".

  No doUpdateTaxRule — alps.json routes edits as delete-then-create.
  roundingType is rendered read-only (bare int; no option-set in projection).
#}

{% set route = 'admin-tax-rule-tax-rule-list' %}
{% set title = '税率設定' %}
{% set sub_title = '店舗設定' %}

{% block main %}
<div class="idea-admin-list-toolbar">
    <div class="idea-admin-list-toolbar__left">
        <span class="idea-admin-count">{{ count }} 件</span>
    </div>
</div>

<section class="idea-admin-panel" aria-labelledby="section-tax-rule-list">
    <div class="idea-admin-panel__head">
        <h3 id="section-tax-rule-list">
            <i class="fa fa-percent fa-fw" aria-hidden="true"></i>
            税率ルール
        </h3>
    </div>
    <div class="idea-admin-panel__body" style="padding: 0;">

        <div class="idea-admin-table-wrap">
            <table class="idea-admin-table" id="tax-rule-list-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>税率</th>
                        <th>端数処理</th>
                        <th>適用日時</th>
                        <th class="idea-admin-table__actions"></th>
                    </tr>
                </thead>
                <tbody>

                    {# inline-create row #}
                    <tr id="tax_rule_item_new">
                        <form id="form1"
                              role="form"
                              method="post"
                              action="/admin/tax-rule/tax-rule-list">
                            <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                            <td>—</td>
                            <td>
                                <div style="display:flex;align-items:center;gap:.4rem;">
                                    <div class="idea-admin-field__input" style="margin:0;flex:1;">
                                        {{ form.input('taxRate')|raw }}
                                        {% if form.error('taxRate') %}
                                            <span class="idea-admin-error">{{ form.error('taxRate') }}</span>
                                        {% endif %}
                                    </div>
                                    <span aria-label="パーセント">%</span>
                                </div>
                            </td>
                            <td>—</td>
                            <td>
                                <div class="idea-admin-field__input" style="margin:0;">
                                    {{ form.input('applyDate')|raw }}
                                    {% if form.error('applyDate') %}
                                        <span class="idea-admin-error">{{ form.error('applyDate') }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="idea-admin-table__actions">
                                <button class="idea-admin-action idea-admin-action--primary" type="submit">
                                    <i class="fa fa-plus fa-fw" aria-hidden="true"></i>
                                    新規作成
                                </button>
                            </td>
                        </form>
                    </tr>

                    {% for TaxRule in taxRules %}
                    <tr id="tax-rule-row-{{ TaxRule.taxRuleId }}">
                        <td>{{ TaxRule.taxRuleId }}</td>
                        <td>{{ TaxRule.taxRate }}&nbsp;%</td>
                        <td>{{ TaxRule.roundingType }}</td>
                        <td>{{ TaxRule.applyDate }}</td>
                        <td class="idea-admin-table__actions">
                            {# delete trigger — opens per-row confirm dialog #}
                            <button class="idea-admin-icon-btn idea-admin-text-btn--danger"
                                    type="button"
                                    aria-label="削除"
                                    data-delete-id="{{ TaxRule.taxRuleId }}"
                                    onclick="document.getElementById('delete-dialog-{{ TaxRule.taxRuleId }}').showModal()">
                                <i class="fa fa-trash fa-fw" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>

                    {# per-row confirm dialog (native <dialog>) #}
                    <dialog id="delete-dialog-{{ TaxRule.taxRuleId }}"
                            aria-labelledby="delete-dialog-title-{{ TaxRule.taxRuleId }}">
                        <div class="idea-admin-panel" style="margin:0;border:none;box-shadow:none;">
                            <div class="idea-admin-panel__head">
                                <h3 id="delete-dialog-title-{{ TaxRule.taxRuleId }}">
                                    <i class="fa fa-exclamation-triangle fa-fw" aria-hidden="true"></i>
                                    確認
                                </h3>
                            </div>
                            <div class="idea-admin-panel__body">
                                <p>税率ルール「{{ TaxRule.taxRuleId }}」を削除します。この操作は取り消せません。</p>
                                <div style="display:flex;justify-content:flex-end;gap:.6rem;margin-top:1rem;">
                                    <button class="idea-admin-action"
                                            type="button"
                                            onclick="this.closest('dialog').close()">
                                        キャンセル
                                    </button>
                                    <a class="idea-admin-action idea-admin-action--destructive"
                                       href="/admin/tax-rule/tax-rule?taxRuleId={{ TaxRule.taxRuleId }}&amp;_method=delete"
                                       rel="doDeleteTaxRule">
                                        <i class="fa fa-trash fa-fw" aria-hidden="true"></i>
                                        削除
                                    </a>
                                </div>
                            </div>
                        </div>
                    </dialog>
                    {% endfor %}

                </tbody>
            </table>
        </div>

    </div>
</section>
{% endblock %}
