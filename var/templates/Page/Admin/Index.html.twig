{#
  BeMart admin dashboard — clean-room build.

  DATA CONTRACT (src/Resource/Page/Admin/Index.php onGet):
    countProducts          int        — total product count (real, from DashboardCountsQuery)
    countCustomers         int        — registered member count (real)
    countNonStockProducts  int        — out-of-stock product count (real)
    orderStatuses          array      — [{name, color, count}] — empty until sales projection lands
    orders                 array      — [{orderNo, orderStatus, orderDate, paymentTotal, total, itemCount}]
    salesThisMonth         int|null   — aggregate sales this month (empty placeholder)
    salesToday             int|null   — aggregate sales today (empty placeholder)
    salesYesterday         int|null   — aggregate sales yesterday (empty placeholder)
    recommendedPlugins     array      — [{pluginCode, name, version, enabled}] (empty placeholder)

  LINKS (src/Resource/Page/Admin/Index.php #[Link] annotations):
    goMemberList      GET  page://self/admin/member-list       → /admin/member-list
    goContentCache    GET  page://self/admin/content/cache     → /admin/content/cache
    doAdminLogout     POST page://self/admin/logout
    goAdminLogout     POST page://self/admin/login

  DESIGN VOCABULARY (public/assets/idea-store/css/idea-admin.css):
    idea-admin-kpi-grid   — row of summary metric cards
    idea-admin-kpi        — single metric card
    idea-admin-kpi__label — metric label text
    idea-admin-kpi__value — large numeric display
    idea-admin-kpi__sub   — secondary caption
    idea-admin-panel      — bordered section card
    idea-admin-panel__head — panel title row
    idea-admin-panel__body — panel content area
    idea-admin-table-wrap — overflow wrapper for tables
    idea-admin-table      — data table
    idea-admin-notice     — inline info / warning banner
    idea-admin-empty      — empty-state placeholder
    idea-admin-empty__title — empty-state heading
    idea-admin-action     — primary action button
    idea-admin-action--primary
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-index' %}
{% set title = 'ダッシュボード' %}

{% block main %}

{# ── Shop-status KPI row (real counts from DashboardCountsQuery) ───────────── #}
<div class="idea-admin-kpi-grid" aria-label="ショップ状況">

    <a href="/admin/product-list" class="idea-admin-kpi" aria-label="取扱商品数">
        <div class="idea-admin-kpi__label">
            <i class="fa fa-cubes fa-fw" aria-hidden="true"></i>
            取扱商品数
        </div>
        <div class="idea-admin-kpi__value">{{ countProducts|number_format }}</div>
        <div class="idea-admin-kpi__sub">商品一覧へ</div>
    </a>

    <a href="/admin/customer-list" class="idea-admin-kpi" aria-label="会員数">
        <div class="idea-admin-kpi__label">
            <i class="fa fa-users fa-fw" aria-hidden="true"></i>
            会員数
        </div>
        <div class="idea-admin-kpi__value">{{ countCustomers|number_format }}</div>
        <div class="idea-admin-kpi__sub">会員一覧へ</div>
    </a>

    <a href="/admin/product-list" class="idea-admin-kpi{% if countNonStockProducts > 0 %} idea-admin-kpi--negative{% endif %}" aria-label="在庫切れ商品数">
        <div class="idea-admin-kpi__label">
            <i class="fa fa-inbox fa-fw" aria-hidden="true"></i>
            在庫切れ商品数
        </div>
        <div class="idea-admin-kpi__value">{{ countNonStockProducts|number_format }}</div>
        <div class="idea-admin-kpi__sub">商品一覧へ</div>
    </a>

</div>{# /.idea-admin-kpi-grid #}

{# ── Sales summary KPI row (placeholder — no sales projection yet) ─────────── #}
<div class="idea-admin-kpi-grid" aria-label="売上状況">

    <div class="idea-admin-kpi">
        <div class="idea-admin-kpi__label">今月の売上</div>
        <div class="idea-admin-kpi__value">
            {% if salesThisMonth is not null %}
                {{ salesThisMonth|number_format }}円
            {% else %}
                ——
            {% endif %}
        </div>
    </div>

    <div class="idea-admin-kpi">
        <div class="idea-admin-kpi__label">本日の売上</div>
        <div class="idea-admin-kpi__value">
            {% if salesToday is not null %}
                {{ salesToday|number_format }}円
            {% else %}
                ——
            {% endif %}
        </div>
    </div>

    <div class="idea-admin-kpi">
        <div class="idea-admin-kpi__label">昨日の売上</div>
        <div class="idea-admin-kpi__value">
            {% if salesYesterday is not null %}
                {{ salesYesterday|number_format }}円
            {% else %}
                ——
            {% endif %}
        </div>
    </div>

</div>{# /.idea-admin-kpi-grid #}

{# ── Order-status table (placeholder — no order aggregate projection yet) ───── #}
<section class="idea-admin-panel" aria-labelledby="panel-order-status">
    <div class="idea-admin-panel__head">
        <h3 id="panel-order-status">
            <i class="fa fa-shopping-cart fa-fw" aria-hidden="true"></i>
            注文状況
        </h3>
        <a href="/admin/order-list" class="idea-admin-action idea-admin-action--primary">
            受注一覧へ
        </a>
    </div>
    <div class="idea-admin-panel__body">
        {% if orderStatuses is not empty %}
            <div class="idea-admin-table-wrap">
                <table class="idea-admin-table">
                    <thead>
                        <tr>
                            <th scope="col">ステータス</th>
                            <th scope="col">件数</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for status in orderStatuses %}
                            <tr>
                                <td>{{ status.name }}</td>
                                <td>{{ status.count|number_format }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="idea-admin-empty">
                <i class="fa fa-inbox fa-2x" aria-hidden="true"></i>
                <span class="idea-admin-empty__title">集計データがありません</span>
            </div>
        {% endif %}
    </div>
</section>

{# ── Plugin panel (placeholder — no plugin projection yet) ────────────────── #}
<section class="idea-admin-panel" aria-labelledby="panel-plugins" style="margin-top:1.5rem">
    <div class="idea-admin-panel__head">
        <h3 id="panel-plugins">
            <i class="fa fa-plug fa-fw" aria-hidden="true"></i>
            インストール済みプラグイン
        </h3>
        <a href="/admin/plugin-list" class="idea-admin-action idea-admin-action--primary">
            プラグイン一覧へ
        </a>
    </div>
    <div class="idea-admin-panel__body">
        {% if recommendedPlugins is not empty %}
            <div class="idea-admin-table-wrap">
                <table class="idea-admin-table">
                    <thead>
                        <tr>
                            <th scope="col">プラグインコード</th>
                            <th scope="col">名称</th>
                            <th scope="col">バージョン</th>
                            <th scope="col">状態</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for plugin in recommendedPlugins %}
                            <tr>
                                <td>{{ plugin.pluginCode }}</td>
                                <td>{{ plugin.name }}</td>
                                <td>{{ plugin.version }}</td>
                                <td>
                                    {% if plugin.enabled %}
                                        <span class="idea-admin-badge idea-admin-badge--public">有効</span>
                                    {% else %}
                                        <span class="idea-admin-badge idea-admin-badge--private">無効</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="idea-admin-empty">
                <i class="fa fa-plug fa-2x" aria-hidden="true"></i>
                <span class="idea-admin-empty__title">プラグインはありません</span>
            </div>
        {% endif %}
    </div>
</section>

{% endblock %}
