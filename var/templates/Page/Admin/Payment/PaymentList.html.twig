{#
  BeMart admin Payment list — EC-CUBE goPaymentList (支払方法設定).

  PORT of EC-CUBE 4.3 admin-theme `Setting/Shop/payment.twig`
  (src/Eccube/Resource/template/admin/Setting/Shop/payment.twig).

  Setting/Shop section, DATA/LIST page (sortable). It extends the admin
  frame (`admin-base.html.twig`, the port of EC-CUBE's admin
  `default_frame.twig`), not the storefront `base.html.twig`. The markup
  skeleton + `c-*` / `ec-*` / Bootstrap classes are kept verbatim from
  EC-CUBE; only the dynamic bindings are rebound to the PaymentList
  resource body (src/Resource/Page/Admin/Payment/PaymentList.php — body
  carries `count` + `payments`, a list of {paymentId, paymentMethodName,
  charge, ruleMin, ruleMax, visible}).

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `url(route, params)` -> deterministic `/{route}?{query}`
     (`BeMartTwigExtension`).
   - `price` filter       -> JPY NumberFormatter (`BeMartTwigExtension`).
   - `{% for Payment in Payments %}` -> the resource body's `payments`
     list. EC-CUBE keys the row + actions by `Payment.id`; the
     AdminPaymentListFetched projection surfaces `paymentId`, so BeMart
     keys the row + actions by `paymentId`. Same anchors, same classes.
   - `Payment.method` -> the projection key is `paymentMethodName`.
   - `Payment.rule_min` / `rule_max` -> the projection keys are
     `ruleMin` / `ruleMax`.
   - `Payment.sortNo` -> the AdminPaymentListFetched projection does NOT
     carry the sort_no column (dtb_payment.sort_no is tracked inside
     PaymentMethodAdminStorage, not projected). The `data-sort-no`
     attribute renders empty. FLAGGED missing-body-field — enumerated
     as residual.
   - `csrf_token_for_anchor()` on the visible-toggle / delete `<a>` ->
     EC-CUBE per-request CSRF widget. OMITTED exactly as the storefront
     ports omit it. EC-CUBE-runtime only — enumerated as residual.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin_setting_shop_payment' %}
{% set title = '支払方法一覧' %}
{% set sub_title = '店舗設定' %}

{% block stylesheet %}
    <style type="text/css">
        li.list-group-item {
            z-index: inherit !important;
        }
    </style>
{% endblock %}

{% block javascript %}
    <script>
        $(function() {
            // 初期表示時のsort noを保持.
            var oldSortNos = [];
            $('.sortable-item').each(function() {
                oldSortNos.push(this.dataset.sortNo);
            });
            oldSortNos.sort(function(a, b) {
                return a - b;
            }).reverse();

            // 並び替え後にsort noを更新
            var updateSortNo = function() {
                var newSortNos = {};
                var i = 0;
                $('.sortable-item').each(function() {
                    newSortNos[this.dataset.id] = oldSortNos[i];
                    i++;
                });

                $.ajax({
                    url: '{{ url('admin_setting_shop_payment_sort_no_move') }}',
                    type: 'POST',
                    data: newSortNos
                }).always(function() {
                    $(".modal-backdrop").remove();
                });
            };

            // 最初と最後の↑↓を再描画
            var redrawDisableAllows = function() {
                var items = $('.sortable-item');
                items.find('a').removeClass('disabled');
                items.first().find('a.action-up').addClass('disabled');
                items.last().find('a.action-down').addClass('disabled');
            };

            // オーバレイ後, 表示順の更新を行う
            var moveSortNo = function() {
                $('body').append($('<div class="modal-backdrop show"></div>'));
                updateSortNo();
                redrawDisableAllows();
            };

            // Drag and Drop
            $(".sortable-container").sortable({
                items: '> .sortable-item',
                cursor: 'move',
                update: function(e, ui) {
                    moveSortNo();
                }
            });

            // Up
            $('.sortable-item').on('click', 'a.action-up', function(e) {
                e.preventDefault();
                var current = $(this).parents('li');

                if (current.prev().hasClass('sortable-item')) {
                    current.prev().before(current);
                    moveSortNo();
                }
            });

            // Down
            $('.sortable-item').on('click', 'a.action-down', function(e) {
                e.preventDefault();
                var current = $(this).parents('li');

                if (current.next().hasClass('sortable-item')) {
                    current.next().after(current);
                    moveSortNo();
                }
            });

            // 表示・非表示
            $('.check-display').click(function(){
                var id = $(this).attr('id');
                if($('.display-show-toggle-' + id).hasClass('fa-eye')){
                    $('.display-show-toggle-' + id).addClass('fa-eye-slash');
                    $('.display-show-toggle-' + id).removeClass('fa-eye');
                    $('#' + id).css('background-color','#FAF1F1');
                }else{
                    $('.display-show-toggle-' + id).addClass('fa-eye');
                    $('.display-show-toggle-' + id).removeClass('fa-eye-slash');
                    $('#' + id).css('background-color','');
                }
            });

            // 削除モーダルのhrefとmessageの変更
            $('#DeleteModal').on('shown.bs.modal', function(event) {
                var target = $(event.relatedTarget);
                // hrefの変更
                $(this).find('[data-method="delete"]').attr('href', target.data('url'));

                // messageの変更
                $(this).find('p.modal-message').text(target.data('message'));
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="c-contentsArea__cols">
        <div class="c-contentsArea__primaryCol">
            <div class="c-primaryCol">
                <div class="d-block mb-3">
                    <a class="btn btn-ec-regular" href="{{ url('admin_setting_shop_payment_new') }}">新規作成</a>
                </div>
                <div class="card rounded border-0 mb-4">
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush sortable-container">
                            <li class="list-group-item">
                                <div class="row justify-content-around">
                                    <div class="col-auto"><strong>&nbsp;</strong></div>
                                    <div class="col-auto"><strong>ID</strong></div>
                                    <div class="col-2"><strong>支払方法</strong></div>
                                    <div class="col-1"><strong>手数料</strong></div>
                                    <div class="col"><strong>利用条件</strong></div>
                                </div>
                            </li>
                            {% for Payment in payments %}
                                <li id="ex-payment-{{ Payment.paymentId }}" class="list-group-item sortable-item" data-id="{{ Payment.paymentId }}" data-sort-no="{{ Payment.sortNo|default('') }}">
                                    <div class="row justify-content-around">
                                        <div class="col-auto d-flex align-items-center"><i class="fa fa-bars text-ec-gray"></i></div>
                                        <div class="col-auto d-flex align-items-center">{{ Payment.paymentId }}</div>
                                        <div class="col-2 d-flex align-items-center"><a href="{{ url('admin_setting_shop_payment_edit', { id: Payment.paymentId}) }}">{{ Payment.paymentMethodName }}</a></div>
                                        <div class="col-1 d-flex align-items-center"><span>{{ Payment.charge|price }}</span></div>
                                        <div class="col d-flex align-items-center">
                                        <span>
                                            {% if Payment.ruleMin > 0 %}
                                                {{ Payment.ruleMin|price }}
                                            {% else %}
                                                {{ 0|price }}
                                            {% endif %}

                                            {% if Payment.ruleMax > 0 %}
                                                〜 {{ Payment.ruleMax|price }}
                                            {% elseif Payment.ruleMax is null %}
                                                〜 無制限
                                            {% endif %}
                                        </span>
                                        </div>
                                        <div class="col-3 text-end">
                                            <a class="btn btn-ec-actionIcon me-2 action-up{{ loop.first ? ' disabled' }}" data-bs-toggle="tooltip" data-bs-placement="top" title="上へ">
                                                <i class="fa fa-arrow-up fa-lg text-secondary"></i>
                                            </a>
                                            <a class="btn btn-ec-actionIcon me-2 action-down{{ loop.last ? ' disabled' }}" data-bs-toggle="tooltip" data-bs-placement="top" title="下へ">
                                                <i class="fa fa-arrow-down fa-lg text-secondary"></i>
                                            </a>
                                            <a class="btn btn-ec-actionIcon me-2 action-visible" href="{{ url('admin_setting_shop_payment_visible', {'id': Payment.paymentId }) }}"
                                               data-bs-toggle="tooltip" data-bs-placement="top" title="{{ Payment.visible ? '非表示にする' : '表示する' }}"
                                               data-confirm="false" data-method="put" >
                                                <i class="fa fa-toggle-{{ Payment.visible ? 'on' : 'off' }} fa-lg text-secondary" aria-hidden="true"></i>
                                            </a>
                                            <div class="d-inline-block me-2" data-bs-toggle="tooltip" data-bs-placement="top"
                                                 title="削除">
                                                <a class="btn btn-ec-actionIcon" data-bs-toggle="modal" data-bs-target="#DeleteModal"
                                                   data-url="{{ url('admin_setting_shop_payment_delete', {'id' : Payment.paymentId}) }}"
                                                   data-message="この操作はあとから取り消すことができません。「{{ Payment.paymentMethodName }}」を削除してよろしいですか？">
                                                    <i class="fa fa-close fa-lg text-secondary"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                        <!-- 削除モーダル -->
                        <div class="modal fade" id="DeleteModal" tabindex="-1" role="dialog"
                             aria-labelledby="DeleteModal" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold">
                                            削除します
                                        </h5>
                                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close">

                                        </button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <p class="text-start modal-message"><!-- jsでメッセージを挿入 --></p>
                                    </div>
                                    <div class="modal-footer">
                                        <button class="btn btn-ec-sub" type="button" data-bs-dismiss="modal">
                                            キャンセル
                                        </button>
                                        <a class="btn btn-ec-delete" href="#"
                                           data-method="delete" data-confirm="false">
                                            削除
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <p>ドラッグ＆ドロップやボタン操作で表示順を変更できます。</p>
            </div>
        </div>
    </div>
{% endblock %}
