{#
  BeMart admin Payment list — clean-room build (idea-admin design language).

  DATA CONTRACT (src/Resource/Page/Admin/Payment/PaymentList.php onGet):
    count      int                                    — total payment method count
    payments   list<{                                 — payment method rows
      paymentId         string|int,
      paymentMethodName string,
      charge            int,
      ruleMin           int|null,
      ruleMax           int|null,
      visible           bool,
    }>

  ACTIONS (resource #[Link] annotations):
    POST   /admin/payment/payment-list                — doCreatePayment (create new)
    GET    /admin/payment/payment?paymentId=…         — goPayment (edit row)
    PUT    /admin/payment/payment?paymentId=…         — doUpdatePayment (update row; also toggle visible)
    DELETE /admin/payment/payment?paymentId=…         — doDeletePayment (delete row)
    GET    /admin/sort-no-move?masterType=payment&_method=put  — reorder (PUT via POST override)

  IdeaStore admin design vocabulary (idea-admin-*):
    idea-admin-toolbar        header action bar (back link + primary actions)
    idea-admin-toolbar__back  back-nav slot
    idea-admin-toolbar__actions  CTA slot
    idea-admin-table-wrap     horizontal scroll wrapper
    idea-admin-table          data table
    idea-admin-table__actions per-row icon action cell
    idea-admin-action         button/link
    idea-admin-action--primary  primary variant
    idea-admin-action--destructive  destructive variant
    idea-admin-icon-btn       icon-only round button
    idea-admin-badge--public / --private  visibility status chip
    idea-admin-empty          empty-state placeholder
    idea-admin-notice         flash / info notice
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-payment-payment-list' %}
{% set title = '支払方法一覧' %}
{% set sub_title = '店舗設定' %}

{% block stylesheet %}
<style>
/* drag-handle cursor for sortable rows */
.payment-row__handle { cursor: grab; color: var(--idea-muted); }
.payment-row__handle:active { cursor: grabbing; }
/* dim a row when visible=false */
tr.is-hidden-payment { opacity: .55; }
</style>
{% endblock %}

{% block javascript %}
<script>
(function () {
    /* ── Sort-order state ─────────────────────────────────────────── */
    var oldSortNos = [];
    document.querySelectorAll('.payment-row[data-sort-no]').forEach(function (row) {
        oldSortNos.push(row.dataset.sortNo);
    });
    oldSortNos.sort(function (a, b) { return a - b; }).reverse();

    function collectNewOrder () {
        var order = {};
        var i = 0;
        document.querySelectorAll('.payment-row[data-id]').forEach(function (row) {
            order[row.dataset.id] = oldSortNos[i++];
        });
        return order;
    }

    function pushSortOrder () {
        var data = collectNewOrder();
        var body = Object.keys(data).map(function (k) {
            return encodeURIComponent(k) + '=' + encodeURIComponent(data[k]);
        }).join('&');
        fetch('/admin/sort-no-move?masterType=payment&_method=put', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        });
        updateMoveButtons();
    }

    function updateMoveButtons () {
        var rows = document.querySelectorAll('.payment-row');
        rows.forEach(function (row, idx) {
            row.querySelector('.action-up').classList.toggle('is-disabled', idx === 0);
            row.querySelector('.action-down').classList.toggle('is-disabled', idx === rows.length - 1);
        });
    }

    /* ── Up / Down buttons ────────────────────────────────────────── */
    document.querySelector('#payment-table-body').addEventListener('click', function (e) {
        var btn = e.target.closest('.action-up, .action-down');
        if (!btn) return;
        e.preventDefault();
        var row = btn.closest('.payment-row');
        if (btn.classList.contains('is-disabled')) return;
        if (btn.classList.contains('action-up') && row.previousElementSibling) {
            row.parentNode.insertBefore(row, row.previousElementSibling);
        } else if (btn.classList.contains('action-down') && row.nextElementSibling) {
            row.parentNode.insertBefore(row.nextElementSibling, row);
        }
        pushSortOrder();
    });

    updateMoveButtons();

    /* ── Delete dialog ────────────────────────────────────────────── */
    var deleteDialog = document.getElementById('delete-dialog');
    var deleteAnchor = document.getElementById('delete-confirm-link');
    var deleteLabel  = document.getElementById('delete-item-label');

    document.querySelector('#payment-table-body').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-delete-url]');
        if (!btn || !deleteDialog) return;
        deleteLabel.textContent  = btn.dataset.deleteLabel || '';
        deleteAnchor.href        = btn.dataset.deleteUrl;
        deleteDialog.removeAttribute('hidden');
    });

    document.getElementById('delete-cancel')?.addEventListener('click', function () {
        deleteDialog.setAttribute('hidden', '');
    });
}());
</script>
{% endblock %}

{% block main %}

{# ── Page toolbar ─────────────────────────────────────────────────── #}
<div class="idea-admin-toolbar" role="toolbar" aria-label="支払方法操作">
    <div class="idea-admin-toolbar__back">
        <a href="/admin/base-info">
            <i class="fa fa-angle-left" aria-hidden="true"></i>
            店舗設定
        </a>
    </div>
    <div class="idea-admin-toolbar__actions">
        <a class="idea-admin-action idea-admin-action--primary"
           href="/admin/payment/payment"
           rel="doCreatePayment">
            <i class="fa fa-plus" aria-hidden="true"></i>
            新規登録
        </a>
    </div>
</div>

{# ── Payment list ─────────────────────────────────────────────────── #}
{% if count > 0 %}
<div class="idea-admin-table-wrap">
    <table class="idea-admin-table" id="payment-list-table" aria-label="支払方法一覧">
        <thead>
            <tr>
                <th scope="col" style="width:2rem"></th>
                <th scope="col">支払方法名</th>
                <th scope="col">手数料</th>
                <th scope="col">利用金額範囲</th>
                <th scope="col">表示</th>
                <th scope="col" class="idea-admin-table__actions"></th>
            </tr>
        </thead>
        <tbody id="payment-table-body">
        {% for Payment in payments %}
            <tr id="ex-payment-{{ Payment.paymentId }}"
                class="payment-row{% if not Payment.visible %} is-hidden-payment{% endif %}"
                data-id="{{ Payment.paymentId }}"
                data-sort-no="{{ Payment.sortNo|default('') }}">

                {# drag handle #}
                <td class="payment-row__handle" aria-label="並び替え">
                    <i class="fa fa-bars" aria-hidden="true"></i>
                </td>

                {# name → edit link #}
                <td>
                    <a href="/admin/payment/payment?paymentId={{ Payment.paymentId }}"
                       rel="goPayment">{{ Payment.paymentMethodName }}</a>
                </td>

                {# charge #}
                <td>{{ Payment.charge|price }}</td>

                {# rule range #}
                <td>
                    {% if Payment.ruleMin is not null and Payment.ruleMin > 0 %}
                        {{ Payment.ruleMin|price }}
                    {% else %}
                        {{ 0|price }}
                    {% endif %}
                    〜
                    {% if Payment.ruleMax is not null and Payment.ruleMax > 0 %}
                        {{ Payment.ruleMax|price }}
                    {% else %}
                        無制限
                    {% endif %}
                </td>

                {# visibility badge #}
                <td>
                    {% if Payment.visible %}
                        <span class="idea-admin-badge idea-admin-badge--public">表示</span>
                    {% else %}
                        <span class="idea-admin-badge idea-admin-badge--private">非表示</span>
                    {% endif %}
                </td>

                {# row actions #}
                <td class="idea-admin-table__actions">
                    <a class="idea-admin-icon-btn action-up"
                       href="#"
                       aria-label="上へ移動"
                       title="上へ">
                        <i class="fa fa-arrow-up" aria-hidden="true"></i>
                    </a>
                    <a class="idea-admin-icon-btn action-down"
                       href="#"
                       aria-label="下へ移動"
                       title="下へ">
                        <i class="fa fa-arrow-down" aria-hidden="true"></i>
                    </a>
                    <a class="idea-admin-icon-btn action-visible"
                       href="/admin/payment/payment?paymentId={{ Payment.paymentId }}&amp;_method=put&amp;visible={{ Payment.visible ? '0' : '1' }}"
                       rel="doUpdatePayment"
                       aria-label="{{ Payment.visible ? '非表示にする' : '表示する' }}"
                       title="{{ Payment.visible ? '非表示にする' : '表示する' }}"
                       data-confirm="false">
                        <i class="fa fa-{{ Payment.visible ? 'eye' : 'eye-slash' }}" aria-hidden="true"></i>
                    </a>
                    <button type="button"
                            class="idea-admin-icon-btn idea-admin-icon-btn--destructive"
                            aria-label="削除"
                            title="削除"
                            data-delete-url="/admin/payment/payment?paymentId={{ Payment.paymentId }}&amp;_method=delete"
                            data-delete-label="{{ Payment.paymentMethodName }}"
                            data-post-action="delete"
                            data-method="delete">
                        <i class="fa fa-trash" aria-hidden="true"></i>
                    </button>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="idea-admin-empty" role="status">
    <i class="fa fa-credit-card idea-admin-empty__icon" aria-hidden="true"></i>
    <p class="idea-admin-empty__title">支払方法が登録されていません</p>
    <p>「新規登録」ボタンから支払方法を追加してください。</p>
</div>
{% endif %}

{# ── Delete confirmation dialog ───────────────────────────────────── #}
<div id="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-dialog-title" hidden>
    <div class="idea-admin-panel">
        <div class="idea-admin-panel__head">
            <h3 id="delete-dialog-title">支払方法を削除します</h3>
        </div>
        <div class="idea-admin-panel__body">
            <p>「<span id="delete-item-label"></span>」を削除します。この操作は取り消せません。</p>
            <div style="display:flex;gap:.75rem;justify-content:flex-end;margin-top:1rem;">
                <button id="delete-cancel" type="button" class="idea-admin-action">
                    キャンセル
                </button>
                <a id="delete-confirm-link"
                   class="idea-admin-action idea-admin-action--destructive"
                   href="#"
                   data-post-action="delete"
                   data-method="delete"
                   data-confirm="false">
                    削除する
                </a>
            </div>
        </div>
    </div>
</div>

{% endblock %}
