{#
  BeMart admin テンプレート登録 — EC-CUBE admin-theme
  `Store/template_add.twig`.

  PORT of EC-CUBE 4.3 `src/Eccube/Resource/template/admin/Store/template_add.twig`
  — the shop design-template registration screen. It extends the admin
  frame (`admin-base.html.twig`, the port of EC-CUBE's admin
  `default_frame.twig`), not the storefront `base.html.twig`.

  Store section, Tier-2 FORM page. EC-CUBE renders a template-code,
  template-name and zip-archive file-upload form (`Form/Type/Admin/TemplateType`,
  admin template block prefix). The Be `doTemplateInstall` write
  transition is a Phase-A stub, so this port renders the upload shell —
  the three inputs plus the 雛形 (template-zip) download link. The
  markup skeleton + `c-*` / Bootstrap classes are kept verbatim from
  EC-CUBE; only the dynamic bindings are rebound to the TemplateAdd
  resource body (src/Resource/Page/Admin/Template/TemplateAdd.php —
  body carries `form`, an AdminTemplateAddForm).

  EC-CUBE-ism rebinding (see var/templates/README.md, "Admin pages"):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `canonical-url route, params)` -> deterministic `/{route}?{query}`
     (`BeMartTwigExtension`).
   - `form_widget(form.code|name|file)` -> `form.input('templateCode'|'templateName'|'file')` — the
     real AdminTemplateAddForm fields (Ray.WebFormModule).
   - `form_widget(form._token)` (CSRF hidden input) -> `csrfToken|default(csrf_token())`
     — EC-CUBE per-request CSRF runtime; enumerated as residual.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin-template-template-add' %}
{% set title = 'テンプレート登録' %}
{% set sub_title = 'オーナーズストア' %}

{% block main %}
    <form role="form" method="post" action="/admin/template/template-add" id="template_add_form" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default(csrf_token()) }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">

                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <span class="card-title">テンプレート登録</span>
                        </div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-3"><span>テンプレートコード</span></div>
                                <div class="col">
                                    {{ form.input('templateCode')|raw }}
                                    {% if form.error('templateCode') %}<span class="invalid-feedback d-block">{{ form.error('templateCode') }}</span>{% endif %}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3"><span>テンプレート名</span></div>
                                <div class="col">
                                    {{ form.input('templateName')|raw }}
                                    {% if form.error('templateName') %}<span class="invalid-feedback d-block">{{ form.error('templateName') }}</span>{% endif %}
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3"><span>テンプレートファイル</span></div>
                                <div class="col">
                                    {{ form.input('file')|raw }}
                                    {% if form.error('file') %}<span class="invalid-feedback d-block">{{ form.error('file') }}</span>{% endif %}
                                    <small class="text-muted d-block">テンプレートファイルはzip形式で圧縮してください。</small>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-3"></div>
                                <div class="col">
                                    <a href="/admin/template/template-list">雛形ファイルダウンロード</a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="/admin/template/template-list">
                                <i class="fa fa-backward" aria-hidden="true"></i>
                                <span>テンプレート一覧へ戻る</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button type="submit" class="btn btn-ec-conversion px-5">登録</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
