{#
  BeMart admin Template upload — EC-CUBE Store/template_add.twig.

  PORT of EC-CUBE 4.3 admin-theme `Store/template_add.twig`.
  Thin FORM page: `TemplateAdd` exposes an AdminTemplateAddForm for the
  three controls (`code`, `name`, `file`). The real archive validation /
  install pipeline is a future Be transition; this page verifies the
  Admin Tier-2 form-rendering recipe.
#}
{% extends 'admin-base.html.twig' %}

{% set route = 'admin_store_template_install' %}
{% set title = 'テンプレートのアップロード' %}
{% set sub_title = 'オーナーズストア' %}

{% block main %}
    <form role="form" class="form-horizontal" name="form1" id="form1" method="post" action="{{ url('admin_store_template_install') }}" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrfToken|default('') }}">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span class="card-title">新規テンプレートアップロード</span></div>
                        <div class="card-body">
                            <div class="row mb-2">
                                <div class="col-2">
                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="テンプレートの格納先のディレクトリ名になります。">
                                        <span>テンプレートコード</span>
                                        <i class="fa fa-question-circle fa-lg ms-1"></i>
                                    </div>
                                </div>
                                <div class="col-10">
                                    {{ form.input('code')|raw }}
                                    {{ form.error('code') }}
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-2">
                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="管理画面で表示するテンプレートの名前を設定します。">
                                        <span>テンプレート名</span>
                                        <i class="fa fa-question-circle fa-lg ms-1"></i>
                                    </div>
                                </div>
                                <div class="col-10">
                                    {{ form.input('name')|raw }}
                                    {{ form.error('name') }}
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col-2">
                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="テンプレート一式となるアーカイブをアップロードします。">
                                        <span>テンプレートファイル</span>
                                        <i class="fa fa-question-circle fa-lg ms-1"></i>
                                    </div>
                                    <br>File format: zip,tar,tar.gz
                                </div>
                                <div class="col-10">
                                    {{ form.input('file')|raw }}
                                    {{ form.error('file') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="c-conversionArea" id="aside_column">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="{{ url('admin_store_template') }}">
                                <i class="fa fa-backward" aria-hidden="true"></i><span>戻る</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5" type="submit">登録</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
