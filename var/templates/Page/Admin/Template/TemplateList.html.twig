{% extends 'admin-base.html.twig' %}

{% set route = 'admin-template-template-list' %}
{% set title = 'テンプレート一覧' %}
{% set sub_title = 'オーナーズストア' %}

{#
  DATA CONTRACT (src/Resource/Page/Admin/Template/TemplateList.php onGet):
    count       int  — total templates returned
    templates   list<{templateId: string, templateName: string, deviceType: int, active: bool}>
    csrfToken   string — CSRF token (select PUT + delete DELETE forms)

  ACTIONS (derived from #[Link] annotations on TemplateList):
    GET  /admin/template/template-list                                  — goTemplateList (this page)
    GET  /admin/template/template-add                                   — goTemplateAdd / goTemplateInstall
    PUT  /admin/template/template-list?_method=put                     — doSelectTemplate (activate)
    POST /admin/template/template-list?templateId=…                    — doDownloadTemplate
    DELETE /admin/template/template-list?templateId=…&_method=delete   — doDeleteTemplate

  deviceType values: 2=スマホ, 10=PC

  idea-admin vocabulary used:
    idea-admin-list-toolbar / idea-admin-list-toolbar__left / __right
    idea-admin-count         — result count chip
    idea-admin-action        — button / link affordance
    idea-admin-action--primary, idea-admin-action--destructive
    idea-admin-table-wrap    — overflow container
    idea-admin-table         — data table
    idea-admin-table__actions — action cell (right-aligned)
    idea-admin-icon-btn      — icon-only button
    idea-admin-badge         — status chip
    idea-admin-badge--public — active / positive state
    idea-admin-dialog-backdrop / idea-admin-dialog / __head / __body / __foot
    idea-admin-dialog__title — dialog heading
    idea-admin-empty         — zero-result state
    idea-admin-empty__title
#}

{% block javascript %}
<script>
(function () {
    /* Submit the activate-template form carrying the selected radio value. */
    var form = document.getElementById('template-select-form');
    if (!form) { return; }
    form.addEventListener('submit', function () {
        var checked = form.querySelector('input[name="template"]:checked');
        var hidden  = document.getElementById('template-id-hidden');
        if (checked && hidden) { hidden.value = checked.value; }
    });
}());
</script>
{% endblock javascript %}

{% block main %}

{# ── Toolbar: count + upload link ── #}
<div class="idea-admin-list-toolbar">
  <div class="idea-admin-list-toolbar__left">
    <span class="idea-admin-count">{{ count }}件</span>
  </div>
  <div class="idea-admin-list-toolbar__right">
    <a class="idea-admin-action idea-admin-action--primary"
       href="/admin/template/template-add">
      <i class="fa fa-upload" aria-hidden="true"></i>
      テンプレートをアップロード
    </a>
  </div>
</div>

{# ── Template table / empty state ── #}
{% if count %}

{#
  doSelectTemplate: PUT /admin/template/template-list
  The radio <input>s select the target; the hidden field carries the chosen
  templateId on submit. csrfToken conveyed as a hidden field per the
  resource contract.
#}
<form
  id="template-select-form"
  method="post"
  action="/admin/template/template-list?_method=put"
>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
  <input type="hidden" id="template-id-hidden" name="templateId" value="">

  <div class="idea-admin-table-wrap">
    <table class="idea-admin-table" aria-label="テンプレート一覧">
      <thead>
        <tr>
          <th scope="col" style="width:3rem;">適用</th>
          <th scope="col">テンプレート名</th>
          <th scope="col">種別</th>
          <th scope="col">保存先</th>
          <th scope="col" class="idea-admin-table__actions"></th>
        </tr>
      </thead>
      <tbody>
        {% for template in templates %}
        <tr id="row-{{ template.templateId }}">

          <td style="text-align:center;">
            <input
              type="radio"
              name="template"
              value="{{ template.templateId }}"
              aria-label="{{ template.templateName }}を適用"
              {% if template.active|default(false) %} checked{% endif %}
            >
          </td>

          <td>
            {{ template.templateName }}
            {% if template.active|default(false) %}
              <span class="idea-admin-badge idea-admin-badge--public">適用中</span>
            {% endif %}
          </td>

          <td>
            {% if template.deviceType is same as(10) %}
              <span class="idea-admin-badge">PC</span>
            {% elseif template.deviceType is same as(2) %}
              <span class="idea-admin-badge">スマホ</span>
            {% else %}
              <span class="idea-admin-badge">—</span>
            {% endif %}
          </td>

          <td>
            <ul style="margin:0;padding:0 0 0 1.1em;font-size:.84rem;">
              <li>app/template/{{ template.templateId }}</li>
              <li>html/template/{{ template.templateId }}</li>
            </ul>
          </td>

          <td class="idea-admin-table__actions">
            {# doDownloadTemplate: POST /admin/template/template-list #}
            <form
              method="post"
              action="/admin/template/template-list?templateId={{ template.templateId }}"
              style="display:contents;"
            >
              <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
              <input type="hidden" name="templateId" value="{{ template.templateId }}">
              <button
                class="idea-admin-icon-btn"
                type="submit"
                aria-label="{{ template.templateName }}をダウンロード"
              >
                <i class="fa fa-cloud-download" aria-hidden="true"></i>
              </button>
            </form>

            {# doDeleteTemplate trigger — opens confirmation dialog #}
            <button
              class="idea-admin-icon-btn idea-admin-action--destructive"
              type="button"
              aria-label="{{ template.templateName }}を削除"
              aria-haspopup="dialog"
              onclick="document.getElementById('delete-dialog-{{ loop.index }}').hidden=false"
            >
              <i class="fa fa-times" aria-hidden="true"></i>
            </button>
          </td>

        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── Activate submit bar ── #}
  <div class="idea-admin-toolbar" style="margin-top:1rem;">
    <div class="idea-admin-toolbar__actions" style="justify-content:flex-end;">
      <button class="idea-admin-action idea-admin-action--primary" type="submit">
        <i class="fa fa-check" aria-hidden="true"></i>
        テンプレートを適用
      </button>
    </div>
  </div>

</form>

{# ── Delete confirmation dialogs (one per row) ── #}
{% for template in templates %}
<div
  id="delete-dialog-{{ loop.index }}"
  class="idea-admin-dialog-backdrop"
  hidden
  role="presentation"
>
  <div class="idea-admin-dialog" role="dialog"
       aria-labelledby="delete-title-{{ loop.index }}"
       aria-modal="true">
    <div class="idea-admin-dialog__head">
      <h5 id="delete-title-{{ loop.index }}" class="idea-admin-dialog__title">
        テンプレートの削除
      </h5>
      <button
        type="button"
        class="idea-admin-text-btn"
        aria-label="閉じる"
        onclick="document.getElementById('delete-dialog-{{ loop.index }}').hidden=true"
      >
        <i class="fa fa-times" aria-hidden="true"></i>
      </button>
    </div>
    <div class="idea-admin-dialog__body">
      <p>
        <strong>{{ template.templateName }}</strong>
        を削除しますか？この操作は取り消せません。
      </p>
    </div>
    <div class="idea-admin-dialog__foot">
      <button
        type="button"
        class="idea-admin-action"
        onclick="document.getElementById('delete-dialog-{{ loop.index }}').hidden=true"
      >キャンセル</button>
      {# doDeleteTemplate: DELETE /admin/template/template-list #}
      <form
        method="post"
        action="/admin/template/template-list?templateId={{ template.templateId }}&_method=delete"
        style="display:contents;"
      >
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
        <input type="hidden" name="templateId" value="{{ template.templateId }}">
        <button class="idea-admin-action idea-admin-action--destructive" type="submit">
          削除
        </button>
      </form>
    </div>
  </div>
</div>
{% endfor %}

{% else %}

<div class="idea-admin-empty" role="status">
  <i class="fa fa-th-large fa-2x" aria-hidden="true"></i>
  <p class="idea-admin-empty__title">テンプレートが登録されていません</p>
  <p style="font-size:.84rem;">
    <a class="idea-admin-action idea-admin-action--primary"
       href="/admin/template/template-add">
      <i class="fa fa-upload" aria-hidden="true"></i>
      テンプレートをアップロード
    </a>
  </p>
</div>

{% endif %}

{% endblock %}
