{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お届け先の追加 | IDEA STORE{% endblock %}
{% block content %}

<nav class="idea-container idea-breadcrumb" aria-label="パンくずリスト">
  <a href="/">ホーム</a><span>/</span>
  <a href="/cart">カート</a><span>/</span>
  <a href="/shopping/shipping-multiple">複数配送先の指定</a><span>/</span>
  <span aria-current="page">お届け先の追加</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-shipping-multiple-edit-heading">
  <div>
    <p class="idea-eyebrow">Add delivery address</p>
    <h1 id="idea-shipping-multiple-edit-heading" class="idea-title idea-title--compact">お届け先の追加</h1>
    <p class="idea-muted">新しいお届け先を入力してください。登録後、複数配送先の指定画面で各商品のお届け先として選択できます。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Multiple shipping</span>
    <strong>New address</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<div class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span><b>2</b>ログイン</span>
  <span class="is-active"><b>3</b>お届け先</span>
  <span><b>4</b>ご注文確認</span>
  <span><b>5</b>完了</span>
</div>

<section class="idea-container idea-section">
  {# rel=doAddMultipleShippingAddress → page://self/shopping/shipping-multiple-edit POST #}
  <form class="idea-checkout-panel idea-address-form h-adr"
        method="post"
        action="/shopping/shipping-multiple-edit"
        novalidate>
    <span class="p-country-name" aria-hidden="true">Japan</span>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Name</p>
        <h2 class="idea-section-title">お名前・フリガナ</h2>
      </div>
      {# rel=goShoppingShippingMultiple → page://self/shopping/shipping-multiple #}
      <a class="idea-link" href="/shopping/shipping-multiple">複数配送先の指定に戻る</a>
    </div>

    <div class="idea-form-grid idea-form-grid--two">
      <label class="idea-field">
        <span>姓</span>
        {{ form.input('name01')|raw }}
        <span class="idea-form-error">{{ form.error('name01') }}</span>
      </label>
      <label class="idea-field">
        <span>名</span>
        {{ form.input('name02')|raw }}
        <span class="idea-form-error">{{ form.error('name02') }}</span>
      </label>
      <label class="idea-field">
        <span>セイ</span>
        {{ form.input('kana01')|raw }}
        <span class="idea-form-error">{{ form.error('kana01') }}</span>
      </label>
      <label class="idea-field">
        <span>メイ</span>
        {{ form.input('kana02')|raw }}
        <span class="idea-form-error">{{ form.error('kana02') }}</span>
      </label>
      <label class="idea-field idea-field--full">
        <span>会社名（任意）</span>
        {{ form.input('companyName')|raw }}
        <span class="idea-form-error">{{ form.error('companyName') }}</span>
      </label>
    </div>

    <div class="idea-panel-head idea-panel-head--inner">
      <div>
        <p class="idea-eyebrow">Address</p>
        <h2 class="idea-section-title">ご住所</h2>
      </div>
    </div>

    <div class="idea-form-grid idea-form-grid--two">
      <label class="idea-field">
        <span>郵便番号</span>
        {{ form.input('postalCode')|raw }}
        <span class="idea-form-error">{{ form.error('postalCode') }}</span>
      </label>
      <label class="idea-field">
        <span>都道府県</span>
        {{ form.input('pref')|raw }}
        <span class="idea-form-error">{{ form.error('pref') }}</span>
      </label>
      <label class="idea-field">
        <span>市区町村</span>
        {{ form.input('addr01')|raw }}
        <span class="idea-form-error">{{ form.error('addr01') }}</span>
      </label>
      <label class="idea-field">
        <span>番地・建物名</span>
        {{ form.input('addr02')|raw }}
        <span class="idea-form-error">{{ form.error('addr02') }}</span>
      </label>
      <label class="idea-field">
        <span>電話番号</span>
        {{ form.input('phoneNumber')|raw }}
        <span class="idea-form-error">{{ form.error('phoneNumber') }}</span>
      </label>
    </div>

    <div class="idea-form-actions">
      <button class="idea-button" type="submit">お届け先を登録する</button>
      <a class="idea-link" href="/shopping/shipping-multiple">戻る</a>
    </div>
  </form>
</section>

{% endblock %}
