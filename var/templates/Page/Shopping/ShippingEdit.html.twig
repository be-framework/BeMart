{#
  BeMart Shopping shipping-edit page — EC-CUBE goShoppingShippingEdit.

  PORT of EC-CUBE 4.3 default-theme `Shopping/shipping_edit.twig`
  (src/Eccube/Resource/template/default/Shopping/shipping_edit.twig).

  FORM page (Ray.WebFormModule) — see var/templates/README.md. Markup
  skeleton, the `ec-role` / `ec-pageHeader` / `ec-registerRole` /
  `ec-off1Grid` / `ec-borderedDefs` / `ec-halfInput` / `ec-zipInput` /
  `ec-select` / `ec-input` / `ec-telInput` / `ec-RegisterRole__actions`
  classes + the `<dl>`/`<dt>`/`<dd>` definition-list structure are kept
  verbatim from EC-CUBE.

  The ShippingEdit resource exposes a real `ShoppingShippingEditForm`
  (an AbstractForm) as `body.form`; the inputs are rendered through it:

    {{ form.input('name01')|raw }}   <- real <input> w/ name/attrs
    {{ form.error('name01') }}       <- inline Be-domain error, if any

  EC-CUBE renders the same inputs through the Symfony FormView
  (`form_widget(form.name.name01)`); the field names / placeholders in
  ShoppingShippingEditForm::init() are ported from EC-CUBE's
  `CustomerAddressType` leaf fields. EC-CUBE's type nests fields under
  compound types, but BeMart's ShippingEdit body carries them FLAT
  (mirrors ALPS `#ShoppingShippingEdit`), so the form declares them
  flat. The render-diff test stubs EC-CUBE's `form_widget` /
  `form_label` to delegate to the SAME form so the inputs + labels
  diff to ZERO. Validation authority stays with the Be Becoming chain.

  EC-CUBE-ism rebinding (see var/templates/README.md):
   - `{{ 'key'|trans }}` -> the ja literal from messages.ja.yaml.
   - `form._token` — Symfony CSRF widget; kept as the hidden `_token`
     input bound to the body's `csrfToken` (null in the html context).
   - `has_errors(...)` — request-validation runtime; resolves false on a
     fresh form, so the conditional ` error` class never appears.
   - `is_granted('ROLE_USER')` — EC-CUBE auth-state runtime. The header
     text and the back-link target switch on it; BeMart's html context
     has no auth state, so the port renders the not-a-member branch (the
     お届け先の変更 header + the back-to-shopping link), the common
     checkout-flow case. Enumerated as a residual in the render test.
   - The `{% for f in form|filter(...) %}` entity-extension auto-render
     loop is OMITTED — a core install has no such extensions.
#}
{% extends 'base.html.twig' %}

{% set body_class = 'cart_page' %}
{% set route = 'shopping_shipping_edit' %}
{% set title = '商品購入/お届け先の変更' %}

{% block javascript %}
    <script src="//yubinbango.github.io/yubinbango/yubinbango.js" charset="UTF-8"></script>
{% endblock javascript %}

{% block main %}

    <div class="ec-role">
        <div class="ec-pageHeader">
            <h1>お届け先の変更</h1>
        </div>
    </div>

    <div class="ec-role">
        <div class="ec-registerRole">
            <div class="ec-off1Grid">
                <div class="ec-off1Grid__cell">
                    <form method="post" action="{{ url('shopping_shipping_edit') }}" class="h-adr">
                        <span class="p-country-name" style="display:none;">Japan</span>
                        <input type="hidden" name="_token" value="{{ csrfToken|default('') }}">
                        <div class="ec-borderedDefs">
                            <dl>
                                <dt>
                                    <label class="ec-label">お名前</label>
                                </dt>
                                <dd>
                                    <div class="ec-halfInput">
                                        {{ form.input('name01')|raw }}
                                        {{ form.input('name02')|raw }}
                                        {{ form.error('name01') }}
                                        {{ form.error('name02') }}
                                    </div>
                                </dd>
                            </dl>
                            <dl>
                                <dt>
                                    <label class="ec-label">お名前(カナ)</label>
                                </dt>
                                <dd>
                                    <div class="ec-halfInput">
                                        {{ form.input('kana01')|raw }}
                                        {{ form.input('kana02')|raw }}
                                        {{ form.error('kana01') }}
                                        {{ form.error('kana02') }}
                                    </div>
                                </dd>
                            </dl>
                            <dl>
                                <dt>
                                    <label class="ec-label">会社名</label>
                                </dt>
                                <dd>
                                    <div class="ec-halfInput">
                                        {{ form.input('companyName')|raw }}
                                        {{ form.error('companyName') }}
                                    </div>
                                </dd>
                            </dl>
                            <dl>
                                <dt>
                                    <label class="ec-label">住所</label>
                                </dt>
                                <dd>
                                    <div class="ec-zipInput"><span>〒</span>
                                        {{ form.input('postalCode')|raw }}
                                        <div class="ec-zipInputHelp">
                                            <div class="ec-zipInputHelp__icon">
                                                <div class="ec-icon"><img
                                                            src="{{ asset('assets/icon/question-white.svg') }}" alt="">
                                                </div>
                                            </div><a href="https://www.post.japanpost.jp/zipcode/" target="_blank"><span>郵便番号検索</span></a>
                                        </div>
                                        {{ form.error('postalCode') }}
                                    </div>

                                    <div class="ec-select">
                                        {{ form.input('pref')|raw }}
                                        {{ form.error('pref') }}
                                    </div>
                                    <div class="ec-input">
                                        {{ form.input('addr01')|raw }}
                                        {{ form.error('addr01') }}
                                    </div>
                                    <div class="ec-input">
                                        {{ form.input('addr02')|raw }}
                                        {{ form.error('addr02') }}
                                    </div>
                                </dd>
                            </dl>
                            <dl>
                                <dt>
                                    <label class="ec-label">電話番号</label>
                                </dt>
                                <dd>
                                    <div class="ec-telInput">
                                        {{ form.input('phoneNumber')|raw }}
                                        {{ form.error('phoneNumber') }}
                                    </div>
                                </dd>
                            </dl>
                        </div>
                        <div class="ec-RegisterRole__actions">
                            <div class="ec-off4Grid">
                                <div class="ec-off4Grid__cell">
                                    <button type="submit" class="ec-blockBtn--action">登録する</button>
                                    <a href="{{ url('shopping') }}" class="ec-blockBtn--cancel">戻る</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
