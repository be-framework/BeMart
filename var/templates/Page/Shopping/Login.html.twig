{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}購入入口 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">カート</a><span>/</span><span>購入入口</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-shopping-login-heading">
  <div>
    <p class="idea-eyebrow">Checkout entrance</p>
    <h1 id="idea-shopping-login-heading" class="idea-title idea-title--compact">購入方法を選ぶ</h1>
    <p class="idea-muted">会員ログインまたはゲスト購入を選んで、ご注文手続きへお進みください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Secure checkout</span>
    <strong>Login / Guest</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<div class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span class="is-active"><b>2</b>購入入口</span>
  <span><b>3</b>配送先</span>
  <span><b>4</b>確認</span>
  <span><b>5</b>完了</span>
</div>

<section class="idea-container idea-section idea-auth-choice" aria-label="購入方法の選択">
  <article class="idea-checkout-panel idea-auth-panel">
    <p class="idea-eyebrow">Member checkout</p>
    <h2 class="idea-section-title">会員の方</h2>
    <p class="idea-muted">メールアドレスとパスワードでログインすると、登録済みの配送先情報を使って手続きへ進めます。</p>

    {% if message is defined and message %}
      <p class="idea-form-error" role="alert">{{ message }}</p>
    {% endif %}

    {# rel=doLogin → page://self/login POST #}
    <form class="idea-auth-form"
          name="shopping_login"
          id="shopping_login"
          method="post"
          action="/login"
          novalidate>
      <input type="hidden" name="_target_path" value="/shopping">
      <input type="hidden" name="_failure_path" value="/shopping/login">
      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

      <label class="idea-field">メールアドレス
        {% if form is defined %}
          {{ form.input('email')|raw }}
          <span class="idea-form-error">{{ form.error('email') }}</span>
        {% else %}
          <input type="text" name="email" id="email" autocomplete="email" placeholder="メールアドレス">
        {% endif %}
      </label>

      <label class="idea-field">パスワード
        {% if form is defined %}
          {{ form.input('password')|raw }}
          <span class="idea-form-error">{{ form.error('password') }}</span>
        {% else %}
          <input type="password" name="password" id="password" autocomplete="current-password" placeholder="パスワード">
        {% endif %}
      </label>

      <button class="idea-button idea-button--wide" type="submit">ログインして進む</button>

      <div class="idea-auth-links">
        {# rel=goCustomerRegistration → page://self/entry #}
        <a class="idea-link" href="/entry">新規会員登録</a>
        <a class="idea-link" href="/forgot-password">パスワードをお忘れの方</a>
      </div>
    </form>
  </article>

  <article class="idea-checkout-panel idea-auth-panel">
    <p class="idea-eyebrow">Guest checkout</p>
    <h2 class="idea-section-title">ゲスト購入</h2>
    <p class="idea-muted">会員登録なしで購入できます。お届け先と連絡先を入力して、そのままご注文手続きへ進んでください。</p>
    {# rel=goShoppingNonMember → page://self/shopping/non-member #}
    <a class="idea-button idea-button--wide" href="/shopping/non-member">ゲスト購入へ進む</a>
    <a class="idea-link idea-summary-link" href="/cart">カートに戻る</a>
  </article>
</section>
{% endblock %}
