{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}ご注文完了 | IDEA STORE{% endblock %}
{% block content %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">Cart</a><span>/</span><span>Complete</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-complete-title">
  <div>
    <p class="idea-eyebrow">Order placed</p>
    <h1 id="idea-complete-title" class="idea-title idea-title--compact">ご注文ありがとう<br>ございます。</h1>
    <p class="idea-muted">ご注文を承りました。確認メールをお送りしていますのでご確認ください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Order status</span>
    <strong>完了</strong>
    {% if orderNo is defined and orderNo %}
      <small>No. {{ orderNo }}</small>
    {% else %}
      <small>Completed</small>
    {% endif %}
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span><b>2</b>購入入口</span>
  <span><b>3</b>ご注文手続き</span>
  <span><b>4</b>内容確認</span>
  <span class="is-active"><b>5</b>完了</span>
</section>

<section class="idea-container idea-section" aria-labelledby="idea-complete-message-heading">
  <div class="idea-checkout-panel" style="max-width: 48rem; margin: 0 auto;">
    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Next steps</p>
        <h2 id="idea-complete-message-heading" class="idea-section-title">お手続きが完了しました</h2>
      </div>
    </div>

    <div class="idea-info-list" style="margin-bottom: 1.5rem;">
      <p>ご注文内容の確認メールをお届けしています。メールが届かない場合は、迷惑メールフォルダをご確認いただくか、お問い合わせページよりご連絡ください。</p>
      {% if orderNo is defined and orderNo %}
        <p><strong>注文番号：{{ orderNo }}</strong></p>
      {% endif %}
      {% if completeMessage is defined and completeMessage %}
        <p>{{ completeMessage|nl2br }}</p>
      {% endif %}
    </div>

    <div class="idea-actions" style="flex-wrap: wrap; gap: 1rem;">
      <a class="idea-button" href="/" rel="goTop">トップページへ</a>
      <a class="idea-button idea-button--light" href="/mypage" rel="goMypage">注文履歴を確認する</a>
    </div>
  </div>
</section>

{% endblock %}
