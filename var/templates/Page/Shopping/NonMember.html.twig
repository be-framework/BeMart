{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お客様情報の入力 | IDEA STORE{% endblock %}
{% block content %}

<nav class="idea-container idea-breadcrumb" aria-label="パンくずリスト">
  <a href="/">ホーム</a><span>/</span><a href="/cart">カート</a><span>/</span><a href="/shopping/login">購入入口</a><span>/</span><span aria-current="page">お客様情報</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-nonmember-heading">
  <div>
    <p class="idea-eyebrow">Guest checkout</p>
    <h1 id="idea-nonmember-heading" class="idea-title idea-title--compact">お客様情報の入力</h1>
    <p class="idea-muted">会員登録不要でご購入いただけます。連絡先とお届け先を入力してください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Guest</span>
    <strong>Step 2</strong>
    <small>Shipping info</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span class="is-active"><b>2</b>お客様情報</span>
  <span><b>3</b>ご注文手続き</span>
  <span><b>4</b>完了</span>
</section>

{% if message is defined and message %}
<div class="idea-container idea-section--tight" role="alert">
  <p class="idea-form-error">{{ message }}</p>
</div>
{% endif %}

<section class="idea-container idea-section">
  <form class="idea-checkout-panel idea-guest-form h-adr"
        method="post"
        action="/shopping/non-member"
        novalidate>
    <span class="p-country-name" aria-hidden="true">Japan</span>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Contact &amp; address</p>
        <h2 class="idea-section-title">連絡先とお届け先</h2>
      </div>
      <a class="idea-link" href="/shopping/login">購入入口に戻る</a>
    </div>

    <div class="idea-form-grid idea-form-grid--two">

      <label class="idea-field">
        <span>姓</span>
        {{ form.input('name01')|raw }}
        <span class="idea-form-error">{{ form.error('name01') }}</span>
      </label>

      <label class="idea-field">
        <span>名</span>
        {{ form.input('name02')|raw }}
        <span class="idea-form-error">{{ form.error('name02') }}</span>
      </label>

      <label class="idea-field">
        <span>セイ</span>
        {{ form.input('kana01')|raw }}
        <span class="idea-form-error">{{ form.error('kana01') }}</span>
      </label>

      <label class="idea-field">
        <span>メイ</span>
        {{ form.input('kana02')|raw }}
        <span class="idea-form-error">{{ form.error('kana02') }}</span>
      </label>

      <label class="idea-field idea-field--full">
        <span>会社名（任意）</span>
        {{ form.input('companyName')|raw }}
        <span class="idea-form-error">{{ form.error('companyName') }}</span>
      </label>

      <label class="idea-field">
        <span>メールアドレス</span>
        {{ form.input('email')|raw }}
        <span class="idea-form-error">{{ form.error('email') }}</span>
      </label>

      <label class="idea-field">
        <span>メールアドレス（確認）</span>
        {{ form.input('email_confirm')|raw }}
        <span class="idea-form-error">{{ form.error('email_confirm') }}</span>
      </label>

      <label class="idea-field">
        <span>電話番号</span>
        {{ form.input('phoneNumber')|raw }}
        <span class="idea-form-error">{{ form.error('phoneNumber') }}</span>
      </label>

      <label class="idea-field">
        <span>郵便番号</span>
        {{ form.input('postalCode')|raw }}
        <span class="idea-form-error">{{ form.error('postalCode') }}</span>
      </label>

      <label class="idea-field">
        <span>都道府県</span>
        {{ form.input('pref')|raw }}
        <span class="idea-form-error">{{ form.error('pref') }}</span>
      </label>

      <label class="idea-field">
        <span>市区町村</span>
        {{ form.input('addr01')|raw }}
        <span class="idea-form-error">{{ form.error('addr01') }}</span>
      </label>

      <label class="idea-field">
        <span>番地・建物名</span>
        {{ form.input('addr02')|raw }}
        <span class="idea-form-error">{{ form.error('addr02') }}</span>
      </label>

    </div>

    <div class="idea-form-actions">
      <button class="idea-button" type="submit">次へ</button>
      <a class="idea-link" href="/cart">カートに戻る</a>
    </div>
  </form>
</section>

{% endblock %}
