{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}注文内容の確認 | {{ shop_name|default('BeMart') }}{% endblock %}

{% block content %}
{% set c = customer|default({}) %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/cart">Cart</a><span>/</span><a href="/shopping">Checkout</a><span>/</span><span>確認</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-confirm-title">
  <div>
    <p class="idea-eyebrow">Order review</p>
    <h1 id="idea-confirm-title" class="idea-title idea-title--compact">注文内容の確認</h1>
    <p class="idea-muted">以下の内容でよろしければ「注文を確定する」を押してください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>{{ c.name01|default('') }} {{ c.name02|default('') }} 様</span>
    <strong>¥{{ paymentTotal|default(0)|number_format }}</strong>
    <small>{{ c.email|default('') }}</small>
  </div>
</section>

<section class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  <span><b>1</b>カート</span>
  <span><b>2</b>ご注文手続き</span>
  <span class="is-active"><b>3</b>内容確認</span>
  <span><b>4</b>完了</span>
</section>

<div class="idea-container idea-checkout-layout">

  <div class="idea-checkout-main">

    {# ── お客様情報 ─────────────────────────────── #}
    <section class="idea-checkout-panel">
      <div class="idea-panel-head">
        <div>
          <p class="idea-eyebrow">Customer</p>
          <h2 class="idea-section-title">お客様情報</h2>
        </div>
        <a class="idea-link" href="/mypage/change">変更</a>
      </div>
      <div class="idea-info-list">
        <p><strong>{{ c.name01|default('') }} {{ c.name02|default('') }} 様</strong></p>
        {% if c.kana01 is defined and c.kana01 is not empty %}
          <p class="idea-muted">{{ c.kana01 }} {{ c.kana02|default('') }}</p>
        {% endif %}
        {% if c.companyName is defined and c.companyName is not empty %}
          <p>{{ c.companyName }}</p>
        {% endif %}
        <p>{{ c.email|default('') }}</p>
        {% if c.postalCode is defined and c.postalCode is not empty %}
          <p>〒{{ c.postalCode }} {{ c.addr01|default('') }} {{ c.addr02|default('') }}</p>
        {% endif %}
        {% if c.phoneNumber is defined and c.phoneNumber is not empty %}
          <p>{{ c.phoneNumber }}</p>
        {% endif %}
      </div>
    </section>

    {# ── 注文商品 ────────────────────────────────── #}
    <section class="idea-checkout-panel">
      <div class="idea-panel-head">
        <div>
          <p class="idea-eyebrow">Items</p>
          <h2 class="idea-section-title">ご注文商品</h2>
        </div>
        <a class="idea-link" href="/shopping">内容を変更</a>
      </div>
      <div class="idea-item-list">
        {% for item in items|default([]) %}
          <div class="idea-item-row">
            <div class="idea-item-info">
              <p class="idea-item-name">{{ item.productName|default(item.productCode) }}</p>
              <p class="idea-muted">商品コード: {{ item.productCode }}</p>
            </div>
            <div class="idea-item-qty">
              <span>× {{ item.quantity|number_format }}</span>
              <span class="idea-item-price">¥{{ item.unitPrice|number_format }}</span>
              <strong class="idea-item-subtotal">¥{{ item.totalPrice|number_format }}</strong>
            </div>
          </div>
        {% else %}
          <p class="idea-muted">商品情報を取得できませんでした。</p>
        {% endfor %}
      </div>
    </section>

    {# ── お支払い方法 ────────────────────────────── #}
    <section class="idea-checkout-panel">
      <div class="idea-panel-head">
        <div>
          <p class="idea-eyebrow">Payment</p>
          <h2 class="idea-section-title">お支払い方法</h2>
        </div>
      </div>
      <p class="idea-selected-value">{{ paymentMethodName|default('') }}</p>
    </section>

  </div>{# /.idea-checkout-main #}

  {# ── 金額サマリー + 注文確定フォーム ──────────── #}
  <aside class="idea-summary-panel">
    <p class="idea-eyebrow">Order summary</p>

    <dl class="idea-price-breakdown">
      <div><dt>小計</dt><dd>¥{{ subtotal|default(0)|number_format }}</dd></div>
      <div><dt>送料</dt><dd>¥{{ deliveryFeeTotal|default(0)|number_format }}</dd></div>
      {% if charge|default(0) > 0 %}
        <div><dt>手数料</dt><dd>¥{{ charge|number_format }}</dd></div>
      {% endif %}
      {% if discount|default(0) > 0 %}
        <div><dt>割引</dt><dd>−¥{{ discount|number_format }}</dd></div>
      {% endif %}
      {% if usePoint|default(0) > 0 %}
        <div><dt>ポイント利用</dt><dd>−{{ usePoint|number_format }} pt</dd></div>
      {% endif %}
      <div><dt>消費税</dt><dd>¥{{ tax|default(0)|number_format }}</dd></div>
      <div class="idea-summary-total"><dt>合計</dt><dd>¥{{ paymentTotal|default(0)|number_format }}</dd></div>
    </dl>

    {% if addPoint|default(0) > 0 %}
      <p class="idea-muted idea-point-notice">この注文で {{ addPoint|number_format }} ポイント獲得予定</p>
    {% endif %}

    <form method="post" action="/shopping/checkout?mode=complete">
      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
      <input type="hidden" name="preOrderId" value="{{ preOrderId|default('') }}">
      <input type="hidden" name="paymentMethodId" value="{{ paymentMethodId|default('') }}">
      <button class="idea-button idea-button--wide" type="submit">注文を確定する</button>
    </form>

    <a class="idea-link idea-summary-link" href="/shopping">ご注文手続きに戻る</a>
  </aside>

</div>{# /.idea-checkout-layout #}

{% endblock %}
