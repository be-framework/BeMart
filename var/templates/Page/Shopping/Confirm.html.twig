{#
  BeMart Shopping confirm page — EC-CUBE goShoppingConfirm.

  PORT of EC-CUBE 4.3 default-theme `Shopping/confirm.twig`
  (src/Eccube/Resource/template/default/Shopping/confirm.twig).

  DATA page (+ a checkout submit form/button) — see
  var/templates/README.md. Markup skeleton, the `ec-role` /
  `ec-cartRole` / `ec-progress` / `ec-orderRole` / `ec-orderAccount` /
  `ec-orderDelivery` / `ec-orderPayment` / `ec-orderConfirm` /
  `ec-totalBox` classes and the block structure are kept verbatim from
  EC-CUBE.

  Phase 3 ENRICHMENT — the Confirm resource
  (src/Resource/Page/Shopping/Confirm.php) now drives the doConfirmOrder
  Be Becoming chain (ConfirmOrderInput → … → OrderConfirmed) instead of
  being a thin pure renderer. The body carries the full confirm-screen
  projection the dynamic bindings are rebound to:
    customer { name01, name02, kana01, kana02, companyName, email,
               phoneNumber, postalCode, pref, addr01, addr02 },
    items[] { productCode, productName, quantity, unitPrice, totalPrice },
    paymentMethodName,
    subtotal, deliveryFeeTotal, charge, discount, tax, total,
    paymentTotal, addPoint, usePoint, csrfToken

  EC-CUBE-ism rebinding (see var/templates/README.md):
   - `{{ 'key'|trans }}` -> the ja literal from messages.ja.yaml.
   - `is_granted('ROLE_USER')` — EC-CUBE auth-state runtime. The
     customer-info progress step renders for anonymous purchases only;
     BeMart's html context has no auth state, so the step is OMITTED
     (the member-checkout path) and the step numbering advances
     accordingly — identical to EC-CUBE's member-checkout output.
   - `form._token` — Symfony CSRF widget; kept as the hidden `_token`
     input bound to the body's `csrfToken` (null in the html context —
     the EventListener mirrors the live token in).
   - `price` / `number_format` filters — BeMartTwigExtension JPY filter.
   - the prefecture is rendered as the `customer.pref` master id (the
     CustomerEntity carries the integer FK, not the resolved name —
     there is no pref-master service in the Be domain); the render-diff
     test feeds EC-CUBE the same integer so the line diffs to zero.
   - `is_reduced_tax_rate(...)` / per-tax-rate breakdown — EC-CUBE
     runtime helpers; the reduced-tax-rate mark and the per-rate总额
     rows are gated behind data the body does not carry (BeMart's
     PurchaseFlow folds tax into a single `tax` total), so they are
     OMITTED and recorded as residuals in the render test.
#}
{% extends 'base.html.twig' %}

{% set route = 'shopping_confirm' %}
{% set title = 'ご注文内容のご確認' %}

{% block main %}

<div class="ec-role">
    <div class="ec-pageHeader">
        <h1>ご注文内容のご確認</h1>
    </div>
</div>

<div class="ec-cartRole">
    <div class="ec-cartRole__progress">
        <ul class="ec-progress">
            {% set step = 1 %}
            <li class="ec-progress__item">
                <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                </div>
                <div class="ec-progress__label">カートの商品
                </div>
            </li>
            <li class="ec-progress__item">
                <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                </div>
                <div class="ec-progress__label">ご注文手続き
                </div>
            </li>
            <li class="ec-progress__item is-complete">
                <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                </div>
                <div class="ec-progress__label">ご注文内容確認
                </div>
            </li>
            <li class="ec-progress__item">
                <div class="ec-progress__number">{{ step }}{% set step = step + 1 %}
                </div>
                <div class="ec-progress__label">完了
                </div>
            </li>
        </ul>
    </div>
</div>

    <form id="shopping-form" method="post" action="{{ url('shopping_checkout') }}">
    <input type="hidden" name="_token" value="{{ csrfToken|default('') }}">
    <div class="ec-orderRole">
        <div class="ec-orderRole__detail">
            <div class="ec-orderAccount">
                <div class="ec-rectHeading">
                    <h2>お客様情報</h2>
                </div>
                <div class="ec-orderAccount__account">
                    <p class="ec-halfInput">{{ customer.name01 }} {{ customer.name02 }} 様</p>
                    <p class="ec-halfInput">{{ customer.kana01 }} {{ customer.kana02 }}</p>
                    <p class="ec-input">{{ customer.companyName }}</p>
                    <p class="ec-zipInput">〒{{ customer.postalCode }}</p>
                    <p class="ec-input">{{ customer.pref }}{{ customer.addr01 }}{{ customer.addr02 }}</p>
                    <p class="ec-telInput">{{ customer.phoneNumber }}</p>
                    <p class="ec-input">{{ customer.email }}</p>
                </div>
            </div>
            <div class="ec-orderDelivery">
                <div class="ec-rectHeading">
                    <h2>配送情報</h2>
                </div>
                <div class="ec-orderDelivery__item">
                    <ul class="ec-borderedList">
                        {% for orderItem in items %}
                        <li>
                            <div class="ec-imageGrid">
                                <div class="ec-imageGrid__content">
                                    <p>{{ orderItem.productName }}</p>
                                    <p>{{ orderItem.unitPrice|price }} × {{ orderItem.quantity|number_format }}<span>小計：{{ orderItem.totalPrice|price }}</span></p>
                                </div>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="ec-orderDelivery__address">
                    <p>{{ customer.name01 }} {{ customer.name02 }} ({{ customer.kana01 }} {{ customer.kana02 }}) 様</p>
                    <p>〒{{ customer.postalCode }} {{ customer.pref }}{{ customer.addr01 }}{{ customer.addr02 }}</p>
                    <p>{{ customer.phoneNumber }}</p>
                </div>
            </div>
            <div class="ec-orderPayment">
                <div class="ec-rectHeading">
                    <h2>お支払方法</h2>
                </div>
                <div class="ec-blockRadio">
                    {{ paymentMethodName }}({{ charge|price }})
                </div>
            </div>
            <div class="ec-orderConfirm">
                <div class="ec-rectHeading">
                    <h2>お問い合わせ</h2>
                </div>
                <div class="ec-input">
                </div>
            </div>
        </div>
        <div class="ec-orderRole__summary">
            <div class="ec-totalBox">
                <dl class="ec-totalBox__spec">
                    <dt>小計</dt>
                    <dd class="ec-totalBox__specTotal">{{ subtotal|price }}</dd>
                </dl>
                <dl class="ec-totalBox__spec">
                    <dt>手数料</dt>
                    <dd>{{ charge|price }}</dd>
                </dl>
                <dl class="ec-totalBox__spec">
                    <dt>送料</dt>
                    <dd>{{ deliveryFeeTotal|price }}</dd>
                </dl>
                <div class="ec-totalBox__total">合計<span class="ec-totalBox__price">{{ total|price }}</span><span class="ec-totalBox__taxLabel">税込</span></div>
                <div class="ec-totalBox__paymentTotal">お支払い合計<span class="ec-totalBox__price">{{ paymentTotal|price }}</span><span class="ec-totalBox__taxLabel">税込</span></div>
                <div class="ec-totalBox__btn">
                    <button type="submit" class="ec-blockBtn--action">注文する</button>
                    <a href="{{ url('shopping') }}" class="ec-blockBtn--cancel">ご注文手続きに戻る</a>
                </div>
            </div>
        </div>
    </div>
</form>
{% endblock %}
