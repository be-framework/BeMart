{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}パスワード再発行メール送信完了 | IDEA STORE{% endblock %}

{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="{{ _links.goLogin.href|default('/login') }}" rel="goLogin">ログイン</a><span>/</span><span>メール送信完了</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-forgot-complete-title">
  <div>
    <p class="idea-eyebrow">Password reset</p>
    <h1 id="idea-forgot-complete-title" class="idea-title idea-title--compact">パスワード再発行メールを送信しました</h1>
    <p class="idea-muted">ご登録のメールアドレス宛にメールをお送りしました。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Reset request</span>
    <strong>Sent</strong>
    <small>メールをご確認ください</small>
  </div>
</section>

<div class="idea-container idea-section">
  <div class="idea-checkout-panel" role="status" aria-live="polite">
    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Next step</p>
        <h2 class="idea-section-title">メールの内容をご確認ください</h2>
      </div>
    </div>

    <p>ご登録のメールアドレスにパスワードを再発行するためのメールをお送りしました。メールの内容をご確認のうえ、パスワードの再設定手続きをお進めください。</p>
    <p class="idea-muted">メールが届かない場合は、ご登録のメールアドレスが正しいかご確認のうえ、再度お試しください。迷惑メールフォルダもあわせてご確認ください。</p>

    <div class="idea-form-actions" style="margin-top:2rem;">
      <a class="idea-button" href="{{ _links.goLogin.href|default('/login') }}" rel="goLogin">ログインページへ</a>
      <a class="idea-link" href="{{ _links.goTop.href|default('/') }}" rel="goTop">トップページへ戻る</a>
    </div>
  </div>
</div>
{% endblock %}
