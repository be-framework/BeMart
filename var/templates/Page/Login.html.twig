{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}ログイン | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><span>ログイン</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-login-title">
  <div>
    <p class="idea-eyebrow">Member login</p>
    <h1 id="idea-login-title" class="idea-title idea-title--compact">ログイン</h1>
    <p class="idea-muted">登録済みのメールアドレスとパスワードでログインしてください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Secure</span>
    <strong>Sign in</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<section class="idea-container idea-section">
  <article class="idea-checkout-panel idea-auth-panel">
    <p class="idea-eyebrow">Account</p>
    <h2 class="idea-section-title">メールアドレスでログイン</h2>

    {% if message is defined and message %}
      <p class="idea-form-error" role="alert">{{ message }}</p>
    {% endif %}

    <form class="idea-auth-form" name="login_mypage" id="login_mypage" method="post" action="/login" novalidate>
      <input type="hidden" name="mode" value="login">
      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

      <label class="idea-field">メールアドレス
        {% if form is defined %}
          {{ form.input('email')|raw }}
          <span class="idea-form-error">{{ form.error('email') }}</span>
        {% else %}
          <input type="text" name="email" id="email" autocomplete="email" placeholder="メールアドレス">
        {% endif %}
      </label>

      <label class="idea-field">パスワード
        {% if form is defined %}
          {{ form.input('password')|raw }}
          <span class="idea-form-error">{{ form.error('password') }}</span>
        {% else %}
          <input type="password" name="password" id="password" autocomplete="current-password" placeholder="パスワード">
        {% endif %}
      </label>

      <button class="idea-button idea-button--wide" type="submit">ログイン</button>

      <div class="idea-auth-links">
        <a class="idea-link" href="/forgot-password">パスワードをお忘れの方</a>
        <a class="idea-link" href="/entry">新規会員登録</a>
      </div>
    </form>
  </article>
</section>
{% endblock %}
