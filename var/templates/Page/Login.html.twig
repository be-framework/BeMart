{#
  BeMart Login page — EC-CUBE goLogin.

  PORT of EC-CUBE 4.3 default-theme `Mypage/login.twig`
  (src/Eccube/Resource/template/default/Mypage/login.twig).

  Markup skeleton, `ec-role` / `ec-pageHeader` / `ec-off2Grid` /
  `ec-login` / `ec-grid2` classes and structure are kept verbatim from
  EC-CUBE. Only the dynamic bindings are rebound to the Login resource
  body (src/Resource/Page/Login.php):
    transitionId, fields[], submitTo { method, href }, csrfToken

  EC-CUBE-ism rebinding (see var/templates/README.md):
   - `{{ 'key'|trans }}`  -> the ja literal from messages.ja.yaml.
   - `form_widget(form.login_email/login_pass)` — EC-CUBE renders these
     through the Symfony FormView. BeMart's resource body carries the
     field NAMES (`fields`), not a FormView, so the `<input>` widgets are
     authored plainly here with the EC-CUBE field names + placeholders.
     The exact Symfony-generated widget attributes (id, validation
     wiring) are EC-CUBE-runtime-only and enumerated as residual.
   - `csrf_token('authenticate')` — EC-CUBE per-request CSRF widget.
     BeMart's html context has no CSRF widget; `csrfToken` is null.
     The hidden `_csrf_token` input is kept (structure) with an empty
     value. EC-CUBE-runtime only.
   - `app.session.flashBag.*`, `is_granted(...)`, `BaseInfo.*`, `error`
     — request-flash / auth-state / BaseInfo runtime. The remember-me
     checkbox depends on `BaseInfo.option_remember_me`; BeMart has no
     BaseInfo, so it is OMITTED (never invented) and noted as residual.
#}
{% extends 'base.html.twig' %}

{% set body_class = 'mypage' %}
{% set route = 'mypage_login' %}
{% set title = 'ログイン' %}

{% block main %}
    <div class="ec-role">
        <div class="ec-pageHeader">
            <h1>ログイン</h1>
        </div>
        <div class="ec-off2Grid">
            <div class="ec-off2Grid__cell">
                <form name="login_mypage" id="login_mypage" method="post" action="{{ url('mypage_login') }}">
                    <div class="ec-login">
                        <div class="ec-login__icon">
                            <div class="ec-icon"><img src="{{ asset('assets/icon/user.svg') }}" alt=""></div>
                        </div>
                        <div class="ec-login__input">
                            <div class="ec-input">
                                <input type="text" id="login_email" name="login_email" style="ime-mode: disabled;" placeholder="メールアドレス" autofocus="autofocus">
                                <input type="password" id="login_pass" name="login_pass" placeholder="パスワード">
                            </div>
                        </div>
                        <div class="ec-grid2">
                            <div class="ec-grid2__cell">
                                <div class="ec-login__actions">
                                    <button type="submit"
                                            class="ec-blockBtn--cancel">ログイン</button>
                                </div>
                            </div>
                            <div class="ec-grid2__cell">
                                <div class="ec-login__link"><a class="ec-link"
                                                               href="{{ url('forgot') }}">ログイン情報をお忘れですか？</a>
                                </div>
                                <div class="ec-login__link"><a class="ec-link"
                                                               href="{{ url('entry') }}">新規会員登録</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrfToken|default('') }}">
                </form>
            </div>
        </div>
    </div>
{% endblock %}
