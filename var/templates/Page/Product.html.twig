{% extends 'IdeaStore/layout/base.html.twig' %}

{#
  BeMart 商品詳細ページ — ALPS goProduct.

  Data contract (src/Resource/Page/Product.php + var/json_schema/get-product.json):
    productCode   string        SKU（必須）
    productName   string|null   商品名（必須）
    price02       integer|null  販売価格・税抜（必須）
    stock         integer|null  在庫数（null = 無制限）
    stockFind     boolean       購入可フラグ（必須）
    description   string|null   説明文
    categoryNames string[]      カテゴリ名一覧
    tagNames      string[]      タグ名一覧
    classNames    string[]      規格名一覧
    mainImage     string|null   メイン画像 URI
    csrfToken     string|null   CSRF トークン
    form          object|null   AddCartForm（html コンテキストのみ）

  Transitions (#[Link] on Product::onGet):
    goProductList   GET  page://self/products
    doAddCartItem   POST page://self/cart/item
    doAddFavorite   POST page://self/mypage/favorite   (お気に入り追加 — 未実装 MISSING BODY FIELD)
    doRemoveFavorite DELETE page://self/mypage/favorite (お気に入り削除 — 未実装 MISSING BODY FIELD)

  Form fields (src/Form/AddCartForm.php):
    productCode  hidden   商品コード（Resource 側で seeded）
    csrfToken    hidden   CSRF トークン（Resource 側で seeded）
    quantity     number   購入数量（min=1）

  Design language: IdeaStore idea-* CSS vocabulary
  (var/templates/IdeaStore/*, /Users/akihito/git/IdeaStore/assets/css/idea-store.css)
#}

{% block title %}{{ productName }} | IDEA STORE{% endblock %}

{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="パンくずリスト">
  <a href="/">ホーム</a><span>/</span><a href="/products" rel="goProductList">商品一覧</a><span>/</span><span aria-current="page">{{ productName }}</span>
</nav>

<article class="idea-container idea-product-detail idea-product-detail--premium" itemscope itemtype="https://schema.org/Product">

  {# ギャラリーカラム #}
  <div class="idea-product-gallery">
    <div class="idea-product-visual">
      <img
        src="{{ mainImage|default('/assets/idea-store/images/product/product-01.svg') }}"
        alt="{{ productName }}"
        itemprop="image"
      >
    </div>
    <div class="idea-product-thumbs" aria-label="商品の使用イメージ">
      <img src="/assets/idea-store/images/editorial/editorial-01.svg" alt="インテリアのイメージ" loading="lazy">
      <img src="/assets/idea-store/images/editorial/editorial-02.svg" alt="素材のクローズアップ" loading="lazy">
      <img src="/assets/idea-store/images/editorial/editorial-04.svg" alt="生活空間での佇まい" loading="lazy">
    </div>
  </div>

  {# 購入ボックスカラム #}
  <div class="idea-product-info idea-product-buybox">
    {% if categoryNames|default([]) is not empty %}
      <p class="idea-eyebrow">{{ categoryNames|first }}</p>
    {% else %}
      <p class="idea-eyebrow">IDEA STORE</p>
    {% endif %}

    <h1 class="idea-section-title" itemprop="name">{{ productName }}</h1>

    {% if description %}
      <p class="idea-lead" itemprop="description">{{ description }}</p>
    {% endif %}

    <p class="idea-price idea-detail-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
      ¥{{ price02|number_format }}
      <meta itemprop="priceCurrency" content="JPY">
      <meta itemprop="price" content="{{ price02 }}">
    </p>

    {% if tagNames|default([]) is not empty or classNames|default([]) is not empty %}
      <div class="idea-chip-row">
        {% for tag in tagNames|default([]) %}
          <span>{{ tag }}</span>
        {% endfor %}
        {% for className in classNames|default([]) %}
          <span>{{ className }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {#
      カート追加フォーム
      action は src/Resource/Page/Product.php #[Link] の href から確定:
        doAddCartItem POST page://self/cart/item -> /cart/item
      フィールド: productCode（hidden）, csrfToken（hidden）, quantity（number）
    #}
    <form class="idea-cart-form" action="/cart/item" method="post" rel="doAddCartItem">
      {{ form.input('csrfToken')|raw }}
      {{ form.input('productCode')|raw }}

      {% if stockFind %}
        <label>
          数量
          {{ form.input('quantity')|raw }}
          {% set quantityError = form.error('quantity') %}
          {% if quantityError %}
            <span class="idea-muted" role="alert">{{ quantityError }}</span>
          {% endif %}
        </label>
        <button type="submit" class="idea-button">カートに入れる</button>
      {% else %}
        <button type="button" class="idea-button" disabled aria-disabled="true">ただいま品切れ中です</button>
      {% endif %}
    </form>

    <div class="idea-product-promises">
      <span>丁寧なものづくり</span>
      <span>生活編集の視点で選んだアイテム</span>
      <span>安心の在庫管理</span>
    </div>

    <dl class="idea-spec-list">
      <div class="idea-spec-row">
        <dt>商品コード</dt>
        <dd itemprop="sku">{{ productCode }}</dd>
      </div>
      {% if categoryNames|default([]) is not empty %}
        <div class="idea-spec-row">
          <dt>カテゴリ</dt>
          <dd>{{ categoryNames|join(' / ') }}</dd>
        </div>
      {% endif %}
      {% if tagNames|default([]) is not empty %}
        <div class="idea-spec-row">
          <dt>タグ</dt>
          <dd>{{ tagNames|join(' / ') }}</dd>
        </div>
      {% endif %}
      <div class="idea-spec-row">
        <dt>在庫状況</dt>
        <dd>{{ stockFind ? '在庫あり' : '品切れ' }}</dd>
      </div>
    </dl>
  </div>
</article>

<section class="idea-container idea-section idea-story-panel" aria-labelledby="idea-product-story-title">
  <p class="idea-eyebrow">About this item</p>
  <h2 id="idea-product-story-title">日々の手順を、少し丁寧に。</h2>
  <p>IDEA STORE の商品は、暮らしの中でどう使うかを想像しながら選んでいます。機能だけでなく、手に取る瞬間の感触や、部屋に置いたときの佇まいを大切にしています。</p>
</section>
{% endblock %}
