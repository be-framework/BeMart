<!DOCTYPE html>
{#
  Phase 3 Step 1 pilot template — EC-CUBE goCart.

  Driven entirely by the Cart resource body (src/Resource/Page/Cart.php):
    cartCount, totalPrice, deliveryFeeTotal,
    carts[] { cartKey, saleTypeId, saleTypeName, totalPrice,
              deliveryFeeTotal, items[] { productCode, quantity, price } }

  Resolved by madapaja/twig-module's TemplateFinder:
    src/Resource/Page/Cart.php -> var/templates/Page/Cart.html.twig
#}
<html lang="ja">
<head>
    <meta charset="utf-8">
    <title>カート | BeMart</title>
</head>
<body>
    <h1>ショッピングカート</h1>

    {% if cartCount == 0 %}
        <p class="cart-empty">カートに商品がありません。</p>
    {% else %}
        <p class="cart-summary">
            カート数: <span class="cart-count">{{ cartCount }}</span> /
            合計: <span class="cart-total">{{ totalPrice }}</span> 円 /
            送料合計: <span class="cart-delivery-fee">{{ deliveryFeeTotal }}</span> 円
        </p>

        {% for cart in carts %}
            <section class="cart" data-cart-key="{{ cart.cartKey }}">
                <h2>{{ cart.saleTypeName }}（{{ cart.cartKey }}）</h2>

                {% if cart.items is empty %}
                    <p class="cart-items-empty">この販売区分の商品はありません。</p>
                {% else %}
                    <table class="cart-items">
                        <thead>
                            <tr>
                                <th>商品コード</th>
                                <th>数量</th>
                                <th>単価</th>
                                <th>小計</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in cart.items %}
                                <tr class="cart-item">
                                    <td class="item-code">{{ item.productCode }}</td>
                                    <td class="item-quantity">{{ item.quantity }}</td>
                                    <td class="item-price">{{ item.price }}</td>
                                    <td class="item-subtotal">{{ item.price * item.quantity }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                <p class="cart-line-total">
                    小計: {{ cart.totalPrice }} 円（送料 {{ cart.deliveryFeeTotal }} 円）
                </p>
            </section>
        {% endfor %}
    {% endif %}

    <nav class="cart-actions">
        <a href="/shopping">レジに進む</a>
        <a href="/products">買い物を続ける</a>
    </nav>
</body>
</html>
