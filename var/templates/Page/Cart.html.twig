{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}カート | IDEA STORE{% endblock %}
{% block content %}
{% set displayCarts = carts|default([])|filter(cart => cart.items|default([])|length > 0) %}
{% set progress = [
  { label: 'カート',      state: 'is-active' },
  { label: 'ログイン',    state: '' },
  { label: 'お届け先',    state: '' },
  { label: 'ご注文確認',  state: '' },
  { label: '完了',        state: '' }
] %}

<nav class="idea-container idea-breadcrumb" aria-label="現在地">
  <a href="/">ホーム</a><span>/</span><span>カート</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-cart-heading">
  <div>
    <p class="idea-eyebrow">Shopping cart</p>
    <h1 id="idea-cart-heading" class="idea-title idea-title--compact">
      <span class="idea-title-line">選んだイデアを、</span>
      <span class="idea-title-line">暮らしへ。</span>
    </h1>
    <p class="idea-muted">数量を確認してレジへ進んでください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>{{ displayCarts|length > 0 ? 'Ready' : 'Empty' }}</span>
    <strong>¥{{ totalPrice|default(0)|number_format }}</strong>
    <small>{{ displayCarts|length }} カートグループ</small>
  </div>
</section>

<nav class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  {% for step in progress %}
    <span class="{{ step.state }}"><b>{{ loop.index }}</b>{{ step.label }}</span>
  {% endfor %}
</nav>

<section class="idea-container idea-section idea-checkout-layout">
  <div class="idea-checkout-main">

    {% if displayCarts|length > 0 %}

      {% if displayCarts|length > 1 %}
        <div class="idea-checkout-panel" role="alert">
          <p class="idea-muted">販売種別が異なる商品があるため、カートが分かれています。それぞれ個別にお手続きください。</p>
        </div>
      {% endif %}

      {% for cart in displayCarts %}
        <article class="idea-checkout-panel idea-cart-panel">
          <div class="idea-panel-head">
            <div>
              <p class="idea-eyebrow">{{ cart.saleTypeName|default('通常販売') }}</p>
              <h2 class="idea-section-title">カートの商品</h2>
            </div>
            <span class="idea-panel-total">¥{{ cart.totalPrice|default(0)|number_format }}</span>
          </div>

          <div class="idea-cart-list">
            {% for item in cart.items|default([]) %}
              {% set qty = item.quantity|default(1) %}
              {% set unitPrice = item.price|default(0) %}
              {% set image = item.mainImage|default('/assets/idea-store/images/product/no-image.svg') %}
              {% if image starts with 'idea-store/' %}
                {% set image = '/save_image/' ~ image %}
              {% elseif image starts with 'save_image/' or image starts with 'assets/' %}
                {% set image = '/' ~ image %}
              {% endif %}

              <article class="idea-cart-item">
                <a class="idea-cart-item__image" href="/products/detail/{{ item.productCode }}">
                  <img src="{{ image }}" alt="{{ item.productName|default(item.productCode) }}" loading="lazy">
                </a>

                <div class="idea-cart-item__body">
                  <p class="idea-card-kicker">{{ item.productCode }}</p>
                  <h3>
                    <a href="/products/detail/{{ item.productCode }}">{{ item.productName|default(item.productCode) }}</a>
                  </h3>
                  {% if item.classCategoryName1|default('') %}
                    <p class="idea-muted">{{ item.className1|default('規格') }}：{{ item.classCategoryName1 }}</p>
                  {% endif %}
                  {% if item.classCategoryName2|default('') %}
                    <p class="idea-muted">{{ item.className2|default('規格') }}：{{ item.classCategoryName2 }}</p>
                  {% endif %}
                  <p class="idea-cart-item__price">¥{{ unitPrice|number_format }} × {{ qty|number_format }}</p>
                </div>

                <div class="idea-cart-item__controls" aria-label="{{ item.productName|default(item.productCode) }} の数量操作">
                  <div class="idea-quantity-actions">
                    <form method="post" action="/cart/item">
                      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                      <input type="hidden" name="productCode" value="{{ item.productCode }}">
                      <input type="hidden" name="operation" value="down">
                      <input type="hidden" name="quantity" value="{{ qty - 1 }}">
                      <button type="submit" aria-label="数量を減らす"{% if qty <= 1 %} disabled{% endif %}>−</button>
                    </form>
                    <span>{{ qty|number_format }}</span>
                    <form method="post" action="/cart/item">
                      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                      <input type="hidden" name="productCode" value="{{ item.productCode }}">
                      <input type="hidden" name="operation" value="up">
                      <input type="hidden" name="quantity" value="{{ qty + 1 }}">
                      <button type="submit" aria-label="数量を増やす">＋</button>
                    </form>
                  </div>
                  <strong>¥{{ (unitPrice * qty)|number_format }}</strong>
                  <form method="post" action="/cart/item">
                    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                    <input type="hidden" name="productCode" value="{{ item.productCode }}">
                    <input type="hidden" name="operation" value="remove">
                    <button class="idea-text-button" type="submit">削除</button>
                  </form>
                </div>
              </article>
            {% endfor %}
          </div>

          <div class="idea-form-actions">
            <a class="idea-button" rel="goCheckoutEntry" href="/shopping">レジに進む</a>
          </div>
        </article>
      {% endfor %}

    {% else %}
      <div class="idea-empty">
        <p class="idea-eyebrow">Your cart is empty</p>
        <h2 class="idea-section-title">カートに商品がありません</h2>
        <p class="idea-muted">気になる商品を見つけてカートに追加してください。</p>
        <a class="idea-button" href="/products">商品を探す</a>
      </div>
    {% endif %}

  </div>

  <aside class="idea-summary-panel" aria-label="注文概要">
    <p class="idea-eyebrow">Order summary</p>
    <dl>
      <div>
        <dt>商品合計</dt>
        <dd>¥{{ totalPrice|default(0)|number_format }}</dd>
      </div>
      <div>
        <dt>送料</dt>
        <dd>¥{{ deliveryFeeTotal|default(0)|number_format }}</dd>
      </div>
      <div class="idea-summary-total">
        <dt>合計</dt>
        <dd>¥{{ (totalPrice|default(0) + deliveryFeeTotal|default(0))|number_format }}</dd>
      </div>
    </dl>
    <a class="idea-button idea-button--wide{% if displayCarts|length == 0 %} idea-button--disabled{% endif %}"
       rel="goCheckoutEntry"
       href="{% if displayCarts|length > 0 %}/shopping{% else %}/products{% endif %}">
      {% if displayCarts|length > 0 %}レジに進む{% else %}買い物を続ける{% endif %}
    </a>
    <a class="idea-link idea-summary-link" href="/products">カタログに戻る</a>
  </aside>
</section>
{% endblock %}
