{#
  BeMart 退会手続き最終確認ページ — goMypageWithdrawConfirm。

  IdeaStore 設計言語によるクリーンルーム実装。
  EC-CUBE の DOM 構造・クラス名・文言は使用していない。

  データ契約 (src/Resource/Page/Mypage/WithdrawConfirm.php):
    - transitionId: goMypageWithdrawConfirm
    - fields: ['csrfToken']
    - submitTo: { method: POST, href: page://self/mypage/withdraw }
    - csrfToken: null (EventListener がライブトークンを注入)
    - #[Link] rel=doWithdrawCustomer  href=page://self/mypage/withdraw  method=post
    - #[Link] rel=goMypage            href=page://self/mypage

  フォームフィールドなし。csrfToken hidden + 実行ボタン + キャンセルリンクのみ。
  AbstractForm 不要（<input> フィールドを持つ画面ではないため）。
#}
{% extends 'IdeaStore/layout/base.html.twig' %}

{% block title %}退会手続きの確認 | IDEA STORE{% endblock %}

{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="パンくずリスト">
  <a href="/">Home</a><span>/</span>
  <a href="/mypage">マイページ</a><span>/</span>
  <a href="/mypage/withdraw">退会手続き</a><span>/</span>
  <span>最終確認</span>
</nav>

<section class="idea-container idea-section idea-account-layout">

  <nav class="idea-account-nav" aria-label="マイページメニュー">
    <p class="idea-eyebrow">Account menu</p>
    <ul class="idea-account-nav__list">
      <li><a href="/mypage">注文履歴</a></li>
      <li><a href="/mypage/favorite-list">お気に入り</a></li>
      <li><a href="/mypage/change">会員情報の変更</a></li>
      <li><a href="/mypage/address-list">お届け先の管理</a></li>
      <li class="is-active"><a href="/mypage/withdraw">退会手続き</a></li>
    </ul>
  </nav>

  <div class="idea-account-main">

    <div class="idea-checkout-panel idea-withdraw-confirm">

      <div class="idea-panel-head">
        <div>
          <p class="idea-eyebrow">Account closure</p>
          <h1 class="idea-section-title">退会手続きの最終確認</h1>
        </div>
      </div>

      <p class="idea-muted">退会すると、注文履歴・お届け先・お気に入りなど、アカウントに保存されているすべての情報が削除されます。この操作は取り消せません。</p>

      <form method="post" action="/mypage/withdraw" class="idea-withdraw-confirm__form">
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
        <div class="idea-form-actions">
          <button type="submit" class="idea-button idea-withdraw-confirm__submit">退会を実行する</button>
          <a href="/mypage" class="idea-button idea-button--light idea-withdraw-confirm__cancel">キャンセル</a>
        </div>
      </form>

    </div>

  </div>

</section>
{% endblock %}
