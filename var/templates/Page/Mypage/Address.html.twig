{#
  BeMart address add/edit page — EC-CUBE お届け先情報編集.

  PORT of EC-CUBE 4.3 default-theme `Mypage/delivery_edit.twig`
  (src/Eccube/Resource/template/default/Mypage/delivery_edit.twig).

  Markup skeleton, `ec-mypageRole` / `ec-editRole` / `ec-off1Grid` /
  `ec-borderedDefs` / `ec-halfInput` / `ec-zipInput` / `ec-select` /
  `ec-input` / `ec-telInput` / `ec-RegisterRole__actions` classes + the
  <dl>/<dt>/<dd> definition-list structure are kept verbatim from
  EC-CUBE.

  Phase 3 — FORM page (Ray.WebFormModule). The Address resource exposes
  a real `AddressForm` (an AbstractForm) as `body.form`; the inputs are
  rendered through it:

    {{ form.input('name01')|raw }}   <- real <input> w/ name/attrs/value
    {{ form.error('name01') }}       <- inline Be-domain error, if any

  EC-CUBE renders the same inputs through the Symfony FormView
  (`form_widget(form.name.name01)`); Ray.WebFormModule is BeMart's
  BEAR-idiomatic equivalent. The field names / placeholders in
  AddressForm::init() are ported from EC-CUBE's `CustomerAddressType`
  leaf fields + the template's `form_widget` `attr` options. The
  render-diff test stubs EC-CUBE's `form_widget` / `form_label` to
  delegate to the SAME AddressForm so the inputs + labels diff to ZERO.

  Validation authority stays with the Be Framework Becoming chain — the
  form is a field-definition + renderer.

  EC-CUBE-ism rebinding (see var/templates/README.md):
   - `{{ 'key'|trans }}` -> the ja literal from messages.ja.yaml.
   - `form._token` — Symfony CSRF widget; BeMart has no CSRF widget, the
     hidden token is kept with the body's `csrfToken` (null in the html
     context — the EventListener mirrors the live token in).
   - `has_errors(...)` — request-validation runtime; resolves false on a
     fresh form, so the conditional ` error` class never appears.
   - The `{% for f in form|filter(...) %}` entity-extension auto-render
     loop is OMITTED — a core install has no such extensions, so it
     emits nothing on either side.
   - `pref` renders as the bare empty `<select>`: the prefecture option
     set is EC-CUBE master data (`mtb_pref`) the resource body does not
     carry. Enumerated as an EC-CUBE-runtime residual.
#}
{% extends 'base.html.twig' %}

{% set body_class = 'mypage' %}
{% set route = 'mypage_delivery_edit' %}
{% set title = 'マイページ' %}

{% block javascript %}
    <script src="//yubinbango.github.io/yubinbango/yubinbango.js" charset="UTF-8"></script>
{% endblock javascript %}

{% block main %}
    <div class="ec-layoutRole__main">
        <div class="ec-mypageRole">
            <div class="ec-pageHeader">
                <h1>マイページ/お届け先一覧</h1>
            </div>
            {% include 'Page/Mypage/navi.html.twig' with { mypageno: 'delivery', name01: name01|default(''), name02: name02|default('') } %}
        </div>
        <div class="ec-mypageRole">
            <form method="post" action="?" novalidate class="h-adr">
                <div class="ec-editRole">
                    <div class="ec-off1Grid">
                        <div class="ec-off1Grid__cell">

                            <span class="p-country-name" style="display:none;">Japan</span>
                            <input type="hidden" name="_token" value="{{ csrfToken|default('') }}">
                            <div class="ec-borderedDefs">
                                <dl>
                                    <dt>
                                        <label class="ec-label">お名前</label>
                                    </dt>
                                    <dd>
                                        <div class="ec-halfInput">
                                            {{ form.input('name01')|raw }}
                                            {{ form.input('name02')|raw }}
                                            {{ form.error('name01') }}
                                            {{ form.error('name02') }}
                                        </div>
                                    </dd>
                                </dl>
                                <dl>
                                    <dt>
                                        <label class="ec-label">お名前(カナ)</label>
                                    </dt>
                                    <dd>
                                        <div class="ec-halfInput">
                                            {{ form.input('kana01')|raw }}
                                            {{ form.input('kana02')|raw }}
                                            {{ form.error('kana01') }}
                                            {{ form.error('kana02') }}
                                        </div>
                                    </dd>
                                </dl>
                                <dl>
                                    <dt>
                                        <label class="ec-label">会社名</label>
                                    </dt>
                                    <dd>
                                        <div class="ec-halfInput">
                                            {{ form.input('companyName')|raw }}
                                            {{ form.error('companyName') }}
                                        </div>
                                    </dd>
                                </dl>
                                <dl>
                                    <dt>
                                        <label class="ec-label">住所</label>
                                    </dt>
                                    <dd>
                                        <div class="ec-zipInput"><span>〒</span>
                                            {{ form.input('postalCode')|raw }}
                                            <div class="ec-zipInputHelp">
                                                <div class="ec-zipInputHelp__icon">
                                                    <div class="ec-icon"><img
                                                                src="{{ asset('assets/icon/question-white.svg') }}" alt="">
                                                    </div>
                                                </div><a href="https://www.post.japanpost.jp/zipcode/" target="_blank"><span>郵便番号検索</span></a>
                                            </div>
                                            {{ form.error('postalCode') }}
                                        </div>

                                        <div class="ec-select">
                                            {{ form.input('pref')|raw }}
                                            {{ form.error('pref') }}
                                        </div>
                                        <div class="ec-input">
                                            {{ form.input('addr01')|raw }}
                                            {{ form.error('addr01') }}
                                        </div>
                                        <div class="ec-input">
                                            {{ form.input('addr02')|raw }}
                                            {{ form.error('addr02') }}
                                        </div>
                                    </dd>
                                </dl>
                                <dl>
                                    <dt>
                                        <label class="ec-label">電話番号</label>
                                    </dt>
                                    <dd>
                                        <div class="ec-telInput">
                                            {{ form.input('phoneNumber')|raw }}
                                            {{ form.error('phoneNumber') }}
                                        </div>
                                    </dd>
                                </dl>
                            </div>

                        </div>
                    </div>
                    <div class="ec-RegisterRole__actions">
                        <div class="ec-off4Grid">
                            <div class="ec-off4Grid__cell">
                                <button type="submit"
                                        class="ec-blockBtn--cancel">登録する</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
