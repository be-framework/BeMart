{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お届け先の編集 | IDEA STORE{% endblock %}
{% block content %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span>
  <a href="/mypage">マイページ</a><span>/</span>
  <a href="/mypage/address-list">お届け先の管理</a><span>/</span>
  <span>{{ addressId is not null ? '編集' : '新規追加' }}</span>
</nav>

<section class="idea-container idea-checkout-hero idea-checkout-hero--address" aria-labelledby="idea-address-title">
  <div>
    <p class="idea-eyebrow">Shipping address</p>
    <h1 id="idea-address-title" class="idea-title idea-title--compact">
      {{ addressId is not null ? 'お届け先を編集' : 'お届け先を追加' }}
    </h1>
    <p class="idea-muted">お名前・住所・電話番号を入力してください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>{{ addressId is not null ? 'Edit address' : 'New address' }}</span>
    <strong>IDEA STORE</strong>
    <small>Delivery book</small>
  </div>
</section>

<section class="idea-container idea-section idea-account-layout">

  <nav class="idea-account-nav" aria-label="マイページメニュー">
    <p class="idea-eyebrow">Account menu</p>
    <ul class="idea-account-nav__list">
      <li><a href="/mypage">注文履歴</a></li>
      <li><a href="/mypage/favorite-list">お気に入り</a></li>
      <li><a href="/mypage/change">会員情報の変更</a></li>
      <li class="is-active"><a href="/mypage/address-list">お届け先の管理</a></li>
      <li><a href="/mypage/withdraw">退会手続き</a></li>
    </ul>
  </nav>

  <div class="idea-account-main">

    <div class="idea-checkout-panel">
      <div class="idea-panel-head">
        <div>
          <p class="idea-eyebrow">{{ addressId is not null ? 'Update address' : 'Add address' }}</p>
          <h2 class="idea-section-title">
            {{ addressId is not null ? 'お届け先の変更' : '新しいお届け先' }}
          </h2>
        </div>
        <a class="idea-link" href="/mypage/address-list">一覧に戻る</a>
      </div>

      <form
        method="post"
        action="{{ submitTo.href|replace({'page://self': ''}) }}"
        novalidate
        class="h-adr idea-address-form"
      >
        <span class="p-country-name" aria-hidden="true">Japan</span>
        <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
        {% if addressId is not null %}
          <input type="hidden" name="addressId" value="{{ addressId }}">
          <input type="hidden" name="_method" value="PUT">
        {% endif %}

        <div class="idea-form-grid">

          <div class="idea-form-grid--two idea-form-grid">
            <label class="idea-field">
              <span>姓<abbr class="idea-required" title="必須">*</abbr></span>
              {{ form.input('name01')|raw }}
              <p class="idea-form-error">{{ form.error('name01') }}</p>
            </label>
            <label class="idea-field">
              <span>名<abbr class="idea-required" title="必須">*</abbr></span>
              {{ form.input('name02')|raw }}
              <p class="idea-form-error">{{ form.error('name02') }}</p>
            </label>
          </div>

          <div class="idea-form-grid--two idea-form-grid">
            <label class="idea-field">
              <span>セイ</span>
              {{ form.input('kana01')|raw }}
              <p class="idea-form-error">{{ form.error('kana01') }}</p>
            </label>
            <label class="idea-field">
              <span>メイ</span>
              {{ form.input('kana02')|raw }}
              <p class="idea-form-error">{{ form.error('kana02') }}</p>
            </label>
          </div>

          <label class="idea-field idea-field--full">
            <span>会社名</span>
            {{ form.input('companyName')|raw }}
            <p class="idea-form-error">{{ form.error('companyName') }}</p>
          </label>

          <label class="idea-field">
            <span>郵便番号<abbr class="idea-required" title="必須">*</abbr></span>
            <span class="idea-postal-wrap">
              <span class="idea-postal-mark" aria-hidden="true">〒</span>
              {{ form.input('postalCode')|raw }}
            </span>
            <p class="idea-form-error">{{ form.error('postalCode') }}</p>
          </label>

          <label class="idea-field">
            <span>都道府県<abbr class="idea-required" title="必須">*</abbr></span>
            {{ form.input('pref')|raw }}
            <p class="idea-form-error">{{ form.error('pref') }}</p>
          </label>

          <label class="idea-field idea-field--full">
            <span>市区町村名<abbr class="idea-required" title="必須">*</abbr></span>
            {{ form.input('addr01')|raw }}
            <p class="idea-form-error">{{ form.error('addr01') }}</p>
          </label>

          <label class="idea-field idea-field--full">
            <span>番地・建物名</span>
            {{ form.input('addr02')|raw }}
            <p class="idea-form-error">{{ form.error('addr02') }}</p>
          </label>

          <label class="idea-field">
            <span>電話番号</span>
            {{ form.input('phoneNumber')|raw }}
            <p class="idea-form-error">{{ form.error('phoneNumber') }}</p>
          </label>

        </div>

        <div class="idea-form-actions">
          <button type="submit" class="idea-button">
            {{ addressId is not null ? '変更を保存する' : 'お届け先を登録する' }}
          </button>
          <a class="idea-link" href="/mypage/address-list">キャンセル</a>
        </div>
      </form>
    </div>

  </div>

</section>
{% endblock %}
