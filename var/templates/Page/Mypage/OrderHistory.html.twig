{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}注文履歴 | IDEA STORE{% endblock %}
{% block content %}

{#
  Data contract (page://self/mypage/order-history — onGet):
    customerId  string
    orderCount  int
    limit       int
    offset      int
    orders[]    { orderNo, orderDate, paymentDate, total, paymentTotal, orderStatus }

  Links defined in Resource:
    goMypageHistory  → /mypage/history?orderNo={orderNo}   (GET, order detail)
    goMypage         → /mypage                             (GET, dashboard)

  orderStatus codes (FinalizedOrderEntity):
    1=新規受付  3=注文取消  4=対応中  5=発送済み
    6=入金済み  7=決済処理中  8=購入処理中  9=返品
#}

{% set statusLabel = {
  1: '新規受付',
  3: '注文取消',
  4: '対応中',
  5: '発送済み',
  6: '入金済み',
  7: '決済処理中',
  8: '購入処理中',
  9: '返品'
} %}

{% set mypageNav = [
  { key: 'index',    label: '注文履歴',       href: '/mypage' },
  { key: 'favorite', label: 'お気に入り',     href: '/mypage/favorite-list' },
  { key: 'change',   label: '会員情報の編集', href: '/mypage/change' },
  { key: 'delivery', label: 'お届け先',       href: '/mypage/address-list' },
  { key: 'withdraw', label: '退会手続き',     href: '/mypage/withdraw' },
] %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span>
  <a href="/mypage">マイページ</a><span>/</span>
  <span>注文履歴</span>
</nav>

<section class="idea-container" style="padding-top:clamp(1.4rem,3vw,2.5rem);">
  <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:start;">
    <div>
      <p class="idea-eyebrow">Order history</p>
      <h1 class="idea-title idea-title--compact">注文履歴</h1>
      {% if orderCount is defined and orderCount > 0 %}
        <p class="idea-muted">{{ orderCount }}件の注文があります。</p>
      {% endif %}
    </div>
    <div style="display:flex;flex-direction:column;gap:.5rem;align-items:flex-end;padding-top:.5rem;">
      {% for nav in mypageNav %}
        <a href="{{ nav.href }}"
           style="font-size:.86rem;font-weight:{% if nav.key == 'order-history' %}900{% else %}700{% endif %};color:{% if nav.key == 'order-history' %}var(--idea-ink){% else %}var(--idea-muted){% endif %};">
          {{ nav.label }}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="idea-container idea-section idea-section--tight" aria-label="注文一覧">
  {% if orders is defined and orders|length > 0 %}
    <div style="display:grid;gap:.85rem;">
      {% for order in orders %}
        <article class="idea-checkout-panel" style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center;">
          <div style="display:grid;gap:.35rem;">
            <div style="display:flex;flex-wrap:wrap;gap:.75rem 1.5rem;align-items:baseline;">
              <span class="idea-eyebrow">{{ order.orderDate|date('Y年n月j日') }}</span>
              <span style="font-size:.8rem;font-weight:800;padding:.2rem .6rem;border-radius:999px;background:rgba(82,107,85,.1);color:var(--idea-olive);">
                {{ statusLabel[order.orderStatus]|default('ステータス不明') }}
              </span>
            </div>
            <dl style="display:grid;grid-template-columns:repeat(auto-fill,minmax(9rem,1fr));gap:.35rem .75rem;margin:0;">
              <div style="display:contents;">
                <dt style="color:var(--idea-muted);font-size:.8rem;font-weight:800;">注文番号</dt>
                <dd style="margin:0;font-size:.9rem;font-family:monospace;letter-spacing:.04em;">{{ order.orderNo }}</dd>
              </div>
              <div style="display:contents;">
                <dt style="color:var(--idea-muted);font-size:.8rem;font-weight:800;">お支払い合計</dt>
                <dd style="margin:0;font-weight:900;" class="idea-price">¥{{ order.paymentTotal|number_format }}</dd>
              </div>
              {% if order.paymentDate is defined and order.paymentDate is not empty %}
                <div style="display:contents;">
                  <dt style="color:var(--idea-muted);font-size:.8rem;font-weight:800;">入金日</dt>
                  <dd style="margin:0;font-size:.86rem;">{{ order.paymentDate|date('Y年n月j日') }}</dd>
                </div>
              {% endif %}
            </dl>
          </div>
          <a href="/mypage/history?orderNo={{ order.orderNo|url_encode }}"
             class="idea-button idea-button--light"
             rel="goMypageHistory"
             style="white-space:nowrap;flex-shrink:0;">
            詳細を見る
          </a>
        </article>
      {% endfor %}
    </div>

    {% if (limit is defined and orderCount is defined) and orderCount > limit %}
      <nav style="display:flex;gap:1rem;justify-content:center;margin-top:2rem;" aria-label="ページネーション">
        {% if offset is defined and offset > 0 %}
          <a href="/mypage/order-history?offset={{ max(offset - limit, 0) }}&historyLimit={{ limit }}"
             class="idea-button idea-button--light">
            前のページ
          </a>
        {% endif %}
        {% if offset is defined and (offset + limit) < orderCount %}
          <a href="/mypage/order-history?offset={{ offset + limit }}&historyLimit={{ limit }}"
             class="idea-button">
            次のページ
          </a>
        {% endif %}
      </nav>
    {% endif %}

  {% else %}
    <div class="idea-empty" role="status">
      <p class="idea-eyebrow">No orders yet</p>
      <h2 class="idea-section-title" style="font-size:clamp(1.5rem,2.5vw,2.2rem);">まだ注文はありません。</h2>
      <p class="idea-muted">気になる商品を見つけたら、カートに追加してみましょう。</p>
      <a href="/products/list" class="idea-button" style="margin-top:1.2rem;">商品を探す</a>
    </div>
  {% endif %}
</section>

{% endblock %}
