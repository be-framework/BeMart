{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お届け先の管理 | IDEA STORE{% endblock %}
{% block content %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/mypage">マイページ</a><span>/</span><span>お届け先の管理</span>
</nav>

<section class="idea-container idea-section idea-account-layout">

  <nav class="idea-account-nav" aria-label="マイページメニュー">
    <p class="idea-eyebrow">Account menu</p>
    <ul class="idea-account-nav__list">
      <li><a href="/mypage">注文履歴</a></li>
      <li><a href="/mypage/favorite-list">お気に入り</a></li>
      <li><a href="/mypage/change">会員情報の変更</a></li>
      <li class="is-active"><a href="/mypage/address-list">お届け先の管理</a></li>
      <li><a href="/mypage/withdraw">退会手続き</a></li>
    </ul>
  </nav>

  <div class="idea-account-main">

    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Address book</p>
        <h1 class="idea-section-title">お届け先の管理</h1>
      </div>
      <a class="idea-button" href="/mypage/address">新しいお届け先を追加する</a>
    </div>

    {% if count|default(0) > 0 %}
      <p class="idea-muted">{{ count }} 件のお届け先が登録されています。</p>

      <div class="idea-address-list">
        {% for address in addresses|default([]) %}
          <article class="idea-checkout-panel idea-address-card" aria-label="{{ address.name01 }} {{ address.name02 }} のお届け先">
            <div class="idea-panel-head">
              <div class="idea-info-list">
                <p><strong>{{ address.name01 }} {{ address.name02 }}</strong>{% if address.kana01 or address.kana02 %}<span class="idea-muted"> （{{ address.kana01|default('') }} {{ address.kana02|default('') }}）</span>{% endif %}</p>
                {% if address.companyName %}<p class="idea-muted">{{ address.companyName }}</p>{% endif %}
                <p>〒{{ address.postalCode }}　{{ address.prefName|default('') }}{{ address.addr01 }}{{ address.addr02 }}</p>
                {% if address.phoneNumber %}<p class="idea-muted">{{ address.phoneNumber }}</p>{% endif %}
              </div>
              <div class="idea-actions">
                <a class="idea-button idea-button--light" href="/mypage/address?addressId={{ address.addressId }}">編集</a>
                <form method="post" action="/mypage/address" class="idea-address-delete-form">
                  <input type="hidden" name="_method" value="delete">
                  <input type="hidden" name="addressId" value="{{ address.addressId }}">
                  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                  <button type="submit" class="idea-text-button" aria-label="{{ address.name01 }} {{ address.name02 }} のお届け先を削除">削除</button>
                </form>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

    {% else %}
      <div class="idea-empty">
        <p class="idea-eyebrow">No addresses saved</p>
        <h2>お届け先がまだ登録されていません。</h2>
        <p class="idea-muted">よく利用するお届け先を登録しておくと、次回の注文がスムーズになります。</p>
        <a class="idea-button" href="/mypage/address">お届け先を追加する</a>
      </div>
    {% endif %}

  </div>

</section>
{% endblock %}
