{#
  BeMart — account nav partial.

  Included by every Mypage page. Does not extend a layout.
  Variables supplied by the including template:
    mypageno  string  active section key: index | favorite | change | delivery | withdraw
    name01    string  given name from resource body (Mypage.onGet → MypageFetched.name01)
    name02    string  family name from resource body (Mypage.onGet → MypageFetched.name02)

  Navigation items derive from Mypage.php #[Link] declarations:
    goMypage              /mypage
    goFavoriteList        /mypage/favorite-list
    goMypageChange        /mypage/change
    goCustomerAddressList /mypage/address-list
    goMypageWithdraw      /mypage/withdraw
#}
<nav class="idea-account-nav" aria-label="アカウントメニュー">
  <ul class="idea-account-nav__list" role="list">

    <li class="idea-account-nav__item{% if mypageno|default('') == 'index' %} is-active{% endif %}">
      <a href="/mypage" rel="goMypage">注文履歴</a>
    </li>

    <li class="idea-account-nav__item{% if mypageno|default('') == 'favorite' %} is-active{% endif %}">
      <a href="/mypage/favorite-list" rel="goFavoriteList">お気に入り</a>
    </li>

    <li class="idea-account-nav__item{% if mypageno|default('') == 'change' %} is-active{% endif %}">
      <a href="/mypage/change" rel="goMypageChange">会員情報</a>
    </li>

    <li class="idea-account-nav__item{% if mypageno|default('') == 'delivery' %} is-active{% endif %}">
      <a href="/mypage/address-list" rel="goCustomerAddressList">お届け先</a>
    </li>

    <li class="idea-account-nav__item{% if mypageno|default('') == 'withdraw' %} is-active{% endif %}">
      <a href="/mypage/withdraw" rel="goMypageWithdraw">退会</a>
    </li>

  </ul>
</nav>

<div class="idea-account-welcome">
  <span class="idea-eyebrow">アカウント</span>
  <p class="idea-account-welcome__name">
    {{ name01|default('') }}{{ name02|default('') }}
  </p>
</div>
