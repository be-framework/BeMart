{#
  BeMart アカウント情報変更完了ページ — goMypageChangeComplete。

  このページは IdeaStore 設計言語で独自構築したクリーンルーム実装。
  EC-CUBE の DOM 構造・クラス名・文言は使用していない。

  データ契約 (src/Resource/Page/Mypage/ChangeComplete.php):
    - transitionId: goMypageChangeComplete
    - fields: [] (空)
    - submitTo: null
    - staticContent.page / staticContent.title
    - #[Link] rel=goTop      href=page://self/
    - #[Link] rel=goMypage   href=page://self/mypage

  フォームなし・送信なし。変更完了の確認メッセージと
  マイページへ戻るリンクのみを描画する静的確認画面。

  アカウントナビゲーションは IdeaStore の idea-account-nav パターンを使用。
  現在位置は "会員情報の変更" にあたるので change リンクをアクティブとする。
#}
{% extends 'IdeaStore/layout/base.html.twig' %}

{% block title %}会員情報の変更完了 | IDEA STORE{% endblock %}

{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="パンくずリスト">
  <a href="/">Home</a><span>/</span>
  <a href="/mypage">マイページ</a><span>/</span>
  <span>会員情報の変更</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-change-complete-title">
  <div>
    <p class="idea-eyebrow">Profile updated</p>
    <h1 id="idea-change-complete-title" class="idea-title idea-title--compact">会員情報を更新しました</h1>
    <p class="idea-muted">変更内容が保存されました。引き続きご利用ください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Account</span>
    <strong>変更完了</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<section class="idea-container idea-section idea-account-layout">

  <nav class="idea-account-nav" aria-label="マイページメニュー">
    <p class="idea-eyebrow">Account menu</p>
    <ul class="idea-account-nav__list">
      <li><a href="/mypage">注文履歴</a></li>
      <li><a href="/mypage/favorite-list">お気に入り</a></li>
      <li class="is-active"><a href="/mypage/change">会員情報の変更</a></li>
      <li><a href="/mypage/address-list">お届け先の管理</a></li>
      <li><a href="/mypage/withdraw">退会手続き</a></li>
    </ul>
  </nav>

  <div class="idea-account-main">
    <div class="idea-checkout-panel idea-change-complete">
      <div class="idea-panel-head">
        <div>
          <p class="idea-eyebrow">Completed</p>
          <h2 class="idea-section-title">変更が完了しました</h2>
        </div>
      </div>
      <p class="idea-muted">会員情報の変更が保存されました。引き続きお買い物をお楽しみください。</p>
      <div class="idea-form-actions">
        <a class="idea-button" href="/mypage">マイページへ戻る</a>
        <a class="idea-link" href="/">トップページへ</a>
      </div>
    </div>
  </div>

</section>
{% endblock %}
