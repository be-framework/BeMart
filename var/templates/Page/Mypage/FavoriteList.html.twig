{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お気に入り | IDEA STORE{% endblock %}
{% block content %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/mypage">マイページ</a><span>/</span><span>お気に入り</span>
</nav>

<section class="idea-container idea-section idea-section--tight" aria-labelledby="idea-favorite-title">
  <div class="idea-section-head">
    <div>
      <p class="idea-eyebrow">My Favorites</p>
      <h1 id="idea-favorite-title" class="idea-section-title">お気に入り一覧</h1>
    </div>
    {% if favoriteCount|default(0) > 0 %}
      <span class="idea-muted">{{ favoriteCount }} 件</span>
    {% endif %}
  </div>

  {% if favoriteCount|default(0) > 0 %}
    <ul class="idea-grid idea-product-grid" aria-label="お気に入り商品">
      {% for item in favorites %}
        {% set imageSrc = item.fileName
          ? '/save_image/' ~ item.fileName
          : '/assets/idea-store/images/product/product-01.svg' %}
        <li>
          <article class="idea-card idea-product-card idea-favorite-item">
            <a class="idea-product-card-media" href="/product?productCode={{ item.productCode }}" aria-label="{{ item.productName }} の詳細">
              <img src="{{ imageSrc }}" alt="{{ item.productName }}" loading="lazy">
            </a>
            <span class="idea-card-body">
              <span class="idea-card-kicker">{{ item.productCode }}</span>
              <strong class="idea-card-title">{{ item.productName }}</strong>
              <span class="idea-price">¥{{ item.unitPrice|number_format }}</span>
              <span class="idea-card-bottom">
                <a class="idea-link" href="/product?productCode={{ item.productCode }}">詳細を見る</a>
                <form method="post" action="/mypage/favorite">
                  <input type="hidden" name="_method" value="delete">
                  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
                  <input type="hidden" name="productCode" value="{{ item.productCode }}">
                  <button class="idea-text-button" type="submit" aria-label="{{ item.productName }} をお気に入りから削除">削除</button>
                </form>
              </span>
            </span>
          </article>
        </li>
      {% endfor %}
    </ul>

    <div class="idea-actions" style="margin-top:2rem;">
      <a class="idea-button idea-button--light" href="/products/list">商品を探す</a>
      <a class="idea-link" href="/mypage">マイページへ戻る</a>
    </div>

  {% else %}
    <div class="idea-empty" aria-live="polite">
      <p class="idea-eyebrow">No favorites yet</p>
      <h2>お気に入りに商品はありません。</h2>
      <p class="idea-muted">気になった商品は商品詳細ページからお気に入りに追加できます。</p>
      <div class="idea-actions">
        <a class="idea-button" href="/products/list">商品を見る</a>
        <a class="idea-link" href="/mypage">マイページへ戻る</a>
      </div>
    </div>
  {% endif %}

</section>
{% endblock %}
