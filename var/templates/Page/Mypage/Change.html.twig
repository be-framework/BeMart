{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}会員情報の編集 | IDEA STORE{% endblock %}
{% block content %}

{# Account nav — active tab: change #}
{% set mypageNav = [
  { key: 'index',    label: '注文履歴',       href: '/mypage' },
  { key: 'favorite', label: 'お気に入り',     href: '/mypage/favorite-list' },
  { key: 'change',   label: '会員情報の編集', href: '/mypage/change' },
  { key: 'delivery', label: 'お届け先',       href: '/mypage/address-list' },
  { key: 'withdraw', label: '退会手続き',     href: '/mypage/withdraw' },
] %}

<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span>
  <a href="/mypage">マイページ</a><span>/</span>
  <span>会員情報の編集</span>
</nav>

<section class="idea-container" style="padding-top:clamp(1.4rem,3vw,2.5rem);">
  <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:start;">
    <div>
      <p class="idea-eyebrow">Account profile</p>
      <h1 class="idea-title idea-title--compact">会員情報の編集</h1>
      <p class="idea-muted">お名前・住所・メールアドレス・パスワード等を変更できます。</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:.5rem;align-items:flex-end;padding-top:.5rem;">
      {% for nav in mypageNav %}
        <a href="{{ nav.href }}"
           style="font-size:.86rem;font-weight:{% if nav.key == 'change' %}900{% else %}700{% endif %};color:{% if nav.key == 'change' %}var(--idea-ink){% else %}var(--idea-muted){% endif %};">
          {{ nav.label }}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="idea-container idea-section idea-section--tight">
  <form class="h-adr" method="post" action="/mypage/change" novalidate>
    <span class="p-country-name" aria-hidden="true">Japan</span>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-checkout-main" style="max-width:780px;">

      {# 氏名 #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Name</p>
            <h2 class="idea-section-title">お名前</h2>
          </div>
        </div>
        <div class="idea-form-grid idea-form-grid--two">
          <label class="idea-field">姓
            {{ form.input('name01')|raw }}
            <span class="idea-form-error">{{ form.error('name01') }}</span>
          </label>
          <label class="idea-field">名
            {{ form.input('name02')|raw }}
            <span class="idea-form-error">{{ form.error('name02') }}</span>
          </label>
          <label class="idea-field">セイ（カナ）
            {{ form.input('kana01')|raw }}
            <span class="idea-form-error">{{ form.error('kana01') }}</span>
          </label>
          <label class="idea-field">メイ（カナ）
            {{ form.input('kana02')|raw }}
            <span class="idea-form-error">{{ form.error('kana02') }}</span>
          </label>
        </div>
      </div>

      {# 会社名 #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Organization</p>
            <h2 class="idea-section-title">会社名（任意）</h2>
          </div>
        </div>
        <div class="idea-form-grid">
          <label class="idea-field idea-field--full">会社名
            {{ form.input('companyName')|raw }}
            <span class="idea-form-error">{{ form.error('companyName') }}</span>
          </label>
        </div>
      </div>

      {# 住所 #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Address</p>
            <h2 class="idea-section-title">住所</h2>
          </div>
        </div>
        <div class="idea-form-grid">
          <label class="idea-field">郵便番号
            {{ form.input('postalCode')|raw }}
            <span class="idea-form-error">{{ form.error('postalCode') }}</span>
          </label>
          <label class="idea-field">都道府県
            {{ form.input('pref')|raw }}
            <span class="idea-form-error">{{ form.error('pref') }}</span>
          </label>
          <label class="idea-field idea-field--full">市区町村
            {{ form.input('addr01')|raw }}
            <span class="idea-form-error">{{ form.error('addr01') }}</span>
          </label>
          <label class="idea-field idea-field--full">番地・建物名
            {{ form.input('addr02')|raw }}
            <span class="idea-form-error">{{ form.error('addr02') }}</span>
          </label>
        </div>
      </div>

      {# 電話番号 #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Phone</p>
            <h2 class="idea-section-title">電話番号</h2>
          </div>
        </div>
        <div class="idea-form-grid">
          <label class="idea-field">電話番号
            {{ form.input('phoneNumber')|raw }}
            <span class="idea-form-error">{{ form.error('phoneNumber') }}</span>
          </label>
        </div>
      </div>

      {# メールアドレス #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Email</p>
            <h2 class="idea-section-title">メールアドレス</h2>
          </div>
        </div>
        <div class="idea-form-grid">
          <label class="idea-field idea-field--full">メールアドレス
            {{ form.input('email')|raw }}
            <span class="idea-form-error">{{ form.error('email') }}</span>
          </label>
          <label class="idea-field idea-field--full">メールアドレス（確認）
            {{ form.input('email_confirm')|raw }}
            <span class="idea-form-error">{{ form.error('email_confirm') }}</span>
          </label>
        </div>
      </div>

      {# パスワード #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Password</p>
            <h2 class="idea-section-title">パスワード</h2>
          </div>
        </div>
        <p class="idea-muted" style="margin:0 0 .75rem;font-size:.88rem;">変更しない場合は空白のままにしてください。</p>
        <div class="idea-form-grid">
          <label class="idea-field idea-field--full">新しいパスワード
            {{ form.input('password')|raw }}
            <span class="idea-form-error">{{ form.error('password') }}</span>
          </label>
          <label class="idea-field idea-field--full">新しいパスワード（確認）
            {{ form.input('password_confirm')|raw }}
            <span class="idea-form-error">{{ form.error('password_confirm') }}</span>
          </label>
        </div>
      </div>

      {# 生年月日 #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Date of birth</p>
            <h2 class="idea-section-title">生年月日（任意）</h2>
          </div>
        </div>
        <div class="idea-form-grid idea-form-grid--three">
          <label class="idea-field">年
            {{ form.input('birth_year')|raw }}
            <span class="idea-form-error">{{ form.error('birth_year') }}</span>
          </label>
          <label class="idea-field">月
            {{ form.input('birth_month')|raw }}
            <span class="idea-form-error">{{ form.error('birth_month') }}</span>
          </label>
          <label class="idea-field">日
            {{ form.input('birth_day')|raw }}
            <span class="idea-form-error">{{ form.error('birth_day') }}</span>
          </label>
        </div>
      </div>

      {# 性別 #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Gender</p>
            <h2 class="idea-section-title">性別（任意）</h2>
          </div>
        </div>
        <div class="idea-option-list">
          {{ form.input('sex')|raw }}
        </div>
        <span class="idea-form-error">{{ form.error('sex') }}</span>
      </div>

      {# 職業 #}
      <div class="idea-checkout-panel">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Occupation</p>
            <h2 class="idea-section-title">職業（任意）</h2>
          </div>
        </div>
        <div class="idea-form-grid">
          <label class="idea-field">職業
            {{ form.input('job')|raw }}
            <span class="idea-form-error">{{ form.error('job') }}</span>
          </label>
        </div>
      </div>

      {# 送信 #}
      <div class="idea-form-actions">
        <button type="submit" class="idea-button">変更を保存する</button>
        <a href="/mypage" class="idea-muted" style="font-size:.9rem;">マイページへ戻る</a>
      </div>

    </div>
  </form>
</section>

{% endblock %}
