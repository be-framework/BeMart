{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お問い合わせ完了 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/contact">お問い合わせ</a><span>/</span><span>完了</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-contact-complete-title">
  <div>
    <p class="idea-eyebrow">Inquiry sent</p>
    <h1 id="idea-contact-complete-title" class="idea-title idea-title--compact">お問い合わせを受け付けました</h1>
    <p class="idea-muted">内容を確認のうえ、担当者よりご連絡差し上げます。確認メールをお送りしましたのでご確認ください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Inquiry</span>
    <strong>IDEA STORE</strong>
    <small>受付完了</small>
  </div>
</section>

<section class="idea-container idea-section idea-section--tight">
  <div class="idea-checkout-panel" role="region" aria-label="受付情報">
    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Receipt</p>
        <h2 class="idea-section-title">受付完了</h2>
      </div>
    </div>

    <p>お問い合わせありがとうございます。内容を確認のうえ、折り返しご連絡いたします。</p>

    {% if ticketId is defined and ticketId %}
    <dl class="idea-spec-list" aria-label="受付番号">
      <div class="idea-spec-row">
        <dt>受付番号</dt>
        <dd><strong>{{ ticketId }}</strong></dd>
      </div>
    </dl>
    {% endif %}

    <div class="idea-form-actions" style="margin-top: 2rem;">
      <a class="idea-button" href="/" rel="goTop">トップページへ戻る</a>
    </div>
  </div>
</section>
{% endblock %}
