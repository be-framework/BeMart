{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}お問い合わせ内容の確認 | IDEA STORE{% endblock %}

{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/contact">お問い合わせ</a><span>/</span><span>確認</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-contact-confirm-title">
  <div>
    <p class="idea-eyebrow">Confirm your inquiry</p>
    <h1 id="idea-contact-confirm-title" class="idea-title idea-title--compact">お問い合わせ内容の確認</h1>
    <p class="idea-muted">以下の内容でよろしければ「送信する」を押してください。修正する場合は「戻る」を押してください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Inquiry review</span>
    <strong>IDEA STORE</strong>
    <small>内容を確認してから送信してください</small>
  </div>
</section>

<section class="idea-container idea-section">
  <form class="idea-checkout-panel" method="post" action="/contact" novalidate>
    <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

    <div class="idea-panel-head">
      <div>
        <p class="idea-eyebrow">Your details</p>
        <h2 class="idea-section-title">お問い合わせ内容</h2>
      </div>
    </div>

    <dl class="idea-info-list">
      <div>
        <dt>お名前</dt>
        <dd>{{ contactName01|default('') }}{% if contactName02|default('') %} {{ contactName02 }}{% endif %}</dd>
      </div>
      <div>
        <dt>メールアドレス</dt>
        <dd>{{ contactEmail|default('') }}</dd>
      </div>
      <div>
        <dt>お問い合わせ内容</dt>
        <dd>{{ contactContents|default('')|nl2br }}</dd>
      </div>
    </dl>

    {# Hidden carriers: forward submitted values to doSubmitContact #}
    {% if form is defined %}
      {{ form.input('contactName01')|raw }}
      {{ form.input('contactName02')|raw }}
      {{ form.input('contactEmail')|raw }}
      {{ form.input('contactContents')|raw }}
    {% endif %}

    <div class="idea-form-actions">
      <button class="idea-button idea-button--wide" type="submit" name="mode" value="complete">送信する</button>
      <button class="idea-button idea-button--wide idea-button--light" type="submit" name="mode" value="back">戻る</button>
    </div>
  </form>
</section>
{% endblock %}
