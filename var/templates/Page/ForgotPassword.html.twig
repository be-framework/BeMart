{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}パスワード再発行 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><span>パスワード再発行</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-forgot-title">
  <div>
    <p class="idea-eyebrow">Account recovery</p>
    <h1 id="idea-forgot-title" class="idea-title idea-title--compact">パスワード再発行</h1>
    <p class="idea-muted">ご登録のメールアドレスを入力してください。パスワードを再設定するためのご案内をお送りします。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Secure</span>
    <strong>Reset link</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<section class="idea-container idea-section">
  <article class="idea-checkout-panel idea-auth-panel">
    <p class="idea-eyebrow">Password reset</p>
    <h2 class="idea-section-title">メールアドレスを入力</h2>
    <p class="idea-muted">登録済みのメールアドレスに再設定リンクを送信します。メールが届かない場合はアドレスをご確認の上、再度お試しください。</p>

    <form class="idea-auth-form" method="post" action="/forgot-password" novalidate>
      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">

      <label class="idea-field">メールアドレス
        {% if form is defined %}
          {{ form.input('email')|raw }}
          <span class="idea-form-error">{{ form.error('email') }}</span>
        {% else %}
          <input type="text" name="email" autocomplete="email" placeholder="メールアドレス">
        {% endif %}
      </label>

      <button class="idea-button idea-button--wide" type="submit">再設定リンクを送る</button>

      <div class="idea-auth-links">
        <a class="idea-link" href="/login">ログインはこちら</a>
      </div>
    </form>
  </article>
</section>
{% endblock %}
