{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}マイページ | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><span>マイページ</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-mypage-title">
  <div>
    <p class="idea-eyebrow">My account</p>
    <h1 id="idea-mypage-title" class="idea-title idea-title--compact">{{ name01|default('') }} {{ name02|default('') }} さんのページ</h1>
    <p class="idea-muted">{{ email|default('') }}</p>
  </div>
  <div class="idea-checkout-status">
    <span>{{ recentOrderCount|default(0) }} 件の注文</span>
    <strong>お気に入り {{ favoriteCount|default(0) }} 件</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<section class="idea-container idea-section idea-account-layout">

  <nav class="idea-account-nav" aria-label="マイページメニュー">
    <p class="idea-eyebrow">Account menu</p>
    <ul class="idea-account-nav__list">
      <li class="is-active"><a href="/mypage">注文履歴</a></li>
      <li><a href="/mypage/favorite-list">お気に入り</a></li>
      <li><a href="/mypage/change">会員情報の変更</a></li>
      <li><a href="/mypage/address-list">お届け先の管理</a></li>
      <li><a href="/mypage/withdraw">退会手続き</a></li>
    </ul>
  </nav>

  <div class="idea-account-main">

    {% if recentOrderCount|default(0) > 0 %}
      <div class="idea-panel-head">
        <div>
          <p class="idea-eyebrow">Order history</p>
          <h2 class="idea-section-title">最近の注文</h2>
        </div>
        <a class="idea-link" href="/mypage/history">すべての履歴を見る</a>
      </div>

      <div class="idea-order-list">
        {% for order in recentOrders|default([]) %}
          <article class="idea-checkout-panel idea-order-card">
            <div class="idea-panel-head">
              <div>
                <p class="idea-eyebrow">注文番号 {{ order.orderNo }}</p>
                <h3 class="idea-section-title">{{ order.orderDate }}</h3>
              </div>
              <div class="idea-order-card__summary">
                <strong>¥{{ order.total|number_format }}</strong>
                <span class="idea-muted">ステータス {{ order.orderStatus }}</span>
                <a class="idea-link" href="/mypage/history?orderNo={{ order.orderNo }}">詳細</a>
              </div>
            </div>

            {% if order.items|default([])|length > 0 %}
              <div class="idea-order-items">
                {% for item in order.items %}
                  <div class="idea-order-item">
                    <div class="idea-order-item__body">
                      <p class="idea-card-kicker">{{ item.productCode }}</p>
                      <p class="idea-order-item__name">{{ item.productName }}</p>
                      <p class="idea-muted">¥{{ item.unitPrice|number_format }} × {{ item.quantity }}</p>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

    {% else %}
      <div class="idea-empty">
        <p class="idea-eyebrow">No orders yet</p>
        <h2>注文履歴はまだありません。</h2>
        <p class="idea-muted">暮らしの入口から、気になる道具を見つけてください。</p>
        <a class="idea-button" href="/products">商品を探す</a>
      </div>
    {% endif %}

  </div>

</section>
{% endblock %}
