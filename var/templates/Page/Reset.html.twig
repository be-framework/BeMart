{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}パスワード再設定 | IDEA STORE{% endblock %}
{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="breadcrumb">
  <a href="/">Home</a><span>/</span><a href="/login" rel="goLogin">ログイン</a><span>/</span><span>パスワード再設定</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-reset-title">
  <div>
    <p class="idea-eyebrow">Password reset</p>
    <h1 id="idea-reset-title" class="idea-title idea-title--compact">パスワード再設定</h1>
    <p class="idea-muted">新しいパスワードを入力してください。8文字以上32文字以下の半角英数字・記号で設定できます。</p>
  </div>
  <div class="idea-checkout-status">
    <span>Secure</span>
    <strong>New password</strong>
    <small>IDEA STORE</small>
  </div>
</section>

<section class="idea-container idea-section">
  <article class="idea-checkout-panel idea-auth-panel">
    <p class="idea-eyebrow">Account security</p>
    <h2 class="idea-section-title">新しいパスワードを設定</h2>

    {% if message is defined and message %}
      <p class="idea-form-error" role="alert">{{ message }}</p>
    {% endif %}

    <form class="idea-auth-form" method="post" action="/reset" novalidate>
      <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
      <input type="hidden" name="resetKey" value="{{ resetKey|default('') }}">

      <label class="idea-field">メールアドレス
        {% if form is defined %}
          {{ form.input('email')|raw }}
          <span class="idea-form-error">{{ form.error('email') }}</span>
        {% else %}
          <input type="text" name="email" autocomplete="email" placeholder="ご登録のメールアドレス">
        {% endif %}
      </label>

      <label class="idea-field">新しいパスワード
        {% if form is defined %}
          {{ form.input('password')|raw }}
          <span class="idea-form-error">{{ form.error('password') }}</span>
        {% else %}
          <input type="password" name="password" autocomplete="new-password" placeholder="半角英数記号8〜32文字">
        {% endif %}
      </label>

      <label class="idea-field">新しいパスワード（確認）
        {% if form is defined %}
          {{ form.input('password_confirm')|raw }}
          <span class="idea-form-error">{{ form.error('password_confirm') }}</span>
        {% else %}
          <input type="password" name="password_confirm" autocomplete="new-password" placeholder="確認のためもう一度入力してください">
        {% endif %}
      </label>

      <button class="idea-button idea-button--wide" type="submit">パスワードを変更する</button>

      <div class="idea-auth-links">
        <a class="idea-link" href="/login" rel="goLogin">ログインページへ戻る</a>
      </div>
    </form>
  </article>
</section>
{% endblock %}
