{% extends 'IdeaStore/layout/base.html.twig' %}

{% block title %}当サイトについて | IDEA STORE{% endblock %}

{% block content %}
<div class="idea-container">

  <nav class="idea-breadcrumb" aria-label="パンくずリスト">
    <a href="/">トップ</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">当サイトについて</span>
  </nav>

  <section class="idea-section idea-section--tight" aria-labelledby="idea-about-title">
    <header class="idea-section-head">
      <h1 class="idea-section-title" id="idea-about-title">
        {{ staticContent.title|default('当サイトについて') }}
      </h1>
    </header>

    {% if staticContent.sections is not empty %}
      <dl class="idea-spec-list" id="idea-about-sections">
        {% for section in staticContent.sections %}
          <div class="idea-spec-row">
            <dt>{{ section.title|default('') }}</dt>
            <dd>
              {% if section.body is defined and section.body is not empty %}
                {{ section.body|nl2br }}
              {% elseif section.content is defined and section.content is not empty %}
                {{ section.content|nl2br }}
              {% endif %}
            </dd>
          </div>
        {% endfor %}
      </dl>
    {% else %}
      <p class="idea-muted" id="idea-about-empty">
        ショップ情報は準備中です。
      </p>
    {% endif %}

    <div class="idea-actions" style="margin-top:2rem;">
      <a class="idea-button idea-button--light" href="/" rel="goTop">トップへ戻る</a>
    </div>
  </section>

</div>
{% endblock %}
