{% extends 'IdeaStore/layout/base.html.twig' %}

{% block title %}特定商取引法に基づく表記 | IDEA STORE{% endblock %}

{% block content %}
<nav class="idea-container idea-breadcrumb" aria-label="パンくずリスト">
  <a href="/">Home</a>
  <span aria-hidden="true">/</span>
  <span aria-current="page">特定商取引法に基づく表記</span>
</nav>

<section class="idea-container idea-section idea-section--tight" aria-labelledby="idea-tradelaw-title">
  <header>
    <p class="idea-eyebrow">Specified Commercial Transactions Act</p>
    <h1 id="idea-tradelaw-title" class="idea-section-title">
      {{ staticContent.title|default('特定商取引法に基づく表記') }}
    </h1>
  </header>

  {% if staticContent.sections is defined and staticContent.sections|length > 0 %}
    <dl class="idea-spec-list" id="idea-tradelaw-sections">
      {% for section in staticContent.sections %}
        <div class="idea-spec-row">
          {% if section.title is defined and section.title %}
            <dt>{{ section.title }}</dt>
          {% else %}
            <dt></dt>
          {% endif %}
          <dd>
            {% if section.body is defined and section.body %}
              {{ section.body|nl2br }}
            {% elseif section.content is defined and section.content %}
              {{ section.content|nl2br }}
            {% endif %}
          </dd>
        </div>
      {% endfor %}
    </dl>
  {% else %}
    <p class="idea-muted" id="idea-tradelaw-empty">
      表記情報は準備中です。
    </p>
  {% endif %}

  <div class="idea-actions" style="margin-top:2rem;">
    <a class="idea-button idea-button--light" href="/" rel="goTop">トップへ戻る</a>
  </div>
</section>
{% endblock %}
