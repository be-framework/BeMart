{% extends 'IdeaStore/layout/base.html.twig' %}
{% block title %}ご注文手続き | IDEA STORE{% endblock %}
{% block content %}
{% set progress = [
  { label: 'カート',        state: '' },
  { label: 'ログイン',      state: '' },
  { label: 'お届け先',      state: '' },
  { label: 'ご注文情報',    state: 'is-active' },
  { label: '確認・完了',    state: '' }
] %}

<nav class="idea-container idea-breadcrumb" aria-label="現在地">
  <a href="/">ホーム</a><span>/</span>
  <a rel="goCart" href="/cart">カート</a><span>/</span>
  <span>ご注文情報</span>
</nav>

<section class="idea-container idea-checkout-hero" aria-labelledby="idea-shopping-heading">
  <div>
    <p class="idea-eyebrow">Checkout</p>
    <h1 id="idea-shopping-heading" class="idea-title idea-title--compact">
      <span class="idea-title-line">届け先と、</span>
      <span class="idea-title-line">お支払いを。</span>
    </h1>
    <p class="idea-muted">お届け先・配送方法・お支払方法をご確認のうえ、次の画面へお進みください。</p>
  </div>
  <div class="idea-checkout-status">
    <span>{{ canCheckout|default(false) ? 'Ready' : 'Empty' }}</span>
    <strong>¥{{ (totalPrice|default(0) + deliveryFeeTotal|default(0))|number_format }}</strong>
    <small>税込・送料込</small>
  </div>
</section>

<nav class="idea-container idea-checkout-progress" aria-label="購入ステップ">
  {% for step in progress %}
    <span class="{{ step.state }}"><b>{{ loop.index }}</b>{{ step.label }}</span>
  {% endfor %}
</nav>

{% if not canCheckout|default(false) %}
<section class="idea-container idea-section">
  <div class="idea-empty">
    <p class="idea-eyebrow">Your cart is empty</p>
    <h2 class="idea-section-title">カートに商品がありません</h2>
    <p class="idea-muted">商品をカートに追加してからお手続きください。</p>
    <a class="idea-button" rel="goCart" href="/cart">カートへ戻る</a>
  </div>
</section>
{% else %}

<form id="shopping-form" method="post" action="/shopping/confirm" novalidate>
  <input type="hidden" name="csrfToken" value="{{ csrfToken|default('') }}">
  <input type="hidden" name="preOrderId" value="{{ preOrderId|default('') }}">

  <section class="idea-container idea-section idea-checkout-layout">
    <div class="idea-checkout-main">

      {# ── お客様情報 ───────────────────────────────────────────── #}
      <article class="idea-checkout-panel" aria-labelledby="idea-account-heading">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Your account</p>
            <h2 id="idea-account-heading" class="idea-section-title">お客様情報</h2>
          </div>
        </div>
        <div class="idea-info-list">
          <p><strong>{{ name01|default('') }} {{ name02|default('') }}</strong></p>
          <p>{{ email|default('') }}</p>
        </div>
      </article>

      {# ── お届け先・配送設定 ──────────────────────────────────── #}
      <article class="idea-checkout-panel" aria-labelledby="idea-delivery-heading">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Delivery</p>
            <h2 id="idea-delivery-heading" class="idea-section-title">お届け先・配送</h2>
          </div>
        </div>

        {% if defaultShippingAddress is not null %}
          <address class="idea-info-list">
            <p>〒{{ defaultShippingAddress.postalCode|default('') }}</p>
            <p>{{ defaultShippingAddress.addr01|default('') }}{{ defaultShippingAddress.addr02|default('') }}</p>
            <p>{{ defaultShippingAddress.phoneNumber|default('') }}</p>
          </address>
        {% endif %}

        <div class="idea-panel-head idea-panel-head--inner">
          <div>
            <p class="idea-eyebrow">Shipping method</p>
            <h3 class="idea-section-title">配送方法・日時</h3>
          </div>
        </div>
        <div class="idea-form-grid idea-form-grid--three">
          <label class="idea-field">配送方法
            {{ form.input('delivery')|raw }}
            <span class="idea-form-error">{{ form.error('delivery') }}</span>
          </label>
          <label class="idea-field">お届け日
            {{ form.input('shipping_delivery_date')|raw }}
            <span class="idea-form-error">{{ form.error('shipping_delivery_date') }}</span>
          </label>
          <label class="idea-field">お届け時間帯
            {{ form.input('delivery_time')|raw }}
            <span class="idea-form-error">{{ form.error('delivery_time') }}</span>
          </label>
        </div>
      </article>

      {# ── お支払方法 ──────────────────────────────────────────── #}
      <article class="idea-checkout-panel" aria-labelledby="idea-payment-heading">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Payment</p>
            <h2 id="idea-payment-heading" class="idea-section-title">お支払方法</h2>
          </div>
        </div>
        <div class="idea-option-list">
          {% for payment in paymentMethods|default([]) %}
            <label class="idea-option-card">
              <input type="radio" name="payment" value="{{ payment.paymentMethodId }}">
              <span>{{ payment.paymentMethodName }}</span>
            </label>
          {% endfor %}
        </div>
        <span class="idea-form-error">{{ form.error('payment') }}</span>
      </article>

      {# ── お問い合わせ ────────────────────────────────────────── #}
      <article class="idea-checkout-panel" aria-labelledby="idea-message-heading">
        <div class="idea-panel-head">
          <div>
            <p class="idea-eyebrow">Notes</p>
            <h2 id="idea-message-heading" class="idea-section-title">ご要望・ご連絡</h2>
          </div>
        </div>
        <div class="idea-form-grid">
          <label class="idea-field idea-field--full">ご要望（任意）
            {{ form.input('message')|raw }}
            <span class="idea-form-error">{{ form.error('message') }}</span>
          </label>
        </div>
      </article>

      {# ── カート内容（明細） ──────────────────────────────────── #}
      {% for cart in carts|default([]) %}
        {% if cart.items|default([])|length > 0 %}
          <article class="idea-checkout-panel idea-cart-panel" aria-labelledby="idea-cart-heading-{{ loop.index }}">
            <div class="idea-panel-head">
              <div>
                <p class="idea-eyebrow">{{ cart.saleTypeName|default('通常販売') }}</p>
                <h2 id="idea-cart-heading-{{ loop.index }}" class="idea-section-title">ご注文商品</h2>
              </div>
              <span class="idea-panel-total">¥{{ cart.totalPrice|default(0)|number_format }}</span>
            </div>
            <div class="idea-cart-list">
              {% for item in cart.items|default([]) %}
                <div class="idea-mini-cart">
                  <div>
                    <span>{{ item.productCode }}</span>
                    <strong>× {{ item.quantity|default(1)|number_format }}</strong>
                  </div>
                  <strong>¥{{ (item.price|default(0) * item.quantity|default(1))|number_format }}</strong>
                </div>
              {% endfor %}
            </div>
          </article>
        {% endif %}
      {% endfor %}

    </div>

    {# ── 注文概要サイドパネル ────────────────────────────────── #}
    <aside class="idea-summary-panel" aria-label="注文概要">
      <p class="idea-eyebrow">Order summary</p>
      <dl>
        <div>
          <dt>商品合計</dt>
          <dd>¥{{ totalPrice|default(0)|number_format }}</dd>
        </div>
        <div>
          <dt>送料</dt>
          <dd>¥{{ deliveryFeeTotal|default(0)|number_format }}</dd>
        </div>
        <div class="idea-summary-total">
          <dt>合計（税込）</dt>
          <dd>¥{{ (totalPrice|default(0) + deliveryFeeTotal|default(0))|number_format }}</dd>
        </div>
      </dl>
      <button class="idea-button idea-button--wide" type="submit">注文内容を確認する</button>
      <a class="idea-link idea-summary-link" rel="goCart" href="/cart">カートへ戻る</a>
      <p class="idea-summary-note idea-muted">注文内容は次の画面でご確認いただけます。</p>
    </aside>

  </section>
</form>

{% endif %}
{% endblock %}
