{#
  BeMart shared storefront layout.

  PORT of EC-CUBE 4.3 default-theme `default_frame.twig`
  (src/Eccube/Resource/template/default/default_frame.twig).

  ALPS carries no presentation, so the honest reference for the
  presentation layer is EC-CUBE's own default-theme templates. This file
  keeps EC-CUBE's markup skeleton and `ec-*` class names verbatim; only
  the EC-CUBE-runtime bindings are rebound. See var/templates/README.md
  for the port method + residual-diff verification standard.

  EC-CUBE-ism rebinding (documented; see README):
   - `{{ '...'|trans }}`  -> Japanese literal the key resolves to in
     messages.ja.yaml. BeMart has no translation layer; substituting the
     literal is the lower-noise option (no Twig extension to register).
   - `asset('x'[, pkg])`  -> static URL. BeMart has no asset-hash
     pipeline; BeMartTwigExtension::asset() ports EC-CUBE's asset PACKAGE
     map (default theme -> `/`, `admin` -> `/template/admin/`, `bundle` ->
     `/bundle/`) so the <link>/<script> markup keeps real, resolvable
     hrefs against the deployed `public/` tree.
   - `app.*`, `is_granted()`, `csrf_token()` — EC-CUBE runtime only.
     The CSRF <meta> and the `body id="page_{route}"` are rendered with
     stable BeMart-side values; enumerated as residual in the diff test.
   - `Layout.*` block regions (Header/Footer/SideLeft/...) — EC-CUBE's
     configurable layout blocks. A default EC-CUBE install wires a fixed
     set of Block widgets into the HEADER / FOOTER / DRAWER regions
     (dtb_block_position.csv). BeMart has no operator-configurable block
     system, but static first-slice Block widgets are ported under
     var/templates/Block/ and included directly here. Dynamic data is not
     invented: login renders the anonymous branch, cart renders an empty
     total, and category navigation exposes the key 商品一覧 link until
     category/cart/auth body enrichment lands.
#}
<!doctype html>
<html lang="ja">
<head prefix="og: https://ogp.me/ns# fb: https://ogp.me/ns/fb# product: https://ogp.me/ns/product#">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="eccube-csrf-token" content="{{ csrf_token|default(csrf_token('bemart')) }}">
    <title>{{ shop_name|default('BeMart') }}{% if title is defined and title is not empty %} / {{ title }}{% endif %}</title>
    <link rel="icon" href="{{ asset('assets/img/common/favicon.ico') }}">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.5.2/css/all.css" integrity="sha384-PPIZEGYM1v8zp5Py7UjFb79S58UeqCL9pYVnVPURKEqvioPROaVAJKKLzvH2rDnI" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
    <script src="{{ asset('front.bundle.js', 'bundle') }}"></script>
    {% block stylesheet %}{% endblock %}
    <link rel="stylesheet" href="{{ asset('assets/css/customize.css') }}">
</head>
<body id="page_{{ route|default('homepage') }}" class="{{ body_class|default('other_page') }}">

<div class="ec-layoutRole">
    {# Layout: HEADER — default EC-CUBE wires header / logo / category_nav_pc
       here. #}
    <header class="ec-layoutRole__header">
        {{ include('Block/header.html.twig') }}
        {{ include('Block/logo.html.twig') }}
        {{ include('Block/category_nav_pc.html.twig') }}
    </header>

    <div class="ec-layoutRole__contents">

        <main class="ec-layoutRole__main">

            {# MAIN AREA #}
            {% block main %}{% endblock %}

        </main>

    </div>

    {# Layout: FOOTER — default EC-CUBE wires the static `footer` widget
       here; ported directly as a Twig partial. #}
    <footer class="ec-layoutRole__footer">
        {{ include('Block/footer.html.twig') }}
    </footer>
</div><!-- ec-layoutRole -->

<div class="ec-overlayRole"></div>
<div class="ec-drawerRoleClose"><i class="fas fa-times"></i></div>
<div class="ec-drawerRole">
    {{ include('Block/login_sp.html.twig') }}
    {{ include('Block/category_nav_sp.html.twig') }}
</div>
<div class="ec-blockTopBtn pagetop">ページトップへ</div>
<script src="{{ asset('assets/js/function.js') }}"></script>
<script src="{{ asset('assets/js/eccube.js') }}"></script>
<script src="{{ asset('assets/js/bemart-unsupported.js') }}"></script>
{% block javascript %}{% endblock %}
    <script src="{{ asset('assets/js/customize.js') }}"></script>
</body>
</html>
