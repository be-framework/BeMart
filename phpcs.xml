<?xml version="1.0"?>
<ruleset name="BeMart">
    <description>BeMart Coding Standard</description>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="80"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg value="nps"/>

    <file>src</file>
    <file>public</file>
    <file>bin</file>

    <rule ref="Generic.PHP.ForbiddenFunctions">
        <!--
            getenv() is banned in application code (read the environment through
            injected values), but it is legitimate at the few seams that run
            before — or define — the DI container: DatabaseUrl is the single
            sanctioned environment reader, and page.php/bin/page.php are the
            composition-root entry scripts that pick the context from
            APP_CONTEXT before any object graph exists, so there is nothing to
            inject into.
        -->
        <exclude-pattern>*/src/Module/DatabaseUrl.php</exclude-pattern>
        <exclude-pattern>*/public/page.php</exclude-pattern>
        <exclude-pattern>*/bin/page.php</exclude-pattern>
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="getenv" value="null"/>
            </property>
        </properties>
    </rule>
</ruleset>
