{
    "name": "my-vendor/be-mart",
    "type": "project",
    "license": "MIT",
    "description": "BeMart — AI-driven EC-CUBE → BEAR.Sunday + Be Framework migration. BEAR.Sunday application layer.",
    "repositories": [
        {
            "type": "path",
            "url": "be",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "bear/sunday": "^1.6",
        "bear/package": "^1.14",
        "be-framework/be": "0.x-dev as 0.1.0",
        "my-vendor/be-mart-be": "@dev",
        "ray/di": "^2.18",
        "ray/input-query": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MyVendor\\BeMart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyVendor\\BeMart\\Tests\\": "tests/",
            "MyVendor\\BeMart\\Be\\Tests\\": "be/tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "stree": "ls -t var/log/*.json | head -1 | xargs -I{} vendor/bin/stree {}"
    },
    "config": {
        "sort-packages": true
    }
}
