{
  "type": "object",
  "required": ["id", "title", "goal", "packet", "workflow", "success_criteria", "priority"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "goal": { "type": "string" },
    "packet": { "type": "string" },
    "workflow": { "type": "string" },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "priority": { "type": "integer", "minimum": 0 },
    "queued_at": { "type": "string" },
    "source_path": { "type": "string" },
    "queue_status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed"]
    },
    "last_run_id": { "type": "string" }
  }
}
