{
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "step",
    "attempt",
    "status",
    "exit_code",
    "command",
    "cwd",
    "started_at",
    "finished_at",
    "stdout_path",
    "stderr_path",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "step": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["succeeded", "transition_failed", "failed", "manual_failed"]
    },
    "exit_code": { "type": "integer" },
    "command": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cwd": { "type": "string" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "stdout_path": { "type": "string" },
    "stderr_path": { "type": "string" },
    "message": { "type": "string" }
  }
}

