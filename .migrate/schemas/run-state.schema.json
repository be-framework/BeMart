{
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "workflow",
    "status",
    "current_step",
    "created_at",
    "updated_at",
    "planning_snapshot",
    "step_history"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "workflow": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["running", "failed", "completed"]
    },
    "current_step": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "plan_sync_required_since": { "type": "string" },
    "last_error": { "type": "string" },
    "active_step": {
      "type": "object",
      "required": ["name", "attempt", "started_at"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "started_at": { "type": "string" }
      }
    },
    "planning_snapshot": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "modified_at"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "modified_at": { "type": "string" }
        }
      }
    },
    "step_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "attempt", "status", "started_at"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "string" },
          "attempt": { "type": "integer", "minimum": 1 },
          "status": {
            "type": "string",
            "enum": ["running", "succeeded", "transition_failed", "failed", "abandoned", "manual_failed"]
          },
          "started_at": { "type": "string" },
          "finished_at": { "type": "string" },
          "exit_code": { "type": "integer" },
          "artifact_ref": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}

