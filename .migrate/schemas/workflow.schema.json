{
  "type": "object",
  "required": ["name", "version", "initial_step", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "initial_step": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "adapter", "on_success", "on_failure", "timeout_sec", "retry_policy"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "adapter": {
            "type": "object",
            "required": ["type", "command"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["command"] },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "cwd": { "type": "string" }
            }
          },
          "on_success": { "type": "string" },
          "on_failure": { "type": "string" },
          "timeout_sec": { "type": "integer", "minimum": 1 },
          "retry_policy": {
            "type": "object",
            "required": ["max_attempts"],
            "additionalProperties": false,
            "properties": {
              "max_attempts": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}

