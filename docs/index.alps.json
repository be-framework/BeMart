{
  "$schema": "https://alps-io.github.io/schemas/alps.json",
  "alps": {
    "version": "1.0",
    "title": "BeMart Documentation Index Profile",
    "doc": {
      "value": "Profile for the BeMart GitHub Pages index. The page is a small semantic entry point whose primary source of truth is the generated ALPS documentation."
    },
    "descriptor": [
      {
        "id": "projectIndex",
        "type": "semantic",
        "title": "Project documentation index"
      },
      {
        "id": "projectName",
        "type": "semantic",
        "title": "Project name"
      },
      {
        "id": "summary",
        "type": "semantic",
        "title": "Short project summary"
      },
      {
        "id": "primarySource",
        "type": "semantic",
        "title": "Primary source of truth link"
      },
      {
        "id": "linkGroup",
        "type": "semantic",
        "title": "Grouped documentation links"
      },
      {
        "id": "groupTitle",
        "type": "semantic",
        "title": "Documentation group title"
      },
      {
        "id": "linkItem",
        "type": "semantic",
        "title": "Documentation link item"
      },
      {
        "id": "linkDescription",
        "type": "semantic",
        "title": "Documentation link description"
      },
      {
        "id": "documentationResource",
        "type": "semantic",
        "title": "Linked documentation resource"
      },
      {
        "id": "goAlpsDocs",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the generated ALPS documentation",
        "doc": {"value": "Open the generated ALPS documentation as the semantic source of truth for BeMart."}
      },
      {
        "id": "goApiDoc",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open BEAR.ApiDoc",
        "doc": {"value": "Open the generated BEAR.ApiDoc resource documentation."}
      },
      {
        "id": "goOpenApiJson",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the OpenAPI JSON",
        "doc": {"value": "Open the OpenAPI 3.1 JSON generated from PHP Resource on-methods."}
      },
      {
        "id": "goApiTerms",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the API term usage index",
        "doc": {"value": "Open the term usage index generated by BEAR.ApiDoc."}
      },
      {
        "id": "goApiLlms",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the LLM API summary",
        "doc": {"value": "Open the LLM-oriented API summary generated by BEAR.ApiDoc."}
      },
      {
        "id": "goMigrationGoal",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the migration goal review",
        "doc": {"value": "Open the document that defines BeMart as a semantic overhaul experiment."}
      },
      {
        "id": "goMigrationStatus",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the migration status",
        "doc": {"value": "Open the current migration status across ALPS, Be, Resource, SQL, HTML, and tests."}
      },
      {
        "id": "goReplacementResiduals",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open complete replacement residuals",
        "doc": {"value": "Open the residual list for compatibility fidelity and production verification."}
      },
      {
        "id": "goFeatureMatrix",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the feature and ALPS status matrix",
        "doc": {"value": "Open the generated feature matrix connecting EC-CUBE routes, ALPS IDs, implementation status, and difficulty."}
      },
      {
        "id": "goInitialArticle",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the archived initial ALPS article",
        "doc": {"value": "Open the archived article about deriving the first ALPS profile from EC-CUBE source code."}
      },
      {
        "id": "goRepository",
        "type": "safe",
        "rt": "#documentationResource",
        "title": "Open the GitHub repository",
        "doc": {"value": "Open the BeMart GitHub repository."}
      }
    ]
  }
}
