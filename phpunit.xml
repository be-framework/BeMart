<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="bemart">
            <directory>tests</directory>
        </testsuite>
        <testsuite name="bemart-be">
            <directory>be/tests/Domain</directory>
        </testsuite>
        <testsuite name="bemart-sql">
            <directory>be/tests/Sql</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="DATABASE_URL" value="mysql://dbuser:secret@127.0.0.1:3306/eccubedb_test?charset=utf8mb4&amp;serverVersion=mariadb-10.11.14"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
            <directory>be/src</directory>
        </include>
    </source>
</phpunit>
