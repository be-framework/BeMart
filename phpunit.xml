<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="fake">
            <directory>tests/Resource</directory>
            <exclude>tests/Resource/Sql</exclude>
            <directory>tests/Auth</directory>
            <directory>tests/Module</directory>
            <directory>tests/Router</directory>
            <directory>tests/Docs</directory>
            <directory>tests/EntryPoint</directory>
            <directory>be/tests/Domain</directory>
        </testsuite>
        <testsuite name="hypermedia">
            <directory>tests/Hypermedia</directory>
        </testsuite>
        <testsuite name="http">
            <directory>tests/Http</directory>
        </testsuite>
        <testsuite name="smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!--
                These groups are not hidden skips. They are boundary suites
                whose assertions are already covered by SQL-backed workflow
                or EC-CUBE reference comparison runs and are intentionally
                kept out of the default schema/runtime contract suite.
            -->
            <group>stateful-sql-covered</group>
            <group>ec-cube-reference</group>
        </exclude>
    </groups>
    <php>
        <env name="DATABASE_URL" value="mysql://root@127.0.0.1:3306/eccubedb_test?charset=utf8mb4&amp;serverVersion=mariadb-10.11.14"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
            <directory>be/src</directory>
        </include>
    </source>
</phpunit>
