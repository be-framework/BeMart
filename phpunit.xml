<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="fake">
            <directory>tests/Resource</directory>
            <exclude>tests/Resource/Sql</exclude>
            <directory>tests/Auth</directory>
            <directory>tests/Module</directory>
            <directory>tests/Router</directory>
            <directory>tests/Docs</directory>
            <directory>tests/EntryPoint</directory>
            <directory>be/tests/Domain</directory>
        </testsuite>
        <testsuite name="sql">
            <directory>be/tests/Sql</directory>
            <directory>tests/Resource/Sql</directory>
        </testsuite>
        <testsuite name="http">
            <directory>tests/Hypermedia</directory>
            <directory>tests/Http</directory>
        </testsuite>
        <testsuite name="smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="DATABASE_URL" value="mysql://dbuser:secret@127.0.0.1:3306/eccubedb_test?charset=utf8mb4&amp;serverVersion=mariadb-10.11.14"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
            <directory>be/src</directory>
        </include>
    </source>
</phpunit>
